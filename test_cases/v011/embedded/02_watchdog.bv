// Test: Watchdog contract - optional/required third bracket
// Category: Embedded - Watchdog
// Syntax: [watchdog] or [?watchdog] or [!watchdog]

let watchdog_active: Bool = false;
let counter: Int = 0;

// Optional watchdog (no prefix = optional)
rct txn process_optional [counter >= 0][counter == @counter + 1]
  [watchdog_active]
{
    &counter = counter + 1;
    term;
};

// Explicit optional watchdog (? prefix)
rct txn process_explicit [counter >= 0][counter == @counter + 1]
  [?watchdog_active]
{
    &counter = counter + 1;
    term;
};

// Required watchdog (! prefix = always enforced)
rct txn process_required [counter >= 0][counter == @counter + 1]
  [!watchdog_active]
{
    &counter = counter + 1;
    term;
};