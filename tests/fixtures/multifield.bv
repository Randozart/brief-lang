// Multiple state variables, multiple transactions
let count: Int = 0;
let active: Bool = false;

rct txn increment [count < 100 && active == false]
  [count == @count + 1 && active == @active]
{
  &count = count + 1;
  term;
};

rct txn toggle [true]
  [active != @active]
{
  &active = true;
  term;
};
