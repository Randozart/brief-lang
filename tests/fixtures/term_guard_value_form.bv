// 2026-08-04 codegen parity fixture (corrected_term_guard): a value-form
// `term! ->` INSIDE a `when` guard must unwind the WHOLE transaction body —
// the interpreter's TermReturn skips everything after the guard, so Print#(2)
// never runs and only "1" is printed. Pre-fix the LLVM backend fell through
// past the guard and printed "12". The termination pass must NOT flag
// Print#(2): the guard is conditional, so Print#(2) is reachable when a != 1.
let a: Int = 0;

node n [a == 0][a == 1] {
  a = 1;
  when a == 1 { endprogram Print#(1); };
  Print#(2);
};
