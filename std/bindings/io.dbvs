// I/O FFI Bindings Schema
// Defines file system and stream operations available via FFI

import "std/types.dbvs";

// Error type for I/O operations
enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    Other
}

// Result type for I/O operations
struct IoResult {
    success: Data,
    error: IoError
}

// Function: print - Print without newline
// Input: text (String)
// Output: void
register 0x00 as "print" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::io::print";
    target: native;
    description: "Print string to stdout without newline";
    check: [true];
}

// Function: println - Print with newline
// Input: text (String)
// Output: void
register 0x01 as "println" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::io::println";
    target: native;
    description: "Print string to stdout with newline";
    check: [true];
}

// Function: input - Read line from stdin
// Input: none
// Output: String
register 0x02 as "input" {
    type: Fn() -> Result<String, IoError>;
    location: "std::io::input";
    target: native;
    description: "Read line from stdin";
    check: [true];
}

// Function: read_file - Read entire file
// Input: path (String)
// Output: String (content)
register 0x03 as "read_file" {
    type: Fn(String) -> Result<String, IoError>;
    location: "std::fs::read_to_string";
    target: native;
    description: "Read entire file contents as string";
    check: [true];
}

// Function: write_file - Write to file
// Input: path (String), content (String)
// Output: void
register 0x04 as "write_file" {
    type: Fn(String, String) -> Result<Void, IoError>;
    location: "std::fs::write";
    target: native;
    description: "Write string contents to file, creating or truncating";
    check: [true];
}

// Function: append_file - Append to file
// Input: path (String), content (String)
// Output: Int (bytes written)
register 0x05 as "append_file" {
    type: Fn(String, String) -> Result<Int, IoError>;
    location: "std::fs::append";
    target: native;
    description: "Append string contents to end of file";
    check: [true];
}

// Function: file_exists - Check if path exists
// Input: path (String)
// Output: Bool
register 0x06 as "file_exists" {
    type: Fn(String) -> Bool;
    location: "std::path::Path::exists";
    target: native;
    description: "Check if file or directory exists";
    check: [true];
}

// Function: delete_file - Delete a file
// Input: path (String)
// Output: void
register 0x07 as "delete_file" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::fs::remove_file";
    target: native;
    description: "Delete a file";
    check: [true];
}

// Function: create_dir - Create directory
// Input: path (String)
// Output: void
register 0x08 as "create_dir" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::fs::create_dir";
    target: native;
    description: "Create a single directory";
    check: [true];
}

// Function: create_dir_all - Create directory tree
// Input: path (String)
// Output: void
register 0x09 as "create_dir_all" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::fs::create_dir_all";
    target: native;
    description: "Create directory and all parent directories";
    check: [true];
}

// Function: delete_dir - Delete empty directory
// Input: path (String)
// Output: void
register 0x0A as "delete_dir" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::fs::remove_dir";
    target: native;
    description: "Delete an empty directory";
    check: [true];
}

// Function: delete_dir_all - Delete directory recursively
// Input: path (String)
// Output: void
register 0x0B as "delete_dir_all" {
    type: Fn(String) -> Result<Void, IoError>;
    location: "std::fs::remove_dir_all";
    target: native;
    description: "Delete directory and all contents recursively";
    check: [true];
}
