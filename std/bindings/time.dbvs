// Time FFI Bindings Schema
// Defines time and date operations available via FFI

import "std/types.dbvs";

// Error type for time operations
enum TimeError {
    SystemTimeError,
    InvalidDuration,
    Overflow
}

// Function: current_timestamp - Get current time
// Input: none
// Output: Int (Unix timestamp in milliseconds)
register 0x00 as "current_timestamp" {
    type: Fn() -> Result<Int, TimeError>;
    location: "std::time::SystemTime::now";
    target: native;
    description: "Get current Unix timestamp in milliseconds";
    check: [true];
}

// Function: sleep_ms - Sleep for milliseconds
// Input: milliseconds (Int)
// Output: void
register 0x01 as "sleep_ms" {
    type: Fn(Int) -> Result<Void, TimeError>;
    location: "std::thread::sleep";
    target: native;
    description: "Sleep for specified milliseconds";
    check: [milliseconds >= 0];
}

// Function: sleep_seconds - Sleep for seconds
// Input: seconds (Int)
// Output: void
register 0x02 as "sleep_seconds" {
    type: Fn(Int) -> Result<Void, TimeError>;
    location: "std::thread::sleep";
    target: native;
    description: "Sleep for specified seconds";
    check: [seconds >= 0];
}

// Function: measure_time_ms - Start timing
// Input: none
// Output: Int (handle)
register 0x03 as "measure_time_ms" {
    type: Fn() -> Result<Int, TimeError>;
    location: "std::time::Instant::now";
    target: native;
    description: "Start timing measurement (returns handle)";
    check: [true];
}

// Function: elapsed_ms - Get elapsed time
// Input: handle (Int)
// Output: Int (elapsed milliseconds)
register 0x04 as "elapsed_ms" {
    type: Fn(Int) -> Result<Int, TimeError>;
    location: "std::time::Instant::elapsed";
    target: native;
    description: "Get elapsed milliseconds since measurement started";
    check: [handle >= 0];
}
