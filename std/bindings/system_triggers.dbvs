// System Triggers FFI Bindings Schema
// Defines OS-level event triggers available via FFI for Regular Briv
// These map to signals, stdin, timers, filesystem events, and network events

import "std/types.dbvs";

// ===== SIGNAL TRIGGERS =====

// SIGINT (Ctrl+C) - OS interrupt signal
register 0x100 as "sigint" {
    type: Trigger(Bool);
    location: "signal::SIGINT";
    target: native;
    description: "Fires when user sends SIGINT (Ctrl+C)";
    check: [true];
    trigger: {
        event_type: "signal";
        signal: "SIGINT";
        mode: "edge";
    }
}

// SIGTERM - OS termination signal
register 0x101 as "sigterm" {
    type: Trigger(Bool);
    location: "signal::SIGTERM";
    target: native;
    description: "Fires when process receives SIGTERM";
    check: [true];
    trigger: {
        event_type: "signal";
        signal: "SIGTERM";
        mode: "edge";
    }
}

// SIGHUP - Terminal hangup signal
register 0x102 as "sighup" {
    type: Trigger(Bool);
    location: "signal::SIGHUP";
    target: native;
    description: "Fires when terminal hangs up";
    check: [true];
    trigger: {
        event_type: "signal";
        signal: "SIGHUP";
        mode: "edge";
    }
}

// ===== STDIN TRIGGERS =====

// stdin_line - Complete line available on stdin
register 0x103 as "stdin_line" {
    type: Trigger(String);
    location: "std::io::stdin_line";
    target: native;
    description: "Fires when a complete line is available on stdin";
    check: [true];
    trigger: {
        event_type: "stdin";
        mode: "line_buffered";
    }
}

// stdin_ready - Data available on stdin
register 0x104 as "stdin_ready" {
    type: Trigger(Bool);
    location: "std::io::stdin_ready";
    target: native;
    description: "Fires when stdin has data available to read";
    check: [true];
    trigger: {
        event_type: "stdin";
        mode: "ready";
    }
}

// ===== TIMER TRIGGERS =====

// clock_tick_1hz - Fires once per second
register 0x105 as "clock_tick_1hz" {
    type: Trigger(Int);
    location: "time::tick_1hz";
    target: native;
    description: "Fires once per second with tick count";
    check: [true];
    trigger: {
        event_type: "timer";
        interval_ms: 1000;
    }
}

// clock_tick_10hz - Fires 10 times per second
register 0x106 as "clock_tick_10hz" {
    type: Trigger(Int);
    location: "time::tick_10hz";
    target: native;
    description: "Fires 10 times per second with tick count";
    check: [true];
    trigger: {
        event_type: "timer";
        interval_ms: 100;
    }
}

// clock_tick_100hz - Fires 100 times per second
register 0x107 as "clock_tick_100hz" {
    type: Trigger(Int);
    location: "time::tick_100hz";
    target: native;
    description: "Fires 100 times per second with tick count";
    check: [true];
    trigger: {
        event_type: "timer";
        interval_ms: 10;
    }
}

// ===== STDOUT TRIGGERS =====

// stdout_ready - Stdout buffer has space
register 0x108 as "stdout_ready" {
    type: Trigger(Bool);
    location: "std::io::stdout_ready";
    target: native;
    description: "Fires when stdout buffer has space for writing";
    check: [true];
    trigger: {
        event_type: "stdout";
        mode: "ready";
    }
}

// ===== FILESYSTEM TRIGGERS =====

// file_event - Watched file changed
register 0x109 as "file_event" {
    type: Trigger(String);
    location: "fs::watch_event";
    target: native;
    description: "Fires when a watched file changes (returns path)";
    check: [true];
    trigger: {
        event_type: "filesystem";
        mode: "watch";
    }
}

// ===== NETWORK TRIGGERS =====

// network_data - Data arrived on monitored socket
register 0x10A as "network_data" {
    type: Trigger(String);
    location: "net::socket_data";
    target: native;
    description: "Fires when data arrives on a monitored socket";
    check: [true];
    trigger: {
        event_type: "network";
        mode: "data_ready";
    }
}

// network_connected - Connection established
register 0x10B as "network_connected" {
    type: Trigger(Bool);
    location: "net::connected";
    target: native;
    description: "Fires when a network connection is established";
    check: [true];
    trigger: {
        event_type: "network";
        mode: "connected";
    }
}

// network_disconnected - Connection dropped
register 0x10C as "network_disconnected" {
    type: Trigger(Bool);
    location: "net::disconnected";
    target: native;
    description: "Fires when a network connection drops";
    check: [true];
    trigger: {
        event_type: "network";
        mode: "disconnected";
    }
}
