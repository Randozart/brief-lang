import "std/types.dbvs";

register 0x40 as "__http_get" {
    type: Fn(Data) -> Data;
    location: "http::get";
    target: native;
    description: "Perform an HTTP GET request";
    check: [true];
}

register 0x41 as "__http_post" {
    type: Fn(Data, Data) -> Data;
    location: "http::post";
    target: native;
    description: "Perform an HTTP POST request with body";
    check: [true];
}
