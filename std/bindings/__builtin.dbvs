// Built-in operations — interpreter-native operations exposed through FFI registry.
// These are the lowest-level operations that the interpreter must perform natively:
//   HashMap, HashSet, StringBuilder, Stack, Queue, Result, Option, String, clone.
//
// This file is loaded by the interpreter to populate fn_locations_by_name, which maps
// __builtin_* names to __builtin.* location keys. The location keys match the match
// arms in src/ffi/registry.rs resolve_location_to_impl().
//
// NOTE: Addresses are arbitrary (in the __builtin range). They are never used as
// physical addresses — they're just identifiers for the DBVS parser.

// ===== HashMap =====

register 0x1000 as "__builtin_HashMap_new" {
    type: Data;
    location: "__builtin.HashMap.new";
    target: native;
    description: "Create empty HashMap";
    check: [true];
}

register 0x1001 as "__builtin_HashMap_insert" {
    type: Data;
    location: "__builtin.HashMap.insert";
    target: native;
    description: "Insert key-value pair into HashMap";
    check: [true];
}

register 0x1002 as "__builtin_HashMap_get" {
    type: Data;
    location: "__builtin.HashMap.get";
    target: native;
    description: "Get value by key from HashMap";
    check: [true];
}

register 0x1003 as "__builtin_HashMap_contains_key" {
    type: Data;
    location: "__builtin.HashMap.contains_key";
    target: native;
    description: "Check if HashMap contains key";
    check: [true];
}

register 0x1004 as "__builtin_HashMap_remove" {
    type: Data;
    location: "__builtin.HashMap.remove";
    target: native;
    description: "Remove key-value pair from HashMap";
    check: [true];
}

register 0x1005 as "__builtin_HashMap_len" {
    type: Data;
    location: "__builtin.HashMap.len";
    target: native;
    description: "Get HashMap entry count";
    check: [true];
}

register 0x1006 as "__builtin_HashMap_is_empty" {
    type: Data;
    location: "__builtin.HashMap.is_empty";
    target: native;
    description: "Check if HashMap is empty";
    check: [true];
}

register 0x1007 as "__builtin_HashMap_keys" {
    type: Data;
    location: "__builtin.HashMap.keys";
    target: native;
    description: "Get all keys from HashMap";
    check: [true];
}

register 0x1008 as "__builtin_HashMap_values" {
    type: Data;
    location: "__builtin.HashMap.values";
    target: native;
    description: "Get all values from HashMap";
    check: [true];
}

