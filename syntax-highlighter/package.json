{
  "name": "briv-language",
  "displayName": "Briv Language",
  "description": "Syntax highlighting, folding, bracket colorization, and intelligent editing for Briv (.bv), Rendered Briv (.rbv), and Embedded Briv (.ebv) files",
  "version": "0.1.0",
  "icon": "images/extension-logo.png",
  "publisher": "randozart",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:briv",
    "onLanguage:rbv",
    "onLanguage:ebv",
    "onLanguage:dbriv",
    "onLanguage:sbriv",
    "onLanguage:srbv",
    "onLanguage:sebv",
    "onLanguage:abv",
    "onLanguage:cbv"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "briv",
        "aliases": ["Briv", "briv"],
        "extensions": [".bv"],
        "icon": {
          "light": "./images/briv-logo.svg",
          "dark": "./images/briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rbv",
        "aliases": ["Rendered Briv", "rendered-briv", "Briv Render", "briv-render"],
        "extensions": [".rbv"],
        "icon": {
          "light": "./images/r-briv-logo.svg",
          "dark": "./images/r-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ebv",
        "aliases": ["Embedded Briv", "embedded-briv", "Briv Embed", "briv-embed"],
        "extensions": [".ebv"],
        "icon": {
          "light": "./images/e-briv-logo.svg",
          "dark": "./images/e-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dbriv",
        "aliases": ["Data Briv", "dbriv", "Briv Data", "briv-data"],
        "extensions": [".dbv", ".dbvl"],
        "icon": {
          "light": "./images/d-briv-logo.svg",
          "dark": "./images/d-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbriv",
        "aliases": ["Strict Briv", "strict-briv"],
        "extensions": [".sbv"],
        "icon": {
          "light": "./images/briv-logo.svg",
          "dark": "./images/briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "srbv",
        "aliases": ["Strict Rendered Briv", "strict-rendered-briv", "Strict Render", "strict-render"],
        "extensions": [".srbv"],
        "icon": {
          "light": "./images/r-briv-logo.svg",
          "dark": "./images/r-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sebv",
        "aliases": ["Strict Embedded Briv", "strict-embedded-briv", "Strict Embed", "strict-embed"],
        "extensions": [".sebv"],
        "icon": {
          "light": "./images/e-briv-logo.svg",
          "dark": "./images/e-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abv",
        "aliases": ["Accelerated Briv", "accelerated-briv", "Briv Accel", "briv-accel"],
        "extensions": [".abv"],
        "icon": {
          "light": "./images/a-briv-logo.svg",
          "dark": "./images/a-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cbv",
        "aliases": ["Circuit Briv", "circuit-briv", "Briv Circuit", "briv-circuit"],
        "extensions": [".cbv"],
        "icon": {
          "light": "./images/c-briv-logo.svg",
          "dark": "./images/c-briv-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "beast",
        "aliases": ["BEAST", "beast"],
        "extensions": [".beast"],
        "icon": {
          "light": "./images/beast-icon.svg",
          "dark": "./images/beast-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "briv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "rbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "ebv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "dbriv",
        "scopeName": "source.dbriv",
        "path": "./syntaxes/dbriv.tmLanguage.json"
      },
      {
        "language": "sbriv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "srbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "sebv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "abv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "cbv",
        "scopeName": "source.briv",
        "path": "./syntaxes/briv.tmLanguage.json"
      },
      {
        "language": "beast",
        "scopeName": "source.beast",
        "path": "./syntaxes/beast.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Briv Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/briv-dark.json"
      },
      {
        "label": "Briv Light",
        "uiTheme": "vs",
        "path": "./themes/briv-light.json"
      }
    ],
    "folding": [
      {
        "language": "briv",
        "boundaries": [
          "// === PATH ANALYSIS ===",
          "// === END PATH ANALYSIS ==="
        ]
      }
    ],
    "brackets": [
      {
        "language": "briv",
        "open": "{",
        "close": "}"
      },
      {
        "language": "briv",
        "open": "[",
        "close": "]"
      },
      {
        "language": "briv",
        "open": "(",
        "close": ")"
      }
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "comments": {
      "lineComment": "#"
    },
    "indentationRules": {
      "increaseIndentPattern": "\\{[^}]*${|\\[([^\\]]*${|\\([^)]*${",
      "decreaseIndentPattern": "^\\s*\\]|\\}\\s*$|\\)\\s*$"
    }
  },
  "devDependencies": {
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "overrides": {
    "undici": "5.11.0"
  }
}
