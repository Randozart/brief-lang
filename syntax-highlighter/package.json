{
  "name": "brief-language",
  "displayName": "Brief Language",
  "description": "Syntax highlighting, folding, bracket colorization, and intelligent editing for Brief (.bv), Rendered Brief (.rbv), and Embedded Brief (.ebv) files",
  "version": "0.1.0",
  "publisher": "randozart",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:brief",
    "onLanguage:rbv",
    "onLanguage:ebv",
    "onLanguage:dbrief",
    "onLanguage:sbrief",
    "onLanguage:srbv",
    "onLanguage:sebv",
    "onLanguage:abv",
    "onLanguage:cbv"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "brief",
        "aliases": ["Brief", "brief"],
        "extensions": [".bv"],
        "icon": {
          "light": "./images/extension-logo.svg",
          "dark": "./images/extension-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rbv",
        "aliases": ["Rendered Brief", "rendered-brief", "Brief Render", "brief-render"],
        "extensions": [".rbv"],
        "icon": {
          "light": "./images/r-brief-logo.svg",
          "dark": "./images/r-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ebv",
        "aliases": ["Embedded Brief", "embedded-brief", "Brief Embed", "brief-embed"],
        "extensions": [".ebv"],
        "icon": {
          "light": "./images/e-brief-logo.svg",
          "dark": "./images/e-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dbrief",
        "aliases": ["Data Brief", "dbrief", "Brief Data", "brief-data"],
        "extensions": [".dbv", ".dbvl", ".dbvs"],
        "icon": {
          "light": "./images/d-brief-logo.svg",
          "dark": "./images/d-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sbrief",
        "aliases": ["Strict Brief", "strict-brief"],
        "extensions": [".sbv"],
        "icon": {
          "light": "./images/extension-logo.svg",
          "dark": "./images/extension-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "srbv",
        "aliases": ["Strict Rendered Brief", "strict-rendered-brief", "Strict Render", "strict-render"],
        "extensions": [".srbv"],
        "icon": {
          "light": "./images/r-brief-logo.svg",
          "dark": "./images/r-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sebv",
        "aliases": ["Strict Embedded Brief", "strict-embedded-brief", "Strict Embed", "strict-embed"],
        "extensions": [".sebv"],
        "icon": {
          "light": "./images/e-brief-logo.svg",
          "dark": "./images/e-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abv",
        "aliases": ["Accelerated Brief", "accelerated-brief", "Brief Accel", "brief-accel"],
        "extensions": [".abv"],
        "icon": {
          "light": "./images/a-brief-logo.svg",
          "dark": "./images/a-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cbv",
        "aliases": ["Circuit Brief", "circuit-brief", "Brief Circuit", "brief-circuit"],
        "extensions": [".cbv"],
        "icon": {
          "light": "./images/c-brief-logo.svg",
          "dark": "./images/c-brief-logo.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "brief",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      },
      {
        "language": "rbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "ebv",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      },
      {
        "language": "dbrief",
        "scopeName": "source.dbrief",
        "path": "./syntaxes/dbrief.tmLanguage.json"
      },
      {
        "language": "sbrief",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      },
      {
        "language": "srbv",
        "scopeName": "source.rbv",
        "path": "./syntaxes/rbv.tmLanguage.json"
      },
      {
        "language": "sebv",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      },
      {
        "language": "abv",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      },
      {
        "language": "cbv",
        "scopeName": "source.brief",
        "path": "./syntaxes/brief.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Brief Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/brief-dark.json"
      },
      {
        "label": "Brief Light",
        "uiTheme": "vs",
        "path": "./themes/brief-light.json"
      }
    ],
    "folding": [
      {
        "language": "brief",
        "boundaries": [
          "// === PATH ANALYSIS ===",
          "// === END PATH ANALYSIS ==="
        ]
      }
    ],
    "brackets": [
      {
        "language": "brief",
        "open": "{",
        "close": "}"
      },
      {
        "language": "brief",
        "open": "[",
        "close": "]"
      },
      {
        "language": "brief",
        "open": "(",
        "close": ")"
      }
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "comments": {
      "lineComment": "#"
    },
    "indentationRules": {
      "increaseIndentPattern": "\\{[^}]*${|\\[([^\\]]*${|\\([^)]*${",
      "decreaseIndentPattern": "^\\s*\\]|\\}\\s*$|\\)\\s*$"
    }
  },
  "devDependencies": {
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "overrides": {
    "undici": "5.11.0"
  }
}
