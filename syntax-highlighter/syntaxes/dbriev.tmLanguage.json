{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Data Briev",
  "fileTypes": [
    "dbv",
    "dbvl"
  ],
  "firstLineMatch": "^//",
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#line-comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.briev",
          "begin": "#\\[",
          "end": "\\]#"
        }
      ]
    },
    "line-comments": {
      "patterns": [
        {
          "name": "comment.line.briev",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.briev",
          "match": "^// === PATH ANALYSIS ==="
        },
        {
          "name": "meta.annotation.briev",
          "match": "^// === END PATH ANALYSIS ==="
        },
        {
          "name": "comment.annotation.briev",
          "match": "^// \\[(ENTRY_POINT|RECURSIVE)\\]"
        },
        {
          "name": "comment.annotation.briev",
          "match": "^// (PATHS_TO|CALLERS|RESOLVES_TO):"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.txn.briev",
          "match": "\\b(txn|TXN)\\b"
        },
        {
          "name": "keyword.control.reactive.briev",
          "match": "\\b(rct|RCT)\\b"
        },
        {
          "name": "keyword.control.async.briev",
          "match": "\\b(async|ASYNC)\\b"
        },
        {
          "name": "keyword.control.modifier.briev",
          "match": "\\b(seq|vol|sync)\\b"
        },
        {
          "name": "keyword.control.flow.briev",
          "match": "\\b(term|escape|TERM|ESCAPE)\\b"
        },
        {
          "name": "keyword.declaration.briev",
          "match": "\\b(sig|defn|let|const|trg|SIG|DEFN|LET|CONST|TRG)\\b"
        },
        {
          "name": "keyword.declaration.ffi.briev",
          "match": "\\b(frgn!?|syscall!?)\\b"
        },
        {
          "name": "keyword.control.match.briev",
          "match": "\\b(match|uni)\\b"
        },
        {
          "name": "keyword.control.visibility.briev",
          "match": "\\b(pvt|sed)\\b"
        },
        {
          "name": "keyword.import.briev",
          "match": "\\b(import|from|IMPORT|FROM)\\b"
        },
        {
          "name": "keyword.control.dbriev.briev",
          "match": "\\b(REGISTER|ALIAS|RULE|CHECK)\\b"
        },
        {
          "name": "keyword.control.temporal.briev",
          "match": "\\b(within|retry)\\b"
        },
        {
          "name": "keyword.other.time-unit.briev",
          "match": "\\b(cycles|cyc|seconds|s|milliseconds|ms|minutes|min|nanoseconds|ns)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.briev",
          "match": "\\b(Int|Float|String|Bool|Data|Void|UInt)\\b"
        },
        {
          "name": "entity.name.type.custom.briev",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "meta.contract.briev",
          "begin": "\\[\\[?",
          "end": "\\]\\]?",
          "patterns": [
            {
              "include": "#line-comments"
            },
            {
              "include": "#block-comments"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.briev",
          "match": "&"
        },
        {
          "name": "variable.language.prior-state.briev",
          "match": "@"
        },
        {
          "name": "storage.modifier.ownership.briev",
          "match": "\\?"
        },
        {
          "name": "storage.modifier.ownership.briev",
          "match": "!"
        },
        {
          "name": "keyword.operator.comparison.briev",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.relational.briev",
          "match": "<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.briev",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.briev",
          "match": "\\+|\\-|\\*|/"
        },
        {
          "name": "keyword.operator.consumptive.briev",
          "match": "~<-|~=|~\\+|~\\-|~\\*|~/"
        },
        {
          "name": "keyword.operator.bitwise.briev",
          "match": "~|&(?!&)|\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.arrow.briev",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.briev",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.briev",
          "match": "'(\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.double.briev",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.briev",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.briev",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.briev",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.briev",
          "match": "\\b0x[0-9a-fA-F]+\\b|\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.true.briev",
          "match": "\\b(true|TRUE)\\b"
        },
        {
          "name": "constant.language.false.briev",
          "match": "\\b(false|FALSE)\\b"
        },
        {
          "name": "constant.language.null.briev",
          "match": "\\b(null|NULL)\\b"
        },
        {
          "name": "constant.language.result.briev",
          "match": "\\b(Ok|Err|OK|ERR|Some|None|SOME|NONE)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.briev",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.briev",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.read.briev",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#line-comments"
        },
        {
          "include": "#block-comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.briev",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.briev",
          "match": ","
        },
        {
          "name": "punctuation.bracket.curly.briev",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.briev",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.briev",
          "match": "[()]"
        }
      ]
    }
  },
  "scopeName": "source.dbriev"
}