{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Briv",
  "fileTypes": ["bv", "br", "abv", "sbv", "rbv", "srbv", "ebv", "sebv", "cbv", "dbv", "dbvl"],
  "firstLineMatch": "^//",
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#line-comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#render-block"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#hash-words"
    },
    {
      "include": "#compiletime-keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#stage-blocks"
    },
    {
      "include": "#navigation-intrinsics"
    },
    {
      "include": "#ast-constructors"
    },
    {
      "include": "#diagnostics"
    },
    {
      "include": "#targets"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#metadata-properties"
    }
  ],
  "repository": {
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.briv",
          "begin": "#\\[",
          "end": "\\]#"
        }
      ]
    },
    "line-comments": {
      "patterns": [
        {
          "name": "comment.line.briv",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.briv",
          "match": "^// === PATH ANALYSIS ==="
        },
        {
          "name": "meta.annotation.briv",
          "match": "^// === END PATH ANALYSIS ==="
        },
        {
          "name": "comment.annotation.briv",
          "match": "^// \\[(ENTRY_POINT|RECURSIVE)\\]"
        },
        {
          "name": "comment.annotation.briv",
          "match": "^// (PATHS_TO|CALLERS|RESOLVES_TO):"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.txn.briv",
          "match": "\\b(txn|TXN)\\b"
        },
        {
          "name": "keyword.control.async.briv",
          "match": "\\b(async|ASYNC)\\b"
        },
        {
          "name": "keyword.control.modifier.briv",
          "match": "\\b(seq|vol|sync)\\b"
        },
        {
          "name": "keyword.control.flow.briv",
          "match": "\\b(term|term!|escape|TERM|ESCAPE)\\b"
        },
        {
          "name": "keyword.declaration.briv",
          "match": "\\b(sig|defn|let|const|trg|txn|SIG|DEFN|LET|CONST|TRG|TXN|struct|enum|STRUCT|ENUM|type|TYPE|fallback|FALLBACK|node|NODE)\\b"
        },
        {
          "name": "keyword.declaration.ffi.briv",
          "match": "\\b(frgn!?|syscall!?)\\b"
        },
        {
          "name": "keyword.control.render.briv",
          "match": "\\b(render|RENDER)\\b"
        },
        {
          "name": "keyword.control.match.briv",
          "match": "\\b(match|uni)\\b"
        },
        {
          "name": "keyword.control.visibility.briv",
          "match": "\\b(pvt|sed)\\b"
        },
        {
          "name": "keyword.import.briv",
          "match": "\\b(import|from|IMPORT|FROM|as|AS|target|TARGET)\\b"
        },
        {
          "name": "keyword.control.dbriv.briv",
          "match": "\\b(REGISTER|ALIAS|RULE|CHECK)\\b"
        },
        {
          "name": "keyword.control.temporal.briv",
          "match": "\\b(within|retry)\\b"
        },
        {
          "name": "storage.modifier.briv",
          "match": "\\b(mmio|MMIO|wake|WAKE|nowake|NOWAKE)\\b"
        },
        {
          "name": "keyword.other.time-unit.briv",
          "match": "\\b(cycles|cyc|seconds|s|milliseconds|ms|minutes|min|nanoseconds|ns)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.briv",
          "match": "\\b(Int|Float|String|Bool|Data|Void|UInt|Ptr|Bits)\\b"
        },
        {
          "name": "entity.name.type.custom.briv",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "meta.contract.briv",
          "begin": "\\[\\[?",
          "end": "\\]\\]?",
          "patterns": [
            {
              "include": "#line-comments"
            },
            {
              "include": "#block-comments"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.briv",
          "match": "&"
        },
        {
          "name": "storage.modifier.ownership.briv",
          "match": "@"
        },
        {
          "name": "storage.modifier.ownership.briv",
          "match": "\\?"
        },
        {
          "name": "storage.modifier.ownership.briv",
          "match": "!"
        },
        {
          "name": "keyword.operator.comparison.briv",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.push.briv",
          "match": "<-"
        },
        {
          "name": "keyword.operator.subtype.briv",
          "match": "<:"
        },
        {
          "name": "keyword.operator.relational.briv",
          "match": "<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.briv",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.briv",
          "match": "\\+|\\-|\\*|/"
        },
        {
          "name": "keyword.operator.consumptive.briv",
          "match": "~<-|~=|~\\+|~\\-|~\\*|~/"
        },
        {
          "name": "keyword.operator.bitwise.briv",
          "match": "~|&(?!&)|\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.arrow.briv",
          "match": "->"
        },
        {
          "name": "keyword.operator.projection.briv",
          "match": ":>"
        },
        {
          "name": "keyword.operator.arrow.briv",
          "match": "<-"
        },
        {
          "name": "keyword.operator.property.briv",
          "match": "<~"
        },
        {
          "name": "keyword.operator.assignment.briv",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.briv",
          "match": "'(\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.double.briv",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.briv",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.briv",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.briv",
          "match": "\\b0x[0-9a-fA-F]+\\b|\\b[0-9]+\\b"
        }
      ]
    },
    "hash-words": {
      "patterns": [
        {
          "name": "support.constant.property-value.hashword.briv",
          "comment": "Positional markers (#L, #R, #T) and protocol category hashwords (#Int, #Float, #String, #Bool, #Char, #Bits, #UInt, #Ptr, #Link, #System). Optional <variant> suffix for parameterized protocols like #String<UTF8>.",
          "match": "#(L|R|T|Int|Float|String|Bool|Char|Bits|UInt|Ptr|Link|System)(<[a-zA-Z0-9_]+>)?"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.true.briv",
          "match": "\\b(true|TRUE)\\b"
        },
        {
          "name": "constant.language.false.briv",
          "match": "\\b(false|FALSE)\\b"
        },
        {
          "name": "constant.language.null.briv",
          "match": "\\b(null|NULL)\\b"
        },
        {
          "name": "constant.language.result.briv",
          "match": "\\b(Ok|Err|OK|ERR|Some|None|SOME|NONE)\\b"
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.constant.property-value.intrinsic.briv",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*#"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.briv",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.briv",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.read.briv",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#line-comments"
        },
        {
          "include": "#block-comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.briv",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.briv",
          "match": ","
        },
        {
          "name": "punctuation.bracket.curly.briv",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.briv",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.briv",
          "match": "[()]"
        }
      ]
    },
    "render-block": {
      "begin": "\\b(render|RENDER)\\b\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.render.briv" },
        "2": { "name": "punctuation.bracket.curly.briv" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.bracket.curly.briv" }
      },
      "patterns": [
        {
          "include": "#html-components"
        },
        {
          "include": "text.html.basic"
        },
        {
          "include": "#briv-bindings"
        }
      ]
    },
    "html-components": {
      "patterns": [
        {
          "match": "(<)([A-Z][a-zA-Z0-9_]*)(\\s+[^>]*)?(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "patterns": [{ "include": "text.html.basic" }] },
            "4": { "name": "punctuation.definition.tag.briv" }
          }
        },
        {
          "match": "(</)([A-Z][a-zA-Z0-9_]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "name": "punctuation.definition.tag.briv" }
          }
        },
        {
          "begin": "(<)([a-z][a-z0-9]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" }
          },
          "end": "(</)(\\2)(>)|(/>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "name": "punctuation.definition.tag.briv" },
            "4": { "name": "punctuation.definition.tag.briv" }
          },
          "patterns": [
            { "include": "#briv-bindings" },
            { "include": "text.html.basic" },
            { "include": "#html-components" }
          ]
        }
      ]
    },
    "briv-bindings": {
      "patterns": [
        {
          "match": "\\b(b-[a-z0-9\\-]+)(:([a-z0-9\\-]+))?(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.briv" },
            "3": { "name": "variable.parameter.briv" },
            "4": { "name": "punctuation.separator.key-value.briv" },
            "5": { "name": "string.quoted.double.briv" }
          }
        }
      ]
    },
    "stage-blocks": {
      "patterns": [
        {
          "name": "entity.name.function.stage-block.briv",
          "match": "\\$\\((PreLex|Parsed|Resolved|Typed|Normalized|Verified|Allocated|Provenanced|Generated|Optimized|Linked)\\)"
        },
        {
          "name": "entity.name.function.stage-block.deprecated.briv",
          "match": "\\$\\((Front|Mid|Post|Back)\\)"
        }
      ]
    },
    "navigation-intrinsics": {
      "patterns": [
        {
          "name": "support.constant.property-value.navigation.briv",
          "match": "\\b(All|Tag|Named|WithKey|WithAttr|And|Or|Not|First|Last|Nth|Children|Descendants|Parent|Ancestors|Closest|Next|Prev|Before|After|Replace|Inside|AppendTo|Insert|Delete|ReplaceWith|Set|Wrap|Rename|Count|IsEmpty|Names|Find|Prepend|Append|Lines|Run|ForEach|Bound|Text|Path|Size|ReadBytes|List|Remove|StrSplit|StrReplace|StrJoin|EnvGet|SysQuery|TimeNow|HttpFetch|ShellCmd|FileRead|FileWrite|ConfigGet|TypeInfo|CastPath|InjectTypeLayout|DocRead|EmitInfo|EmitWarning|EmitError|Quote)\\$"
        }
      ]
    },
    "ast-constructors": {
      "patterns": [
        {
          "name": "support.constant.property-value.constructor.briv",
          "match": "\\b(Import|Defn|Txn|Contract|Block|Let|Assign|Term|Guarded|Call|Ident|Expr|BinOp|Field|BlockExpr|Bits|Ptr|Tuple|Metadata|Pattern)\\$"
        }
      ]
    },
    "diagnostics": {
      "patterns": [
        {
          "name": "support.constant.property-value.diagnostic.briv",
          "match": "\\b(EmitInfo|EmitWarning|EmitError)\\$"
        }
      ]
    },
    "targets": {
      "patterns": [
        {
          "name": "support.constant.property-value.target.briv",
          "match": "\\b(Source|Ir|Bin|Stage)\\$"
        }
      ]
    },
    "compiletime-keywords": {
      "patterns": [
        {
          "name": "support.constant.property-value.compiletime.briv",
          "match": "\\$(let|const|defn|txn)\\b"
        }
      ]
    },
    "metadata-properties": {
      "patterns": [
        {
          "name": "keyword.other.property.briv",
          "match": "\\b(maxbits|observable|alignment|primitive|ctd|alu|llvm_type|layout)\\b"
        }
      ]
    }
  },
  "scopeName": "source.briv"
}
