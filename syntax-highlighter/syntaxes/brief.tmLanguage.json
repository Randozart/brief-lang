{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Brief",
  "fileTypes": ["bv", "br", "abv", "sbv", "rbv", "srbv", "ebv", "sebv", "cbv", "dbv", "dbvs", "dbvl"],
  "firstLineMatch": "^//",
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#line-comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#render-block"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#hash-words"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#stage-blocks"
    },
    {
      "include": "#navigation-intrinsics"
    },
    {
      "include": "#ast-constructors"
    },
    {
      "include": "#diagnostics"
    },
    {
      "include": "#targets"
    },
    {
      "include": "#macro-words"
    },
    {
      "include": "#compiletime-keywords"
    },
    {
      "include": "#metadata-properties"
    }
  ],
  "repository": {
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.brief",
          "begin": "#\\[",
          "end": "\\]#"
        }
      ]
    },
    "line-comments": {
      "patterns": [
        {
          "name": "comment.line.brief",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.brief",
          "match": "^// === PATH ANALYSIS ==="
        },
        {
          "name": "meta.annotation.brief",
          "match": "^// === END PATH ANALYSIS ==="
        },
        {
          "name": "comment.annotation.brief",
          "match": "^// \\[(ENTRY_POINT|RECURSIVE)\\]"
        },
        {
          "name": "comment.annotation.brief",
          "match": "^// (PATHS_TO|CALLERS|RESOLVES_TO):"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.txn.brief",
          "match": "\\b(txn|TXN)\\b"
        },
        {
          "name": "keyword.control.async.brief",
          "match": "\\b(async|ASYNC)\\b"
        },
        {
          "name": "keyword.control.flow.brief",
          "match": "\\b(term|term!|escape|TERM|ESCAPE)\\b"
        },
        {
          "name": "keyword.declaration.brief",
          "match": "\\b(sig|defn|let|const|trg|txn|SIG|DEFN|LET|CONST|TRG|TXN|struct|enum|STRUCT|ENUM|type|TYPE|fallback|FALLBACK|node|NODE)\\b"
        },
        {
          "name": "keyword.declaration.ffi.brief",
          "match": "\\b(frgn!?|syscall!?)\\b"
        },
        {
          "name": "keyword.control.render.brief",
          "match": "\\b(render|RENDER)\\b"
        },
        {
          "name": "keyword.control.match.brief",
          "match": "\\b(match|uni)\\b"
        },
        {
          "name": "keyword.control.visibility.brief",
          "match": "\\b(pvt|sed)\\b"
        },
        {
          "name": "keyword.import.brief",
          "match": "\\b(import|from|IMPORT|FROM|as|AS|target|TARGET)\\b"
        },
        {
          "name": "keyword.control.dbrief.brief",
          "match": "\\b(REGISTER|ALIAS|RULE|CHECK)\\b"
        },
        {
          "name": "keyword.control.temporal.brief",
          "match": "\\b(within|retry)\\b"
        },
        {
          "name": "storage.modifier.brief",
          "match": "\\b(mmio|MMIO|wake|WAKE|nowake|NOWAKE)\\b"
        },
        {
          "name": "keyword.other.time-unit.brief",
          "match": "\\b(cycles|cyc|seconds|s|milliseconds|ms|minutes|min|nanoseconds|ns)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.brief",
          "match": "\\b(Int|Float|String|Bool|Data|Void|UInt|Ptr|Bits)\\b"
        },
        {
          "name": "entity.name.type.custom.brief",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "meta.contract.brief",
          "begin": "\\[\\[?",
          "end": "\\]\\]?",
          "patterns": [
            {
              "include": "#line-comments"
            },
            {
              "include": "#block-comments"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.brief",
          "match": "&"
        },
        {
          "name": "variable.language.prior-state.brief",
          "match": "@"
        },
        {
          "name": "keyword.operator.comparison.brief",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.push.brief",
          "match": "<-"
        },
        {
          "name": "keyword.operator.subtype.brief",
          "match": "<:"
        },
        {
          "name": "keyword.operator.relational.brief",
          "match": "<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.brief",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.brief",
          "match": "\\+|\\-|\\*|/"
        },
        {
          "name": "keyword.operator.temporal-fallback.brief",
          "match": "~\\?"
        },
        {
          "name": "keyword.operator.term-until.brief",
          "match": "~/"
        },
        {
          "name": "keyword.operator.bitwise.brief",
          "match": "~|&(?!&)|\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.arrow.brief",
          "match": "->"
        },
        {
          "name": "keyword.operator.projection.brief",
          "match": ":>"
        },
        {
          "name": "keyword.operator.push.brief",
          "match": "<-"
        },
        {
          "name": "keyword.operator.property.brief",
          "match": "<~"
        },
        {
          "name": "keyword.operator.assignment.brief",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.brief",
          "match": "'(\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.double.brief",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.brief",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.brief",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.brief",
          "match": "\\b0x[0-9a-fA-F]+\\b|\\b[0-9]+\\b"
        }
      ]
    },
        "hash-words": {
          "patterns": [
            {
              "name": "keyword.hashword.brief",
              "match": "#L|#R|#T"
            }
          ]
        },
        "booleans": {
      "patterns": [
        {
          "name": "constant.language.true.brief",
          "match": "\\b(true|TRUE)\\b"
        },
        {
          "name": "constant.language.false.brief",
          "match": "\\b(false|FALSE)\\b"
        },
        {
          "name": "constant.language.null.brief",
          "match": "\\b(null|NULL)\\b"
        },
        {
          "name": "constant.language.result.brief",
          "match": "\\b(Ok|Err|OK|ERR|Some|None|SOME|NONE)\\b"
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.intrinsic.brief",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*#"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.brief",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.brief",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.read.brief",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#line-comments"
        },
        {
          "include": "#block-comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.brief",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.brief",
          "match": ","
        },
        {
          "name": "punctuation.bracket.curly.brief",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.brief",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.brief",
          "match": "[()]"
        }
      ]
    },
    "render-block": {
      "begin": "\\b(render|RENDER)\\b\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.render.brief" },
        "2": { "name": "punctuation.bracket.curly.brief" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.bracket.curly.brief" }
      },
      "patterns": [
        {
          "include": "#html-components"
        },
        {
          "include": "text.html.basic"
        },
        {
          "include": "#brief-bindings"
        }
      ]
    },
    "html-components": {
      "patterns": [
        {
          "match": "(<)([A-Z][a-zA-Z0-9_]*)(\\s+[^>]*)?(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.brief" },
            "2": { "name": "entity.name.tag.brief" },
            "3": { "patterns": [{ "include": "text.html.basic" }] },
            "4": { "name": "punctuation.definition.tag.brief" }
          }
        },
        {
          "match": "(</)([A-Z][a-zA-Z0-9_]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.brief" },
            "2": { "name": "entity.name.tag.brief" },
            "3": { "name": "punctuation.definition.tag.brief" }
          }
        },
        {
          "begin": "(<)([a-z][a-z0-9]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.brief" },
            "2": { "name": "entity.name.tag.brief" }
          },
          "end": "(</)(\\2)(>)|(/>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.brief" },
            "2": { "name": "entity.name.tag.brief" },
            "3": { "name": "punctuation.definition.tag.brief" },
            "4": { "name": "punctuation.definition.tag.brief" }
          },
          "patterns": [
            { "include": "#brief-bindings" },
            { "include": "text.html.basic" },
            { "include": "#html-components" }
          ]
        }
      ]
    },
    "brief-bindings": {
      "patterns": [
        {
          "match": "\\b(b-[a-z0-9\\-]+)(:([a-z0-9\\-]+))?(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.brief" },
            "3": { "name": "variable.parameter.brief" },
            "4": { "name": "punctuation.separator.key-value.brief" },
            "5": { "name": "string.quoted.double.brief" }
          }
        }
      ]
    },
    "stage-blocks": {
      "patterns": [
        {
          "name": "entity.name.function.stage-block.brief",
          "match": "\\$\\((PreLex|Parsed|Resolved|Typed|Normalized|Verified|Allocated|Provenanced|Generated|Optimized|Linked)\\)"
        },
        {
          "name": "entity.name.function.stage-block.deprecated.brief",
          "match": "\\$\\((Front|Mid|Post|Back)\\)"
        }
      ]
    },
    "navigation-intrinsics": {
      "patterns": [
        {
          "name": "support.function.navigation.brief",
          "match": "\\b(All|Tag|Named|WithKey|WithAttr|And|Or|Not|First|Last|Nth|Children|Descendants|Parent|Ancestors|Closest|Next|Prev|Before|After|Replace|Inside|AppendTo|Insert|Delete|ReplaceWith|Set|Wrap|Rename|Count|IsEmpty|Names|Find|Prepend|Append|Lines|Run|ForEach|Bound|Text|Path|Size|ReadBytes|List|Remove|StrSplit|StrReplace|StrJoin|EnvGet|SysQuery|TimeNow|HttpFetch|ShellCmd|FileRead|FileWrite|ConfigGet|TypeInfo|CastPath|InjectTypeLayout|DocRead|EmitInfo|EmitWarning|EmitError|Quote)\\$"
        }
      ]
    },
    "ast-constructors": {
      "patterns": [
        {
          "name": "support.function.constructor.brief",
          "match": "\\b(Import|Defn|Txn|Contract|Block|Let|Assign|Term|Guarded|Call|Ident|Expr|BinOp|Field|BlockExpr|Bits|Ptr|Tuple|Metadata|Pattern)\\$"
        }
      ]
    },
    "diagnostics": {
      "patterns": [
        {
          "name": "keyword.other.diagnostic.brief",
          "match": "\\b(EmitInfo|EmitWarning|EmitError)\\$"
        }
      ]
    },
    "targets": {
      "patterns": [
        {
          "name": "variable.language.target.brief",
          "match": "\\b(Source|Ir|Bin|Stage)\\$"
        }
      ]
    },
    "macro-words": {
      "patterns": [
        {
          "name": "entity.name.function.macro.brief",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!"
        }
      ]
    },
    "compiletime-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.compiletime.brief",
          "match": "\\$(let|const|defn|txn)\\b"
        }
      ]
    },
    "metadata-properties": {
      "patterns": [
        {
          "name": "keyword.other.property.brief",
          "match": "\\b(maxbits|observable|alignment|primitive|ctd|alu|llvm_type|layout)\\b"
        }
      ]
    }
  },
  "scopeName": "source.brief"
}
