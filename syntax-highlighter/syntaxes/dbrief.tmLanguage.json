{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Data Briv",
  "fileTypes": ["dbv", "dbvl"],
  "firstLineMatch": "^//",
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#line-comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.briv",
          "begin": "#\\[",
          "end": "\\]#"
        }
      ]
    },
    "line-comments": {
      "patterns": [
        {
          "name": "comment.line.briv",
          "match": "//.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.briv",
          "match": "^// === PATH ANALYSIS ==="
        },
        {
          "name": "meta.annotation.briv",
          "match": "^// === END PATH ANALYSIS ==="
        },
        {
          "name": "comment.annotation.briv",
          "match": "^// \\[(ENTRY_POINT|RECURSIVE)\\]"
        },
        {
          "name": "comment.annotation.briv",
          "match": "^// (PATHS_TO|CALLERS|RESOLVES_TO):"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.txn.briv",
          "match": "\\b(txn|TXN)\\b"
        },
        {
          "name": "keyword.control.reactive.briv",
          "match": "\\b(rct|RCT)\\b"
        },
        {
          "name": "keyword.control.async.briv",
          "match": "\\b(async|ASYNC)\\b"
        },
        {
          "name": "keyword.control.modifier.briv",
          "match": "\\b(seq|vol|sync)\\b"
        },
        {
          "name": "keyword.control.flow.briv",
          "match": "\\b(term|escape|TERM|ESCAPE)\\b"
        },
        {
          "name": "keyword.declaration.briv",
          "match": "\\b(sig|defn|let|const|trg|SIG|DEFN|LET|CONST|TRG)\\b"
        },
        {
          "name": "keyword.declaration.ffi.briv",
          "match": "\\b(frgn!?|syscall!?)\\b"
        },
        {
          "name": "keyword.control.match.briv",
          "match": "\\b(match|uni)\\b"
        },
        {
          "name": "keyword.control.visibility.briv",
          "match": "\\b(pvt|sed)\\b"
        },
        {
          "name": "keyword.import.briv",
          "match": "\\b(import|from|IMPORT|FROM)\\b"
        },
        {
          "name": "keyword.control.dbriv.briv",
          "match": "\\b(REGISTER|ALIAS|RULE|CHECK)\\b"
        },
        {
          "name": "keyword.control.temporal.briv",
          "match": "\\b(within|retry)\\b"
        },
        {
          "name": "keyword.other.time-unit.briv",
          "match": "\\b(cycles|cyc|seconds|s|milliseconds|ms|minutes|min|nanoseconds|ns)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.briv",
          "match": "\\b(Int|Float|String|Bool|Data|Void|UInt)\\b"
        },
        {
          "name": "entity.name.type.custom.briv",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "meta.contract.briv",
          "begin": "\\[\\[?",
          "end": "\\]\\]?",
          "patterns": [
            {
              "include": "#line-comments"
            },
            {
              "include": "#block-comments"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.briv",
          "match": "&"
        },
        {
          "name": "variable.language.prior-state.briv",
          "match": "@"
        },
        {
          "name": "storage.modifier.ownership.briv",
          "match": "\\?"
        },
        {
          "name": "storage.modifier.ownership.briv",
          "match": "!"
        },
        {
          "name": "keyword.operator.comparison.briv",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.relational.briv",
          "match": "<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.briv",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.briv",
          "match": "\\+|\\-|\\*|/"
        },
        {
          "name": "keyword.operator.consumptive.briv",
          "match": "~<-|~=|~\\+|~\\-|~\\*|~/"
        },
        {
          "name": "keyword.operator.bitwise.briv",
          "match": "~|&(?!&)|\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.arrow.briv",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.briv",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.briv",
          "match": "'(\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.double.briv",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.briv",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.briv",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.briv",
          "match": "\\b0x[0-9a-fA-F]+\\b|\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.true.briv",
          "match": "\\b(true|TRUE)\\b"
        },
        {
          "name": "constant.language.false.briv",
          "match": "\\b(false|FALSE)\\b"
        },
        {
          "name": "constant.language.null.briv",
          "match": "\\b(null|NULL)\\b"
        },
        {
          "name": "constant.language.result.briv",
          "match": "\\b(Ok|Err|OK|ERR|Some|None|SOME|NONE)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.briv",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.briv",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.read.briv",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#line-comments"
        },
        {
          "include": "#block-comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.briv",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.briv",
          "match": ","
        },
        {
          "name": "punctuation.bracket.curly.briv",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.briv",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.briv",
          "match": "[()]"
        }
      ]
    }
  },
  "scopeName": "source.dbriv"
}
