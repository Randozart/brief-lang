{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rendered Briv",
  "fileTypes": ["rbv"],
  "patterns": [
    {
      "include": "#view-tag"
    },
    {
      "include": "#style-tag"
    },
    {
      "include": "#script-tag"
    },
    {
      "include": "source.briv"
    }
  ],
  "repository": {
    "script-tag": {
      "begin": "(<script>|<script type=\"briv\">)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "end": "</script>",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "patterns": [
        {
          "include": "source.briv"
        }
      ]
    },
    "view-tag": {
      "begin": "(<view>)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "end": "(</view>)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "patterns": [
        {
          "include": "#html-components"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "style-tag": {
      "begin": "(<style>)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "end": "(</style>)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.briv" }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "html-components": {
      "patterns": [
        {
          "match": "(<)([A-Z][a-zA-Z0-9_]*)(\\s+[^>]*)?(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "patterns": [{ "include": "text.html.basic" }] },
            "4": { "name": "punctuation.definition.tag.briv" }
          }
        },
        {
          "match": "(</)([A-Z][a-zA-Z0-9_]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "name": "punctuation.definition.tag.briv" }
          }
        },
        {
          "begin": "(<)([a-z][a-z0-9]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" }
          },
          "end": "(</)(\\2)(>)|(/>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.briv" },
            "2": { "name": "entity.name.tag.briv" },
            "3": { "name": "punctuation.definition.tag.briv" },
            "4": { "name": "punctuation.definition.tag.briv" }
          },
          "patterns": [
            { "include": "#briv-bindings" },
            { "include": "text.html.basic" },
            { "include": "#html-components" }
          ]
        }
      ]
    },
    "briv-bindings": {
      "patterns": [
        {
          "match": "\\b(b-[a-z0-9\\-]+)(:([a-z0-9\\-]+))?(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.briv" },
            "3": { "name": "variable.parameter.briv" },
            "4": { "name": "punctuation.separator.key-value.briv" },
            "5": { "name": "string.quoted.double.briv" }
          }
        }
      ]
    }
  },
  "scopeName": "source.rbv"
}
