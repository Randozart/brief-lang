{
  "name": "Briv Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.lineHighlightBackground": "#F0F0F0",
    "editor.selectionBackground": "#ADD6FF",
    "editorCursor.foreground": "#000000",
    "editorLineNumber.foreground": "#237893"
  },
  "tokenColors": [
    {
      "scope": "keyword.control.txn.briv",
      "settings": { "foreground": "#0000FF", "fontStyle": "bold" }
    },
    {
      "scope": "keyword.control.reactive.briv",
      "settings": { "foreground": "#795E26", "fontStyle": "bold" }
    },
    {
      "scope": "keyword.control.async.briv",
      "settings": { "foreground": "#0000FF", "fontStyle": "italic" }
    },
    {
      "scope": "keyword.control.flow.briv",
      "settings": { "foreground": "#AF00DB", "fontStyle": "bold" }
    },
    {
      "scope": "keyword.declaration.briv",
      "settings": { "foreground": "#0000FF" }
    },
    {
      "scope": "keyword.import.briv",
      "settings": { "foreground": "#0000FF" }
    },
    {
      "scope": "support.type.primitive.briv",
      "settings": { "foreground": "#267F99" }
    },
    {
      "scope": "entity.name.type.custom.briv",
      "settings": { "foreground": "#267F99" }
    },
    {
      "scope": "string.quoted.double.briv",
      "settings": { "foreground": "#A31515" }
    },
    {
      "scope": "constant.numeric.integer.briv",
      "settings": { "foreground": "#098658" }
    },
    {
      "scope": "constant.numeric.float.briv",
      "settings": { "foreground": "#098658" }
    },
    {
      "scope": "constant.language.true.briv",
      "settings": { "foreground": "#0000FF", "fontStyle": "bold" }
    },
    {
      "scope": "constant.language.false.briv",
      "settings": { "foreground": "#0000FF", "fontStyle": "bold" }
    },
    {
      "scope": "comment.line.briv",
      "settings": { "foreground": "#008000", "fontStyle": "italic" }
    },
    {
      "scope": "comment.annotation.briv",
      "settings": { "foreground": "#008000", "fontStyle": "bold" }
    },
    {
      "scope": "meta.annotation.briv",
      "settings": { "foreground": "#795E26", "fontStyle": "bold underline" }
    },
    {
      "scope": "storage.modifier.ownership.briv",
      "settings": { "foreground": "#0000FF", "fontStyle": "bold" }
    },
    {
      "scope": "keyword.operator.comparison.briv",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "keyword.operator.logical.briv",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "keyword.operator.term-until.briv",
      "settings": { "foreground": "#795E26", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.function.briv",
      "settings": { "foreground": "#795E26" }
    },
    {
      "scope": "punctuation.terminator.briv",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "punctuation.separator.comma.briv",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "meta.attribute.briv-binding",
      "settings": { "foreground": "#D04CA0" }
    },
    {
      "scope": "tag.embedded.script.briv",
      "settings": { "foreground": "#0000FF" }
    },
    {
      "scope": "tag.embedded.view.briv",
      "settings": { "foreground": "#0000FF" }
    },
    {
      "scope": "tag.embedded.style.briv",
      "settings": { "foreground": "#0000FF" }
    },
    {
      "scope": "text.plain",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "keyword.other.property.briv",
      "settings": { "foreground": "#795E26" }
    },
    {
      "scope": "entity.name.function.stage-block.briv",
      "settings": { "foreground": "#A31515" }
    },
    {
      "scope": "keyword.operator.property.briv",
      "settings": { "foreground": "#795E26" }
    },
    {
      "scope": "keyword.operator.push.briv",
      "settings": { "foreground": "#A31515" }
    },
    {
      "scope": "keyword.operator.bitwise.briv",
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": "keyword.operator.arrow.briv",
      "settings": { "foreground": "#A31515" }
    },
    {
      "scope": "keyword.operator.projection.briv",
      "settings": { "foreground": "#267F99" }
    },
    {
      "scope": "variable.other.constant.briv",
      "settings": { "foreground": "#A31515" }
    },
    {
      "scope": "constant.language.result.briv",
      "settings": { "foreground": "#D04CA0" }
    }
  ]
}
