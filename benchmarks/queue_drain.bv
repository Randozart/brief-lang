// queue_drain — Collection drain benchmark (push/pop cycle)
//
// Tests: compiler proves convergence via counter (`count < N`), while the
// body exercises the collection drain analysis (`<- &queue` in the body
// triggers `detect_collection_drain`). The list starts with a single
// element [0] allocated as 3 i64 slots (header×2 + elem×1 = 24 bytes).
// Each tick: pop from slot 2, push to slot 2 — the push always writes
// within the alloca. No UB, no buffer overflow.
//
// The counter is runtime-determined (__get_env_int) so the compiler
// cannot precompute the 50M-iteration loop. The collection ops are a
// side exercise that tests the LLVM backend's ArrowMut/ArrowDiscard path.
//
// Build:
//   ./target/release/brief-compiler llvm benchmarks/queue_drain.bv \
//       --out benchmarks --optimize-budget 256
//
// C reference: queue_drain_c.c

#!exit count == N;

let N: Int = getenv_int#("BOUND");
let count: Int = 0;
let queue: List<Int> = [0];

rct txn work [count < N][count == N] {
    <- &queue;
    &queue <- count;
    &count = count + 1;

    [count % 5000000 == 0] {
        print_int#(count);
    };

    term;
};