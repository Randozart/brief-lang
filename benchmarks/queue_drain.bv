// queue_drain — Collection drain benchmark (push/pop cycle)
//
// Tests: compiler proves convergence via counter (`count < N`), while the
// body exercises the collection drain analysis. The ring buffer starts with
// a single element [0] allocated as a RingBuf heap struct (4 × i64 slots).
// Each tick: pop from head slot, push to tail slot — O(1) via head/tail
// pointer arithmetic with bitwise wrap (mask = capacity - 1).
//
// The counter is runtime-determined (__get_env_int) so the compiler
// cannot precompute the 50M-iteration loop. The collection ops are a
// side exercise that tests the LLVM backend's RingPush#/RingPop# path.
//
// Build:
//   ./target/release/brief-compiler build --llvm benchmarks/queue_drain.bv \
//       --out benchmarks --optimize-budget 256
//
// C reference: queue_drain_c.c


let N: Int = GetEnvInt!(")BOUND");
let count: Int = 0;
import "std/core/ring_buffer.bv";
let queue: RingBuffer<Int> = [0];

rct txn work [count < N][count == N] {
    <- &queue;
    &queue <- count;
count = count + 1;

    [count % 5000000 == 0] {
        Print!(count);
    };

    term;
};