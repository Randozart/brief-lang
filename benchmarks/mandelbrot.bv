// Mandelbrot — Integer iteration benchmark
// Exercises: dense Int arithmetic (mul, add, mod, shift), LCG, 6-field complex
// simulation with integer "escape" tracking.


let count: Int = 0;
let N: Int = get_env_int!("BOUND");
let seed: Int = 42;
let zr: Int = 100;
let zi: Int = 0;
let cr: Int = -75;
let ci: Int = 10;
let t1: Int = 0;
let t2: Int = 0;
let t3: Int = 0;
let escapes: Int = 0;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;
const SCALE: Int = 100;
const THRESH: Int = 40000;

// ── Transaction ──────────────────────────────────────────────────────
node mb [count < N][count == N] {
    let ns1: Int = (seed * IA + IC) % IM;
    let ncr: Int = ns1 % 200 - 100;
    let ns2: Int = (ns1 * IA + IC) % IM;
    let nci: Int = ns2 % 200 - 100;
    let nt1: Int = zr * ncr / SCALE;
    let nt2: Int = zi * nci / SCALE;
    let nt3: Int = zr * nci / SCALE;
    let nzr: Int = nt1 - nt2;
    let nzi: Int = nt3 + zi * ncr / SCALE;
    let nesc: Int = escapes + nzr * nzr / SCALE + nzi * nzi / SCALE;
    seed = ns2;  cr = ncr;  ci = nci;  t1 = nt1;  t2 = nt2;  t3 = nt3;  zr = nzr;  zi = nzi;  escapes = nesc;
    when count % 5000000 == 0 { println!(nesc); };
    count = count + 1;
    when count == N { exit program println!(nesc); };
    term;
};