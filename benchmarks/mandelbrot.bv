// Mandelbrot — Integer iteration benchmark
// Exercises: dense Int arithmetic (mul, add, mod, shift), LCG, 6-field complex
// simulation with integer "escape" tracking. Float_math + nbody already cover Float.
// This benchmark stresses the Int pipeline with intermediate-complexity operations.

#!exit count == N && escapes >= 0 && zr >= 0 && zi >= 0 && cr >= -200 && ci >= -200;

import "link/brief_rt.o";
import { io_pending } from "std/brief_rt.bv";

frgn __get_env_int(name: String) -> Int from "libruntime";

let count: Int = 0;
let N: Int = __get_env_int("BOUND");
let seed: Int = 42;
let zr: Int = 100;
let zi: Int = 0;
let cr: Int = -75;
let ci: Int = 10;
let t1: Int = 0;
let t2: Int = 0;
let t3: Int = 0;
let escapes: Int = 0;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;
const SCALE: Int = 100;
const THRESH: Int = 40000;

// ── Transaction ──────────────────────────────────────────────────────
rct txn mb [io_pending && count < N][count == N] {
    // LCG for next c
    &seed = seed * IA;
    &seed = seed + IC;
    &seed = seed % IM;
    &cr = seed % 200 - 100;

    &seed = seed * IA;
    &seed = seed + IC;
    &seed = seed % IM;
    &ci = seed % 200 - 100;

    // Complex multiply: z = z * c (fixed-point, scale 100)
    &t1 = zr * cr / SCALE;
    &t2 = zi * ci / SCALE;
    &t3 = zr * ci / SCALE;
    &zr = t1 - t2;
    &zi = t3 + zi * cr / SCALE;

    // Track norm
    &escapes = escapes + zr * zr / SCALE + zi * zi / SCALE;

    &count = count + 1;
    term;
};
