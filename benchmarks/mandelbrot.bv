// Mandelbrot — Integer iteration benchmark
// Exercises: dense Int arithmetic (mul, add, mod, shift), LCG, 6-field complex
// simulation with integer "escape" tracking.

#!exit count == N && escapes >= 0;

import "link/brief_rt.c";

frgn #out __print_int(n: Int) -> Bool ;
frgn __get_env_int(name: String) -> Int ;

let count: Int = 0;
let N: Int = __get_env_int("BOUND");
let seed: Int = 42;
let zr: Int = 100;
let zi: Int = 0;
let cr: Int = -75;
let ci: Int = 10;
let t1: Int = 0;
let t2: Int = 0;
let t3: Int = 0;
let escapes: Int = 0;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;
const SCALE: Int = 100;
const THRESH: Int = 40000;

// ── Transaction ──────────────────────────────────────────────────────
rct txn mb [count < N][count == N] {
    &seed = seed * IA;
    &seed = seed + IC;
    &seed = seed % IM;
    &cr = seed % 200 - 100;

    &seed = seed * IA;
    &seed = seed + IC;
    &seed = seed % IM;
    &ci = seed % 200 - 100;

    &t1 = zr * cr / SCALE;
    &t2 = zi * ci / SCALE;
    &t3 = zr * ci / SCALE;
    &zr = t1 - t2;
    &zi = t3 + zi * cr / SCALE;

    &escapes = escapes + zr * zr / SCALE + zi * zi / SCALE;

    [count % 5000000 == 0] {
        __print_int(escapes);
    };

    &count = count + 1;

    [count == N] {
        __print_int(escapes);
    };
    term;
};