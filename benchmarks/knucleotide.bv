// knucleotide — k-mer rolling hash pipeline + FFI output
// Exercises: 2-bit hash packing, integer shift/or/and, convergent loop.

#!exit count == N && hash >= 0;

import "link/brief_rt.c";

frgn #out __print_int(n: Int) -> Bool ;
frgn __get_env_int(name: String) -> Int ;

let count: Int = 0;
let N: Int = __get_env_int("BOUND");
let seed: Int = 42;
let hash: Int = 0;
let chksum: Int = 0;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;
const MASK: Int = 63;

// ── Transaction ──────────────────────────────────────────────────────
rct txn kn [count < N][count == N] {
    let nseed: Int = (seed * IA + IC) % IM;
    let nhash: Int = ((hash << 2) | (nseed & 3)) & MASK;
    let nchksum: Int = chksum + nhash % 13;
    &seed = nseed;  &hash = nhash;  &chksum = nchksum;
    [count % 5000000 == 0] { __print_int(nchksum); };
    &count = count + 1;
    [count == N] { term! -> __print_int(nchksum); };
    term;
};