// Biquad IIR Filter Cascade - DSP benchmark for the LLVM backend
//
// Tests:
//   - Float arithmetic pipeline (fmul, fadd, fsub)
//   - Register promotion via noalias nocapture + alwaysinline
//   - SMT-driven bounds-check elision via @llvm.assume
//   - Precondition dispatch: [count < total] guarded reactive transaction
//   - Convergence contract: [count < total][count == total]
//     The proof engine verifies bounded convergence; the LLVM backend
//     emits only the canonical while loop with inline bound.
//
// Equivalent C reference: iir_filter_c.c
//
// Build:
//   cargo run --bin briv-compiler -- build --llvm benchmarks/iir_filter.bv -o benchmarks/iir_filter.ll
//   clang -O3 -march=native -o benchmarks/iir_filter benchmarks/iir_filter.ll
//
// Benchmarks:
//   perf stat ./benchmarks/iir_filter
//   perf stat ./benchmarks/iir_filter_c

// Coefficients - compile-time constants, emitted as @name = constant float
const b0: Float = 0.003916126444;
const b1: Float = 0.007832252889;
const b2: Float = 0.003916126444;
const a1: Float = -1.815341082700;
const a2: Float = 0.831005589300;

// Impulse input - constant for impulse response
const input: Float = 1.0;

// Loop bound - constant, inlined into the while comparison
const total: Int = 50000000;

// Delay-line state (feedback path) - mutates every tick
let x1: Float = 0.0;
let x2: Float = 0.0;
let y1: Float = 0.0;
let y2: Float = 0.0;

// Loop counter - mutates every tick
let count: Int = 0;

// Convergence contract: the reactor fires while count < total and must
// eventually converge to count == total.  The proof engine verifies
// bounded convergence; the LLVM backend emits:
//   while (count < 50000000) { process_body(); }
// with zero runtime contract evaluation.
node process [count < total][count == total] {
    // Feedforward path: b0*input + b1*x1 + b2*x2
    let f0: Float = b0 * input;
    let f1: Float = b1 * x1;
    let f2: Float = b2 * x2;
    let ff: Float = f0 + f1 + f2;

    // Feedback path: a1*y1 + a2*y2
    let fb1: Float = a1 * y1;
    let fb2: Float = a2 * y2;
    let fb: Float = fb1 + fb2;

    // Output = feedforward - feedback
    let out: Float = ff - fb;

    // Shift delay line
x2 = x1;
    x1 = input;
    y2 = y1;
    y1 = out;

    // Bump loop counter
count = count + 1;
    term;
};
