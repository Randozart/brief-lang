// queue_drain_sym — Symmetric C-mirror for queue_drain benchmarks.
// Counter-only loop; no collection ops. Mirrors the C reference
// step-for-step to measure raw throughput without collection overhead.
//
// Build:
//   ./target/release/briev-compiler build --llvm benchmarks/queue_drain_sym.bv \
//       --out benchmarks --optimize-budget 256
//
// C reference: queue_drain_sym_c.c


let N: Int = get_env_int!("BOUND");
let count: Int = 0;

node work [count < N][count == N] {
    count = count + 1;

    when count % 5000000 == 0 {
        println!(count);
    };

    term;
};
