// UTF-8 Operations — Tests pure-Brief memcmp + utf8_validate
//
// Allocates runtime buffers with Alloc#, stores the loop counter
// (runtime varying) via Store#, then compares/validates via
// pure-Brief byte-string functions. The loop counter changes each
// iteration, preventing compile-time folding.
//
// C reference: utf8_ops_c.c
//
// Note: Use environment variables BOUND and SEED to control iteration
// count and data variation. Default BOUND is 50000000 but this
// benchmark is slower (pure-Brief txn convergence loops),
// so expect ~100 iterations/second at default budget.

import "std/types/utf8view.bv";

const TOTAL: Int = GetEnvInt!("BOUND");
const SEED: Int = GetEnvInt!("SEED");

let ops: Int = 0;
let checksum: Int = 0;

node work [ops < TOTAL][ops == TOTAL] {
    let a: Int = Alloc#(8) as Int;
    let b: Int = Alloc#(8) as Int;
    // Store runtime-varying data — cannot fold
    Store#(a, ops + SEED);
    Store#(b, ops + SEED + 1);
    
    let cmp: Int = memcmp(a, b, 8);
    let valid: Int = utf8_validate(a, 8);
    checksum = checksum + cmp + valid;
    ops = ops + 1;
    [ops % 5000000 == 0] {
        PrintLn!(checksum);
    };
    term;
};
