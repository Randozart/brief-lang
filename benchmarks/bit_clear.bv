// bit_clear — Popcount decay benchmark
//
// Tests: compiler proves convergence for `clear_reg = clear_reg & (clear_reg - 1)` via
// `detect_popcount_decay`. Each iteration clears exactly one bit,
// so the ranking function `popcount(clear_reg) → 0` converges in at most
// 63 iterations (for a 63-bit positive integer).
//
// Inherently bounded by integer width (63 iterations max for i64::MAX).
// Timing is noise-floor dominated with fork+exec harness, but correctness
// is meaningful.
//
// Build:
//   ./target/release/briev-compiler build --llvm benchmarks/bit_clear.bv \
//       --out benchmarks --optimize-budget 256
//
// C reference: bit_clear_c.c


const initial_reg: Int = 0x7FFFFFFFFFFFFFFF;
let clear_reg: Int = initial_reg;

node clear_bit [clear_reg != 0][clear_reg == 0] {
    let next_reg = clear_reg & (clear_reg - 1);

    when next_reg % 100000 == 0 {
        println!(next_reg);
    };

    clear_reg = next_reg;
    term;
};
