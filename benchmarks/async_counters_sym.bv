// Async Parallel Counters — Symmetric Runtime Benchmark
//
// History:
//   2026-07-01: Split from async_counters into sym (runtime) + idio (optimizer).
//     The original async_counters benchmark had print_int guards for observability
//     but its C reference was changed in ad67b83 to a trivial fold-only version
//     (long g_a = 25000000L; (void)g_a;). This made the comparison meaningless:
//     Brief ran the full thread pool with 50M barrier round-trips (~500s) while
//     C returned in microseconds. The sym version keeps the observable body and
//     gets a proper 2-thread barrier C reference for fair runtime comparison.
//     The idio version removes print_int from bodies to test the pure fold path.
//
// Tests:
//   - Auto-categorization: two txns with disjoint writes -> async candidates
//   - Thread pool: workers execute body functions concurrently
//   - Dual-barrier synchronization: release -> reactor -> wait per tick
//   - Runtime throughput vs pthread_barrier C reference
//
// inc_a and inc_b write different state fields (a, b). The proof engine
// guarantees no data races -- plain loads/stores, no atomics needed.
//
// Build:
//   cargo run --bin brief-compiler -- llvm benchmarks/async_counters_sym.bv \
//     --out benchmarks --optimize-budget 256
//
// C reference: async_counters_sym_c.c (two pthreads + barriers)

#!exit a == N && b == N;

let a: Int = 0;
let b: Int = 0;
let N: Int = getenv_int#("BOUND");

rct async txn inc_a [a < N][a == N] {
    &a = a + 1;
    [a % 5000000 == 0] {
        print_int#(a);
    };
    term;
};
rct async txn inc_b [b < N][b == N] {
    &b = b + 1;
    [b % 5000000 == 0] {
        print_int#(b);
    };
    term;
};
