// global_lifetime — the garbage scheduler (docs/plans/2026-08-01-global-lifetime-design.md).
// A heap Ptr buffer is allocated and written each iteration; the scheduler
// PROVES the `life` node is the buffer's last consumer and emits a Free# (via
// __briev_free) exactly after the loop completes — there is NO manual free in
// this file. The `__briev_free_count` runtime counter lets a test assert
// frees == allocs (no premature free, no leak).
//
// C reference: global_lifetime_c.c

let N: Int = get_env_int!("BOUND");
let buf: Ptr<Int> = Malloc#(64 * 8) as Ptr<Int>;
let sum: Int = 0;

node life [sum < N][sum == N] {
    buf[sum % 64] = sum;
    sum = sum + 1;
    when sum % 5000000 == 0 {
        println!(buf[sum % 64]);
    };
    term;
};
