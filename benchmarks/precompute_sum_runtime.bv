// Precompute Sum — Runtime-variable bound via __get_env_int
// Bound is a state field, compiler cannot precompute.
//
// Build:
//   ./target/release/briev-compiler build --llvm benchmarks/precompute_sum_runtime.bv \
//       --out benchmarks --optimize-budget 256


import { get_env_int } from "std/env.bv";
// briev_rt.c linked automatically

let bound: Int = get_env_int("BOUND");
let count: Int = 0;
let acc_a: Int = 0;
let acc_b: Int = 0;

node step_a [bound > 0 && count < bound && acc_a >= 0][count == bound] {
    acc_a = acc_a + count;
    count = count + 1;
    when count == bound {
        endprogram println!(acc_a + acc_b);
    };
    term;
};

node step_b [bound > 0 && count < bound && acc_b >= 0][count == bound] {
    acc_b = acc_b + count;
    count = count + 1;
    when count == bound {
        endprogram println!(acc_a + acc_b);
    };
    term;
};
