// Async Parallel Counters — Tests thread pool dispatch (Path 5)
//
// Tests:
//   - Auto-categorization: two txns with disjoint writes → async candidates
//   - Thread pool: workers execute body functions concurrently
//   - Dual-barrier synchronization: release → reactor → wait per tick
//   - FFI output prevents dead-code elimination
//
// inc_a and inc_b write different state fields (a, b). The proof engine
// guarantees no data races — plain loads/stores, no atomics needed.
//
// import "link/brief_rt.c" in brief_rt.bv pulls in the runtime automatically.
//
// Build:
//   cargo run --bin brief-compiler -- build --llvm benchmarks/async_counters.bv --out benchmarks --optimize-budget 256
//
// C reference: async_counters_c.c (two pthreads)


let a: Int = 0;
let b: Int = 0;
let N: Int = get_env_int!("BOUND");

async node inc_a [a < N][a == N] {
    a = a + 1;
    when a % 5000000 == 0 {
        println!(a);
    };
    term;
};
async node inc_b [b < N][b == N] {
    b = b + 1;
    when b % 5000000 == 0 {
        println!(b);
    };
    term;
};
