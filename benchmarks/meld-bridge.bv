// meld-bridge — C ABI ↔ Rust ABI zero-cost bridge
//
// Two struct types with identical bit layouts, melded for zero-cost
// compatibility across language ABI boundaries.
//
// This benchmark validates the meld feature at the parser/typechecker/
// TypeUniverse level. The full LLVM pipeline requires a backend fix.
//
// KNOWN ISSUE: LLVM backend has a statement reordering bug (emit_ssa_main
// in loop_engine.rs). Let statements after a meld cast may be emitted
// before the cast, producing undefined SSA registers.
//
// Tag: --runtime


import "link/brief_rt.c";

frgn consume_buffer(data: Int, size: Int) -> Int ;

struct CBuffer { ptr: Int, len: Int };
struct RSBuffer { data: Int, size: Int };
meld CBuffer <:> RSBuffer;

let accum: Int = 0;
let raw_ptr: Int = 42;
let raw_len: Int = 16;

rct txn run [accum < 1000][accum == 1000] {
    let buf: CBuffer = CBuffer { ptr: raw_ptr, len: raw_len };
    let rs: RSBuffer = buf as RSBuffer;
    let ok: Int = consume_buffer(rs.data, rs.size);
    &accum = accum + ok;
    term;
};
