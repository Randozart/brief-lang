// meld-bridge — C ABI ↔ Rust ABI zero-cost bridge
//
// Two obj types with identical bit layouts, adapted across language ABI
// boundaries with an explicit `as` cast (SPEC 19.6: the meld declaration is
// removed; shapes adapt through explicit protocol cast edges).
//
// This benchmark validates the explicit-cast adaptation at the
// parser/typechecker/TypeUniverse level. The full LLVM pipeline requires a
// backend fix.
//
// KNOWN ISSUE: LLVM backend has a statement reordering bug (emit_ssa_main
// in loop_engine.rs). Let statements after an `as` cast may be emitted
// before the cast, producing undefined SSA registers.
//
// Tag: --runtime (disabled in the harness — no compiled .bv gate)


// briev_rt.c linked automatically

frgn consume_buffer(data: Int, size: Int) -> Int ;

obj CBuffer { ptr: Int, len: Int };
obj RSBuffer { data: Int, size: Int };
// 2026-08-09 (Phase 12): the meld declaration is removed (SPEC 19.6) —
// CBuffer <:> RSBuffer adapts through explicit protocol cast edges.

let accum: Int = 0;
let raw_ptr: Int = 42;
let raw_len: Int = 16;

node run [accum < 1000][accum == 1000] {
    let buf: CBuffer = CBuffer { ptr: raw_ptr, len: raw_len };
    let rs: RSBuffer = buf as RSBuffer;
    let ok: Int = consume_buffer(rs.data, rs.size);
    accum = accum + ok;
    term;
};
