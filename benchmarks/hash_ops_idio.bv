// hash_ops_idio — the idiomatic HashMap<K, V> via std/collections.bv.
// m.insert((i, i*2)) then m.get(i) each iteration — the sum of the
// read-back values is the observable output. Direct hashing (the `_sym`
// flat-table form is hash_ops.bv; the chained-bucket HashMap is a documented
// follow-up).
//
// 2026-08-17 (tuple correctness): the HashMap element is the (K, V) pair —
// `m <- (k, v)` / `m.insert((k, v))`, `m.get(k)` by key.
//
// C reference: hash_ops_idio_c.c

import { HashMap } from "std/collections.bv";

let N: Int = get_env_int!("BOUND");
// Size the table to 2*N so it never fills (`count < cap` always holds) — the
// probes then hit at q == 0 and `break` exits immediately (O(1)). The C
// reference mirrors this structure (a real 2*N open-addressing table), so the
// A/B is the same workload: hashmap insert + read-back per iteration.
let m: HashMap<Int, Int> = 2 * N;
let i: Int = 0;
let sum: Int = 0;

node work [i < N][i == N] {
    m.insert((i, i * 2));
    sum = sum + m.get(i);
    i = i + 1;
    when i % 5000000 == 0 {
        println!(sum);
    };
    term;
};
