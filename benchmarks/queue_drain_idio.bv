// queue_drain_idio — Idiomatic Briv-native version of queue_drain.
// Reactive transaction with collection drain (`<- queue` + `queue <- count`).
// Exercises the collection drain analysis (detect_collection_drain) in the
// compiler, while the symmetric variant (queue_drain_sym) mirrors C.
//
// Build:
//   ./target/release/briv-compiler build --llvm benchmarks/queue_drain_idio.bv \
//       --out benchmarks --optimize-budget 256
//
// No C reference — this is a Briv-native pattern. Correctness is compared
// against the symmetric variant's C reference.


import { List } from "std/collections.bv";

let N: Int = get_env_int!("BOUND");
let count: Int = 0;
let queue: List<Int> = [0];

node work [count < N][count == N] {
    <- queue;
    queue <- count;
count = count + 1;

    when count % 5000000 == 0 {
        println!(count);
    };

    term;
};