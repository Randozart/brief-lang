// fannkuch_redux_sym — Permutation operations (Briev-idiomatic flat fields)
// Symmetric variant: adds periodic checksum print every 5M iterations.
// Prevents LLVM precomputation by adding hot-loop FFI.
//
// Build:
//   ./target/release/briev-compiler build --llvm benchmarks/fannkuch_redux_sym.bv \
//       --out benchmarks --optimize-budget 256


let count: Int = 0;
let N: Int = get_env_int!("BOUND");
let seed: Int = 42;
let max_flips: Int = 0;
let checksum: Int = 0;

let p0: Int = 0;
let p1: Int = 1;
let p2: Int = 2;
let p3: Int = 3;
let p4: Int = 4;
let p5: Int = 5;
let p6: Int = 6;
let p7: Int = 7;
let p8: Int = 8;
let p9: Int = 9;
let p10: Int = 10;
let p11: Int = 11;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;

node fan [count < N][count == N] {
    let ns: Int = (seed * IA + IC) % IM;

    seed = p0;
    p0 = p1;
    p1 = p2;
    p2 = p3;
    p3 = p4;
    p4 = p5;
    p5 = p6;
    p6 = p7;
    p7 = p8;
    p8 = p9;
    p9 = p10;
    p10 = p11;

    let f: Int = p0;
    when f == 0 {
        checksum = checksum - ns;
        endprogram println!(count);
    };
    when f != 0 {
        checksum = checksum + ns;
    };
    count = count + 1;
    term;
};