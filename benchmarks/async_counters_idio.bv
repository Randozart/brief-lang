// Async Counters — Tests parallel dispatch of disjoint-write-set txns
//
// Two reactive transactions inc_a and inc_b write different fields (a and b).
// Neither reads what the other writes — write sets are fully disjoint.
//
// The compiler must:
//   1. Detect disjoint write sets via field-name analysis
//   2. Classify these as async-candidates (no WAW/RAW/WAR conflicts)
//   3. Emit async_body functions + thread pool init
//   4. Dispatch inc_a and inc_b in parallel across worker threads
//
// C reference: async_counters_idio_c.c

import { print_int } from "std/io.bv";

const N: Int = 50000000;

let a: Int = 0;
let b: Int = 0;

rct async txn inc_a [a < N][a == N] {
    a = a + 1;
    [a % 10000000 == 0] {
        PrintLn!(a);
    };
    term;
};

rct async txn inc_b [b < N][b == N] {
    b = b + 1;
    [b % 10000000 == 0] {
        PrintLn!(b);
    };
    term;
};
