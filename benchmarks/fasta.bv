// Fasta — DNA sequence generation benchmark
// Exercises: frgn output in hot loop, convergent loop.


let count: Int = 0;
let N: Int = GetEnvInt!("BOUND");
let seed: Int = 42;
const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;

// ── Transaction ──────────────────────────────────────────────────────
// Note: node atomically batches writes — all seed = ... assignments
// would read pre-tick state. The three steps are combined into one
// expression so the LCG advances correctly each tick.
node fasta [count < N][count == N] {
    seed = (seed * IA + IC) % IM;
    __print_char(seed % 26 + 97);
    count = count + 1;
    term;
};
