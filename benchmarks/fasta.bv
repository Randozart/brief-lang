// Fasta — DNA sequence generation benchmark
// Exercises: frgn output in hot loop, convergent loop.

#!exit count == N;

let count: Int = 0;
let N: Int = getenv_int#("BOUND");
let seed: Int = 42;
const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;

// ── Transaction ──────────────────────────────────────────────────────
// Note: rct txn atomically batches writes — all &seed = ... assignments
// would read pre-tick state. The three steps are combined into one
// expression so the LCG advances correctly each tick.
rct txn fasta [count < N][count == N] {
    &seed = (seed * IA + IC) % IM;
    putchar#(seed % 26 + 97);
    &count = count + 1;
    term;
};
