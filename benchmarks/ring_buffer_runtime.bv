// Ring Buffer — Runtime-variable bound via __get_env_int
// Bound is a state field initialized by an FFI call at startup,
// so the compiler cannot constant-fold or precompute.
// The loop remains a tight while-loop without __rt_wait() calls.
//
// Build:
//   ./target/release/brief-compiler build --llvm benchmarks/ring_buffer_runtime.bv \
//       --out benchmarks --optimize-budget 256


import { get_env_int } from "std/env.bv";
// brief_rt.c linked automatically

let bound: Int = get_env_int("BOUND");
let ops: Int = 0;

rct txn work [bound > 0 && ops < bound][ops == bound] {
    ops = ops + 1;
    [ops % 5000000 == 0] {
        Print!(ops);
    };
    term;
};
