// Print Loop — Runtime-variable bound via __get_env_int
// Iterates up to BOUND, printing progress every 100000 iterations.
// Bound is a state field, so the compiler cannot constant-fold.
//
// Build:
//   ./target/release/brief-compiler llvm benchmarks/print_loop.bv \
//       --out benchmarks --optimize-budget 256


import { get_env_int } from "std/env.bv";
import "link/brief_rt.c";

let bound: Int = get_env_int("BOUND");
let ops: Int = 0;

rct txn work [bound > 0 && ops < bound][ops == bound] {
    ops = ops + 1;
    [ops % 100000 == 0] {
        print_int#(ops);
    };
    term;
};
