// Ring Buffer — Tests enum dispatch with wake hybrid (Path 4)
//
// Tests:
//   - Folded while-loop (ops < N → ops == N convergence)
//   - FFI output prevents dead-code elimination
//
// import "link/brief_rt.c" in brief_rt.bv pulls in the runtime automatically.
//
// Build:
//   cargo run --bin brief-compiler -- llvm benchmarks/ring_buffer.bv --out benchmarks --optimize-budget 256
//
// C reference: ring_buffer_c.c

#!exit ops == N;

let ops: Int = 0;
let N: Int = getenv_int#("BOUND");

rct txn work [ops < N][ops == N] {
    &ops = ops + 1;
    [ops % 5000000 == 0] {
        print_int#(ops);
    };
    term;
};
