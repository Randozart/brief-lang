// popcount — population count via derivation
// The MCMC superoptimizer should discover bit-parallel popcount:
//   x - ((x>>1) & 0x5555555555555555) - ((x>>2) & 0x3333333333333333) ...
// or an efficient intrinsic-based equivalent.

defn popcount(x: Int) -> Int := {
    0 -> 0;
    1 -> 1;
    3 -> 2;
    7 -> 3;
    255 -> 8;
    1024 -> 1;
    4294967295 -> 32;
};
