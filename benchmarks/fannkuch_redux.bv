// Fannkuch-Redux — Permutation operations (Briv-idiomatic flat fields)
// Exercises: 16 flat Int fields, LCG, convergence loop.
// Symmetric with C reference: saves p0 before rotation for checksum.

let count: Int = 0;
let N: Int = get_env_int!("BOUND");
let seed: Int = 42;
let max_flips: Int = 0;
let checksum: Int = 0;

// ── 12-element permutation ──────────────────────────────────────────
let p0: Int = 0;
let p1: Int = 1;
let p2: Int = 2;
let p3: Int = 3;
let p4: Int = 4;
let p5: Int = 5;
let p6: Int = 6;
let p7: Int = 7;
let p8: Int = 8;
let p9: Int = 9;
let p10: Int = 10;
let p11: Int = 11;

const IM: Int = 139968;
const IA: Int = 3877;
const IC: Int = 29573;

// ── Transaction ──────────────────────────────────────────────────────
node fan [count < N][count == N] {
    let ns: Int = (seed * IA + IC) % IM;
    let saved: Int = p0;
    let nchecksum: Int = checksum + saved % 13;
    let nmax: Int = max_flips + nchecksum % 17;
    seed = ns;
    p0 = p1;  p1 = p2;  p2 = p3;  p3 = p4;  p4 = p5;  p5 = p6;
    p6 = p7;  p7 = p8;  p8 = p9;  p9 = p10;  p10 = p11;  p11 = saved;
    checksum = nchecksum;  max_flips = nmax;
    count = count + 1;
    when count == N { exit program println!(checksum); };
    term;
};