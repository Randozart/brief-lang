  (
  "toplevel"
  "Statement(Let { name: "data", names: ["data"], ty: Some(Ptr(Custom("Int"))), expr: Some(Call("Malloc#", [BinaryOp(Mul, Identifier("CAP"), Decimal(8))], None)), modifiers: [] })"
)
  (
  "toplevel"
  "Statement(Let { name: "head", names: ["head"], ty: Some(Custom("Int")), expr: Some(Decimal(0)), modifiers: [] })"
)
  (
  "toplevel"
