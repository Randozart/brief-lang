// Sparse Dispatch — Enum dispatch overhead benchmark.
//
// 8 txns each gated by `count < total && count % 8 == N`, 1 fires per
// iteration. No io_pending trigger — runs as a non-triggered SSA while
// loop (no 100ms __rt_wait blocking). Tests precondition evaluation
// overhead of 8-way dispatch vs C's direct switch(count % 8).
//
// C reference: sparse_dispatch_c.c — equivalent switch (count % 8).
//
// Build:
//   ./target/release/brief-compiler build --llvm benchmarks/sparse_dispatch.bv \
//       --out benchmarks --optimize-budget 256


let count: Int = 0;
let total: Int = GetEnvInt!("BOUND");

node ping  when count < total && count % 8 == 0][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node ack   when count < total && count % 8 == 1][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node err   when count < total && count % 8 == 2][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node debug when count < total && count % 8 == 3][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node data  when count < total && count % 8 == 4][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node ctrl  when count < total && count % 8 == 5][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node sync_ when count < total && count % 8 == 6][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
node stat  when count < total && count % 8 == 7][count == total { count = count + 1; when count % 5000000 == 4999999 { PrintLn!(count + 1); }; term; };
