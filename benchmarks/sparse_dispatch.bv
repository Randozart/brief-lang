// Sparse Dispatch — Enum dispatch overhead benchmark.
//
// 8 txns each gated by `count < total && count % 8 == N`, 1 fires per
// iteration. No io_pending trigger — runs as a non-triggered SSA while
// loop (no 100ms __rt_wait blocking). Tests precondition evaluation
// overhead of 8-way dispatch vs C's direct switch(count % 8).
//
// C reference: sparse_dispatch_c.c — equivalent switch (count % 8).
//
// Build:
//   ./target/release/brief-compiler llvm benchmarks/sparse_dispatch.bv \
//       --out benchmarks --optimize-budget 256

#!exit count == total;

import { __get_env_int } from "std/env.bv";
import "link/brief_rt.o";

let count: Int = 0;
let total: Int = __get_env_int("BOUND");

rct txn ping [count % 8 == 0][count == total] { &count = count + 1; term; };
rct txn ack  [count % 8 == 1][count == total] { &count = count + 1; term; };
rct txn err  [count % 8 == 2][count == total] { &count = count + 1; term; };
rct txn debug[count % 8 == 3][count == total] { &count = count + 1; term; };
rct txn data [count % 8 == 4][count == total] { &count = count + 1; term; };
rct txn ctrl [count % 8 == 5][count == total] { &count = count + 1; term; };
rct txn sync [count % 8 == 6][count == total] { &count = count + 1; term; };
rct txn stat [count % 8 == 7][count == total] { &count = count + 1; term; };
