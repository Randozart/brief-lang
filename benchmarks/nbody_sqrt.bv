// nbody_sqrt — 5-body gravity sim with libm sqrtf (FFI)
// Compares Briv vs C on identical algorithm: libm sqrtf, unrolled pairs.
// The sqrt FFI call inside the hot body prevents pure-counter fold
// via statement_contains_ffi, keeping all field stores live.
//
// Build:
//   ./target/release/briv-compiler build --llvm benchmarks/nbody_sqrt.bv \
//       --out benchmarks --optimize-budget 2048


let bound: Int = get_env_int!("BOUND");
let count: Int = 0;

const pi: Float32 = 3.141592653589793;
const solar_mass: Float32 = 4.0 * pi * pi;
const dpy: Float32 = 365.24;
const dt: Float32 = 0.01;

// Body 0 (Sun)
let bx0: Float32 = 0.0;         let by0: Float32 = 0.0;         let bz0: Float32 = 0.0;
let vx0: Float32 = 0.0;         let vy0: Float32 = 0.0;         let vz0: Float32 = 0.0;
const m0: Float32 = 1.0 * solar_mass;

// Body 1 (Jupiter)
let bx1: Float32 = 4.84143144246472090;
let by1: Float32 = -1.16032004402742839;
let bz1: Float32 = -0.103622044471123109;
let vx1: Float32 = 0.00166007664274403694 * dpy;
let vy1: Float32 = 0.00769901118419740425 * dpy;
let vz1: Float32 = -0.0000690460016972063023 * dpy;
const m1: Float32 = 0.000954791938424326609 * solar_mass;

// Body 2 (Saturn)
let bx2: Float32 = 8.34336671824457987;
let by2: Float32 = 4.12479856412430479;
let bz2: Float32 = -0.403523417114321381;
let vx2: Float32 = -0.00276742510726862411 * dpy;
let vy2: Float32 = 0.00499852801234917238 * dpy;
let vz2: Float32 = 0.0000230417297573763929 * dpy;
const m2: Float32 = 0.000285885980666130812 * solar_mass;

// Body 3 (Uranus)
let bx3: Float32 = 12.8943695621309110;
let by3: Float32 = -15.1111514016986312;
let bz3: Float32 = -0.223307578892655734;
let vx3: Float32 = 0.00296460137564761618 * dpy;
let vy3: Float32 = 0.00237847173959480950 * dpy;
let vz3: Float32 = -0.0000296589568540237556 * dpy;
const m3: Float32 = 0.0000436624404335156298 * solar_mass;

// Body 4 (Neptune)
let bx4: Float32 = 15.3796971148509165;
let by4: Float32 = -25.9193146099879641;
let bz4: Float32 = 0.179258772950371181;
let vx4: Float32 = 0.00268067772490389322 * dpy;
let vy4: Float32 = 0.00162824170038242295 * dpy;
let vz4: Float32 = -0.0000951592254519715870 * dpy;
const m4: Float32 = 0.0000515138902046611451 * solar_mass;

node simulate [
    count < bound
][count == bound] {
    let dx01: Float32 = bx0 - bx1;
    let dy01: Float32 = by0 - by1;
    let dz01: Float32 = bz0 - bz1;
    let dsq01: Float32 = dx01*dx01 + dy01*dy01 + dz01*dz01;
    let dist01: Float32 = Sqrt#(dsq01);
    let mag01: Float32 = dt / (dsq01 * dist01);
    let dx02: Float32 = bx0 - bx2;
    let dy02: Float32 = by0 - by2;
    let dz02: Float32 = bz0 - bz2;
    let dsq02: Float32 = dx02*dx02 + dy02*dy02 + dz02*dz02;
    let dist02: Float32 = Sqrt#(dsq02);
    let mag02: Float32 = dt / (dsq02 * dist02);
    let dx03: Float32 = bx0 - bx3;
    let dy03: Float32 = by0 - by3;
    let dz03: Float32 = bz0 - bz3;
    let dsq03: Float32 = dx03*dx03 + dy03*dy03 + dz03*dz03;
    let dist03: Float32 = Sqrt#(dsq03);
    let mag03: Float32 = dt / (dsq03 * dist03);
    let dx04: Float32 = bx0 - bx4;
    let dy04: Float32 = by0 - by4;
    let dz04: Float32 = bz0 - bz4;
    let dsq04: Float32 = dx04*dx04 + dy04*dy04 + dz04*dz04;
    let dist04: Float32 = Sqrt#(dsq04);
    let mag04: Float32 = dt / (dsq04 * dist04);
    let dx12: Float32 = bx1 - bx2;
    let dy12: Float32 = by1 - by2;
    let dz12: Float32 = bz1 - bz2;
    let dsq12: Float32 = dx12*dx12 + dy12*dy12 + dz12*dz12;
    let dist12: Float32 = Sqrt#(dsq12);
    let mag12: Float32 = dt / (dsq12 * dist12);
    let dx13: Float32 = bx1 - bx3;
    let dy13: Float32 = by1 - by3;
    let dz13: Float32 = bz1 - bz3;
    let dsq13: Float32 = dx13*dx13 + dy13*dy13 + dz13*dz13;
    let dist13: Float32 = Sqrt#(dsq13);
    let mag13: Float32 = dt / (dsq13 * dist13);
    let dx14: Float32 = bx1 - bx4;
    let dy14: Float32 = by1 - by4;
    let dz14: Float32 = bz1 - bz4;
    let dsq14: Float32 = dx14*dx14 + dy14*dy14 + dz14*dz14;
    let dist14: Float32 = Sqrt#(dsq14);
    let mag14: Float32 = dt / (dsq14 * dist14);
    let dx23: Float32 = bx2 - bx3;
    let dy23: Float32 = by2 - by3;
    let dz23: Float32 = bz2 - bz3;
    let dsq23: Float32 = dx23*dx23 + dy23*dy23 + dz23*dz23;
    let dist23: Float32 = Sqrt#(dsq23);
    let mag23: Float32 = dt / (dsq23 * dist23);
    let dx24: Float32 = bx2 - bx4;
    let dy24: Float32 = by2 - by4;
    let dz24: Float32 = bz2 - bz4;
    let dsq24: Float32 = dx24*dx24 + dy24*dy24 + dz24*dz24;
    let dist24: Float32 = Sqrt#(dsq24);
    let mag24: Float32 = dt / (dsq24 * dist24);
    let dx34: Float32 = bx3 - bx4;
    let dy34: Float32 = by3 - by4;
    let dz34: Float32 = bz3 - bz4;
    let dsq34: Float32 = dx34*dx34 + dy34*dy34 + dz34*dz34;
    let dist34: Float32 = Sqrt#(dsq34);
    let mag34: Float32 = dt / (dsq34 * dist34);
    let nvx0: Float32 = vx0 - dx01*m1*mag01 - dx02*m2*mag02 - dx03*m3*mag03 - dx04*m4*mag04;
    let nvy0: Float32 = vy0 - dy01*m1*mag01 - dy02*m2*mag02 - dy03*m3*mag03 - dy04*m4*mag04;
    let nvz0: Float32 = vz0 - dz01*m1*mag01 - dz02*m2*mag02 - dz03*m3*mag03 - dz04*m4*mag04;
    let nvx1: Float32 = vx1 + dx01*m0*mag01 - dx12*m2*mag12 - dx13*m3*mag13 - dx14*m4*mag14;
    let nvy1: Float32 = vy1 + dy01*m0*mag01 - dy12*m2*mag12 - dy13*m3*mag13 - dy14*m4*mag14;
    let nvz1: Float32 = vz1 + dz01*m0*mag01 - dz12*m2*mag12 - dz13*m3*mag13 - dz14*m4*mag14;
    let nvx2: Float32 = vx2 + dx02*m0*mag02 + dx12*m1*mag12 - dx23*m3*mag23 - dx24*m4*mag24;
    let nvy2: Float32 = vy2 + dy02*m0*mag02 + dy12*m1*mag12 - dy23*m3*mag23 - dy24*m4*mag24;
    let nvz2: Float32 = vz2 + dz02*m0*mag02 + dz12*m1*mag12 - dz23*m3*mag23 - dz24*m4*mag24;
    let nvx3: Float32 = vx3 + dx03*m0*mag03 + dx13*m1*mag13 + dx23*m2*mag23 - dx34*m4*mag34;
    let nvy3: Float32 = vy3 + dy03*m0*mag03 + dy13*m1*mag13 + dy23*m2*mag23 - dy34*m4*mag34;
    let nvz3: Float32 = vz3 + dz03*m0*mag03 + dz13*m1*mag13 + dz23*m2*mag23 - dz34*m4*mag34;
    let nvx4: Float32 = vx4 + dx04*m0*mag04 + dx14*m1*mag14 + dx24*m2*mag24 + dx34*m3*mag34;
    let nvy4: Float32 = vy4 + dy04*m0*mag04 + dy14*m1*mag14 + dy24*m2*mag24 + dy34*m3*mag34;
    let nvz4: Float32 = vz4 + dz04*m0*mag04 + dz14*m1*mag14 + dz24*m2*mag24 + dz34*m3*mag34;
    vx0 = nvx0;
    vy0 = nvy0;
    vz0 = nvz0;
    vx1 = nvx1;
    vy1 = nvy1;
    vz1 = nvz1;
    vx2 = nvx2;
    vy2 = nvy2;
    vz2 = nvz2;
    vx3 = nvx3;
    vy3 = nvy3;
    vz3 = nvz3;
    vx4 = nvx4;
    vy4 = nvy4;
    vz4 = nvz4;
    bx0 = bx0 + dt * nvx0;
    by0 = by0 + dt * nvy0;
    bz0 = bz0 + dt * nvz0;
    bx1 = bx1 + dt * nvx1;
    by1 = by1 + dt * nvy1;
    bz1 = bz1 + dt * nvz1;
    bx2 = bx2 + dt * nvx2;
    by2 = by2 + dt * nvy2;
    bz2 = bz2 + dt * nvz2;
    bx3 = bx3 + dt * nvx3;
    by3 = by3 + dt * nvy3;
    bz3 = bz3 + dt * nvz3;
    bx4 = bx4 + dt * nvx4;
    by4 = by4 + dt * nvy4;
    bz4 = bz4 + dt * nvz4;
    count = count + 1;

    when count == bound {
        let edist01: Float32 = Sqrt#((bx0 - bx1) * (bx0 - bx1) + (by0 - by1) * (by0 - by1) + (bz0 - bz1) * (bz0 - bz1));
        let edist02: Float32 = Sqrt#((bx0 - bx2) * (bx0 - bx2) + (by0 - by2) * (by0 - by2) + (bz0 - bz2) * (bz0 - bz2));
        let edist03: Float32 = Sqrt#((bx0 - bx3) * (bx0 - bx3) + (by0 - by3) * (by0 - by3) + (bz0 - bz3) * (bz0 - bz3));
        let edist04: Float32 = Sqrt#((bx0 - bx4) * (bx0 - bx4) + (by0 - by4) * (by0 - by4) + (bz0 - bz4) * (bz0 - bz4));
        let edist12: Float32 = Sqrt#((bx1 - bx2) * (bx1 - bx2) + (by1 - by2) * (by1 - by2) + (bz1 - bz2) * (bz1 - bz2));
        let edist13: Float32 = Sqrt#((bx1 - bx3) * (bx1 - bx3) + (by1 - by3) * (by1 - by3) + (bz1 - bz3) * (bz1 - bz3));
        let edist14: Float32 = Sqrt#((bx1 - bx4) * (bx1 - bx4) + (by1 - by4) * (by1 - by4) + (bz1 - bz4) * (bz1 - bz4));
        let edist23: Float32 = Sqrt#((bx2 - bx3) * (bx2 - bx3) + (by2 - by3) * (by2 - by3) + (bz2 - bz3) * (bz2 - bz3));
        let edist24: Float32 = Sqrt#((bx2 - bx4) * (bx2 - bx4) + (by2 - by4) * (by2 - by4) + (bz2 - bz4) * (bz2 - bz4));
        let edist34: Float32 = Sqrt#((bx3 - bx4) * (bx3 - bx4) + (by3 - by4) * (by3 - by4) + (bz3 - bz4) * (bz3 - bz4));
        let e01: Float32 = m0 * m1 / edist01;
        let e02: Float32 = m0 * m2 / edist02;
        let e03: Float32 = m0 * m3 / edist03;
        let e04: Float32 = m0 * m4 / edist04;
        let e12: Float32 = m1 * m2 / edist12;
        let e13: Float32 = m1 * m3 / edist13;
        let e14: Float32 = m1 * m4 / edist14;
        let e23: Float32 = m2 * m3 / edist23;
        let e24: Float32 = m2 * m4 / edist24;
        let e34: Float32 = m3 * m4 / edist34;
        let ep: Float32 = -(e01 + e02 + e03 + e04 + e12 + e13 + e14 + e23 + e24 + e34);
        let ek0: Float32 = 0.5 * m0 * (vx0 * vx0 + vy0 * vy0 + vz0 * vz0);
        let ek1: Float32 = 0.5 * m1 * (vx1 * vx1 + vy1 * vy1 + vz1 * vz1);
        let ek2: Float32 = 0.5 * m2 * (vx2 * vx2 + vy2 * vy2 + vz2 * vz2);
        let ek3: Float32 = 0.5 * m3 * (vx3 * vx3 + vy3 * vy3 + vz3 * vz3);
        let ek4: Float32 = 0.5 * m4 * (vx4 * vx4 + vy4 * vy4 + vz4 * vz4);
        let energy: Float32 = ep + ek0 + ek1 + ek2 + ek3 + ek4;
        term! -> println!(energy);
    };
    term;
};
