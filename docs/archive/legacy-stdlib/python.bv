// lib/glue/python.bv — Python C API bridge declarations
// 2026-07-23: FFI functions and obj layouts for Python C extensions.
// Used by generator.bv to emit Briev-native bridge wrappers.

// ── Python C API frgn declarations ──────────────────────────────────────
frgn PyArg_ParseTuple(Ptr, Ptr, ...) -> Int from #POSIX;
frgn PyLong_FromLongLong(Int) -> Ptr from #POSIX;
frgn PyModule_Create2(Ptr, Int) -> Ptr from #POSIX;

// ── Struct layouts for C module metadata ────────────────────────────────
// These are injected into the type universe so the backend can verify
// layout compatibility. Actual obj emission is in the C file written
// by the generator's build_py_module.
