// gpu-compute.abv — GPU vector addition kernel
// 2026-07-15: Cleaned up — removed broken mutable ref syntax.
// Compiles to SPIR-V via the spirv backend.

// Grid configuration (host must set these at dispatch time)
let idx: Int = GetGlobalId#(0);
let total: Int = GetGlobalSize#(0);
let wg_size: Int = WorkgroupSize#(0);

// Buffers (host maps these)
let buf_a: Ptr<Float> = 0;
let buf_b: Ptr<Float> = 0;
let buf_c: Ptr<Float> = 0;

// Per-work-item: load, compute, store
txn vec_add [idx < total][idx >= total] {
    let a: Float = Load#(buf_a + idx * 8);
    let b: Float = Load#(buf_b + idx * 8);
    Store#(buf_c + idx * 8, a + b, 8);
    term;
};
