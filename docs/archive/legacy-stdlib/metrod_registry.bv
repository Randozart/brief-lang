// Metro Daemon Registry Types
// Data structures used by the metrod daemon to track services

// ===== SERVICE ENTRY =====

obj ServiceEntry {
    name: String;
    shm_name: String;
    addr: Int;
    capacity: Int;
    payload_size: Int;
    input_fields: Int;
    output_fields: Int;
    registered_at: Int;
    active: Bool
}

// ===== REGISTRATION REQUEST =====

obj RegisterRequest {
    name: String;
    capacity: Int;
    input_fields: Int;
    output_fields: Int
}

// ===== REGISTRATION RESPONSE =====

enum RegisterResult {
    RegisterOk(String, Int),
    RegisterExists(String),
    RegisterError(String)
}

// ===== LOOKUP REQUEST =====

obj LookupRequest {
    name: String
}

// ===== LOOKUP RESPONSE =====

obj LookupResponse {
    found: Bool;
    shm_name: String;
    addr: Int;
    capacity: Int;
    header_offset: Int;
    payload_offset: Int
}

// ===== DEREGISTER REQUEST =====

obj DeregisterRequest {
    name: String
}

// ===== DAEMON STATUS =====

obj DaemonStatus {
    service_count: Int;
    total_memory: Int;
    uptime_ms: Int;
    version: String
}

// ===== MEMORY SPEC JSON FIELDS =====

obj MemorySpecChannel {
    address: String;
    header_offset: Int;
    payload_offset: Int;
    capacity: Int;
    input_fields: Int;
    output_fields: Int
}

// ===== HELPER: Calculate payload size from service definition =====

defn calculate_payload_size(input_fields: Int, output_fields: Int) -> Int {
    // Each field gets up to 256 bytes of payload space
    let field_size: Int = 256;
    term (input_fields + output_fields) * field_size;
}

// ===== HELPER: Generate shm name from service name =====

defn make_shm_name(service_name: String) -> String {
    term "metro_" + service_name;
}

// ===== HELPER: Format memory spec as JSON string =====

defn format_memory_spec(entry: ServiceEntry) -> String {
    let spec_json: String = "{";
    let spec_json = spec_json + "\"channel\": {";
    let spec_json = spec_json + "\"address\": \"" + entry.shm_name + "\",";
    let spec_json = spec_json + "\"header_offset\": 0,";
    let spec_json = spec_json + "\"payload_offset\": 32,";
    let spec_json = spec_json + "\"capacity\": " + to_string(entry.capacity) + ",";
    let spec_json = spec_json + "\"input_fields\": " + to_string(entry.input_fields) + ",";
    let spec_json = spec_json + "\"output_fields\": " + to_string(entry.output_fields);
    let spec_json = spec_json + "}}";
    term spec;
}
