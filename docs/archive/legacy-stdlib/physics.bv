// physics.bv — pure compute, no view, no UI dependencies
// 2026-07-26: Compiled to WASM via LlvmBackend(wasm32) when compiling parent .rbv
// with --backend webstack. All .bv imports are WASM by default — no (wasm) annotation needed.
// See docs/architecture/features/rendered-briev-wasm.md

frgn submit_triangles(verts: Ptr<Float>, count: Int) -> Bool from #System;

txn simulate(p: Ptr<Float>, n: Int) -> Float {
    let result: Float = 0.0;
    let i: Int = 0;
    node loop [i < n][i == n] {
        when i < n {
            result = result + (p[i] * p[i]);
            i = i + 1;
        };
        term;
    };
    term result;
};
