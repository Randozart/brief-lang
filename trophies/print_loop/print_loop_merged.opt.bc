%struct.__sigset_t = type { [16 x i64] }
%struct.epoll_event = type <{ i32, %union.sigval }>

@N = local_unnamed_addr constant i64 50000000
@print_interval = local_unnamed_addr constant i64 100000
@llvm.wake_triggers = constant [1 x ptr] [ptr @__io_pending]
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @brief_rt_ctor, ptr null }]
@g_epoll_fd = internal unnamed_addr global i32 -1, align 4
@__stdin_ready = dso_local global i8 0, section "brief_trg", align 1
@__io_pending = dso_local global i8 0, section "brief_trg", align 1
@__const.__rt_wait.tv = private unnamed_addr constant %struct.timespec { i64 0, i64 100000 }, align 8
@stdout = external local_unnamed_addr global ptr, align 8
@stderr = external local_unnamed_addr global ptr, align 8
@.str = private unnamed_addr constant [6 x i8] c"%lld\0A\00", align 1
@.str.1 = private unnamed_addr constant [6 x i8] c"%.9f\0A\00", align 1
@stdin = external local_unnamed_addr global ptr, align 8
@g_timer_1hz = internal global ptr null, align 8
@g_timer_100hz = internal global ptr null, align 8
@__sigint_flag = dso_local global i8 0, section "brief_trg", align 1
@__sigterm_flag = dso_local global i8 0, section "brief_trg", align 1
@__sighup_flag = dso_local global i8 0, section "brief_trg", align 1
@__timer_1hz = dso_local global i64 0, section "brief_trg", align 8
@__timer_100hz = dso_local local_unnamed_addr global i64 0, section "brief_trg", align 8
@__stdin_buffer = dso_local local_unnamed_addr global ptr null, section "brief_trg", align 8

