// ── validate-trg: Warn on unresolved dynamic trigger targets ─────────
//
// 2026-07-21: Rewritten with direct AST navigation DSL.
// Checks each trigger for a resolvable instance reference.
// Warns for triggers whose target identifier is empty/missing.

$(Verified) {
    ForEach$(Tag$("trigger")) {
        Let$has_target = $.Descendants$(Tag$("ident")).First$().IsEmpty$();
        If$($has_target) {
            EmitWarning$("trigger with no target: " + $.Names$().First$());
        };
    };
};
