// ── entry-check: Verify at least one entry mechanism exists ───────────
//
// 2026-07-21: Rewritten with direct AST navigation DSL.
// Checks for [#] entry markers and trigger declarations.
// Replaces old Collect$ + CheckReactive$ intrinsics.

$(Typed) {
    Let$has_entry = Tag$("contract").WithAttr$("entry", true).Count$();
    Let$has_trg = Tag$("trigger").Count$();
    If$($has_entry == 0 && $has_trg == 0) {
        EmitError$("no entry point: add [#] to defn main or trg declaration");
    };
};
