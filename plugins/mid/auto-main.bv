// ── auto-main: Auto-wire [#] to defn/txn main ─────────────────────────
//
// 2026-07-21: Rewritten with direct AST navigation DSL.
// Navigates into defn/txn main's contract node and sets entry flag.
// Previously used MatchIR$ serialize/deserialize at $(Mid).

$(Typed) @ highest {
    Tag$("defn").Named$("main").First$()
        .Descendants$("contract").First$()
        .Set$("entry", true);
    Tag$("txn").Named$("main").First$()
        .Descendants$("contract").First$()
        .Set$("entry", true);
};
