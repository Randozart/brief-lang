// ── Standard Prelude — LLVM/Webstack/GPU Targets ─────────────────────────
// 2026-07-15: Injects std/prelude.bv imports. Runs at Front stage with
// highest priority so imports are available before type checking.

$(Front @ highest) {
    InsertLiteralImport$("std/types/bootstrap.bv");
    InsertLiteralImport$("std/os/fs.bv");
    InsertLiteralImport$("std/os/net.bv");
    InsertLiteralImport$("std/os/signal.bv");
    InsertLiteralImport$("std/os/ipc.bv");
    InsertLiteralImport$("std/os/thread.bv");
    InsertLiteralImport$("std/os/user.bv");
    InsertLiteralImport$("std/os/mem.bv");
    InsertLiteralImport$("std/os/atomic.bv");
    InsertLiteralImport$("std/core/ptr.bv");
    InsertLiteralImport$("std/core/string_builder.bv");
};
