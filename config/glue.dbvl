// config/glue.dbvl — GLUE adapter registry (Data Brief).
// 2026-08-03: migrated from lib/glue.toml. Per language:
//   <lang>: { types_module; extension; bridge_kind; calling_convention;
//            module_init; protocols: { "#Cat": { native; c_abi; } }; };
//   <lang>.templates.<n>: "<output path>" "template text with \n escapes";
// Quoted mode required (templates contain { } ; and newlines). Loaded via
// ConfigDb::from_quoted_str + resolve_config_file("glue").
//
// Template variables: {{bridge_name}} {{name}} {{params}} {{ffi_params}}
//   {{c_types}} {{args}} {{args_abi}} {{return}} {{c_return}}
//   {{return_expr}} {{s_param}} {{s_init}} {{exports}} {{ffi_decls}}
// Special template keys: "fn_template", "ffi_template"

node: { types_module: "glue/node/types.bv"; extension: "mjs"; bridge_kind: "esm_module"; calling_convention: "c_abi"; module_init: false; protocols: { "#Bool": { native: "boolean"; c_abi: "bool" }; "#Char": { native: "string"; c_abi: "i32" }; "#Data": { native: "Uint8Array"; c_abi: "cstring" }; "#Float": { native: "number"; c_abi: "double" }; "#Int": { native: "bigint"; c_abi: "i64" }; "#String": { native: "string"; c_abi: "cstring" } } ; conversions: { to_abi: { "#Int": "{name}"; "#Float": "{name}"; "#String": "{name}"; "#Bool": "{name}"; "#Data": "{name}"; "#Char": "{name}" }; from_abi: { "#Int": "result_abi"; "#Float": "result_abi"; "#String": "result_abi"; "#Bool": "result_abi"; "#Data": "result_abi"; "#Char": "result_abi" } } ; state: { decl: ""; arg: "_state"; ffi_type: "'pointer'" }; param_decl: "{name}: {type}" };
node.templates.0: "ffi_template" "{{name}}: [{{c_return}}, [{{s_ffi_type}}{{c_types}}]],";
node.templates.1: "fn_template" "export function {{name}}({{params}}) {\n    return lib.{{name}}({{s_param}}{{args_abi}});\n}\n";
node.templates.2: "index.mjs" "// GLUE bridge for {{bridge_name}} — auto-generated.\nimport { createRequire } from 'module';\nconst require = createRequire(import.meta.url);\nconst ffi = require('ffi-napi');\n\nconst lib = ffi.Library('./bridge.so', {\n    init_state: ['void', ['pointer']],\n    {{ffi_decls}}\n});\n\nlet _state = null;\n\nfunction init_state() {\n    const buf = Buffer.alloc(32);\n    _state = buf;\n    lib.init_state(buf);\n}\n\ninit_state();\n\n{{exports}}\n";
python: { types_module: "glue/python/types.bv"; extension: "so"; bridge_kind: "native_module"; calling_convention: "c_abi"; module_init: true; protocols: { "#Bool": { native: "bool"; c_abi: "ctypes.c_bool" }; "#Char": { native: "str"; c_abi: "ctypes.c_char" }; "#Data": { native: "bytes"; c_abi: "ctypes.c_void_p" }; "#Float": { native: "float"; c_abi: "ctypes.c_double" }; "#Int": { native: "int"; c_abi: "ctypes.c_int64" }; "#String": { native: "str"; c_abi: "ctypes.c_void_p" } } ; conversions: { to_abi: { "#Int": "{name}"; "#Float": "{name}"; "#String": "{name}"; "#Bool": "{name}"; "#Data": "{name}"; "#Char": "{name}" }; from_abi: { "#Int": "result_abi"; "#Float": "result_abi"; "#String": "result_abi"; "#Bool": "result_abi"; "#Data": "result_abi"; "#Char": "result_abi" } } ; state: { decl: ""; arg: "_STATE"; ffi_type: "ctypes.c_void_p" }; param_decl: "{name}: {type}" };
python.templates.0: "__init__.py" "\"\"\"GLUE bridge for {{bridge_name}} — auto-generated.\"\"\"\nimport ctypes\nimport os\n\n_lib = ctypes.CDLL(os.path.join(os.path.dirname(__file__), \"bridge.so\"))\n\ndef _init_state():\n    _lib.init_state.argtypes = [ctypes.c_void_p]\n    _lib.init_state.restype = None\n    buf = ctypes.create_string_buffer(32)\n    state = ctypes.cast(ctypes.pointer(buf), ctypes.c_void_p)\n    _lib.init_state(state)\n    return state\n\n_STATE = _init_state()\n\n{{exports}}\n";
python.templates.1: "fn_template" "def {{name}}({{params}}):\n    _lib.{{name}}.argtypes = [{{s_ffi_type}}{{c_types}}]\n    _lib.{{name}}.restype = {{c_return}}\n    return _lib.{{name}}({{s_param}}{{args_abi}})\n";
rust: { types_module: "glue/rust/types.bv"; extension: "rs"; bridge_kind: "extern_c_crate"; calling_convention: "lto"; module_init: false; protocols: { "#Bool": { native: "bool"; c_abi: "bool" }; "#Char": { native: "i32"; c_abi: "i32" }; "#Data": { native: "*mut u8"; c_abi: "*mut u8" }; "#Float": { native: "f64"; c_abi: "f64" }; "#Int": { native: "i64"; c_abi: "i64" }; "#String": { native: "*mut u8"; c_abi: "*mut u8" } } ; conversions: { to_abi: { "#Int": "{name}"; "#Float": "{name}"; "#String": "{name}"; "#Bool": "{name}"; "#Data": "{name}"; "#Char": "{name}" }; from_abi: { "#Int": "result_abi"; "#Float": "result_abi"; "#String": "result_abi"; "#Bool": "result_abi"; "#Data": "result_abi"; "#Char": "result_abi" } } ; state: { decl: "state: *mut std::ffi::c_void"; arg: "STATE"; ffi_type: "" }; param_decl: "{name}: {type}" };
rust.templates.0: "Cargo.toml" "[package]\nname = \"{{bridge_name}}\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"staticlib\", \"lib\"]\n\n[dependencies]\n";
rust.templates.1: "build.rs" "fn main() {\n    println!(\"cargo:rustc-link-search={}\", std::env::var(\"OUT_DIR\").unwrap());\n    println!(\"cargo:rustc-link-lib={{bridge_name}}\");\n}\n";
rust.templates.2: "ffi_template" "    pub fn {{name}}({{s_ffi_param}}{{ffi_params}}) -> {{c_return}};";
rust.templates.3: "fn_template" "pub fn {{name}}({{params}}) -> {{return}} { unsafe {\n    let result_abi = ffi::{{name}}({{s_param}}{{args_abi}});\n    {{return_expr}}\n} }\n";
rust.templates.4: "src/ffi.rs" "// FFI declarations — auto-generated.\n#![allow(dead_code)]\nuse std::ffi::c_void;\n\nextern \"C\" {\n    {{s_init}}\n    {{ffi_decls}}\n}\n";
rust.templates.5: "src/lib.rs" "// GLUE bridge for {{bridge_name}} — auto-generated.\n#![allow(dead_code)]\n\nmod ffi;\nuse std::ffi::c_void;\n\nstatic mut STATE: *mut c_void = std::ptr::null_mut();\n\nfn init_state() {\n    unsafe {\n        let layout = std::alloc::Layout::from_size_align(32, 8).unwrap();\n        let buf = std::alloc::alloc_zeroed(layout) as *mut c_void;\n        ffi::init_state(buf);\n        STATE = buf;\n    }\n}\n\n{{exports}}\n";
web: { types_module: "glue/web/types.bv"; extension: "mjs"; bridge_kind: "wasm_runtime"; calling_convention: "wasm_import"; module_init: false; protocols: { "#Bool": { native: "boolean"; wasm_abi: "i32" }; "#CanvasContext": { native: "WebGLRenderingContext | GPUDevice"; wasm_abi: "i32" }; "#Element": { native: "Element"; wasm_abi: "i32" }; "#Float": { native: "number"; wasm_abi: "f64" }; "#Int": { native: "number"; wasm_abi: "i32" }; "#String": { native: "string"; wasm_abi: "i32" } } ; conversions: { to_abi: { "#Int": "{name}"; "#Float": "{name}"; "#String": "{name}"; "#Bool": "{name}"; "#Data": "{name}"; "#Char": "{name}" }; from_abi: { "#Int": "result_abi"; "#Float": "result_abi"; "#String": "result_abi"; "#Bool": "result_abi"; "#Data": "result_abi"; "#Char": "result_abi" } }; state: { decl: ""; arg: ""; ffi_type: "" }; param_decl: "{name}: {type}" };
web.templates.0: "dom-shim.mjs" "// dom-shim.mjs — Auto-generated GLUE web runtime for {{bridge_name}}\n// Reads WASM linear memory at known state offsets. Called by the WASM module\n// via __web_flush_state import at each transaction commit point.\n\nexport class WasmDomRuntime {\n  constructor(wasmBytes) {\n    this._handles = [null];\n    this._bindingTable = [];\n    this._init(wasmBytes);\n  }\n\n  async _init(wasmBytes) {\n    const wasm = await WebAssembly.instantiate(wasmBytes, {\n      env: this._buildImports(),\n    });\n    this._instance = wasm.instance;\n    this._memory = wasm.instance.exports.memory;\n    this._loadStateLayout();\n  }\n\n  _buildImports() {\n    return {\n      __web_flush_state: (updatesPtr, count) => {\n        this._applyFlush(updatesPtr, count);\n      },\n    };\n  }\n\n  _loadStateLayout() {\n    const layoutPtr = this._instance.exports.state_layout();\n    const mem = new DataView(this._memory.buffer);\n    // ... layout table read at runtime ...\n  }\n\n  _applyFlush(updatesPtr, count) {\n    const mem = new DataView(this._memory.buffer);\n    let off = updatesPtr;\n    for (let i = 0; i < count; i++) {\n      const handle = mem.getUint32(off, true); off += 4;\n      const valPtr = mem.getUint32(off, true); off += 4;\n      const valLen = mem.getUint32(off, true); off += 4;\n      const binding = this._bindingTable[handle];\n      if (binding) {\n        const value = valLen > 0\n          ? new TextDecoder().decode(new Uint8Array(this._memory.buffer, valPtr, valLen))\n          : null;\n        binding.applyFn(value);\n      }\n    }\n  }\n}\n\nexport async function createApp(wasmBytes) {\n  const runtime = new WasmDomRuntime(wasmBytes);\n  return runtime._instance.exports;\n}\n";
c: { types_module: "glue/c/types.bv"; extension: "h"; bridge_kind: "extern_c_crate"; calling_convention: "lto"; module_init: false; protocols: { "#String": { native: "int64_t"; c_abi: "int64_t" }; "#Int": { native: "int64_t"; c_abi: "int64_t" }; "#Float": { native: "double"; c_abi: "double" }; "#Bool": { native: "int8_t"; c_abi: "int8_t" }; "#Data": { native: "int64_t"; c_abi: "int64_t" }; "#Char": { native: "int32_t"; c_abi: "int32_t" } }; conversions: { to_abi: { "#Int": "{name}"; "#Float": "{name}"; "#String": "{name}"; "#Bool": "{name}"; "#Data": "{name}"; "#Char": "{name}" }; from_abi: { "#Int": "result_abi"; "#Float": "result_abi"; "#String": "result_abi"; "#Bool": "result_abi"; "#Data": "result_abi"; "#Char": "result_abi" } }; state: { decl: "BriefState* state"; arg: "state"; ffi_type: "" }; param_decl: "{type} {name}"; fn_param_decl: "{ret} (*{name})({params})" };
c.bindings.brief_types.h: "// Autogenerated by Brief Compiler — do not edit manually\n#pragma once\n#include <stdint.h>\n\ntypedef struct BriefState BriefState;\nextern BriefState* __brief_init_state(void);\nextern void __glue_release(BriefState* state);\nextern void __brief_set_cancel(BriefState* state, int32_t flag);\nextern void __brief_clear_cancel(BriefState* state);\n\n{{ffi_decls}}\n";
c.bindings.ffi_template: "{{c_return}} {{name}}({{s_ffi_param}}{{ffi_params}});";
rust.bindings.brief_bindings.rs: "// Autogenerated by Brief Compiler — do not edit manually\nuse std::ffi::c_void;\n\n#[repr(C)]\npub struct BriefState { _private: [u8; 0] }\n\nextern \"C\" {\n    pub fn __brief_init_state() -> *mut c_void;\n    pub fn __glue_release(state: *mut c_void);\n    {{ffi_decls}}\n}\n";
rust.bindings.ffi_template: "    pub fn {{name}}({{s_ffi_param}}{{ffi_params}}) -> {{c_return}};";
python.bindings.brief_bindings.py: "\"\"\"Autogenerated by Brief Compiler — do not edit manually.\"\"\"\nimport ctypes\n\n_lib = ctypes.CDLL(\"bridge.so\")\n\nclass BriefState(ctypes.Structure):\n    pass\n\n_lib.__brief_init_state.restype = ctypes.c_void_p\n_lib.__glue_release.argtypes = [ctypes.c_void_p]\n\n{{ffi_decls}}\n";
python.bindings.ffi_template: "{{name}} = _lib.{{name}}\n{{name}}.argtypes = [{{s_ffi_type}}{{c_types}}]\n{{name}}.restype = {{c_return}}\n";
python.templates.2: "native.module" "#define PY_SSIZE_T_CLEAN\n#define Py_LIMITED_API 0x03090000\n#include <Python.h>\n\ntypedef struct BriefState BriefState;\nextern BriefState* __brief_init_state(void);\nextern void __glue_release(BriefState* state);\n\nextern {{export_protos}};\n\nstatic BriefState* g_state = NULL;\n\n{{methods}}\n\nstatic PyMethodDef module_methods[] = {\n    {{method_defs}}\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef module_def = {\n    PyModuleDef_HEAD_INIT, \"{{bridge_name}}\", NULL, -1, module_methods\n};\n\nPyMODINIT_FUNC PyInit_{{bridge_name}}(void) {\n    g_state = __brief_init_state();\n    return PyModule_Create(&module_def);\n}\n";
python.templates.3: "native.method" "static PyObject* py_{{name}}(PyObject* self, PyObject* args) {\n    {{parse_decls}}\n    if (!PyArg_ParseTuple(args, \"{{parse_fmt}}\", {{parse_args}})) return NULL;\n    {{ret_c}} r = {{call}};\n    return {{build}};\n}\n";
python.templates.4: "native.method_def" "    {\"{{name}}\", py_{{name}}, METH_VARARGS, \"{{name}}\"},";
python.templates.5: "native.c_type.#Int" "long long";
python.templates.6: "native.fmt.#Int" "l";
python.templates.7: "native.ret.#Int" "long long";
python.templates.8: "native.build.#Int" "PyLong_FromLongLong(r)";
python.templates.9: "native.c_type.#Float" "double";
python.templates.10: "native.fmt.#Float" "d";
python.templates.11: "native.ret.#Float" "double";
python.templates.12: "native.build.#Float" "PyFloat_FromDouble(r)";
python.templates.13: "native.c_type.#String" "long long";
python.templates.14: "native.fmt.#String" "l";
python.templates.15: "native.ret.#String" "long long";
python.templates.16: "native.build.#String" "PyLong_FromVoidPtr((void*)r)";
