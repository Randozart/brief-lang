// ── Allocation Strategy Config ──────────────────────────────────────────
// 2026-07-18: Custom allocation strategy LLVM IR templates.
// PascalCase strategies (Arena, Malloc, Alloca) are intrinsic — do not
// redefine them here.
//
// Quoted strategy names like "pool_serial" are resolved through this file.
// Each entry provides an LLVM IR template with {v} and {size} placeholders.
// {v}   = result register name (without %)
// {size} = size_i64 register name
//
// 2026-08-03 (Phase 3, data-briev-config plan): migrated from
// alloc-strategies.toml. Row shape is `<name>: "<template with \n escapes>";
// [free];`. The template REQUIRES quoted mode — bare mode takes `{size}` as a
// nested sub-record and errors (locked by
// bare_mode_rejects_templates_with_braces). Field 1 is the Free# dispatch
// override: `none` → no-op; `"fn_name"` → call custom free; absent → call
// @free (safe default). The .toml remains until the parity test proves
// identical output.

// free field controls Free# dispatch:
//   none      → Free# is a no-op (arena, ring buffer, pool reuse)
//   @free     → call @free (default)
//   "fn_name" → call custom free function
// If free is omitted, Free# calls @free (safe default).

pool_serial: "%{v}_p = call ptr @pool_alloc(i64 {size})\n%{v} = ptrtoint ptr %{v}_p to i64"; none;
mmap_shared: "%{v}_p = call ptr @mmap_shared(i64 {size})\n%{v} = ptrtoint ptr %{v}_p to i64"; munmap_shared;
pinned_dma: "%{v}_p = call ptr @alloc_dma_pinned(i64 {size})\n%{v} = ptrtoint ptr %{v}_p to i64"; free_dma_pinned;
