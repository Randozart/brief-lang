// ── Address Map (deprecated alias) ──────────────────────────────────────
// 2026-07-15: Named address resolution for AddressOf# intrinsic.
// Maps logical device names to memory-mapped I/O addresses.
// Used by the compiler to resolve AddressOf#("uart") at compile time.
// The interpreter has a fallback table for known names.
//
// 2026-08-03 (Phase 3, data-briev-config plan): migrated from address-map.toml.
// This is the DEPRECATED tier-2 fallback — the active board's
// lib/boards/<board>/addresses.dbvl is the primary source and resolves first.
// Keys are CAPITALIZED constants (matches the case-insensitive lookup).
// Second field (0x1000) is the register block size, parsed but unused by the
// resolver. Keep this file only while legacy programs reference the generic
// names (uart/gpio/timer/spi/i2c/dma); boards own the real addresses.

UART: 0xFFE01000; 0x1000;
UART0: 0xFFE01000; 0x1000;
GPIO: 0xFE001000; 0x1000;
GPIO0: 0xFE001000; 0x1000;
TIMER: 0xFE002000; 0x1000;
TIMER0: 0xFE002000; 0x1000;
SPI: 0xFE003000; 0x1000;
SPI0: 0xFE003000; 0x1000;
I2C: 0xFE004000; 0x1000;
I2C0: 0xFE004000; 0x1000;
DMA: 0xFE005000; 0x1000;
DMA0: 0xFE005000; 0x1000;
