// gemm.abv - matrix product: y[m*N + n] = sum_k A[m*K + k] * B[k*N + n].
// M = N = K = 4096 (137 GFLOP). Naive expression — the compiler's job is
// to see the GEMM shape and emit what a hand-tuned kernel would (plan
// 2026-09-01-m2-gemm).
const M: Int = 4096;
const N: Int = 4096;
const K: Int = 4096;

let i: Int = 0;
let a: Float[16777216];
let b: Float[16777216];
let y: Float[16777216];

async node gemm [i < M * N][i == M * N] {
    let acc: Float = 0;
    let m: Int = i / N;
    let n: Int = i % N;
    foreach k in 0..K {
        acc = acc + a[m * K + k] * b[k * N + n];
    }
    y[i] = acc;
    i = i + 1;
    term;
};
