// gemv_m256.abv - M=256, K=4096: mid small-M shape (plan 2026-09-01-smallm-splitk).
const M: Int = 256;
const K: Int = 4096;

let i: Int = 0;
let a: Float[1048576];
let x: Float[4096];
let y: Float[256];

async node gemv [i < M][i == M] {
    let acc: Float = 0;
    foreach k in 0..K {
        acc = acc + a[i * K + k] * x[k];
    }
    y[i] = acc;
    i = i + 1;
    term;
};
