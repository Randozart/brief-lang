// Constraint Range Example
// Demonstrates <: [lo..hi] range sugar which desugars to _ >= lo && _ <= hi

let score: Int = 0;

rct txn process_score {
  let valid: Int <: [0..100] = score;
  term print_int#(valid);
};

rct txn increment [score < 100][score == @score + 1] {
  &score = score + 1;
  term;
};
