// link-example.bv — Link a C source file into a Briv program
//
// This demonstrates the link dependency system.
// The compiler compiles helper.c to LLVM bitcode via clang,
// merges it with the program IR, and runs LTO on both.
//
// Usage: briv-compiler build examples/link-demo/link-example.bv

// Link the C helper — the compiler will find it relative to this file
import "link-demo/helper.c";

// Declare the C functions as FFI
frgn double_it(n: Int) -> Int;
frgn greet(name: String) -> Bool;

txn run [true][result == 84] {
    let doubled: Int = double_it(42);
    let greeted: Bool = greet("Briv");
    result = doubled;
    term greeted;
};