// inop-uart-mmap: MMIO UART driver using flattened board constants
//
// Demonstrates:
//   1. import "target" resolves to board schema (STM32F407)
//   2. Flattened constants (uart1_dr, uart1_sr, uart1_cr1) are compile-time Int
//   3. Contract-proven MMIO access with volatile_load#/volatile_store#
//   4. The `in_range` pattern for contract bounds
//
// Usage: brief-compiler --board stm32f407 check examples/inop-uart-mmap.bv

import "target";

defn in_range(addr: Int, base: Int, end: Int) -> Bool {
    term addr >= base && addr < end;
};

// Polling loop: wait for TX empty flag
txn poll_txe(sr_addr: Ptr<Int>) [sr_addr as Int > 0][volatile_load#(sr_addr) & 0x80 != 0]
{
    term;
};

// Send one byte via UART1 (polling, blocks until TX buffer empty)
defn uart_send(c: Int) -> Bool
    [in_range(uart1_dr, uart1_base, uart1_end)]
    [in_range(uart1_sr, uart1_base, uart1_end)]
{
    let ok: Int = poll_txe(uart1_sr as Ptr<Int>);
    term volatile_store#(uart1_dr as Ptr<Int>, c);
};

// Polling loop: wait for RX full flag
txn poll_rxne(sr_addr: Ptr<Int>) [sr_addr as Int > 0][volatile_load#(sr_addr) & 0x40 != 0]
{
    term;
};

// Read one byte from UART1 (polling, blocks until RX buffer full)
defn uart_recv() -> Int
    [in_range(uart1_dr, uart1_base, uart1_end)]
    [in_range(uart1_sr, uart1_base, uart1_end)]
{
    let ok: Int = poll_rxne(uart1_sr as Ptr<Int>);
    term volatile_load#(uart1_dr as Ptr<Int>);
};

// Enable UART1 by setting UE bit (CR1 bit 13)
defn uart_enable() -> Int
    [in_range(uart1_cr1, uart1_base, uart1_end)]
    [true]
{
    let cr1: Int = volatile_load#(uart1_cr1 as Ptr<Int>);
    term volatile_store#(uart1_cr1 as Ptr<Int>, cr1 | 0x20);
};

// Toggle GPIOA pin 0 via ODR register
defn gpio_toggle() -> Int
    [in_range(gpioa_odr, gpioa_base, gpioa_end)]
    [true]
{
    let val: Int = volatile_load#(gpioa_odr as Ptr<Int>);
    term volatile_store#(gpioa_odr as Ptr<Int>, val ^ 0x01);
};

// Self-test: verify constants match known STM32F407 addresses
defn self_check() -> Bool {
    term uart1_dr == 0x40011000
      && uart1_sr == 0x40011001
      && uart1_cr1 == 0x4001100C
      && gpioa_odr == 0x40020014
      && uart1_end == 0x40011018
      && gpioa_end == 0x40020400;
};
