// ── Pipe Chain Example ──────────────────────────────────────────────
//
// Demonstrates basic pipe chaining with |> operator.
// 5 |> add_one() |> double() |> add_one()
//   = add_one(double(add_one(5)))
//   = add_one(double(6)) = add_one(12) = 13
//
// Run: brief-compiler rbv examples/pipe-chain.bv

defn add_one(x: Int) -> Int { term x + 1; };
defn double(x: Int) -> Int { term x * 2; };

txn main() -> Bool {
    let result: Int = 5 |> add_one() |> double() |> add_one();
    term! -> print_int#(result);   // prints 13
};
