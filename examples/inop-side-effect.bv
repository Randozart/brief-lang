// inop-side-effect.bv — inop! (side-effectful user intrinsic)
// Contrasts with inop (pure). Uses BILD body with side effects.
// Demonstrates: inop! (side-effectful), BILD with store/load,
// fallback expression for interpreter

// Pure inop — no side effects, compiler can CSE/reorder
inop sadd(a: Int, b: Int) -> Int {
    %res = add i64 %a, %b;
    term %res;
} fallback a + b;

// Side-effectful inop! — has observable side effects,
// compiler must preserve ordering
inop! log_value(msg: String, val: Int) -> Int {
    // BILD body: calls fprintf under the hood
    %fmt = getelementptr @"log: %s = %d\n";
    %ret = call i32 @fprintf(%fmt, %msg, %val);
    term %ret;
} fallback 0;

// inop! with memory store (MMIO-style)
inop! write_register(addr: Int, val: Int) -> Int {
    store i64 %val, i64* %addr;
    term %val;
} fallback val;

// Using pure inop — can be reordered/eliminated
txn compute_sum [true][result == 30] {
    let x: Int = sadd#(10, 20);     // pure — no side effects
    &result = x;
    term;
};

// Using side-effectful inop! — must preserve order
txn log_computation [true][logged == true] {
    let _ = log_value#("result", result);  // side effect — preserved
    &logged = true;
    term;
};