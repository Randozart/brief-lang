// pointer-trickery: Ptr<T> low-level operations — type punning, MMIO, contract safety
//
// Demonstrates:
//   1. Ptr<Int> arithmetic (navigate a register block)
//   2. Ptr<Int> → Ptr<Int> type reinterpretation via `as` cast
//   3. volatile_load# / volatile_store# for MMIO register access
//   4. Contract-proven bounds safety
//   5. BILD inline asm via asm target { } for raw syscalls

const UART_BASE: Int = 0x40011000;
const UART_END:  Int = 0x40011020;

// --- MMIO register block (sequentially addressed 32-bit registers) ---
const UART_DR:    Ptr<Int> = 0x40011000 as Ptr<Int>;   // data register
const UART_FR:    Ptr<Int> = 0x40011004 as Ptr<Int>;   // flag register
const UART_IBRD:  Ptr<Int> = 0x40011008 as Ptr<Int>;   // integer baud rate
const UART_FBRD:  Ptr<Int> = 0x4001100C as Ptr<Int>;   // fractional baud rate
const UART_LCRH:  Ptr<Int> = 0x40011010 as Ptr<Int>;   // line control

// --- Pointer arithmetic: navigate register block ---
// UART_FR can also be computed as UART_DR + 4
let computed_fr: Ptr<Int> = UART_DR + 4;
let base_reg: Ptr<Int> = UART_DR + 8;  // arbitrary offset

// --- Type reinterpretation: access lower 32 bits of an Int register as Char ---
// ptr as Ptr<Char> reinterprets the same address with i32 semantics
let uart_dr_as_char: Ptr<Char> = UART_DR as Ptr<Char>;

// --- Volatile access with contract-proven safety ---
defn read_uart(reg: Ptr<Int>) -> Int
    [reg as Int >= UART_BASE]
    [reg as Int <  UART_END]
{
    term volatile_load#(reg);
};

defn write_uart(reg: Ptr<Int>, val: Int) -> Bool
    [reg as Int >= UART_BASE]
    [reg as Int <  UART_END]
{
    term volatile_store#(reg, val);
};

// --- Sequenced MMIO transaction ---
let uart_config_done: Bool = false;
let uart_init_done: Bool = false;
let result: Int = 0;

rct txn configure_uart [step < 3][step == 3] {
    [step == 0] {
        // Step 0: configure baud rate registers
        let ok: Bool = write_uart(UART_IBRD, 26);
        let ok2: Bool = write_uart(UART_FBRD, 3);
        uart_config_done = ok && ok2;
        step = step + 1;
        term;
    };
    [step == 1] {
        // Step 1: read back configuration to verify
        let ibrd_val: Int = read_uart(UART_IBRD);
        let fbrd_val: Int = read_uart(UART_FBRD);
        if ibrd_val == 0 && fbrd_val == 0 {
            result = 1;  // interpreter returns 0 for volatile_load (dummy)
        };
        step = step + 1;
        term;
    };
    [step == 2] {
        // Step 2: finalize — these pass because contracts prove bounds safety
        let final_ok: Bool = write_uart(UART_LCRH, 0x60);
        uart_init_done = final_ok;
        result = result + 2;  // total = 3
        &step = step + 1;
        term;
    };
};

// Compile:   ./target/release/brief-compiler build examples/pointer-trickery.bv
// Expected:  (interpreter runs to completion, result = 3)
