// proof-oracle.bv — ?# proof oracle system
// Demonstrates: ?# annotation, fuel injection, structural recursion checking,
// proof handler dispatch

// The ?# annotation tells the compiler to prove termination
// via structural recursion checking (SPARK-style decreasing variant)
?# fact[n : Int] -> Int
defn fact(n: Int) -> Int [n >= 0][term >= 1] {
    [n <= 1] {
        term 1;
    };
    term n * fact(n - 1);
};

// Fuel-bounded proof: the compiler injects a fuel counter
// that ensures the loop terminates within ?# bound
?# countdown[n : Int, fuel: Int] -> Int
txn countdown(n: Int) [n > 0][n == @n - 1] -> Int {
    [n == 1] {
        term 0;
    };
    term countdown(n - 1);
};

// Proof oracle with rollback handler
// When the fuel runs out, the handler restores the pre-state
?# sum_list[items: List<Int>, i: Int] -> Int [handler: rollback]
defn sum_list(items: List<Int>) -> Int [true][term >= 0] {
    let len: Int = items :> Size;
    txn sum_loop [i < len][i == len] -> Int {
        &result = result + items[i];
        &i = i + 1;
        term;
    };
    term 0;
};