// ── Collect$/MatchIR$ BEAST Pattern Example ────────────────────────────
//
// 2026-07-15: Demos BEAST pattern matching in a $(Back) stage block.
// Collect$ gathers all AST nodes matching a pattern (read-only, logs count).
// MatchIR$ rewrites matched nodes with a replacement pattern.
//
// Build: brief-compiler build examples/stage/collect-match.bv --emit-beast

$(Back) {
    // Collect all defn declarations and log them
    Collect$("(defn ?name ?params ?ret ?body)");
};

defn main() -> Int {
    term 0;
};
