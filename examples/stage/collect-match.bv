// ── AST Navigation DSL Example ──────────────────────────────────────────
//
// 2026-07-21: Demonstrates the direct AST navigation DSL.
// Counts all defn declarations using Tag$/Count$ instead of Collect$.
// Build: brief-compiler build examples/stage/collect-match.bv --emit-beast typed

$(Typed) {
    Let$defns = Tag$("defn").Count$();
    EmitWarning$("Found " + $defns + " defn(s) in AST");
};

defn main() -> Int {
    term 0;
};
