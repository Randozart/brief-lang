// 2026-07-21: Updated from $(Back)/$(Front) to $(Optimized)/$(Parsed).

$(Optimized) {
    // Optimized stage: final validation before writing to disk
    EmitWarning$("Optimized stage: final check passed");
};

$(Parsed) {
    // Insert stdlib import before first user import
    Tag$("import").First$().Before$()
        .Insert$(Import$("std/types.bv"));
};

defn main() -> Int {
    // AddressOf# returns a typed pointer for trigger bindings
    let uart: Ptr<Bits<8>> = AddressOf#("sys:uart/status");
    term 0;
};
