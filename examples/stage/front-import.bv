// 2026-07-21: Updated from $(Front) + InsertLiteralImport$ to $(Parsed) +
// direct AST navigation. Inserts an import before the first existing import.

$(Parsed) {
    Tag$("import").First$().Before$()
        .Insert$(Import$("std/option.bv"));
};

// The import inserted above is available here:
defn main() -> Int {
    let x: Option<Int> = Option::Some(42);
    term 0;
};
