// 2026-07-21: Updated from $(Mid) to $(Typed).

$(Typed) {
    // Count calls to PrintInt# — was previously done via Collect$
    Let$calls = Tag$("call").Named$("PrintInt#").Count$();
    If$($calls > 0) {
        EmitWarning$("Typed stage: " + $calls + " PrintInt# calls found");
    };
};

defn compute(x: Int) -> Int {
    term x * 2;
};

defn main() -> Int {
    term compute(21);
};
