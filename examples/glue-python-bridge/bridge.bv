// GLUE Python Bridge — example Briev bridge file
//
// Inlines minimal type definitions (no prelude dependency).
// Compiled to a shared library that Python loads via ctypes.
//
// Workflow:
//   briev build --disable-plugin prelude --library bridge.bv --out .
//   llc -filetype=obj bridge.ll -o bridge.o
//   cc -shared bridge.o -o libbridge.so   (Linux)
//   python3 gluerun.py

type Int : Bits {
    !> maxbits: 64;
    !> alignment: 8;
};

export
defn add(a: Int, b: Int) -> Int {
    term a + b;
};

export
defn multiply(a: Int, b: Int) -> Int {
    term a * b;
};
