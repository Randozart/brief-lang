// render-struct-demo.rbv — render struct component definition
// 2026-07-26: Migrated from rstruct to render struct syntax
//
// A render struct attaches view HTML to state fields and transactions.
// The struct defines the data layout; render struct defines the view.

let name: String = "World";
let count: Int = 0;

txn set_name [true][name == new_name] {
    name = new_name;
    term;
};

txn greet [count < 100][count == @count + 1] {
    count = count + 1;
    term;
};

render struct Greeter {
    <div class="greeter">
        <h1 b-text="'Hello, ' + name + '!'">Hello, World!</h1>
        <p>Greeted <span b-text="count">0</span> times</p>
        <button b-trigger:click="greet">Greet</button>
        <input type="text" b-bind:value="name" />
    </div>
};

<view>
    <div class="container">
        <Greeter />
    </div>
</view>

<style>
.greeter { padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
button { padding: 8px 16px; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; }
input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 100%; }
</style>
