// render-struct-demo.rbv — render component definition
// 2026-08-12 (2b3): obj-backed — obj Greeter owns state + member txns; the
// render fragment binds the obj's slots. HTML-side spawn (<Greeter />) is
// reactor-owned + zero-init; Briev-side seeds land with the 2b3 Briev-side
// slice (let g1: Greeter = Greeter { name: "World" }).

obj Greeter {
    name: String;
    count: Int;

    txn set_name(new_name: String) [true][name == new_name] {
        name = new_name;
        term;
    };

    txn greet [count < 100][true] {
        count = count + 1;
        term;
    };
};

render Greeter {
    <div class="greeter">
        <h1>Hello, <span b-text="name">World</span>!</h1>
        <p>Greeted <span b-text="count">0</span> times</p>
        <button b-trigger:click="greet">Greet</button>
        <input type="text" b-bind:value="name" />
    </div>
};

<view>
    <div class="container">
        <Greeter />
    </div>
</view>

<style>
.greeter { padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
button { padding: 8px 16px; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; }
input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 100%; }
</style>
