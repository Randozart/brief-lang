// wasm-import.rbv — Compute module import via WASM sidecar
//
// 2026-07-26: Superseded — the webstack v2 compiles ALL .bv/.rbv code to WASM
// by default. The (wasm) import annotation is no longer needed; .bv modules
// used as compute sidecars are compiled to WASM via LlvmBackend(wasm32) and
// linked by the GlueWebGenerator at runtime.
//
// Compilation:
//   briev build wasm-import.rbv --backend webstack
//     → app.wasm (main logic) + dom-shim.mjs (runtime bridge)
//   The imported physics.bv compiles to a separate .wasm sidecar, linked
//   via the wasm_runtime bridge in lib/glue.toml.
//
// See docs/architecture/features/rendered-briev-wasm.md for the current
// webstack architecture.

(wasm) import physics from "physics.bv" as wasmPhysics;

state result: Float = 0.0;
state data: List<Float> = [];
state count: Int = 0;

b-text: "Computed: {result}";

node tick [count > 0][tick_count == @tick_count + 1] {
    result = wasmPhysics.simulate(data :> Ptr, count);
    term;
};
