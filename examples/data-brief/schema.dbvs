// schema.dbvs — Data Brief Schema that validates .dbv and .dbvl files
// .dbvs files define expected structure, types, and constraints

schema Config {
    app: String required,
    version: String required,
    debug: Bool default(false),
    optimization: {
        budget: Int <: [0..1000000],
        simplify: Bool default(true),
        vectorize: Bool default(false)
    },
    backends: List<String> enum(["llvm", "webstack", "circt"]),
    threads: Int <: [1..64]
}