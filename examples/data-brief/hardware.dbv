// hardware.dbv — Hardware register map for MMIO
// Used by Embedded Brief (.ebv) for address binding

{
    "gpio": {
        "base": "0x4000",
        "width": 32,
        "registers": {
            "output": { "offset": 0, "access": "rw" },
            "input":  { "offset": 4, "access": "ro" },
            "dir":    { "offset": 8, "access": "rw" }
        }
    },
    "uart": {
        "base": "0x8000",
        "width": 8,
        "registers": {
            "data":  { "offset": 0, "access": "rw" },
            "status": { "offset": 1, "access": "ro" },
            "ctrl":  { "offset": 2, "access": "rw" }
        }
    }
}