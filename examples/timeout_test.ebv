// timeout-test.ebv — Embedded Briev with fetch timeout
// Demonstrates: sig declarations, union types, within-cycles timeout

sig fetch: () -> Int;

let res: Int = 0;
let fetched: Bool = false;

node fetch_data [fetched == false][fetched == true] {
    res = fetch() within 10 cycles;
    [res > 0] {
        term true;
    };
    [res <= 0] {
        term true;
    };
};
