// glue-macro.bv — Full GLUE bridge pattern
// 2026-07-22: Demonstrates export defn, frgn.
// Three-language bridge: Briev exports, Rust/Python/Node imports
// 2026-08-09 (Phase 12): the `meld Int -> Float` layout proof is removed
// (SPEC 19.6) — layouts adapt through GLUE descriptors + explicit casts.

// Foreign function: import from the target language
frgn print_number(n: Int) -> Bool from "lib/demo_glue.c";

// Exported function: available to foreign callers
export defn add_and_print(a: Int, b: Int) -> Int {
    let sum: Int = a + b;
    let _ = print_number(sum);
    term sum;
};

// Another export with meld-proven type compatibility
export defn compute_dot(x: List<Float>, y: List<Float>) -> Float {
    term compute_dot_loop(x, y, 0, 0.0);
};

defn compute_dot_loop(x: List<Float>, y: List<Float>, i: Int, acc: Float) -> Float {
    when i >= x.Count#() { term acc; };
    term compute_dot_loop(x, y, i + 1, acc + (x[i] * y[i]));
};

// The GLUE adapter macro (in glue/adapters/rust.bv) generates:
//   pub fn add_and_print(a: i64, b: i64) -> i64 { ... }
//   pub fn compute_dot(x: &[f64], y: &[f64]) -> f64 { ... }
