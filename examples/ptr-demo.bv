// ptr-demo.bv — Demonstrates & (address-of) and * (dereference) operators
//
// The & operator creates a typed pointer (Ptr<T> or PtrConst<T>) to any
// variable or state field. The * operator dereferences a pointer, reading
// the value it points to.
//
// peek uses a Guarded { ... term! ... } pattern so the swan song (print)
// is correctly hoisted by the codegen. See emit_ssa_main's post_hoist logic.

// State field for demonstration
let counter: Int = 0;

// Let bindings demonstrate PtrConst inference (read-only)
let dec: Int = 1;

// Transaction using & in LHS (mutable assignment)
// &counter creates Ptr<Int> since counter is a state field
rct txn increment [counter < 10][counter == 10] {
  counter = counter + dec;  // Write through pointer to state field
  term;
};

// Transaction demonstrating * dereference
// Uses a Guarded block to get proper swan-song hoisting
rct txn peek [counter > 0 && counter < 10][counter >= 10] {
  // &counter gives us a Ptr<Int>. counter reads the value.
  let counter_val = counter;
  [counter_val > 0] {  // guard ensures this only fires when there is a value
    term! -> Print#(counter_val);
  };
};
