// ─────────────────────────────────────────────────────────────
// fn-ptr-demo.bv — Function values via callable types (SPEC §9.2)
// 2026-08-23: migrated off removed .#Ptr projection onto native
// fn-as-value typing — identifiers naming functions type as their
// own signatures and flow into callable-typed parameters.
// ─────────────────────────────────────────────────────────────

defn cmp_int(a: Int, b: Int) -> Bool { term a == b; };
defn cmp_lt(a: Int, b: Int) -> Bool { term a < b; };

defn apply_cmp(f: (Int, Int) -> Bool, a: Int, b: Int) -> Bool {
    term f(a, b);
};

let i: Int = 0;

node demo [i < 1][i == 1] {
    let eq = apply_cmp(cmp_int, 5, 5);
    let lt = apply_cmp(cmp_lt, 3, 7);
    Print#(eq);
    Print#(lt);
    i = i + 1;
    term;
};
