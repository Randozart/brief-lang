// target-import: Board-level device constants via `import "target"`
//
// Demonstrates:
//   1. import "target" resolves to the board description
//   2. Flattened Int constants for peripheral base addresses
//   3. Flattened Int constants for individual register addresses
//   4. Contract-proven MMIO access using volatile_load#/volatile_store#
//
// Usage:
//   brief-compiler --board stm32f407 target-import.bv
//
// Without --board, defaults to "stm32f407".

import "std/types";
//
// The bridge flattens schema-typed board entries into individual constants:
//   uart1_base = 0x40011000  (peripheral base)
//   uart1_end  = 0x40011018  (base + size)
//   uart1_dr   = 0x40011000  (base + dr_offset)
//   uart1_sr   = 0x40011001  (base + sr_offset)
//   uart1_cr1  = 0x4001100C  (base + cr1_offset)
//   uart1_cr2  = 0x40011010  (base + cr2_offset)

import "target";

// UART register addresses (flattened from uart1 obj)
// uart1_dr   = 0x40011000  — Data register
// uart1_sr   = 0x40011001  — Status register
// uart1_cr1  = 0x4001100C  — Control register 1
// uart1_cr2  = 0x40011010  — Control register 2

defn uart_init() -> Bool
    [uart1_cr1 > 0]
    [uart1_cr1 < 0x50000000]
{
    // Enable UART by setting CR1.UE bit (bit 13)
    let cr1_val: Byte = volatile_load#(uart1_cr1 as Ptr<Byte>);
    term volatile_store#(uart1_cr1 as Ptr<Byte>, cr1_val | 0x20);
};

defn uart_send(c: Byte) -> Bool {
    // Wait for TX buffer empty (SR.TXE bit 7)
    let sr: Byte = volatile_load#(uart1_sr as Ptr<Byte>);
    while (sr & 0x80) == 0 {
        sr = volatile_load#(uart1_sr as Ptr<Byte>);
    };
    // Send the character
    term volatile_store#(uart1_dr as Ptr<Byte>, c);
};

defn uart_recv() -> Bool {
    // Wait for RX buffer not empty (SR.RXNE bit 5)
    let sr: Byte = volatile_load#(uart1_sr as Ptr<Byte>);
    while (sr & 0x20) == 0 {
        sr = volatile_load#(uart1_sr as Ptr<Byte>);
    };
    // Read and acknowledge data
    let _c: Byte = volatile_load#(uart1_dr as Ptr<Byte>);
    term true;
};

// GPIO: toggle pin via ODR register
// gpioa_odr = 0x40020014  (base + odr_offset)
defn gpio_toggle() -> Bool
    [gpioa_odr > 0]
    [gpioa_odr < 0x50000000]
{
    let val: Byte = volatile_load#(gpioa_odr as Ptr<Byte>);
    term volatile_store#(gpioa_odr as Ptr<Byte>, val ^ 0x01);
};
