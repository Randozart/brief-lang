// contract_verification — withdraw/deposit with provable bounds.
let balance: Int = 100;
let min_balance: Int = 10;

defn sufficient_funds(amount: Int) -> Bool {
  term balance >= amount;
};

txn withdraw [balance > min_balance]
  [balance >= min_balance]
{
  balance = balance - 50;
  term;
};

txn deposit [balance < 1000]
  [balance <= 1000]
{
  balance = balance + 25;
  term;
};
