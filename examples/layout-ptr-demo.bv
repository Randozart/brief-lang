// ─────────────────────────────────────────────────────────────
// layout-ptr-demo.bv — Demonstrates typed pointers with contracts
// 2026-08-23: migrated off removed PtrN/Ptr64 aliases and
// volatile_load#/volatile_store# onto Ptr<Bit<N>> + Load#/Store#.
// ─────────────────────────────────────────────────────────────

import "std/types";

let byte_ptr: Ptr<Bit<8>>  = 0x4000 as Ptr<Bit<8>>;
let word_ptr: Ptr<Bit<16>> = 0x4000 as Ptr<Bit<16>>;
let qword_ptr: Ptr<Bit<64>> = 0x4000 as Ptr<Bit<64>>;

defn read_byte(addr: Ptr<Bit<8>>) -> Int {
    term Load#(addr);
};

defn write_byte(addr: Ptr<Bit<8>>, val: Int) -> Bool {
    Store#(addr, val);
    term true;
};

defn addr_as_ptr(addr: Int) -> Ptr<Bit<8>> {
    term addr as Ptr<Bit<8>>;
};

// Contract-proven address arithmetic (SPEC §14.2: cast-based math)
defn addr_offset(base: Ptr<Bit<8>>, offset: Int) -> Int {
    term base as Int + offset;
};

let i: Int = 0;

node demo [i < 1][i == 1] {
    let addr = addr_offset(byte_ptr, 4);
    write_byte(addr as Ptr<Bit<8>>, 42);
    let val = read_byte(addr as Ptr<Bit<8>>);

    // Cast round-trip
    let raw = qword_ptr as Int;
    let back = raw as Ptr<Bit<64>>;

    endprogram Print#(val);
};
