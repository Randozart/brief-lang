// error-handling.bv — Result<T,E> from stdlib, modern enum syntax.
// 2026-08-23 (enum-construction plan): constructors are first-class
// expressions; matching is exhaustive `match` arms with payload bindings.

import { is_ok } from "std/result";

// Function returning Result
defn divide(a: Int, b: Int) -> Result<Int, String> {
    when b == 0 {
        term Err("division by zero");
    };
    term Ok(a / b);
};

// Pattern matching on Result with payload bindings
defn safe_divide(a: Int, b: Int) -> Int {
    let res = divide(a, b);
    term match res {
        Ok(val) => val,
        Err(msg) => 0 - 1,
    };
};

// Chaining with Result
defn parse_and_divide(input: Int) -> Result<Int, String> {
    when input == 0 {
        term Err("zero input");
    };
    term divide(input, 2);
};

let i: Int = 0;

node run [i < 3][i == 3] {
    when i == 0 {
        Print#(safe_divide(10, 2));
        i = i + 1;
        term;
    };
    when i == 1 {
        // Err path: safe_divide maps to -1.
        endprogram Print#(safe_divide(5, 0));
    };
    when i == 2 {
        // Ok(8/2) flows through the constructor + match machinery.
        let final = parse_and_divide(8);
        endprogram Print#(safe_divide(final, 1));
    };
};
