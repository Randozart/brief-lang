// Briev Compiler - Main Entry Point (Ouroboros Proof)
// Proof of self-hosting: Briev compiles a program that uses the Briev compiler library
// This file uses the Briev-written lexer to tokenize Briev source code

import compiler.token;
import compiler.ast;
import compiler.lexer;

// ===== COMPILER FUNCTIONS =====

defn count_tokens(source: String) -> Int [source != ""][term >= 0] {
    // Step 1: Tokenize using the Briev-written lexer
    let lex = new_lexer(source);
    let result = tokenize(lex);
    uni result(Ok(pair)) = {
        let (tokens, _state) = pair;
        term tokens.len();
    };
    uni result(Err(_e)) = {
        term 0;
    };
}

// ===== MAIN TRANSACTION =====

txn compile_main [source != ""][count >= 0] {
    let source: String = "let x: Int = 0;\n\n txn test [x > 0][x == @x] {\n   term;\n };";
    let count = count_tokens(source);
    term count;
};
