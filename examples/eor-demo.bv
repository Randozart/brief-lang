// ─────────────────────────────────────────────────────────────
// eor-demo.bv — Extract-Operate-Repack optimization
// 2026-08-23: migrated off removed `meld` declaration and the old
// Bits bit-range suffix onto plain type aliases via spec metadata.
// ─────────────────────────────────────────────────────────────

defn scale(val: Int, factor: Int) -> Int {
    // EOR pattern: the backend detects Cast(BinaryOp(Cast(a, Int),
    // Cast(b, Int)), Int) and emits a single mul i64.
    term (val * factor);
};

defn add_meters(a: Int, b: Int) -> Int {
    term (a + b);
};

let dist: Int = 100;
let i: Int = 0;

node demo [i < 1][i == 1] {
    let doubled: Int = scale(dist, 2);   // 200 — single mul i64
    let total: Int = add_meters(dist, doubled); // 300 — single add i64
    Print#(total);
    i = i + 1;
    term;
};
