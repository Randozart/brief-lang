// macro-demo.bv — $! macro system
// Demonstrates: $!macro, quote { }, @-interpolation, compile#(), error#(), gensym#()

// A simple $!macro that generates a getter function for a struct field
$!macro make_getter(name: String, field: String) {
    quote {
        defn @name(obj: Ptr<Byte>) -> Int {
            let ptr: Ptr<Byte> = obj + @field :> Offset;
            term ptr :> Load;
        };
    }
};

// Use the macro to generate getters
make_getter!("get_x", "x");
make_getter!("get_y", "y");

// A compile-time assert macro
$!macro assert_size(type_name: String, expected: Int) {
    let actual: Int = compile#("size_of(" + type_name + ")");
    [actual != expected] {
        error#("Expected " + type_name + " size " + int_to_str#(expected) + " but got " + int_to_str#(actual));
    };
};

// Compile-time check that Int is 8 bytes
assert_size!("Int", 8);

// A hygienic counter macro using gensym#
$!macro make_counter(name: String) {
    let count_var: String = gensym#("counter");
    quote {
        let @count_var: Int = 0;
        txn @name [@count_var < 100][@count_var == @@count_var + 1] {
            &@count_var = @count_var + 1;
            term;
        };
    }
};

make_counter!("tick");
make_counter!("tock");

// Warming: compile-time only intrinsics
$!macro compile_time_check() {
    warn#("This macro runs at compile time");
    compile#("3 + 4")  // returns 7 — purely compile-time
};

compile_time_check!();

defn main() -> Int {
    term compile#("40 + 2");
};