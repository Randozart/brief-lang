// view-directives.rbv — Advanced RBV view directives
// Demonstrates: b-style, b-class, b-when, b-show, b-each

let nums: Int[3];
let dark_mode: Bool = false;
let show_sidebar: Bool = true;
let bg_color: String = "#fff";

txn toggle_dark [dark_mode == false][dark_mode == true] {
    dark_mode = true;
    term;
};

txn toggle_sidebar [show_sidebar == true][show_sidebar == false] {
    show_sidebar = false;
    term;
};

txn cycle_color [bg_color == "#fff"][bg_color == "#333"] {
    bg_color = "#333";
    term;
};

<view>
<div>
    <!-- b-when: conditionally mount element (structurally mounts/unmounts) -->
    <div b-when="dark_mode" b-style="color: white">
        Dark mode active
    </div>

    <!-- b-show: show/hide (always rendered, CSS display toggle) -->
    <div b-show="show_sidebar">
        Sidebar content
    </div>

    <!-- b-style: dynamic inline styles (bounded field reference) -->
    <div b-style="background: bg_color">
        Dynamic background
    </div>

    <!-- b-class: dynamic CSS classes (bounded single-field expressions) -->
    <div b-class="{ 'active': dark_mode == true, 'highlight': dark_mode }">
        Conditional classes
    </div>

    <!-- b-each: iterate over a static vector -->
    <ul>
        <li b-each:item="nums" b-key="item" b-class="{ 'selected': item == 2 }">
            <span b-text="item">0</span>
        </li>
    </ul>
</div>
</view>

<style>
.active { font-weight: bold; }
.highlight { border: 2px solid gold; }
.selected { background: #667eea; color: white; }
li { padding: 8px; cursor: pointer; }
li:hover { background: #f0f0f0; }
</style>
