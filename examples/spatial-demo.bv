// ─────────────────────────────────────────────────────────────
// spatial-demo.bv — Spatial stdlib wrappers over block intrinsics
// 2026-08-23: migrated onto the Fill#/Copy# intrinsics via the
// std/spatial.bv wrappers, driven from a node. Compare/hash await
// their arcs (see BUGS.md sweep triage).
// ─────────────────────────────────────────────────────────────

import { block_copy, block_fill } from "std/spatial.bv";

let i: Int = 0;

node demo [i < 1][i == 1] {
    // Allocate and fill two buffers (Malloc# replaces __alloc#)
    let a: Ptr<Bit<8>> = Malloc#(8);
    let b: Ptr<Bit<8>> = Malloc#(8);

    let _filled = block_fill(a, 255, 8);
    let _copied = block_copy(b, a, 8);

    i = i + 1;
    term;
};
