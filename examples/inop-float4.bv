// ── Float4 SIMD Type Example ──────────────────────────────────
//
// Demonstrates Phase 7B operator→intrinsic declarations.
// Defines a 4-lane single-precision float vector with native
// LLVM SIMD support.

type Float4 <: Bits {
    Bytes <~ 16;
    Alignment <~ 16;
    LLVMType <~ ptr;
    Storage <~ Native;

    op Add(Float4) -> Float4 = my_fadd;
    op Sub(Float4) -> Float4 = my_fsub;
    op Mul(Float4) -> Float4 = my_fmul;
};

defn add_two(a: Float4, b: Float4) -> Float4 {
    term a + b;
};
