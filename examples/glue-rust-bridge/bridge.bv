// GLUE Rust Bridge — example Brief bridge file
//
// Inlines the minimal type definitions to avoid pulling in the stdlib
// OS runtime (no extern brief_rt.c dependency needed for scalar math).
// The resulting .ll is self-contained — only references LLVM builtins.
//
// Workflow:
//   brief build --no-stdlib --library bridge.bv --out .  # bridge.ll
//   cargo build                                            # build.rs llc + link

type Int <: Bits {
    bytes <~ 8;
    alignment <~ 8;
};

#export
defn add(a: Int, b: Int) -> Int {
    term a + b;
};

#export
defn multiply(a: Int, b: Int) -> Int {
    term a * b;
};
