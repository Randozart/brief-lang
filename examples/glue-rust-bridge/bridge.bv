// GLUE Rust Bridge — example Brief bridge file
//
// Inlines the minimal type definitions to avoid pulling in the prelude
// (no OS runtime — extern brief_rt.c not needed for scalar math).
// The resulting .ll is self-contained — only references LLVM builtins.
//
// Workflow:
//   brief build --disable-plugin prelude --library bridge.bv --out .  # bridge.ll
//   cargo build                                            # build.rs llc + link

type Int: #Int {
    !> maxbits: 64;
    !> alignment: 8;
};

obj CBuffer {
    ptr: Int;
    len: Int;
};

export defn add(a: Int, b: Int) -> Int {
    term a + b;
};

export defn multiply(a: Int, b: Int) -> Int {
    term a * b;
};

export defn first_len(buf: CBuffer) -> Int {
    term buf.ptr + buf.len;
};
