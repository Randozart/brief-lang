// node_bridge.bv — the Python <-> Node cross-language bridge.
// 2026-08-03 (plan 2026-08-03-glue-folders-node-bridge): Python and Node have
// no mature native binding between them. Briv's composite is their only
// common interface: both call save/read/bump (live, in-process) and exchange
// the composite String across process boundaries via the runtime's file I/O
// (persist/load) — the only transport both languages share is Briv itself.
//
// The CStr <-> String adaptation uses EXPLICIT protocol casts
// (cstr_to_briv / str_to_c from lib/glue/c.bv) — the meld implicit admission
// was removed (SPEC 19.6): foreign shapes adapt through explicit cast edges.

import "glue/c.bv";

// Runtime file I/O — the cross-process transport. `__read_file__` returns a
// bare nul-terminated buffer; `load` wraps it with cstr_to_briv (correctness
// first — never the fragile str_to_c heuristic). Note the frgn convention:
// `frgn <briv_name>(...) : <C_symbol>` — the first is the Briv name, `:` binds the C/runtime symbol.
frgn briv_read_file_raw(path: String) -> Int  : __read_file__ from "lib/runtime/briv_rt.c" fallback 0;
frgn briv_write_file(path: String, data: String) -> Int  : __write_file__ from "lib/runtime/briv_rt.c" fallback 0;

let saved: String = "";
let count: Int = 0;

export defn save(name: CStr) -> CStr {
    saved = cstr_to_briv(name as Int);
    term str_to_c(saved) as CStr;
};

export defn read() -> CStr {
    term str_to_c(saved) as CStr;
};

export defn bump(delta: Int) -> Int {
    count = count + delta;
    term count;
};

export defn persist(path: CStr) -> CStr {
    let w: Int = briv_write_file(cstr_to_briv(path as Int), saved);
    term str_to_c(saved) as CStr;
};

export defn load(path: CStr) -> CStr {
    let raw: Int = briv_read_file_raw(cstr_to_briv(path as Int));
    let s: String = cstr_to_briv(raw);
    saved = s;
    term str_to_c(saved) as CStr;
};
