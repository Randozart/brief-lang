// node_bridge.bv — the Python <-> Node cross-language bridge.
// 2026-08-03 (plan 2026-08-03-glue-folders-node-bridge): Python and Node have
// no mature native binding between them. Briev's composite is their only
// common interface: both call save/read/bump (live, in-process) and exchange
// the composite String across process boundaries via the runtime's file I/O
// (persist/load) — the only transport both languages share is Briev itself.
//
// The CStr <-> String adaptation uses EXPLICIT protocol casts
// (cstr_to_briev / str_to_c from lib/glue/c.bv) — the meld implicit admission
// was removed (SPEC 19.6): foreign shapes adapt through explicit cast edges.

import "glue/c.bv";

// Runtime file I/O — the cross-process transport. `__read_file__` returns a
// bare nul-terminated buffer; `load` wraps it with cstr_to_briev (correctness
// first — never the fragile str_to_c heuristic). Note the frgn convention:
// `frgn <briev_name>(...) : <C_symbol>` — the first is the Briev name, `:` binds the C/runtime symbol.
frgn briev_read_file_raw(path: String) -> Int  : __read_file__ from "lib/runtime/briev_rt.c";
frgn briev_write_file(path: String, data: String) -> Int  : __write_file__ from "lib/runtime/briev_rt.c";

let saved: String = "";
let count: Int = 0;

export defn save(name: CStr) -> CStr {
    saved = cstr_to_briev(name as Int);
    term str_to_c(saved) as CStr;
};

export defn read() -> CStr {
    term str_to_c(saved) as CStr;
};

export defn bump(delta: Int) -> Int {
    count = count + delta;
    term count;
};

export defn persist(path: CStr) -> CStr {
    let w: Int = briev_write_file(cstr_to_briev(path as Int), saved);
    term str_to_c(saved) as CStr;
};

export defn load(path: CStr) -> CStr {
    let raw: Int = briev_read_file_raw(cstr_to_briev(path as Int));
    let s: String = cstr_to_briev(raw);
    saved = s;
    term str_to_c(saved) as CStr;
};
