// bild-asm-target: Multi-architecture inline assembly via `asm target { }` in BILD
//
// Demonstrates:
//   1. asm target { } with arch-specific dispatch
//   2. Multiple arch arms with fallback default
//   3. Compound predicates: [arch("x86_64"), os("linux")]
//   4. Syscall-style interface with register constraints
//   5. `inop!` declaration with contracts and fallback expression

// Architecture-generic CPUID instruction
// Returns a processor feature bitmask
inop! cpuid() -> Int {
    %res = asm target {
        [arch("x86_64")]:
            "xor %%rcx, %%rcx; cpuid"
            : "={rax},{rax},{rbx},{rcx},{rdx}"
            : (i64 0);
        [arch("aarch64")]:
            "mrs %0, midr_el1"
            : "={x0}"
            : ();
        default:
            "ud2"
            : "={rax}"
            : ();
    };
    term %res;
} fallback 0;

// Architecture-generic read of a model-specific register
inop! read_msr(msr: Int) -> Int
    [msr >= 0][msr < 0x10000]
{
    %res = asm target {
        [arch("x86_64")]:
            "rdmsr"
            : "={rax},{rax},{rdx},{rcx}"
            : (i64 %msr);
        default:
            "ud2"
            : "={rax},{rax},{rdx}"
            : (i64 %msr);
    };
    term %res;
} fallback 0;

// Architecture-generic breakpoint / trap instruction
inop! debug_break() -> Int {
    %res = asm target {
        [arch("x86_64")]:
            "int3"
            : "={rax}"
            : ();
        [arch("aarch64")]:
            "brk #0"
            : "={x0}"
            : ();
        [arch("riscv64")]:
            "ebreak"
            : "={a0}"
            : ();
        default:
            "ud2"
            : "={rax}"
            : ();
    };
    term %res;
} fallback 0;

// Architecture-generic memory barrier
inop! memory_barrier() -> Int {
    %res = asm target {
        [arch("x86_64")]:
            "mfence"
            : "={rax}"
            : ();
        [arch("aarch64")]:
            "dmb sy"
            : "={x0}"
            : ();
        [arch("riscv64")]:
            "fence iorw, iorw"
            : "={a0}"
            : ();
        default:
            "ud2"
            : "={rax}"
            : ();
    };
    term %res;
} fallback 0;

// Compound predicate: x86_64 on Linux only
inop! fast_syscall(nr: Int, a1: Int, a2: Int, a3: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64"), os("linux")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi},{rdx}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3);
        default:
            "ud2"
            : "={rax},{rax},{rdi},{rsi},{rdx}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3);
    };
    term %res;
} fallback -1;

// Usage: call these in a defn
defn demo_asm() -> Int {
    let features: Int = cpuid();
    let break_val: Int = debug_break();
    let barrier: Int = memory_barrier();
    term features;
};
