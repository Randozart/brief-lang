// Pure Brief FFI Test
// Intrinsic calls (println#, sqrt#, sin#, pow#) replace old frgn
// counterparts. GLUE-style frgn declarations for string ops use
// the FFI registry directly without TOML bindings.
//
// Intrinsics provide native LLVM codegen — no binding files
// needed for operations the compiler already knows about.

// GLUE-style FFI declarations (no TOML bindings)
frgn string_length(s: String) -> Result<Int, StringError> ;
frgn string_concat(a: String, b: String) -> Result<String, StringError> ;

// Test 1: println via intrinsic
txn test1 [true][term == void] {
    term println#("Hello from Brief FFI!");
};

// Test 2: sqrt via intrinsic  
txn test2 [sqrt#(16.0) == 4.0][term == 4.0] {
    term sqrt#(16.0);
};

// Test 3: sin via intrinsic
txn test3 [sin#(0.0) == 0.0][term == 0.0] {
    term sin#(0.0);
};

// Test 4: pow via intrinsic
txn test4 [pow#(2.0, 3.0) == 8.0][term == 8.0] {
    term pow#(2.0, 3.0);
};

// Test 5: string length — GLUE-style FFI
txn test5 [string_length("hello") == 5][result == 5]] {
    term string_length("hello");
};

// Test 6: string concat — GLUE-style FFI
txn test6 [string_concat("hello", "world") == "helloworld"][result == "helloworld"]] {
    term string_concat("hello", "world");
};

// Run all tests
txn run_all [true][all_passed] {
    let t1 = test1();
    let t2 = test2();
    let t3 = test3();
    let t4 = test4();
    let t5 = test5();
    let t6 = test6();
    
    let all_passed = t1 && t2 && t3 && t4 && t5 && t6;
    
    [all_passed] {
        println#("ALL FFI TESTS PASSED!");
    };
    
    [~all_passed] {
        println#("SOME TESTS FAILED!");
    };
    
    term all_passed;
};