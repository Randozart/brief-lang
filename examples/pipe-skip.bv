// ── Pipe Chain Dot-Skip Example ─────────────────────────────────────
//
// Demonstrates .|> (skip=1) and .2|> (skip=2) operators.
// |> reads the immediately preceding result.
// .|> reads from 1 position back (.1|> is equivalent).
// .2|> reads from 2 positions back.
//
// Pipeline: 3 |> square() |> add_one() .2|> double()
//
//   Step 1 (|>):     square(3)                     = 9
//   Step 2 (|>):     add_one(9)                    = 10
//   Step 3 (.2|>):   double(initial)               = double(3) = 6
//                     (.2|> skips 2 commands back,
//                      reads from index 2-2 = 0)
//
// Run: briv-compiler build --llvm examples/pipe-skip.bv

defn square(x: Int) -> Int { term x * x; };
defn add_one(x: Int) -> Int { term x + 1; };
defn double(x: Int) -> Int { term x * 2; };

txn main() -> Bool {
    let result: Int = 3 |> square() |> add_one() .2|> double();
    term! -> Print#(result);   // prints 6
};
