# ============================================
*.bc.json
test-*.js
test-*.js.map
test-*.d.ts
test-*.d.ts.map
test-*.d.ts.map
generated/
landing-build/
page-build/
*_build/
examples/cobol/output/

# ============================================
# NODE/JAVASCRIPT (legacy tooling)
# ============================================
node_modules/
package-lock.json
package.json
!syntax-highlighter/package.json
!syntax-highlighter/*.vsix
tsconfig.json
dist/

# ============================================
# IMAGES & LOGOS
# ============================================
*.gif

# ============================================
# EDITOR & IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
