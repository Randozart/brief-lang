                            let ret = unsafe { libc::gethostname(buf.as_mut_ptr() as *mut libc::c_char, 256) };
                            if ret == 0 {
                                let name = unsafe { std::ffi::CStr::from_ptr(buf.as_ptr() as *const libc::c_char).to_string_lossy().to_string() };
                                Ok(Value::Bits(name.into_bytes()))
