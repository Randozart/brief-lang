                            let msg = unsafe { std::ffi::CStr::from_ptr(buf.as_ptr() as *const libc::c_char).to_string_lossy().to_string() };
                            if ret == 0 { Ok(Value::Bits(msg.into_bytes())) } else { Ok(Value::Bits(format!("[Unknown error {}]", errnum).into_bytes())) }
