                    // ===== D14: Debugging (2026-06-19) =====
                    Intrinsic::Abort => {
                        #[cfg(unix)]
                        { unsafe { libc::abort(); } }
                        #[cfg(not(unix))]
                        { std::process::abort(); }
                        // unreachable
                        #[allow(unreachable_code)]
                        Ok(Value::Void)
