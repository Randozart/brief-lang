// GLUE Rust Adapter Macro
//
// This is a Brief `$!macro` that generates a Rust crate wrapping a Brief bridge.
// It is invoked during `brief export bridge.bv rust` and uses emit_file#() to
// write the Cargo.toml, build.rs, src/lib.rs, and src/ffi.rs files.
//
// Architecture: This macro is pure Brief code, not a Rust template engine.
// When Brief self-hosts, this file survives as-is — no rewrite needed.
// The bridged library (.a) is linked statically via Rust's build.rs,
// and the wrapper presents each #export as a safe Rust function.
//
// Arguments (from export pipeline):
//   bridge_name: String — name of the bridge
//   exports_json: String — JSON array of ExportDecl
//   frgns_json: String — JSON array of FrgnDecl
//   melds_json: String — JSON array of MeldDecl (unused for now)

$!macro generate_rust_wrapper { bridge_name, exports_json, frgns_json, melds_json } -> String {

    // ===== Generate Cargo.toml =====
    let cargo_toml: String = "";
    &cargo_toml = cargo_toml + "[package]\n";
    &cargo_toml = cargo_toml + "name = \"" + bridge_name + "-bridge\"\n";
    &cargo_toml = cargo_toml + "version = \"0.1.0\"\n";
    &cargo_toml = cargo_toml + "edition = \"2021\"\n";
    &cargo_toml = cargo_toml + "\n";
    &cargo_toml = cargo_toml + "[lib]\n";
    &cargo_toml = cargo_toml + "crate-type = [\"lib\", \"cdylib\"]\n";
    &cargo_toml = cargo_toml + "\n";
    &cargo_toml = cargo_toml + "[dependencies]\n";
    // The build.rs tells cargo to link the bridge .a, so no external deps needed

    // ===== Generate build.rs =====
    let build_rs: String = "";
    &build_rs = build_rs + "// Auto-generated by brief export " + bridge_name + " rust\n";
    &build_rs = build_rs + "fn main() {\n";
    &build_rs = build_rs + "    println!(\"cargo::rustc-link-lib=static=\" + bridge_name + \"\");\n";
    &build_rs = build_rs + "    println!(\"cargo::rustc-link-search=.\");\n";
    &build_rs = build_rs + "}\n";

    // ===== Generate src/lib.rs =====
    let lib_rs: String = "";
    &lib_rs = lib_rs + "// Auto-generated by brief export " + bridge_name + " rust\n";
    &lib_rs = lib_rs + "// Safe Rust wrappers for the " + bridge_name + " bridge.\n";
    &lib_rs = lib_rs + "// The FFI declarations live in ffi.rs — users should NOT import that directly.\n";
    &lib_rs = lib_rs + "\n";
    &lib_rs = lib_rs + "mod ffi;\n";
    &lib_rs = lib_rs + "\n";

    // ===== Generate src/ffi.rs =====
    let ffi_rs: String = "";
    &ffi_rs = ffi_rs + "// Auto-generated by brief export " + bridge_name + " rust\n";
    &ffi_rs = ffi_rs + "// Raw FFI declarations. Users should use lib.rs wrappers instead.\n";
    &ffi_rs = ffi_rs + "#[link(name = \"" + bridge_name + "\")]\n";
    &ffi_rs = ffi_rs + "extern \"C\" {\n";
    &ffi_rs = ffi_rs + "    pub fn __brief_init_state() -> i64;\n";
    &ffi_rs = ffi_rs + "}\n";

    // Emit files via emit_file# intrinsic
    error#("emit_file test: about to write Cargo.toml");
    let _: Void = emit_file#("Cargo.toml", cargo_toml);
    let _: Void = emit_file#("build.rs", build_rs);
    let _: Void = emit_file#("src/lib.rs", lib_rs);
    let _: Void = emit_file#("src/ffi.rs", ffi_rs);

    term "ok";
};
