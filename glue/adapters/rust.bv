// GLUE Rust Adapter Macro
//
// Generates a Rust crate wrapping a Brief bridge. Invoked during
// `brief export bridge.bv rust`. Uses emit_file#() to write
// Cargo.toml, build.rs, src/lib.rs, and src/ffi.rs.
//
// Architecture: Pure Brief macro — survives self-hosting unchanged.

macro generate_rust_wrapper (bridge_name: String, exports_dbvl: String, frgns_dbvl: String, melds_dbvl: String) -> String {
    let cargo_toml = "[package]\nname = \"" + bridge_name + "-bridge\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"lib\", \"cdylib\"]\n\n[dependencies]\n";
    let build_rs = "fn main() {\n    println!(\"cargo::rustc-link-lib=static=" + bridge_name + "\");\n    println!(\"cargo::rustc-link-search=.\");\n}\n";
    let ffi_rs = "#[link(name = \"" + bridge_name + "\")]\nextern \"C\" {\n    pub fn __brief_init_state() -> i64;\n}\n";
    let lib_rs = "// Brief bridge: " + bridge_name + "\nmod ffi;\n";

    emit_file#("Cargo.toml", cargo_toml);
    emit_file#("build.rs", build_rs);
    emit_file#("src/lib.rs", lib_rs);
    emit_file#("src/ffi.rs", ffi_rs);

    term "ok";
};
