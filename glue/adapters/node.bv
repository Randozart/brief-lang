// GLUE Node.js Adapter Macro
//
// Generates a Node.js package wrapping a Brief bridge.
// Invoked during `brief export bridge.bv node`. Uses emit_file#()
// to write package.json, index.mjs, and type definitions.
//
// Architecture: Generates an ES module that loads the bridge via
// child_process as a runtime subprocess. The bridge binary communicates
// over stdin/stdout JSON-RPC. This avoids requiring N-API or node-gyp.
// Once WASM output is stable, a WebAssembly.instantiate path can be added.

macro generate_node_wrapper (bridge_name: String, exports_dbvl: String, frgns_dbvl: String, melds_dbvl: String) -> String {
    let package_json = "{\n" +
        "  \"name\": \"" + bridge_name + "-bridge\",\n" +
        "  \"version\": \"0.1.0\",\n" +
        "  \"type\": \"module\",\n" +
        "  \"main\": \"index.mjs\",\n" +
        "  \"types\": \"index.d.ts\"\n" +
        "}\n";

    let index_mjs = "import { spawn } from 'child_process';\n" +
        "import { createRequire } from 'module';\n" +
        "import { fileURLToPath } from 'url';\n" +
        "import { dirname, join } from 'path';\n\n" +
        "const __filename = fileURLToPath(import.meta.url);\n" +
        "const __dirname = dirname(__filename);\n\n" +
        "let _bridge = null;\n\n" +
        "function getBridge() {\n" +
        "  if (!_bridge) {\n" +
        "    const binaryPath = join(__dirname, '" + bridge_name + "');\n" +
        "    _bridge = spawn(binaryPath, [], { stdio: ['pipe', 'pipe', 'inherit'] });\n" +
        "  }\n" +
        "  return _bridge;\n" +
        "}\n\n" +
        "export function call(method, args = []) {\n" +
        "  return new Promise((resolve, reject) => {\n" +
        "    const bridge = getBridge();\n" +
        "    const req = JSON.stringify({ method, args }) + '\\n';\n" +
        "    bridge.stdin.write(req);\n" +
        "    bridge.stdout.once('data', (data) => {\n" +
        "      try { resolve(JSON.parse(data.toString())); }\n" +
        "      catch (e) { reject(e); }\n" +
        "    });\n" +
        "  });\n" +
        "}\n\n" +
        "export default { call };\n";

    let index_dts = "// GLUE bridge: " + bridge_name + "\n" +
        "export function call(method: string, args?: any[]): Promise<any>;\n" +
        "declare const _default: { call: typeof call };\n" +
        "export default _default;\n";

    emit_file#("package.json", package_json);
    emit_file#("index.mjs", index_mjs);
    emit_file#("index.d.ts", index_dts);

    term "ok";
};
