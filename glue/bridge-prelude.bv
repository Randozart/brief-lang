// GLUE Bridge Prelude — minimal type universe for bridge files
//
// Defines the core types that bridge files need without pulling in the
// full stdlib OS prelude (which adds syscall runtime dependencies).
// Use `--no-stdlib` + import "glue/bridge-prelude.bv" to avoid
// pulling in brief_rt.c dependencies.
//
// Usage:
//   brief build --no-stdlib --library bridge.bv --out .

type Int <: Bits {
    bytes <~ 8;
    alignment <~ 8;
};

type Float <: Bits {
    bytes <~ 4;
    alignment <~ 4;
};

type Bool <: Bits {
    bytes <~ 1;
    alignment <~ 1;
};

type Char <: Bits {
    bytes <~ 4;
    alignment <~ 4;
};
