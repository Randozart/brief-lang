// GLUE Bridge Prelude — minimal type universe for bridge files
//
// Defines the core types that bridge files need without pulling in the
// full prelude plugin (which adds OS runtime dependencies).
// Use `--disable-plugin prelude` + import "glue/bridge-prelude.bv" to avoid
// pulling in brief_rt.c dependencies.
//
// Usage:
//   brief build --disable-plugin prelude --library bridge.bv --out .

type Int <: Bits {
    maxbits <~ 64;
    alignment <~ 8;
};

type Float <: Bits {
    maxbits <~ 32;
    alignment <~ 4;
};

type Bool <: Bits {
    maxbits <~ 8;
    alignment <~ 1;
};

type Char <: Bits {
    maxbits <~ 32;
    alignment <~ 4;
};
