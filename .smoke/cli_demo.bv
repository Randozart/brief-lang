// Phase 3 CLI argv capture demo: entry_cmd() reads the subcommand, arg_present
// checks a flag.
import { entry_cmd, arg_present } from "std/cli.bv";

let tick: Int = 0;
node report [tick < 1][tick == 1] {
    let cmd: String = entry_cmd();
    let has_v: Bool = arg_present("--verbose");
    let e1: Int = (cmd == "build") as Int;
    let e2: Int = (has_v) as Int;
    println!("cmd==build: {}", e1);
    println!("has_verbose: {}", e2);
    tick = 1;
    term;
};
