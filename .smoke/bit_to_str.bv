// B2: #Bit → #String is the encoding door — wraps raw bytes as UTF8.
let s: String = "hello";
let tick: Int = 0;
node report [tick < 1][tick == 1] {
    let b: #Bit = s as #Bit;          // content view: buffer address
    let r: String = b as String;      // encoding door: UTF8 wrap
    println!("{}", r);
    tick = 1;
    term;
};
