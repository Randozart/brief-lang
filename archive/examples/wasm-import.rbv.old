// wasm-import.rbv — (wasm) import syntax for compute-heavy Brief sub-programs
// The `(wasm)` annotation tells the compiler to compile the imported .bv to
// a WASM sidecar module and auto-generate TypeScript wrapper functions.
//
// The imported file runs as native WASM (via LLVM wasm32 target). All standard
// intrinsics (print_int#, put_char#, etc.) resolve via the env import stubs
// generated in the TS output.
//
// Custom `frgn from "c"` in the imported .bv is a compile-time error — WASM
// modules can only use built-in intrinsics and pure Brief logic.
//
// Other import targets: (circt) for hardware compilation, (javascript) for
// inline JS/TS functions, (native) for default (no prefix needed).
//
// Compilation:
//   brief build wasm-import.rbv   → emits wasm-import.ts, wasm-import.js, wasm-import.html
//   The physics.wasm sidecar is compiled and embedded as a Uint8Array
//   in the .ts file, instantiated via WebAssembly.instantiate() at runtime.
//
// The embedded WASM module's exports are accessible via wrapper functions:
//   await init_physics_wasm();  // returns WebAssembly.Instance
//   instance.exports.simulate(data, count);  // call exported functions

(wasm) import physics from "physics.bv" as wasmPhysics;

state result: Float = 0.0;
state data: List<Float> = [];
state count: Int = 0;

b-text: "Computed: {result}";

node tick [count > 0][tick_count == @tick_count + 1] {
    result = wasmPhysics.simulate(data :> Ptr, count);
    term;
};
