// bridge/pp-types.bv — GLUE bridge for Type pretty-printer
// 2026-07-22: Phase 8 — Export Brief pretty-printer to Rust compiler.
//
// The round-trip test helpers (brief_test_*) take/return Int (C string
// pointers) so Rust can pass null-terminated strings without needing
// native Brief string construction on the Rust side. Conversion between
// C strings and Brief strings happens via brief_rt.c runtime functions.

import "std/types.bv";
import "std/string.bv";
import "pp/types.bv";
import "pp/exprs.bv";

// ── Runtime helpers ───────────────────────────────────────────────────
// 2026-07-22: C string ↔ Brief string conversion for round-trip testing.
// brief_rt.c already provides brief_str_to_c. We add brief_cstr_to_brief
// so Rust can pass C string pointers as Int and receive C string pointers
// back.

frgn brief_cstr_to_brief(ptr: Int) -> String as cstr_to_brief from "lib/runtime/brief_rt.c" fallback "";
frgn brief_str_to_c(handle: String) -> Int as str_to_c from "lib/runtime/brief_rt.c" fallback 0;
frgn brief_free_brief_str(handle: Int) -> Void as free_brief_str from "lib/runtime/brief_rt.c" fallback;

// ── Exported pretty-printer functions ─────────────────────────────────

export
defn brief_pp_type_bits(n: String) -> String {
    term pp_type_bits(n);
};

export
defn brief_pp_type_void() -> String {
    term pp_type_void();
};

export
defn brief_pp_type_custom(name: String) -> String {
    term pp_type_custom(name);
};

export
defn brief_pp_type_generic(name: String, args: String) -> String {
    term pp_type_generic(name, args);
};

export
defn brief_pp_type_applied(name: String, args: String) -> String {
    term pp_type_applied(name, args);
};

export
defn brief_pp_type_union(types: String) -> String {
    term pp_type_union(types);
};

export
defn brief_pp_type_tuple(types: String) -> String {
    term pp_type_tuple(types);
};

export
defn brief_pp_type_typevar(name: String) -> String {
    term pp_type_typevar(name);
};

export
defn brief_pp_type_ptr(inner: String) -> String {
    term pp_type_ptr(inner);
};

export
defn brief_pp_type_ptr_const(inner: String) -> String {
    term pp_type_ptr_const(inner);
};

export
defn brief_pp_type_function(params: String, ret: String) -> String {
    term pp_type_function(params, ret);
};

export
defn brief_pp_type_width(n: String) -> String {
    term pp_type_width(n);
};

export
defn brief_pp_type_vector(ty: String, dims: String) -> String {
    term pp_type_vector(ty, dims);
};

export
defn brief_pp_type_constrained(ty: String, range: String) -> String {
    term pp_type_constrained(ty, range);
};

export
defn brief_pp_type_layout_ptr(c: String) -> String {
    term pp_type_layout_ptr(c);
};

export
defn brief_pp_binop(kind: String) -> String {
    term pp_binop(kind);
};

export
defn brief_pp_unary_op(kind: String) -> String {
    term pp_unary_op(kind);
};

// ── Round-trip test wrappers (Int → Int, C string in/out) ─────────────
// 2026-07-22: Take C string pointers as Int, convert to Brief strings,
// call the pp function, convert back to C string pointer, return as Int.
// This lets Rust call pp functions without constructing Brief strings.

export
defn brief_test_cstr_roundtrip(input_ptr: Int) -> Int {
    let s: String = cstr_to_brief(input_ptr);
    term str_to_c(s);
};

export
defn brief_test_custom_echo(input_ptr: Int) -> Int {
    let s: String = cstr_to_brief(input_ptr);
    let r: String = pp_type_custom(s);
    term str_to_c(r);
};

export
defn brief_test_bits_static() -> Int {
    let r: String = "Bits(42): test";
    term str_to_c(r);
};

export
defn brief_test_type_bits(input_ptr: Int) -> Int {
    let s: String = cstr_to_brief(input_ptr);
    let r: String = pp_type_bits(s);
    term str_to_c(r);
};

export
defn brief_test_type_void() -> Int {
    let r: String = pp_type_void();
    term str_to_c(r);
};

export
defn brief_test_binop(kind_ptr: Int) -> Int {
    let s: String = cstr_to_brief(kind_ptr);
    let r: String = pp_binop(s);
    term str_to_c(r);
};

export
defn brief_test_unary_op(kind_ptr: Int) -> Int {
    let s: String = cstr_to_brief(kind_ptr);
    let r: String = pp_unary_op(s);
    term str_to_c(r);
};
