// 2026-07-26: Tamer entry point — DAG-based buffer sizing, no Alloc#.

import "vm.bv";
import "analyze.bv";

export defn tame(lair_data: Ptr<Int>, lair_len: Int,
                 beastpack_data: Ptr<Int>, beastpack_len: Int) -> Int
{
    let word0 = *(lair_data + 0);
    let magic = word0 & 0xFFFFFFFF;
    when magic != 0x5249414C { term 101; };

    let w4 = *(lair_data + 4);
    let fn_off = w4;
    let w5 = *(lair_data + 5);
    let fn_size = w5;
    let w6 = *(lair_data + 6);
    let bc_off = w6;
    let w7 = *(lair_data + 7);
    let bc_len = w7;
    let fn_count = fn_size / 20;
    let bc_data = lair_data + bc_off;
    let fn_table = lair_data + fn_off;

    when bc_off + bc_len > lair_len { term 103; };
    when fn_off + fn_size > lair_len { term 104; };
    when fn_count == 0 { term 105; };

    // Analyze bytecode to compute minimum buffer sizes
    let (stack_slots, locals_slots, frames_max) = compute_buffer_sizes(
        fn_table, fn_count, bc_data, bc_len);

    // Contract: analysis result must not exceed fixed buffer limits
    [stack_slots <= 1024][stack_slots >= 0];
    [locals_slots <= 4096][locals_slots >= 0];
    [frames_max <= 256][frames_max > 0];

    // Struct-based buffers — proven sufficient by DAG analysis
    let stack: VMStack;
    let locals: VMLocals;
    let frames: VMFrames;

    let _result = vm_loop(
        &stack, &locals, &frames,
        bc_data, bc_len, fn_table, fn_count,
        0, 0, 1);

    term 0;
};
