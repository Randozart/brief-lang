// 2026-08-23 (Plan 1 HCALL slice): the tamer's interpreter step — the ONLY
// export. Architecture after the ABI findings below: C OWNS memory and
// tables (malloc, host-table parse); Briev is a pure fetch-decode-execute
// function. The earlier tame()-owns-everything design failed because state
// writes from defn bodies don't round-trip through the exported %state view
// (accessors read zeros) — see BUGS.md convergent-txn entry.
//
// import chain: vm.bv (interpreter core + HostTable) ← loader.bv (read_*).

import "vm.bv";

// Install-time host services, backed by lib/runtime/briev_rt.c.
frgn BrievHostPrintInt(v: Int) -> Int : briev_host_print_int from "lib/runtime/briev_rt.c";
frgn BrievHostFail(id: Int, a: Int) -> Int : briev_host_fail from "lib/runtime/briev_rt.c";

// Single fetch-decode-execute step for the C driver loop. Returns the next
// pc, or -1 when the program halted (pc out of bounds / RET / TRAP).
export defn step(stack_ptr: Ptr<VMStack>, locals_ptr: Ptr<VMLocals>,
                 frames_ptr: Ptr<VMFrames>,
                 lair_data: Ptr<Int>, bc_end: Int,
                 fn_table: Ptr<Int>, foff: Int, fn_count: Int,
                 pc: Int) -> Int
{
    when pc < 0 || pc >= bc_end { term -1; };
    let op = read_u8(lair_data, pc);
    term exec_op(stack_ptr, locals_ptr, frames_ptr,
                 lair_data, fn_table, foff, fn_count,
                 op, pc, 0);
};
