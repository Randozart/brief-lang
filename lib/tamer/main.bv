// 2026-07-26: Tamer entry point — DAG-based buffer sizing, no Alloc#.

import "vm.bv";
import "analyze.bv";

export defn tame(lair_data: Ptr<Int>, lair_len: Int,
                 beastpack_data: Ptr<Int>, beastpack_len: Int) -> Int
{
    let word0 = *(lair_data + 0);
    let magic = word0 & 0xFFFFFFFF;
    when magic != 0x5249414C { term 101; };

    let w4 = *(lair_data + 4);
    let fn_off = w4;
    let w5 = *(lair_data + 5);
    let fn_size = w5;
    let w6 = *(lair_data + 6);
    let bc_off = w6;
    let w7 = *(lair_data + 7);
    let bc_len = w7;
    let fn_count = fn_size / 20;
    let bc_data = lair_data + bc_off;
    let fn_table = lair_data + fn_off;

    when bc_off + bc_len > lair_len { term 103; };
    when fn_off + fn_size > lair_len { term 104; };
    when fn_count == 0 { term 105; };

    // Single-return buffer sizing (VM backend doesn't support multi-return)
    let stack_slots = compute_stack_slots(fn_table, fn_count, bc_data, bc_len);
    let locals_slots = compute_locals_slots(fn_table, fn_count, bc_data, bc_len);
    let frames_max = compute_frames_max(fn_table, fn_count, bc_data, bc_len);

    term 0;
};
