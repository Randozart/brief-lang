// ── LLVM IR Emission (via Host FFI) ────────────────────────────────
// 2026-07-26: Host functions registered in tamer/main.c.
//   3 = host_llvm_emit(ptr_to_text) — append IR text to buffer
//   4 = host_llvm_flush(ptr_to_output_path) — write buffer to .ll file
//   5 = host_invoke_clang(ptr_to_argv) — fork+exec clang

// Host function declarations — these become HCALL instructions
frgn emit_ir(text: Int) -> Int : host_llvm_emit from "host";
frgn flush_ir(path: Int) -> Int : host_llvm_flush from "host";
frgn invoke_clang(argv: Int) -> Int : host_invoke_clang from "host";

export defn emit_ir_text(text: Ptr<Int>) -> Int {
    term emit_ir(text as Int);
};

export defn flush_ir_to_file(path: Ptr<Int>) -> Int {
    term flush_ir(path as Int);
};

export defn compile_with_clang(argv: Ptr<Int>) -> Int {
    term invoke_clang(argv as Int);
};
