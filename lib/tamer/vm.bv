// 2026-07-26: Briev VM interpreter — struct array buffers.
// Memory by Proof: all buffer bounds proven by contract preconditions.
// No Alloc#, no flat pointer arithmetic.

import "loader.bv";

// ── Struct definitions ────────────────────────────────────────────────────

// 2026-08-23 (Plan 1 HCALL slice): host-service table parsed from the
// .lair host section. Ids are the canonical ones from the compiler
// (src/backend/vm/mod.rs): Print#=0, Log#=1; unknown services carry ids
// >= 1000 and are rejected loudly by BrievHostFail.
frgn BrievHostPrintInt(v: Int) -> Int : briev_host_print_int from "lib/runtime/briev_rt.c";
frgn BrievHostArity(id: Int) -> Int : briev_host_arity_of from "lib/runtime/briev_rt.c";
struct HostTable { ids: Int[64]; arities: Int[64]; count: Int; };
const HOST_ID_PRINT_INT:   Int = 0;
const HOST_ID_LOG_INT:     Int = 1;
const HOST_ID_UNKNOWN_MIN: Int = 1000;

struct VMStack { data: Int[1024]; len: Int; };
struct VMLocals { data: Int[4096]; len: Int; };
struct VMFrames { data: Frame[256]; count: Int; };
struct Frame { locals_base: Int; local_count: Int; return_pc: Int; };
struct HCallArgs { a0: Int; a1: Int; a2: Int; a3: Int; a4: Int; };

// ── Opcodes ────────────────────────────────────────────────────────────────

const OP_NOP: Int = 0x00;
const OP_DROP: Int = 0x01;
const OP_DUP: Int = 0x02;
const OP_SWAP: Int = 0x03;
const OP_ADD: Int = 0x06;
const OP_SUB: Int = 0x07;
const OP_MUL: Int = 0x08;
const OP_AND: Int = 0x0B;
const OP_OR: Int = 0x0C;
const OP_XOR: Int = 0x0D;
const OP_NOT: Int = 0x0E;
const OP_SHL: Int = 0x0F;
const OP_SHR_S: Int = 0x10;
const OP_EQ: Int = 0x11;
const OP_BNOT: Int = 0x1C;
const OP_LOAD: Int = 0x17;
const OP_STORE: Int = 0x18;
const OP_RET: Int = 0x19;
const OP_TRAP: Int = 0x1B;
const OP_PUSH_I8: Int = 0x30;
const OP_LOAD_LOCAL: Int = 0x31;
const OP_STORE_LOCAL: Int = 0x32;
const OP_PUSH_FRAME: Int = 0x33;
const OP_POP_FRAME: Int = 0x34;
const OP_PUSH_I16: Int = 0x50;
const OP_JMP: Int = 0x51;
const OP_JZ: Int = 0x52;
const OP_JNZ: Int = 0x53;
const OP_CALL: Int = 0x54;
const OP_PUSH_I32: Int = 0x70;
const OP_HCALL: Int = 0x71;
const OP_PUSH_I64: Int = 0x90;

// ── Execution loop ───────────────────────────────────────────────────────
// Callable txn: loops while running != 0. Entry function is fn_idx=0.

txn vm_loop(stack: Ptr<VMStack>, locals: Ptr<VMLocals>,
            frames: Ptr<VMFrames>,
            bc_data: Ptr<Int>, bc_end: Int,
            fn_table: Ptr<Int>, foff: Int, fn_count: Int,
            ht: Ptr<HostTable>,
            pc: Int, saved_locals_base: Int,
            running: Int)
    [pc >= 0 && pc < bc_end && running != 0]
    [running == 0] -> Int
{
    let op = read_u8(bc_data, pc);
    let new_pc = exec_op(
        stack, locals, frames,
        bc_data, fn_table, foff, fn_count,
        op, pc, saved_locals_base);

    when new_pc < 0 { running = 0; };
    when new_pc >= 0 && new_pc < bc_end { pc = new_pc; };
    term 0;
};

// ── Opcode dispatch ──────────────────────────────────────────────────────
// Each arm reads/writes struct fields through Ptr<VMStack>, Ptr<VMLocals>,
// Ptr<VMFrames>. No flat pointer arithmetic.

// 2026-08-23: a DEFN, not a txn — opcode dispatch is a pure function;
// as a txn its convergent loop spun forever when called directly (the
// pre-condition never changes within one call).
defn exec_op(stack: Ptr<VMStack>, locals: Ptr<VMLocals>,
            frames: Ptr<VMFrames>,
            bc: Ptr<Int>, ft: Ptr<Int>, foff: Int, fnc: Int,
            op: Int, pc: Int, sll: Int) -> Int
{
    let sl = (*stack).len;
    match op {
        0x00 => { // nop
            term pc + 1;
        };

        0x01 => { // drop
            when sl > 0 { (*stack).len = sl - 1; };
            term pc + 1;
        };

        0x02 => { // dup
            when sl > 0 {
                (*stack).data[sl] = (*stack).data[sl - 1];
                (*stack).len = sl + 1;
            };
            term pc + 1;
        };

        0x03 => { // swap
            when sl >= 2 {
                let a = (*stack).data[sl - 1];
                let b = (*stack).data[sl - 2];
                (*stack).data[sl - 2] = a;
                (*stack).data[sl - 1] = b;
            };
            term pc + 1;
        };

        0x06 => { // add
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] + (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x07 => { // sub
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] - (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x08 => { // mul
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] * (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x0B => { // and
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] & (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x0C => { // or
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] | (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x0D => { // xor
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] ^ (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x0E => { // not (logical NOT)
            when sl >= 1 {
                when (*stack).data[sl - 1] == 0 { (*stack).data[sl - 1] = 1; };
                when (*stack).data[sl - 1] != 0 { (*stack).data[sl - 1] = 0; };
            };
            term pc + 1;
        };

        0x0F => { // shl
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] << ((*stack).data[sl - 1] & 63);
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x10 => { // shr_s (arithmetic)
            when sl >= 2 {
                (*stack).data[sl - 2] = (*stack).data[sl - 2] >> ((*stack).data[sl - 1] & 63);
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x11 => { // eq
            when sl >= 2 {
                when (*stack).data[sl - 2] == (*stack).data[sl - 1] {
                    (*stack).data[sl - 2] = 1;
                };
                when (*stack).data[sl - 2] != (*stack).data[sl - 1] {
                    (*stack).data[sl - 2] = 0;
                };
                (*stack).len = sl - 1;
            };
            term pc + 1;
        };

        0x17 => { // load
            when sl >= 1 {
                let addr = (*stack).data[sl - 1];
                (*stack).data[sl - 1] = Load#(addr, 8);
            };
            term pc + 1;
        };

        0x18 => { // store
            when sl >= 2 {
                let addr = (*stack).data[sl - 2];
                let val = (*stack).data[sl - 1];
                Store#(addr, val, 8);
                (*stack).len = sl - 2;
            };
            term pc + 1;
        };

        0x19 => { // ret
            term -1;
        };

        0x1B => { // trap
            term -1;
        };

        0x30 => { // push_i8
            let val = read_i8(bc, pc + 1);
            when sl < 1024 {
                (*stack).data[sl] = val;
                (*stack).len = sl + 1;
            };
            term pc + 2;
        };

        0x31 => { // load_local
            let slot = read_u8(bc, pc + 1);
            let val = (*locals).data[sll + slot];
            when sl < 1024 {
                (*stack).data[sl] = val;
                (*stack).len = sl + 1;
            };
            term pc + 2;
        };

        0x32 => { // store_local
            let slot = read_u8(bc, pc + 1);
            when sl >= 1 {
                (*locals).data[sll + slot] = (*stack).data[sl - 1];
                (*stack).len = sl - 1;
            };
            term pc + 2;
        };

        0x33 => { // push_frame
            let slots = read_u8(bc, pc + 1);
            when (*frames).count < 256 {
                (*frames).data[(*frames).count].locals_base = (*locals).len;
                (*frames).data[(*frames).count].local_count = slots;
                (*frames).data[(*frames).count].return_pc = pc + 2;
                (*frames).count = (*frames).count + 1;
            };
            term pc + 2;
        };

        0x34 => { // pop_frame
            when (*frames).count > 0 {
                (*frames).count = (*frames).count - 1;
            };
            term pc + 1;
        };

        0x50 => { // push_i16
            let val = read_i16(bc, pc + 1);
            when sl < 1024 {
                (*stack).data[sl] = val;
                (*stack).len = sl + 1;
            };
            term pc + 3;
        };

        0x51 => { // jmp
            let offset = read_i16(bc, pc + 1);
            term pc + 3 + offset;
        };

        0x52 => { // jz
            let offset = read_i16(bc, pc + 1);
            when sl >= 1 {
                let cond = (*stack).data[sl - 1];
                (*stack).len = sl - 1;
                when cond == 0 { term pc + 3 + offset; };
                term pc + 3;
            };
            term pc + 3;
        };

        0x53 => { // jnz
            let offset = read_i16(bc, pc + 1);
            when sl >= 1 {
                let cond = (*stack).data[sl - 1];
                (*stack).len = sl - 1;
                when cond != 0 { term pc + 3 + offset; };
                term pc + 3;
            };
            term pc + 3;
        };

        0x54 => { // call
            let fn_idx = read_u16(bc, pc + 1);
            when fn_idx < fnc {
                let callee_bc_off = fn_bc_offset(ft, foff, fn_idx);
                let callee_local_c = fn_local_count(ft, foff, fn_idx);
                let callee_arg_c = fn_arg_count(ft, foff, fn_idx);
                when (*frames).count < 256 {
                    // Save return state on CURRENT frame (before pushing new frame)
                    (*frames).data[(*frames).count].return_pc = pc + 3;
                    (*frames).data[(*frames).count].locals_base = (*locals).len;
                    (*frames).data[(*frames).count].local_count = callee_local_c;
                    (*frames).count = (*frames).count + 1;
                    // Copy args from stack to local slots
                    when callee_arg_c >= 1 {
                        (*locals).data[(*locals).len + 0] = (*stack).data[sl - 1];
                    };
                    when callee_arg_c >= 2 {
                        (*locals).data[(*locals).len + 1] = (*stack).data[sl - 2];
                    };
                    when callee_arg_c >= 3 {
                        (*locals).data[(*locals).len + 2] = (*stack).data[sl - 3];
                    };
                    when callee_arg_c >= 4 {
                        (*locals).data[(*locals).len + 3] = (*stack).data[sl - 4];
                    };
                    (*locals).len = (*locals).len + callee_local_c;
                    (*stack).len = sl - callee_arg_c;
                    term callee_bc_off;
                };
                term pc + 3;
            };
            term pc + 3;
        };

        0x70 => { // push_i32
            let val = read_i32(bc, pc + 1);
            when sl < 1024 {
                (*stack).data[sl] = val;
                (*stack).len = sl + 1;
            };
            term pc + 5;
        };

        0x71 => { // hcall — host-service dispatch (Plan 1, 2026-08-23)
            let host_id = read_u32(bc, pc + 1);
            // Arity lookup lives in C (briev_rt.c owns the parsed table).
            let n = BrievHostArity(host_id);
            when n == 1 {
                let a = (*stack).data[(*stack).len - 1];
                (*stack).len = (*stack).len - 1;
                let _r = host_dispatch1(host_id, a);
            };
            term pc + 5;
        };

        0x90 => { // push_i64
            let val = read_i64(bc, pc + 1);
            when sl < 1024 {
                (*stack).data[sl] = val;
                (*stack).len = sl + 1;
            };
            term pc + 9;
        };

        0x1C => { // bnot (bitwise NOT)
            when sl >= 1 {
                (*stack).data[sl - 1] = ~(*stack).data[sl - 1];
            };
            term pc + 1;
        };

        _ => { term -1; }; // TEMP-MARK
    };
};

// ── Host-service dispatch (Plan 1 HCALL slice, 2026-08-23) ──────────────
// The .lair host table maps service id → arity. Ids are canonical
// (HOST_ID_* above); the name strings ride along for diagnostics only.

// 2026-08-23: plain recursive DEFNS — the txn form's convergent loop spun
// forever when called from a non-reactive context (same family as
// parse_host_table; BUGS.md 2026-08-23).
defn host_arity_scan(ht: Ptr<HostTable>, id: Int, i: Int) -> Int {
    when i >= (*ht).count { term -1; };
    when (*ht).ids[i] == id { term (*ht).arities[i]; };
    term host_arity_scan(ht, id, i + 1);
};

defn host_arity(ht: Ptr<HostTable>, id: Int) -> Int {
    term host_arity_scan(ht, id, 0);
};

defn host_dispatch1(id: Int, a: Int) -> Int {
    when id == HOST_ID_PRINT_INT { term BrievHostPrintInt(a); };
    when id == HOST_ID_LOG_INT   { term BrievHostPrintInt(a); };
    when id >= HOST_ID_UNKNOWN_MIN { term BrievHostFail(id, a); };
    term BrievHostFail(id, a);
};
