// option — Option<T> with native enum variant construction + match.
// 2026-08-23 (Phase 10 / enum-construction plan): migrated off the removed
// `uni` dialect. Closure-taking adapters (map/and_then/filter/or_else) stay
// deferred — Fn(T) -> U syntax is unsupported (see original notes).

enum Option<T> {
    Some(T),
    None
};

defn is_some<T>(opt: Option<T>) -> Bool {
    term match opt {
        Some(_) => true,
        None => false,
    };
};

defn is_none<T>(opt: Option<T>) -> Bool {
    term !is_some(opt);
};

defn unwrap<T>(opt: Option<T>) -> T {
    term match opt {
        Some(v) => v,
        None => 0 as T,
    };
};

defn unwrap_or<T>(opt: Option<T>, default: T) -> T {
    term match opt {
        Some(v) => v,
        None => default,
    };
};
