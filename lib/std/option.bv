// Option<T> - Represents optional values
// Eliminates null pointer exceptions

import { __builtin_Option_Some, __builtin_Option_None }
    from "std/__builtin/option.bv";

// ===== ENUM DEFINITION =====

enum Option<T> {
    Some(T),
    None
};

// ===== CONSTRUCTION =====

defn Some<T>(value: T) [true][term.is_some()] -> Option<T> {
    term __builtin_Option_Some(value);
};

defn None<T>() [true][term.is_none()] -> Option<T> {
    term __builtin_Option_None();
};

defn some<T>(value: T) [true][term.is_some()] -> Option<T> {
    term Some(value);
};

defn none<T>() [true][term.is_none()] -> Option<T> {
    term None;
};

// ===== INSPECTION =====

defn is_some<T>(opt: Option<T>) [true][term == true || term == false] -> Bool {
    uni opt(Some(_)) = {
        term true;
    };
    uni opt(None) = {
        term false;
    };
    term false;
};

defn is_none<T>(opt: Option<T>) [true][term == true || term == false] -> Bool {
    uni opt(Some(_)) = {
        term false;
    };
    uni opt(None) = {
        term true;
    };
    term false;
};

// ===== EXTRACTION =====

defn unwrap<T>(opt: Option<T>) [opt.is_some()][true] -> T {
    uni opt(Some(v)) = {
        term v;
    };
    // None case impossible - precondition guarantees opt.is_some()
};

defn unwrap_or<T>(opt: Option<T>, default: T) [true][term == unwrap(opt) || term == default] -> T {
    uni opt(Some(v)) = {
        term v;
    };
    uni opt(None) = {
        term default;
    };
    term default;
};

defn unwrap_or_else<T>(opt: Option<T>, fallback: () -> T) [fallback != null][term == unwrap(opt) || term == fallback()] -> T {
    uni opt(Some(v)) = {
        term v;
    };
    uni opt(None) = {
        term fallback();
    };
    term fallback();
};

// ===== TRANSFORMATION =====

defn map<T, U>(opt: Option<T>, f: T -> U) [f != null][term.is_some() == opt.is_some()] -> Option<U> {
    uni opt(Some(v)) = {
        term Some(f(v));
    };
    uni opt(None) = {
        term None;
    };
    term None;
};

defn and_then<T, U>(opt: Option<T>, f: T -> Option<U>) [f != null][term.is_some() == opt.is_some()] -> Option<U> {
    uni opt(Some(v)) = {
        term f(v);
    };
    uni opt(None) = {
        term None;
    };
    term None;
};

defn or_else<T>(opt: Option<T>, fallback: () -> Option<T>) [fallback != null][term.is_some() == opt.is_some() || term.is_some()] -> Option<T> {
    uni opt(Some(v)) = {
        term Some(v);
    };
    uni opt(None) = {
        term fallback();
    };
    term fallback();
};

defn filter<T>(opt: Option<T>, pred: T -> Bool) [pred != null][term.is_some() && pred(unwrap(opt))] -> Option<T> {
    uni opt(Some(v)) = {
        [pred(v)] {
            term Some(v);
        };
        term None;
    };
    uni opt(None) = {
        term None;
    };
    term None;
};

// ===== COMBINATION =====

defn zip<T, U>(a: Option<T>, b: Option<U>) [true][term.is_some() == (a.is_some() && b.is_some())] -> Option<(T, U)> {
    uni a(Some(x)) = {
        uni b(Some(y)) = {
            term Some((x, y));
        };
        uni b(None) = {
            term None;
        };
        term None;
    };
    uni a(None) = {
        term None;
    };
    term None;
};

defn ok_or<T, E>(opt: Option<T>, err: E) [true][term.is_ok() == opt.is_some()] -> Result<T, E> {
    uni opt(Some(v)) = {
        term Ok(v);
    };
    uni opt(None) = {
        term Err(err);
    };
    term Err(err);
};

defn ok_or_else<T, E>(opt: Option<T>, err_fn: () -> E) [err_fn != null][term.is_ok() == opt.is_some()] -> Result<T, E> {
    uni opt(Some(v)) = {
        term Ok(v);
    };
    uni opt(None) = {
        term Err(err_fn());
    };
    term Err(err_fn());
};
