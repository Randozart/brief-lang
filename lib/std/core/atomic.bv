// Atomic operations — Lock-free concurrent data structures
// Tier 1: Primitives
//
// Uses LLVM atomic intrinsics via BILD for the LLVM backend.
// The interpreter fallback provides correct semantics via volatile_load/store.
//
// Types: All operations work on Ptr<T> where T can be any i64-sized type.
// On targets without native atomics, the LLVM backend emits libatomic calls.

// Atomic load: *ptr
inop! atomic_load<T>(ptr: Ptr<T>) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %v = load atomic i64, ptr %p acquire, align 8;
    term %v;
} fallback {
    volatile_load#(ptr)
};

// Atomic store: *ptr = val
inop! atomic_store<T>(ptr: Ptr<T>, val: T) -> Bool
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    store atomic i64 %val, ptr %p release, align 8;
    term %val;
} fallback {
    volatile_store#(ptr, val)
};

// Atomic compare-and-swap:
//   if *ptr == expected { *ptr = desired; true } else { false }
inop! atomic_cas<T>(ptr: Ptr<T>, expected: T, desired: T) -> Bool
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %pair = cmpxchg ptr %p, i64 %expected, i64 %desired acquire acquire;
    %success = extractvalue { i64, i1 } %pair, 1;
    term %success;
} fallback {
    let cur: T = volatile_load#(ptr);
    if cur == expected {
        term volatile_store#(ptr, desired);
    } else {
        term false;
    };
};

// Atomic fetch-and-add: tmp = *ptr; *ptr += val; term tmp
inop! atomic_fetch_add<T>(ptr: Ptr<T>, val: T) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %old = atomicrmw add ptr %p, i64 %val acquire;
    term %old;
} fallback {
    let cur: T = volatile_load#(ptr);
    term volatile_store#(ptr, cur + val);
};

// Atomic fetch-and-sub: tmp = *ptr; *ptr -= val; term tmp
inop! atomic_fetch_sub<T>(ptr: Ptr<T>, val: T) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %old = atomicrmw sub ptr %p, i64 %val acquire;
    term %old;
} fallback {
    let cur: T = volatile_load#(ptr);
    term volatile_store#(ptr, cur - val);
};

// Atomic fetch-and-and: tmp = *ptr; *ptr &= val; term tmp
inop! atomic_fetch_and<T>(ptr: Ptr<T>, val: T) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %old = atomicrmw and ptr %p, i64 %val acquire;
    term %old;
} fallback {
    let cur: T = volatile_load#(ptr);
    term volatile_store#(ptr, cur & val);
};

// Atomic fetch-and-or: tmp = *ptr; *ptr |= val; term tmp
inop! atomic_fetch_or<T>(ptr: Ptr<T>, val: T) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %old = atomicrmw or ptr %p, i64 %val acquire;
    term %old;
} fallback {
    let cur: T = volatile_load#(ptr);
    term volatile_store#(ptr, cur | val);
};

// Atomic fetch-and-xor: tmp = *ptr; *ptr ^= val; term tmp
inop! atomic_fetch_xor<T>(ptr: Ptr<T>, val: T) -> T
    [ptr as Int >= 0][true]
{
    %p = inttoptr i64 %ptr to ptr;
    %old = atomicrmw xor ptr %p, i64 %val acquire;
    term %old;
} fallback {
    let cur: T = volatile_load#(ptr);
    term volatile_store#(ptr, cur ^ val);
};
