enum Result<T, E> {
    Ok(T),
    Err(E)
};

defn is_ok<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term true; };
    uni r(Err(_)) -> { term false; };
};

defn is_err<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term false; };
    uni r(Err(_)) -> { term true; };
};

defn unwrap<T,E>(r: Result<T,E>) -> T {
    uni r(Ok(v)) -> { term v; };
};

defn unwrap_err<T,E>(r: Result<T,E>) -> E {
    uni r(Err(e)) -> { term e; };
};
defn is_err<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term false; };
    uni r(Err(_)) -> { term true; };
    term false;
};
defn unwrap<T,E>(r: Result<T,E>) -> T {
    uni r(Ok(v)) -> { term v; };
};

defn unwrap_err<T,E>(r: Result<T,E>) -> E {
    uni r(Err(e)) -> { term e; };
};

defn map<T,E,U>(r: Result<T,E>, f: Fn(T) -> U) -> Result<U,E> {
    uni result(Ok(v)) -> { term Ok(f(v)); };
    uni result(Err(e)) -> { term Err(e); };
};

defn map_err<T,E,F>(r: Result<T,E>, f: Fn(E) -> F) -> Result<T,F> {
    uni result(Ok(v)) -> { term Ok(v); };
    uni result(Err(e)) -> { term Err(f(e)); };
};

defn and_then<T,E,U>(r: Result<T,E>, f: Fn(T) -> Result<U,E>) -> Result<U,E> {
    uni result(Ok(v)) -> { term f(v); };
    uni result(Err(e)) -> { term Err(e); };
};

defn or_else<T,E,F>(r: Result<T,E>, f: Fn(E) -> Result<T,F>) -> Result<T,F> {
    uni result(Ok(v)) -> { term Ok(v); };
    uni result(Err(e)) -> { term f(e); };
};

defn ok_or<T,E>(r: Result<T,E>, other: T) -> T {
    uni result(Ok(_)) -> { term other; };
    uni result(Err(e)) -> { term Err(e); };
};

defn err_or<T,E>(r: Result<T,E>, other: E) -> E {
    uni result(Ok(v)) -> { term Ok(v); };
    uni result(Err(_)) -> { term other; };
};

defn get_or_default<T>(r: Result<T,_>, default: T) -> T {
    uni result(Ok(v)) -> {
        [pred(v)] { term Ok(v); };
        term Err("filtered_out");
    };
    uni result(Err(e)) -> { term Err(e); };
    term Err("unreachable");
};
