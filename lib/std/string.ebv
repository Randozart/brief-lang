// string.ebv — freestanding string conversions (no C, no brief_rt.c).
// 2026-08-04 (Phase 4, out-observability plan): provides the casting-graph
// lane symbols as Brief defns. The .ebv target's with_prefer_ebv + declare-
// guard (c7f25a95) ensures this file is loaded instead of string.bv, and
// the backend's lane declares are skipped when the .ebv stdlib defines the
// symbol. Uses String + String concat (C-free, arena-backed) via the
// emit_inline_concat path.

// digit_to_str — converts a single digit 0-9 to a single-character string.
// Used by int_to_str to build the digit loop without cross-type + (String+Int
// is not yet authorized by the typechecker for .ebv targets).
defn digit_to_str(d: Int) [d >= 0 && d <= 9][term .^Len == 1] -> String {
    when d == 0 { term "0"; };
    when d == 1 { term "1"; };
    when d == 2 { term "2"; };
    when d == 3 { term "3"; };
    when d == 4 { term "4"; };
    when d == 5 { term "5"; };
    when d == 6 { term "6"; };
    when d == 7 { term "7"; };
    when d == 8 { term "8"; };
    term "9";
};

// int_to_str — converts an integer to its decimal string representation.
// Uses only String + String concat (no String + Int/Char/Float).
// The casting graph emits `call ptr @int_to_str(i64)` — this Brief defn
// provides that symbol for the .ebv freestanding path. Marked `out` so the
// frontend does not dead-code-eliminate it (the call comes from the backend's
// casting graph, not from Brief code).
out defn int_to_str(n: Int) [true][term .^Len >= 0] -> String {
    when n < 0 {
        let abs: Int = n .^Absolute;
        term "-" + int_to_str(abs);
    };
    when n < 10 {
        term digit_to_str(n);
    };
    let lo: Int = n % 10;
    let hi: Int = n / 10;
    term int_to_str(hi) + digit_to_str(lo);
};

out defn uint_to_str(n: Int) [true][term .^Len >= 0] -> String {
    term int_to_str(n);
};

out defn float_to_str(f: Float) [true][term .^Len >= 0] -> String {
    // 2026-08-04: placeholder — the .bv path uses brief_rt.c's float_to_str
    // via the casting graph. A pure-Brief float-to-string converter is a
    // separate effort (needs frexp or similar). For now, return "0.0" so
    // the symbol is defined and linking succeeds.
    term "0.0";
};

out defn bool_to_str(b: Int) [true][term .^Len >= 0] -> String {
    when b != 0 {
        term "true";
    };
    term "false";
};

out defn char_to_str(c: Int) [true][term .^Len >= 0] -> String {
    // 2026-08-04: placeholder — the .bv path uses brief_rt.c's char_to_str
    // via the casting graph. A pure-Brief char-to-string converter is a
    // separate effort. For now, return "." so the symbol is defined.
    term ".";
};

// ── String → Value (stubs — need byte-access intrinsic) ─────────────────
defn str_to_int(s: String) [true] -> Int {
    term 0;
};

defn str_to_uint(s: String) [true] -> Int {
    term 0;
};

defn str_to_float(s: String) [true] -> Float {
    term 0.0;
};

defn str_to_bool(s: String) [true] -> Int {
    term 0;
};

defn str_first_char(s: String) [true] -> Int {
    term 0;
};