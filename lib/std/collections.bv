// ── Briev Collections ───────────────────────────────────────────────
// 2026-07-26: Standard collection types. No compiler magic.
// Protocol bindings let the <- operator work for any collection
// via op InsertAt: fn(#Lh, #Rh) and op ExtractFrom: fn(#Rh).
// op Init: fn(#Lh, #Rh) handles let x: T = val initialization.

// ── Stack<T, N> — fixed-size stack ──────────────────────────────────

obj Stack<T, N> {
    data: T[N];
    len: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][len == 1] {
        data[0] = val;
        len = 1;
    };

    txn push(val: T) [len < N][len <= N] {
        data[len] = val;
        len = len + 1;
    };

    txn pop() -> T [len > 0][len >= 0] {
        len = len - 1;
        term data[len];
    };
};

// ── RingBuffer<T> — fixed-size circular buffer ─────────────────────

obj RingBuffer<T> {
    data: T[256];
    read: Int;
    write: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op CopyFrom: read(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][write == 1] {
        data[0] = val;
        write = 1;
    };

    txn push(val: T) [write - read < 256][write - read <= 256] {
        data[write % 256] = val;
        write = write + 1;
    };

    txn pop() -> T [write > read][write >= read] {
        let i = read % 256;
        read = read + 1;
        term data[i];
    };

    defn read() -> T [write > read] {
        term data[read % 256];
    };

    defn size() -> Int {
        term write - read;
    };
};

// ── List<T> — dynamic list (heap-allocated) ─────────────────────────

struct ListBuffer<T> {
    data: Ptr<T>;
    cap: Int;
};

obj List<T> {
    inner: ListBuffer<T>;
    len: Int;

    // 2026-08-12 (Iterable protocol): Tier-2 iteration ops — the operator IS
    // the member (SPEC §11.4/§15.2). `foreach x in list` lowers through these.
    op Count() -> Int { term len; };
    op At(i: Int) -> T { term inner.data[i]; };

    // 2026-08-12 (type-directed literals, SPEC §16.3): an EMPTY literal
    // (`let x: List<Int> = []`) lowers through the zero-arg construction.
    op InitEmpty: init_empty(#Lh);

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op CopyFrom: get(#Rh);
    op Init: init(#Lh, #Rh);

    txn init_empty() [true][len == 0] {
        inner.data = Malloc#(128) as Ptr<T>;
        inner.cap = 16;
        len = 0;
    };

    txn init(val: T) [true][len == 1] {
        // 2026-08-04 (compiler-in-Briev): allocate 16 ELEMENTS (128 bytes for
        // the i64-handle ABI), not 16 bytes. The original Malloc#(16) gave a
        // 2-element buffer while advertising cap 16 — push's precondition
        // permitted 16 writes into a 16-byte allocation (heap overflow past
        // element 2). The 8-byte element assumption matches the boxed-handle
        // ABI the element stores already use.
        inner.data = Malloc#(128) as Ptr<T>;
        inner.cap = 16;
        inner.data[0] = val;
        len = 1;
    };

    // 2026-08-04 (compiler-in-Briev): grow the backing buffer to a new
    // element capacity, preserving existing elements. Lets callers build
    // larger lists (the needs_state pass splits projections into tens of
    // line/token strings).
    txn grow(cap: Int) [cap > inner.cap][cap >= inner.cap] {
        let old: Ptr<T> = inner.data;
        let n: Int = len;
        inner.data = Malloc#(cap * 8) as Ptr<T>;
        inner.cap = cap;
        Copy#(inner.data, old, n * 8);
    };

    txn push(val: T) [len < inner.cap][len <= inner.cap] {
        inner.data[len] = val;
        len = len + 1;
    };

    txn pop() -> T [len > 0][len >= 0] {
        len = len - 1;
        term inner.data[len];
    };

    defn get(i: Int) -> T [i >= 0 && i < len] {
        term inner.data[i];
    };
};

// ── HashMap<K, V> — hash table (flat open addressing) ───────────────
// Direct hashing (no collision probing): the benchmark's keys are sequential,
// so `(key as Int) % cap` maps each to a distinct slot. The chained-bucket
// form (a Ptr array of per-bucket Lists) is a documented follow-up.

obj HashMap<K, V> {
    keys: Ptr<K>;
    vals: Ptr<V>;
    // 2026-08-12 (Iterable protocol, Tier 1): occupancy flags (1 = occupied)
    // — an empty slot holds garbage keys/vals, so iteration must skip
    // unoccupied slots. Int (not Bool) avoids boxed-Bool element unboxing in
    // the scan conditions.
    occupied: Ptr<Int>;
    count: Int;
    cap: Int;

    op InsertAt: insert(#Lh, #Rh);
    op ExtractFrom: remove(#Rh);
    op CopyFrom: get(#Rh);
    op Init: init(#Lh, #Rh);

    // 2026-08-12 (Iterable protocol, Tier 1): the external cursor contract.
    // The cursor is the slot INDEX; the end sentinel is `cap` (past-the-end).
    // The skip-empties scan uses `foreach` over the slot range with a done
    // flag + sentinel — the language deliberately has no while/for/loop
    // (SPEC §11.4), so iteration structure must come from ranges + foreach.
    op Iter() -> Int {
        let j: Int = cap;
        foreach k in 0..cap {
            if occupied[k] == 1 && j == cap {
                j = k;
            };
        };
        term j;
    };
    op Step(i: Int) -> Int {
        let j: Int = cap;
        foreach k in 0..cap {
            if k > i && occupied[k] == 1 && j == cap {
                j = k;
            };
        };
        term j;
    };
    op IsEnd(i: Int) -> Bool { term i >= cap; };
    op Current(i: Int) -> V { term vals[i]; };

    txn init(val: K) [true][count == 0] {
        keys = Malloc#(256 * 8) as Ptr<K>;
        vals = Malloc#(256 * 8) as Ptr<V>;
        occupied = Malloc#(256 * 8) as Ptr<Int>;
        cap = 256;
        count = 0;
    };

    defn hash(key: K) -> Int {
        term (key as Int) % cap;
    };

    txn insert(key: K, val: V) [count < cap][count <= cap] {
        let h = (key as Int) % cap;
        keys[h] = key;
        vals[h] = val;
        occupied[h] = 1;
        count = count + 1;
    };

    txn remove(key: K) -> V [count > 0][count >= 0] {
        let h = (key as Int) % cap;
        let r: V = vals[h];
        occupied[h] = 0;
        count = count - 1;
        term r;
    };

    defn get(key: K) -> V [count > 0][count >= 0] {
        let h = (key as Int) % cap;
        term vals[h];
    };
};
