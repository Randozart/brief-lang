// ── Briev Collections ───────────────────────────────────────────────
// 2026-07-26: Standard collection types. No compiler magic.
// Protocol bindings let the <- operator work for any collection
// via op InsertAt: fn(#Lh, #Rh) and op ExtractFrom: fn(#Rh).
// op Init: fn(#Lh, #Rh) handles let x: T = val initialization.

// ── Stack<T, N> — fixed-size stack ──────────────────────────────────

obj Stack<T, N> {
    data: T[N];
    len: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][len == 1] {
        data[0] = val;
        len = 1;
    };

    txn push(val: T) [len < N][len <= N] {
        data[len] = val;
        len = len + 1;
    };

    txn pop() -> T [len > 0][len >= 0] {
        len = len - 1;
        term data[len];
    };
};

// ── RingBuffer<T> — fixed-size circular buffer ─────────────────────

obj RingBuffer<T> {
    data: T[256];
    read: Int;
    write: Int;

    op InsertAt: push(#Lh, #Rh);
    op ExtractFrom: pop(#Rh);
    op CopyFrom: read(#Rh);
    op Init: init(#Lh, #Rh);

    txn init(val: T) [true][write == 1] {
        data[0] = val;
        write = 1;
    };

    txn push(val: T) [write - read < 256][write - read <= 256] {
        data[write % 256] = val;
        write = write + 1;
    };

    txn pop() -> T [write > read][write >= read] {
        let i = read % 256;
        read = read + 1;
        term data[i];
    };

    defn read() -> T [write > read] {
        term data[read % 256];
    };

    defn size() -> Int {
        term write - read;
    };
};

// ── List<T> — dynamic list (compiler-owned Length, heap-backed) ─────
// 2026-08-15 (coll plan §3.7): `coll obj List<T>` — the compiler scaffolds
// the op surface (`op Count`/`op At`/`op Init`/`op InitEmpty`/`op InsertAt`/
// `op ExtractFrom`/`op CopyFrom`) and appends hidden `cap`/`len` slots.
// `ListBuffer` is just the element store (`data: Ptr<T>`); capacity is
// compiler-owned. The old hand-written members (init/grow/push/pop/get/len)
// are deleted — the scaffold synthesizes equivalent ones.

struct ListBuffer<T> {
    data: Ptr<T>;
};

coll obj List<T> {
    inner: ListBuffer<T>;
};

// ── HashMap<K, V> — hash table (flat open addressing) ───────────────
// Direct hashing (no collision probing): the benchmark's keys are sequential,
// so `(key as Int) % cap` maps each to a distinct slot. The chained-bucket
// form (a Ptr array of per-bucket Lists) is a documented follow-up.

// 2026-08-16 (hashmap redesign): a key/value pair as a NAMED struct — struct
// elements are the coll/op machinery's native element type (tuple elements
// miscompile today; see the hashmap redesign plan §6). Used by HashMap's
// insert/iterate surface.
struct Entry<K, V> { key: K; val: V; };

obj HashMap<K, V> {
    keys: Ptr<K>;
    vals: Ptr<V>;
    // 2026-08-12 (Iterable protocol, Tier 1): occupancy flags (1 = occupied)
    // — an empty slot holds garbage keys/vals, so iteration must skip
    // unoccupied slots. Int (not Bool) avoids boxed-Bool element unboxing in
    // the scan conditions.
    occupied: Ptr<Int>;
    count: Int;
    cap: Int;

    op InsertAt: insert(#Lh, #Rh);
    op ExtractFrom: remove(#Rh);
    op CopyFrom: get(#Rh);
    op Init: init(#Lh, #Rh);

    // 2026-08-16 (hashmap redesign): `op Count` = the element count — the
    // collection op surface (`Count#`/`len`/`is_empty`). This is a map's
    // OCCUPIED count, NOT the slot-array size `cap` (the Tier-1 cursor scans
    // `cap` slots skipping empties).
    op Count() -> Int { term count; };

    // 2026-08-12 (Iterable protocol, Tier 1): the external cursor contract.
    // The cursor is the slot INDEX; the end sentinel is `cap` (past-the-end).
    // The skip-empties scan uses `foreach` over the slot range with a done
    // flag + sentinel — the language deliberately has no while/for/loop
    // (SPEC §11.4), so iteration structure must come from ranges + foreach.
    op Iter() -> Int {
        let j: Int = cap;
        foreach k in 0..cap {
            if occupied[k] == 1 && j == cap {
                j = k;
            };
        };
        term j;
    };
    op Step(i: Int) -> Int {
        let j: Int = cap;
        foreach k in 0..cap {
            if k > i && occupied[k] == 1 && j == cap {
                j = k;
            };
        };
        term j;
    };
    op IsEnd(i: Int) -> Bool { term i >= cap; };
    // 2026-08-16 (hashmap redesign): `op Current` returns the VALUE at the
    // occupied slot (a foreach over a map iterates its values). The
    // key-at-cursor is reachable via `keys[i]` in a caller that tracks the
    // index, or via `get`/`keys` scans.
    op Current(i: Int) -> V { term vals[i]; };

    txn init(val: K) [true][count == 0] {
        keys = Malloc#(256 * 8) as Ptr<K>;
        vals = Malloc#(256 * 8) as Ptr<V>;
        occupied = Malloc#(256 * 8) as Ptr<Int>;
        cap = 256;
        count = 0;
    };

    defn hash(key: K) -> Int {
        term (key as Int) % cap;
    };

    // 2026-08-16 (hashmap redesign): insert takes the PAIR as one Entry —
    // the `op InsertAt: insert(#Lh,#Rh)` binding passes a single RHS, so a
    // 2-arg insert could never receive a `<-`/literal value. Linear probing
    // for collisions; rehash on full (double cap, reinsert all occupied).
    // The foreach probe uses a `p = cap` done-sentinel (no `break` in Briev):
    // once the slot is found, p becomes cap and later iterations no-op on
    // `p < cap`.
    txn insert(e: Entry<K, V>) [count < cap][count <= cap] {
        let k: K = e.key;
        let v: V = e.val;
        // 2026-08-16: linear-probe for an empty slot or the same key. The
        // `done` Bool gates the writes (a `p = cap` sentinel miscompiles —
        // see the hashmap redesign plan). Rehash-on-full is DEFERRED: a
        // nested `foreach` inside an `if` inside a txn member body segfaults
        // when the txn re-fires (pre-existing codegen bug); the map stays at
        // its initial cap and the `count < cap` contract fails at capacity.
        let h: Int = (k as Int) % cap;
        let p: Int = h;
        let done_slot: Bool = false;
        foreach q in 0..cap {
            if !done_slot {
                if occupied[p] == 0 || keys[p] == k {
                    keys[p] = k;
                    vals[p] = v;
                    occupied[p] = 1;
                    done_slot = true;
                } else {
                    if p + 1 < cap {
                        p = p + 1;
                    } else {
                        p = 0;
                    };
                };
            };
        };
        if !done_slot {
            // Unreachable when count < cap (at least one slot is free).
        };
        count = count + 1;
    };

    defn get(key: K) -> V [count > 0][count >= 0] {
        let h: Int = (key as Int) % cap;
        let p: Int = h;
        let r: V = vals[p];
        let done_slot: Bool = false;
        foreach q in 0..cap {
            if !done_slot {
                if occupied[p] == 1 && keys[p] == key {
                    r = vals[p];
                    done_slot = true;
                } else {
                    if p + 1 < cap {
                        p = p + 1;
                    } else {
                        p = 0;
                    };
                };
            };
        };
        term r;
    };

    defn contains(key: K) -> Bool {
        let h: Int = (key as Int) % cap;
        let p: Int = h;
        let found_slot: Bool = false;
        foreach q in 0..cap {
            if !found_slot {
                if occupied[p] == 1 && keys[p] == key {
                    found_slot = true;
                } else {
                    if p + 1 < cap {
                        p = p + 1;
                    } else {
                        p = 0;
                    };
                };
            };
        };
        term found_slot;
    };

    txn remove(key: K) -> V [count > 0][count >= 0] {
        let h: Int = (key as Int) % cap;
        let p: Int = h;
        let r: V = vals[p];
        let done_slot: Bool = false;
        foreach q in 0..cap {
            if !done_slot {
                if occupied[p] == 1 && keys[p] == key {
                    r = vals[p];
                    occupied[p] = 0;
                    done_slot = true;
                } else {
                    if p + 1 < cap {
                        p = p + 1;
                    } else {
                        p = 0;
                    };
                };
            };
        };
        if done_slot {
            count = count - 1;
        };
        term r;
    };

    // 2026-08-16 (hashmap redesign): keys()/values()/entries() scans are
    // DEFERRED — a `List<K>` accumulator in a generic member body fails to
    // typecheck when collections.bv is imported (the free-T arrow-assign
    // `acc <- keys[i]` can't resolve `push_element_type(List<K>)` across the
    // import boundary; see BUGS.md). Iteration is a documented follow-up once
    // the generic-member arrow is fixed.
};
