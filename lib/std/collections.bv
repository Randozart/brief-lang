// ── Brief Collections ───────────────────────────────────────────────
// 2026-07-26: User-defined collection types. No compiler magic.
// Protocol bindings let the <- operator work for any collection
// via InsertAt <~ push(#L, #R) and ExtractFrom <~ pop(#L).

// ── RingBuffer<T> — fixed-size circular buffer ──────────────────────

export defn new_ring_buffer<T>(val: T) -> RingBuffer<T> {
    let mut rb: RingBuffer<T>;
    rb.data[0] = val;
    rb.read = 0;
    rb.write = 1;
    term rb;
};

obj RingBuffer<T> {
    data: T[256];
    read: Int;
    write: Int;

    InsertAt <~ push(#L, #R);
    ExtractFrom <~ pop(#L);

    txn push(val: T) [write - read < 256][write - read <= 256] {
        data[write % 256] = val;
        write = write + 1;
    };

    txn pop() -> T [write > read][write >= read] {
        let i = read % 256;
        read = read + 1;
        term data[i];
    };

    defn size() -> Int {
        term write - read;
    };
};
