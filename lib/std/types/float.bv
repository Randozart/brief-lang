// ── Floating Point Type Definitions ──────────────────────────
//
// Extended floating point types built on the Primitive type system.
// These types use operator→intrinsic declarations to define their
// behavior.
//
// Phase 7B: These files will compile once the operator→intrinsic
// pipeline is fully wired through the typechecker.

// 16-bit half-precision float (hardware on some GPUs)
type Float16 <: Bits {
    maxbits <~ 16;
    alignment <~ 2;
    tbaa <~ "FloatNode";

    op Add(Float16) -> Float16 = FAdd16#;
    op Sub(Float16) -> Float16 = FSub16#;
    op Mul(Float16) -> Float16 = FMul16#;
};

// 4-lane SIMD float vector
type Float4 <: Bits {
    maxbits <~ 128;
    alignment <~ 16;
    tbaa <~ "FloatNode";

    op Add(Float4) -> Float4 = FAddV4F32#;
    op Sub(Float4) -> Float4 = FSubV4F32#;
    op Mul(Float4) -> Float4 = FMulV4F32#;
};
