    llvm <~ "i8";
    storage <~ "Boxed";
    tbaa <~ "Bool";
    box <~ "zext.i1.to.i64#";
    unbox <~ "trunc.i64.to.i1#";
    default_width <~ 1;
    commuting <~ true;
    op Eq(Bool) -> Bool = "icmp eq";
    op Ne(Bool) -> Bool = "icmp ne";
    op And(Bool) -> Bool = "and";
    op Or(Bool) -> Bool = "or";
    op Not() -> Bool = "not";
};

