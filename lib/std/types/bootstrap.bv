// ── Bootstrap Type Universe ──────────────────────────────────
//
// 2026-06-30: Built-in primitive type declarations using the
// Annotation Arrow (<~) syntax. These form the prelude — always
// implicitly imported into every .bv compilation.
//
// 2026-07-20: Hashword protocol architecture — op Add(#Int, #Int)
// replaces old metadata-driven dispatch.

type Int <: Bits {
    bytes <~ 8;
    alignment <~ 8;
    op Add(#Int, #Int);
    op Sub(#Int, #Int);
    op Mul(#Int, #Int);
    op Div(#Int, #Int);
    op Mod(#Int, #Int);
    op Neg(#Int);
    op Eq(#Int, #Int);
    op Ne(#Int, #Int);
    op Lt(#Int, #Int);
    op Le(#Int, #Int);
    op Gt(#Int, #Int);
    op Ge(#Int, #Int);
};

type UInt <: Bits {
    bytes <~ 8;
    alignment <~ 8;
    op Add(#Int, #Int);
    op Sub(#Int, #Int);
    op Mul(#Int, #Int);
    op Div(#Int, #Int);
    op Mod(#Int, #Int);
    op Eq(#Int, #Int);
    op Ne(#Int, #Int);
    op Lt(#Int, #Int);
    op Le(#Int, #Int);
    op Gt(#Int, #Int);
    op Ge(#Int, #Int);
};

