// ── Bootstrap Type Universe ──────────────────────────────────
//
// 2026-08-15 (fundamentals-as-types): the fundamental types (`Data`,
// `Bit<N>`, `Int`, `UInt`, `Float`, `Bool`, `Char`, `String`, `Blob`,
// `Ptr`, `Void`) are compiler-native primordials seeded in the type
// universe. They need NO stdlib redeclaration and carry no overloadable ops
// (`op` is for user types; the intrinsics handle fundamental dispatch).
// This file only declares the WIDTH refinements (Int8/Int16/.../Int128,
// Float32/Float64, Double) and the byte-buffer `Blob` (a Data member like
// String, `[len][bytes]`, no encoding interpretation).
//
// Width is inferred from `spec Bits: N`; everything else is derived from
// the fundamental's protocol by the casting graph.

type UInt: Int;

type Int8: Int { spec Bits: 8; };
type UInt8: Int { spec Bits: 8; };

type Int16: Int { spec Bits: 16; };
type UInt16: Int { spec Bits: 16; };

type Int32: Int { spec Bits: 32; };
type UInt32: Int { spec Bits: 32; };

type Int64: Int { spec Bits: 64; };
type UInt64: Int { spec Bits: 64; };

type Int128: Int { spec Bits: 128; };
type UInt128: Int { spec Bits: 128; };

type Float32: Float { spec Bits: 32; };
type Float64: Float { spec Bits: 64; };

type Double: Float { spec Bits: 64; };

// 2026-08-15 (fundamentals-as-types): the byte-buffer type is `Blob` (the
// [len][bytes] buffer with no encoding interpretation); `Data` is the
// universal parent (root). `#b"..."` literals are Blob-typed.
type Blob: Data { spec Bits: 64; };

// 2026-07-30: Slice<T> — fat-pointer view over contiguous elements.
// LLVM type { ptr, i64 } derived from field shapes by emit_toplevel.rs:llvm_type().
// No llvm_type metadata needed. Replaces UTF8View.
type Slice<T> {
    data: Ptr<T>;
    len: Int;
};
