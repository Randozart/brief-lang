type Bool <: Bits {
    bytes <~ 1;
    alignment <~ 1;
    llvm <~ "i8";
    tbaa <~ "Bool";
    default_width <~ 1;
    commuting <~ true;
    op Eq ~> "int.eq";
    op Ne ~> "int.ne";
