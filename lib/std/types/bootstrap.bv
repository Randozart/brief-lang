// ── Bootstrap Type Universe ──────────────────────────────────
//
// 2026-07-24: Protocol-first type declarations. Each type declares
// which protocol it implements (#Int, #Float, etc.). Width is
// inferred unless explicit (bits <~ N). Bits is implicit.
//
// The compiler uses protocol information to drive all operation
// dispatch. Backends know how to add, subtract, etc. for each
// protocol without per-type configuration.

type Int: #Int {
    op Parse(#Int);
    op Parse(Decimal);
    op Add(#Int, #Int);
    op Sub(#Int, #Int);
    op Mul(#Int, #Int);
    op Div(#Int, #Int);
    op Mod(#Int, #Int);
    op Neg(#Int);
    op Eq(#Int, #Int);
    op Ne(#Int, #Int);
    op Lt(#Int, #Int);
    op Le(#Int, #Int);
    op Gt(#Int, #Int);
    op Ge(#Int, #Int);
};

type UInt: Int;

type Int8: Int { bits <~ 8; };
type UInt8: Int { bits <~ 8; };

type Int16: Int { bits <~ 16; };
type UInt16: Int { bits <~ 16; };

type Int32: Int { bits <~ 32; };
type UInt32: Int { bits <~ 32; };

type Int64: Int { bits <~ 64; };
type UInt64: Int { bits <~ 64; };

type Float: #Float {
    op Parse(#Float);
    op Parse(Decimal);
    op Add(#Int, #Int);
    op Sub(#Int, #Int);
    op Mul(#Int, #Int);
    op Div(#Int, #Int);
    op Neg(#Int);
    op Eq(#Int, #Int);
    op Ne(#Int, #Int);
    op Lt(#Int, #Int);
    op Le(#Int, #Int);
    op Gt(#Int, #Int);
    op Ge(#Int, #Int);
};

type Double: #Float { bits <~ 64; };

type Bool: #Bool {
    bits <~ 8;
    op Eq(#Int, #Int);
    op Ne(#Int, #Int);
    op And(#Bits, #Bits);
    op Or(#Bits, #Bits);
    op Not(#Bits);
};

type Char: Int { bits <~ 32; };

type String {
    data: Int;
    len: Int;
    alignment <~ 8;
    encoding <~ "UTF-8";
};

type Utf8View {
    data: Int;
    len: Int;
    alignment <~ 8;
    encoding <~ "UTF-8";
};

type StaticString {
    data: Int;
    len: Int;
};

type SmallString64 {
    slot0: Int;
    slot1: Int;
    slot2: Int;
    slot3: Int;
    slot4: Int;
    slot5: Int;
    slot6: Int;
    slot7: Int;
    len: Int;
    alignment <~ 8;
    encoding <~ "UTF-8";
};

type Data: Int { bits <~ 64; };
