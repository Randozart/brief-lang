// ── Bootstrap Type Universe ──────────────────────────────────
//
// 2026-07-24: Protocol-first type declarations. Each type declares
// which protocol it implements (#Int, #Float, etc.). Width is
// inferred unless explicit (bits <~ N). Bits is implicit.
//
// The compiler uses protocol information to drive all operation
// dispatch. Backends know how to add, subtract, etc. for each
// protocol without per-type configuration.
//
// op declarations use the new `:` binding syntax. The expr
// body is documentation for bootstrap types; the backend uses
// hardcoded codegen based on protocol membership.

type Int: #Int {
    op Add: add(#L, #R);
    op Sub: sub(#L, #R);
    op Mul: mul(#L, #R);
    op Div: div(#L, #R);
    op Mod: mod(#L, #R);
    op Neg: neg(#L);
    op Eq: eq(#L, #R);
    op Ne: ne(#L, #R);
    op Lt: lt(#L, #R);
    op Le: le(#L, #R);
    op Gt: gt(#L, #R);
    op Ge: ge(#L, #R);
};

type UInt: Int;

type Int8: Int { !> bits: 8; };
type UInt8: Int { !> bits: 8; };

type Int16: Int { !> bits: 16; };
type UInt16: Int { !> bits: 16; };

type Int32: Int { !> bits: 32; };
type UInt32: Int { !> bits: 32; };

type Int64: Int { !> bits: 64; };
type UInt64: Int { !> bits: 64; };

type Float: #Float {
    op Add: add(#L, #R);
    op Sub: sub(#L, #R);
    op Mul: mul(#L, #R);
    op Div: div(#L, #R);
    op Neg: neg(#L);
    op Eq: eq(#L, #R);
    op Ne: ne(#L, #R);
    op Lt: lt(#L, #R);
    op Le: le(#L, #R);
    op Gt: gt(#L, #R);
    op Ge: ge(#L, #R);
};

type Double: #Float { !> bits: 64; };

type Bool: #Bool {
    !> bits: 8;
    op Eq: eq(#L, #R);
    op Ne: ne(#L, #R);
    op And: band(#L, #R);
    op Or: bor(#L, #R);
    op Not: bnot(#L);
};

type Char: #Char { !> bits: 32;
};

// 2026-07-30: String participates in #String protocol.
// Casting graph handles all protocol-level casts:
//   #String → #Bit = extractvalue 0 (hardcoded, never overridable)
//   #String → #Int = ExtCall("str_to_int") (protocol default)
//   #String → #Float = ExtCall("str_to_float") (protocol default)
//   #Bit → #String = CastFrom(#Bit) override if declared (interpretation door)
// 2026-08-01 (B0): String is a bare #String protocol member with NO fields and
// NO metadata. The value is a ptr to a length-prefixed [len][bytes] buffer;
// everything else is derived from the protocol by the casting graph. The old
// {data, len} fields and !> encoding metadata were never read by the compiler
// (type_universe/mod.rs:89,285-287 — encoding unread; fields retained only for
// the is_string_like structural check, which B4 removes). prop Size/Bytes
// are wired to real dispatch in Phase B3.
type String: #String {
    prop Size: chars(#L);
    prop Bytes: byte_len(#L);
};

type UTF8View {
    data: Int;
    len: Int;
    !> alignment: 8;
    !> encoding: "UTF-8";
};

type StaticString {
    data: Int;
    len: Int;
};

type SmallString64 {
    slot0: Int;
    slot1: Int;
    slot2: Int;
    slot3: Int;
    slot4: Int;
    slot5: Int;
    slot6: Int;
    slot7: Int;
    len: Int;
    !> alignment: 8;
    !> encoding: "UTF-8";
};

type Data: Int { !> bits: 64; };

// 2026-07-30: Slice<T> — fat-pointer view over contiguous elements.
// LLVM type { ptr, i64 } derived from field shapes by emit_toplevel.rs:llvm_type().
// No llvm_type metadata needed. Replaces UTF8View.
type Slice<T> {
    data: Ptr<T>;
    len: Int;
    prop Size: len;
};
