type Bool <: Bits {
    bytes <~ 1;
    alignment <~ 1;
    llvm <~ "i8";
    tbaa <~ "Bool";
    default_width <~ 1;
    commuting <~ true;
    op Eq ~> "int.eq";
    op Ne ~> "int.ne";
    op And ~> "int.and";
    op Or ~> "int.or";
    op Not ~> "int.not";
};

type Char <: Bits {
    bytes <~ 4;
    alignment <~ 4;
    llvm <~ "i32";
    tbaa <~ "Char";
    default_width <~ 32;
};

type String {
    data: Int;
    len: Int;
    alignment <~ 8;
    encoding <~ "UTF-8";
    tbaa <~ "String";
};

type Data <: Bits {
    bytes <~ 8;
    alignment <~ 8;
    llvm <~ "i8*";
    tbaa <~ "String";
    default_width <~ 64;
};