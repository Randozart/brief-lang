// ── Bootstrap Type Universe ──────────────────────────────────
//
// 2026-06-30: Built-in primitive type declarations using the
// Annotation Arrow (<~) syntax. These form the prelude — always
// implicitly imported into every .bv compilation.
//
// 2026-07-08: Phase 2B — added default_width, commuting, and
// operator declarations for universe-driven codegen dispatch.

type Int <: Bits {
    bytes <~ 8;
    alignment <~ 8;
    llvm <~ "i64";
    storage <~ "Boxed";
    tbaa <~ "Int";
    default_width <~ 64;
    commuting <~ true;
    op Add(Int) -> Int = "add nsw";
    op Sub(Int) -> Int = "sub nsw";
    op Mul(Int) -> Int = "mul nsw";
    op Div(Int) -> Int = "sdiv";
    op Mod(Int) -> Int = "srem";
    op Neg() -> Int = "neg";
    op Eq(Int) -> Bool = "icmp eq";
    op Ne(Int) -> Bool = "icmp ne";
    op Lt(Int) -> Bool = "icmp slt";
    op Le(Int) -> Bool = "icmp sle";
    op Gt(Int) -> Bool = "icmp sgt";
    op Ge(Int) -> Bool = "icmp sge";
};

type UInt <: Bits {
    bytes <~ 8;
    alignment <~ 8;
    llvm <~ "i64";
    storage <~ "Boxed";
    tbaa <~ "Int";
    default_width <~ 64;
    commuting <~ true;
    op Add(UInt) -> UInt = "add";
    op Sub(UInt) -> UInt = "sub";
    op Mul(UInt) -> UInt = "mul";
    op Div(UInt) -> UInt = "udiv";
    op Mod(UInt) -> UInt = "urem";
    op Eq(UInt) -> Bool = "icmp eq";
    op Ne(UInt) -> Bool = "icmp ne";
    op Lt(UInt) -> Bool = "icmp ult";
    op Le(UInt) -> Bool = "icmp ule";
    op Gt(UInt) -> Bool = "icmp ugt";
    op Ge(UInt) -> Bool = "icmp uge";
};

