type Float <: Bits {
    bytes <~ 4;
    alignment <~ 4;
    llvm <~ "float";
    storage <~ "Native";
    tbaa <~ "Float";
    box <~ "bitcast.f32.to.i64#";
    unbox <~ "bitcast.i64.to.f32#";
    default_width <~ 32;
    commuting <~ true;
    op Add(Float) -> Float = "fadd fast";
    op Sub(Float) -> Float = "fsub fast";
    op Mul(Float) -> Float = "fmul fast";
    op Div(Float) -> Float = "fdiv fast";
    op Mod(Float) -> Float = "frem fast";
    op Neg() -> Float = "fneg";
    op Eq(Float) -> Bool = "fcmp oeq";
    op Ne(Float) -> Bool = "fcmp one";
    op Lt(Float) -> Bool = "fcmp olt";
    op Le(Float) -> Bool = "fcmp ole";
    op Gt(Float) -> Bool = "fcmp ogt";
    op Ge(Float) -> Bool = "fcmp oge";
};

