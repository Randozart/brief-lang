export let SYS_MKNOD:         Int = 133;
export let SYS_MKDIR:         Int = 83;
export let SYS_RMDIR:         Int = 84;
export let SYS_UNLINK:        Int = 87;
export let SYS_RENAME:        Int = 82;
export let SYS_SYMLINK:       Int = 88;
export let SYS_READLINK:      Int = 89;
export let SYS_LINK:          Int = 86;
export let SYS_GETCWD:        Int = 79;
export let SYS_CHDIR:         Int = 80;
export let SYS_SOCKET:        Int = 41;
export let SYS_BIND:          Int = 49;
export let SYS_LISTEN:        Int = 50;
