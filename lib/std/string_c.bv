// 2026-07-15: Convert Briev string to C-style null-terminated string.
// Briev string format: [8-byte length (i64)][UTF-8 data].
// C string format: [data][null byte].
// Allocates via Malloc# — caller must free.

defn to_c_string(s: Int) -> Int {
    let len: Int = Length#(s);
    let data_start: Int = s + 8;
    let cstr: Int = Malloc#(len + 1);
    Copy#(cstr, data_start, len);
    Fill#(cstr + len, 0, 1);
    term cstr;
};
