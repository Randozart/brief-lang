// 2026-07-15: Convert Brief string to C-style null-terminated string.
// Brief string format: [8-byte length (i64)][UTF-8 data].
// C string format: [data][null byte].
// Allocates via Malloc# — caller must free.

defn to_c_string(s: Ptr<Byte>) -> Ptr<Byte> {
    let len: Int = Length#(s);
    let data_start: Ptr<Byte> = s + 8;
    let cstr: Ptr<Byte> = Malloc#(len + 1);
    Memcpy#(cstr, data_start, len);
    Memset#(cstr + len, 0, 1);
    term cstr;
};
