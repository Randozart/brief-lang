enum Result<T, E> {
    Ok(T),
    Err(E)
};

defn is_ok<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term true; };
    uni r(Err(_)) -> { term false; };
};

defn is_err<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term false; };
    uni r(Err(_)) -> { term true; };
};

defn unwrap<T,E>(r: Result<T,E>) -> T {
    uni r(Ok(v)) -> { term v; };
};

defn unwrap_err<T,E>(r: Result<T,E>) -> E {
    uni r(Err(e)) -> { term e; };
};
defn is_err<T,E>(r: Result<T,E>) -> Bool {
    uni r(Ok(_)) -> { term false; };
    uni r(Err(_)) -> { term true; };
    term false;
};
defn unwrap<T,E>(r: Result<T,E>) -> T {
    uni r(Ok(v)) -> { term v; };
};

defn unwrap_err<T,E>(r: Result<T,E>) -> E {
    uni r(Err(e)) -> { term e; };
};

// Fn(T) -> U syntax unsupported — convenience closures deferred.
// map, map_err, and_then, or_else require closure support.
// ok_or, err_or need the Result type in the return position.
