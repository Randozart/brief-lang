// HashSet<T> - Hash-based set implementation
// Uses list with uniqueness enforcement
// Backends optimize to native hash sets

// ===== STRUCT DEFINITION =====

struct HashSet<T> {
    items: List<T>
};

// ===== CONSTRUCTION =====

defn new_set<T>() -> HashSet<T> [true][term :> Size == 0] {
    term HashSet { items: [] };
};

defn with_capacity<T>(capacity: Int) -> HashSet<T> [capacity > 0][term :> Size == 0] {
    term HashSet { items: [] };
};

// ===== OPERATIONS =====

defn insert<T>(set: HashSet<T>, item: T) 
    [true][term.contains(item)] 
    -> HashSet<T> 
{
    [set.contains(item)] {
        term set;
    };
    term HashSet { items: set.items + [item] };
};

defn remove<T>(set: HashSet<T>, item: T) 
    [set.contains(item)][!term.contains(item)] 
    -> HashSet<T> 
{
    let new_items: List<T> = [];
    let i: Int = 0;
    [i < set.items :> Size] {
        [set.items[i] != item] {
            &new_items = new_items + [set.items[i]];
        };
        &i = i + 1;
    };
    term HashSet { items: new_items };
};

defn contains<T>(set: HashSet<T>, item: T) 
    [true][term == true || term == false] 
    -> Bool 
{
    let i: Int = 0;
    [i < set.items :> Size] {
        [set.items[i] == item] {
            term true;
        };
        &i = i + 1;
    };
    term false;
};

// ===== SET OPERATIONS =====

defn union<T>(a: HashSet<T>, b: HashSet<T>) 
    [true][term :> Size >= a :> Size && term :> Size >= b :> Size] 
    -> HashSet<T> 
{
    let result: HashSet<T> = a;
    let i: Int = 0;
    [i < b.items :> Size] {
        &result = result.insert(b.items[i]);
        &i = i + 1;
    };
    term result;
};

defn intersection<T>(a: HashSet<T>, b: HashSet<T>) 
    [true][term :> Size <= a :> Size && term :> Size <= b :> Size] 
    -> HashSet<T> 
{
    let result: HashSet<T> = new_set();
    let i: Int = 0;
    [i < a.items :> Size] {
        [b.contains(a.items[i])] {
            &result = result.insert(a.items[i]);
        };
        &i = i + 1;
    };
    term result;
};

defn difference<T>(a: HashSet<T>, b: HashSet<T>) 
    [true][term :> Size <= a :> Size] 
    -> HashSet<T> 
{
    let result: HashSet<T> = new_set();
    let i: Int = 0;
    [i < a.items :> Size] {
        [!b.contains(a.items[i])] {
            &result = result.insert(a.items[i]);
        };
        &i = i + 1;
    };
    term result;
};

// ===== METADATA =====

defn len<T>(set: HashSet<T>) 
    [true][term >= 0] 
    -> Int 
{
    term set.items :> Size;
};

defn is_empty<T>(set: HashSet<T>) 
    [true][term == true || term == false] 
    -> Bool 
{
    term set.items :> Size == 0;
};

// ===== ITERATION =====

defn iter<T>(set: HashSet<T>) 
    [true][term :> Size == set :> Size] 
    -> List<T> 
{
    term set.items;
};

defn to_list<T>(set: HashSet<T>) 
    [true][term :> Size == set :> Size] 
    -> List<T> 
{
    term set.items;
};

defn from_list<T>(items: List<T>) 
    [true][term :> Size <= items :> Size] 
    -> HashSet<T> 
{
    let result: HashSet<T> = new_set();
    let i: Int = 0;
    [i < items :> Size] {
        &result = result.insert(items[i]);
        &i = i + 1;
    };
    term result;
};

defn clear<T>(set: HashSet<T>) 
    [true][term :> Size == 0] 
    -> HashSet<T> 
{
    term HashSet { items: [] };
};
