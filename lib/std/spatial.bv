// spatial — block memory operations over the compiler's Fill#/Copy#
// intrinsics (llvm.memset/llvm.memcpy under the hood).
// 2026-08-23: migrated off removed block_* statement forms and the
// never-implemented Memcmp#/Hash# intrinsics — compare/hash await their
// own arcs (tracked in BUGS.md sweep triage).

defn block_fill(ptr: Ptr, val: Int, n: Int) -> Bool {
    Fill#(ptr, val, n);
    term true;
};

defn block_copy(dst: Ptr, src: Ptr, n: Int) -> Bool {
    Copy#(dst, src, n);
    term true;
};
