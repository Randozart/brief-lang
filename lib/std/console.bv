// Console — terminal input cell.
// Provides line-buffered console input with duplicate-safe line detection.
// Outputs `line: String` (the emitted line on Enter) and `line_id: Int`
// (monotonically incrementing sequence counter — fires on every Enter).
//
// Import exposes the cell (not `sed`). Usage:
//
//   import "std/console.bv";
//   trg inp: String @ Console!;
//   rct txn handle [[inp != ""] { process(inp); &inp = ""; term; };
//
// The `@ Console!` shorthand creates an async persistent Console instance
// and binds a trigger to its `line` output port. The `Console!` suffix
// with `!` is required — it matches the `cell!` persistent declaration.
//
// For duplicate-safe detection (same input twice), bind to `line_id`:
//
//   trg inp_line: String @ Console.line;
//   trg inp_id: Int @ Console.line_id;
//   let last_id: Int = -1;
//   rct txn handle [inp_id != last_id]] {
//       process(inp_line);
//       &last_id = inp_id;
//       term;
//   };
//
// Ctrl+C is NOT emitted as a line — it returns '\x03' via stdin. Handle
// it separately with a `trg raw: Char @stdin#;` for shutdown, or check
// for it inside the handler.
//
// Terminal raw mode must be enabled by the application before use:
//   tty_raw_mode#(true);  // enable
//   tty_raw_mode#(false); // disable on exit

cell! Console -> line: String, line_id: Int {
    line: String = "";
    prev_key: Char = '\0';
    seq: Int = 0;

    trg raw: Char @ stdin#;

    rct txn process [raw != prev_key]] {
        [raw == '\n'] {
            &seq = seq + 1;
            &line_id = seq;
        };

        [raw >= ' ' && raw != '\x7f'] {
            &line = line + (String)raw;line = (String)raw;
        };

        &prev_key = raw;
        term;
    };
};
