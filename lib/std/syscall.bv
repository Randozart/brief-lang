// Syscall — Architecture-generic syscall interface for BILD inop! declarations
// Tier 1: Primitives
//
// Provides syscall1 through syscall6 as architecture-generic inop! declarations
// using the `asm target { }` BILD extension for cross-arch dispatch.
//
// Usage:
//   import { syscall3 } from "std/syscall.bv";
//   let result: Int = syscall3(0, 1, addr, 8);  // SYS_read on Linux x86_64
//
// Each syscall takes a syscall number as the first argument, followed by
// the syscall arguments (up to 6). Unused arguments should be 0.
//
// The `fallback` expression returns -1 for interpreter/non-LLVM targets.

// syscall6: Full 6-argument syscall
//   nr: Syscall number
//   a1-a6: Arguments (pass 0 for unused)
//   returns: Syscall result (negative = error, typically -errno on Linux)
inop! syscall6(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int, a6: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6);
        [arch("riscv64")]:
            "ecall"
            : "={a0},{a7},{a0},{a1},{a2},{a3},{a4},{a5}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;

// syscall5: 5-argument syscall
inop! syscall5(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0},{x1},{x2},{x3},{x4}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;

// syscall4: 4-argument syscall (most common on Linux)
inop! syscall4(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi},{rdx},{r10}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0},{x1},{x2},{x3}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3, i64 %a4);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;

// syscall3: 3-argument syscall (e.g., read, write, close)
inop! syscall3(nr: Int, a1: Int, a2: Int, a3: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi},{rdx}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0},{x1},{x2}"
            : (i64 %nr, i64 %a1, i64 %a2, i64 %a3);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;

// syscall2: 2-argument syscall (e.g., exit, getpid)
inop! syscall2(nr: Int, a1: Int, a2: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi},{rsi}"
            : (i64 %nr, i64 %a1, i64 %a2);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0},{x1}"
            : (i64 %nr, i64 %a1, i64 %a2);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;

// syscall1: 1-argument syscall (e.g., exit, brk)
inop! syscall1(nr: Int, a1: Int) -> Int
    [nr > 0][nr < 512]
{
    %res = asm target {
        [arch("x86_64")]:
            "syscall"
            : "={rax},{rax},{rdi}"
            : (i64 %nr, i64 %a1);
        [arch("aarch64")]:
            "svc #0"
            : "={x0},{x8},{x0}"
            : (i64 %nr, i64 %a1);
        default:
            "ud2"
            : "=r"
            : ();
    };
    term %res;
} fallback -1;
