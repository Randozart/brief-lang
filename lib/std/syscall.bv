// Syscall — Architecture-generic syscall interface
// Tier 1: Primitives
//
// Provides syscall1 through syscall6 using the SysCall# intrinsic,
// which handles architecture dispatch internally.
//
// Usage:
//   import { syscall3 } from "std/syscall.bv";
//   let result: Int = syscall3(0, 1, addr, 8);  // SYS_read on Linux x86_64
//
// Each syscall takes a syscall number as the first argument, followed by
// the syscall arguments (up to 6). Unused arguments should be 0.
// SysCall# has observable: true and is always available.

// syscall6: Full 6-argument syscall
defn syscall6(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int, a6: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1, a2, a3, a4, a5, a6);
};

// syscall5: 5-argument syscall
defn syscall5(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1, a2, a3, a4, a5);
};

// syscall4: 4-argument syscall (most common on Linux)
defn syscall4(nr: Int, a1: Int, a2: Int, a3: Int, a4: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1, a2, a3, a4);
};

// syscall3: 3-argument syscall (e.g., read, write, close)
defn syscall3(nr: Int, a1: Int, a2: Int, a3: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1, a2, a3);
};

// syscall2: 2-argument syscall (e.g., exit, getpid)
defn syscall2(nr: Int, a1: Int, a2: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1, a2);
};

// syscall1: 1-argument syscall (e.g., exit, brk)
defn syscall1(nr: Int, a1: Int) -> Int
    [nr > 0][nr < 512]
{
    term SysCall#(nr, a1);
};
