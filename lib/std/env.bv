// Environment variable reader — called at init_state() time
// so the bound is a runtime value the compiler cannot constant-fold.
// Returns 0 if the env var is missing or unparseable.
// Replaced: frgn __get_env_int with getenv_int# intrinsic.
defn __get_env_int(name: String) -> Int {
    term getenv_int#(name);
};
