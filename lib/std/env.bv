// 2026-07-19: Environment variable access. Replaces GetEnv#/GetEnvInt# intrinsics.
// Pure-Briev wrappers around C runtime helpers. The !GetEnv/!GetEnvInt plugin
// dispatches to these based on the expected return type.
//
// Usage:
//   let val: Int = !GetEnvInt("BOUND");
//   let val: String = !GetEnv("PATH");

import "std/ffi/env.bv";

// 2026-07-19: Named 'get_env' not 'getenv' to avoid conflict with C library.
defn get_env(key: String) -> String {
    term frgn__getenv_briev(key);
};

defn get_env_int(key: String) -> Int {
    term frgn__getenv_int(key);
};
