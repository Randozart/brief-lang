// HashMap<K, V> - Hash-based map implementation
// Requires K: Hash + Eq trait bounds

// ===== NATIVE DEFINITIONS =====

// Construction
defn new_map<K, V>() -> HashMap<K, V> [true][result.len() == 0] {
    term HashMap::empty();
};

defn with_capacity<K, V>(capacity: Int) -> HashMap<K, V> [capacity > 0][result.len() == 0] {
    term HashMap::with_capacity(capacity);
};

// Basic operations
defn insert<K, V>(map: HashMap<K, V>, key: K, value: V) 
    [true][result.contains_key(key) && result.get(key) == Some(value)] 
    -> HashMap<K, V> 
{
    term map.insert(key, value);
};

defn get<K, V>(map: HashMap<K, V>, key: K) 
    [true][true] 
    -> Option<V> 
{
    term map.get(key);
};

defn contains_key<K, V>(map: HashMap<K, V>, key: K) 
    [true][result == true || result == false] 
    -> Bool 
{
    term map.contains_key(key);
};

defn remove<K, V>(map: HashMap<K, V>, key: K) 
    [map.contains_key(key)][!result.contains_key(key)] 
    -> HashMap<K, V> 
{
    term map.remove(key);
};

// Metadata
defn len<K, V>(map: HashMap<K, V>) 
    [true][result >= 0] 
    -> Int 
{
    term map.len();
};

defn is_empty<K, V>(map: HashMap<K, V>) 
    [true][result == true || result == false] 
    -> Bool 
{
    term map.len() == 0;
};

// Iteration
defn keys<K, V>(map: HashMap<K, V>) 
    [true][result.len() == map.len()] 
    -> List<K> 
{
    term map.keys();
};

defn values<K, V>(map: HashMap<K, V>) 
    [true][result.len() == map.len()] 
    -> List<V> 
{
    term map.values();
};

defn iter<K, V>(map: HashMap<K, V>) 
    [true][result.len() == map.len()] 
    -> List<(K, V)> 
{
    term map.iter();
};

// Advanced operations
defn merge<K, V>(a: HashMap<K, V>, b: HashMap<K, V>) 
    [true][result.len() >= a.len() && result.len() <= a.len() + b.len()] 
    -> HashMap<K, V> 
{
    let result = a;
    let keys = b.keys();
    let i: Int = 0;
    [i < keys.len()] {
        let key = keys[i];
        let value = b.get(key).unwrap();
        &result = result.insert(key, value);
        &i = i + 1;
    };
    term result;
};

defn filter<K, V>(map: HashMap<K, V>, pred: (K, V) -> Bool) 
    [true][result.len() <= map.len()] 
    -> HashMap<K, V> 
{
    let result = new_map<K, V>();
    let keys = map.keys();
    let i: Int = 0;
    [i < keys.len()] {
        let key = keys[i];
        let value = map.get(key).unwrap();
        [pred(key, value)] {
            &result = result.insert(key, value);
        };
        &i = i + 1;
    };
    term result;
};

defn clear<K, V>(map: HashMap<K, V>) 
    [true][result.len() == 0] 
    -> HashMap<K, V> 
{
    term new_map<K, V>();
};

// Entry API (for efficient insert-or-update)
defn entry<K, V>(map: HashMap<K, V>, key: K) 
    [true][true] 
    -> Entry<K, V> 
{
    term map.entry(key);
};
