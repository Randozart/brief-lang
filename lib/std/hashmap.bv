// HashMap<K, V> - Hash-based map implementation
// Uses list of key-value pairs with linear search
// Backends optimize to native hash tables

// ===== STRUCT DEFINITION =====

struct HashMap<K, V> {
    entries: List<(K, V)>
};

// ===== CONSTRUCTION =====

defn new_map<K, V>() -> HashMap<K, V> [true][term.len() == 0] {
    term HashMap { entries: [] };
};

defn with_capacity<K, V>(capacity: Int) -> HashMap<K, V> [capacity > 0][term.len() == 0] {
    term HashMap { entries: [] };
};

// ===== BASIC OPERATIONS =====

defn insert<K, V>(map: HashMap<K, V>, key: K, value: V) 
    [true][term.contains_key(key) && term.get(key) == Some(value)] 
    -> HashMap<K, V> 
{
    [map.contains_key(key)] {
        let idx: Int = map.find_index(key);
        let new_entries: List<(K, V)> = map.entries.set(idx, (key, value));
        term HashMap { entries: new_entries };
    };
    let new_entries: List<(K, V)> = map.entries + [(key, value)];
    term HashMap { entries: new_entries };
};

defn get<K, V>(map: HashMap<K, V>, key: K) 
    [true][term.is_some() == map.contains_key(key)] 
    -> Option<V> 
{
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, v) = map.entries[i];
        [k == key] {
            term Some(v);
        };
        &i = i + 1;
    };
    term None;
};

defn contains_key<K, V>(map: HashMap<K, V>, key: K) 
    [true][term == true || term == false] 
    -> Bool 
{
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, _) = map.entries[i];
        [k == key] {
            term true;
        };
        &i = i + 1;
    };
    term false;
};

defn remove<K, V>(map: HashMap<K, V>, key: K) 
    [map.contains_key(key)][!term.contains_key(key)] 
    -> HashMap<K, V> 
{
    let new_entries: List<(K, V)> = [];
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, _) = map.entries[i];
        [k != key] {
            &new_entries = new_entries + [map.entries[i]];
        };
        &i = i + 1;
    };
    term HashMap { entries: new_entries };
};

// ===== METADATA =====

defn len<K, V>(map: HashMap<K, V>) 
    [true][term >= 0] 
    -> Int 
{
    term map.entries.len();
};

defn is_empty<K, V>(map: HashMap<K, V>) 
    [true][term == true || term == false] 
    -> Bool 
{
    term map.entries.len() == 0;
};

// ===== ITERATION =====

defn keys<K, V>(map: HashMap<K, V>) 
    [true][term.len() == map.entries.len()] 
    -> List<K> 
{
    let result: List<K> = [];
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, _) = map.entries[i];
        &result = result + [k];
        &i = i + 1;
    };
    term result;
};

defn values<K, V>(map: HashMap<K, V>) 
    [true][term.len() == map.entries.len()] 
    -> List<V> 
{
    let result: List<V> = [];
    let i: Int = 0;
    [i < map.entries.len()] {
        let (_, v) = map.entries[i];
        &result = result + [v];
        &i = i + 1;
    };
    term result;
};

defn iter<K, V>(map: HashMap<K, V>) 
    [true][term.len() == map.entries.len()] 
    -> List<(K, V)> 
{
    term map.entries;
};

// ===== COMBINATION =====

defn merge<K, V>(a: HashMap<K, V>, b: HashMap<K, V>) 
    [true][term.len() >= a.len()] 
    -> HashMap<K, V> 
{
    let result: HashMap<K, V> = a;
    let i: Int = 0;
    [i < b.entries.len()] {
        let (k, v) = b.entries[i];
        &result = result.insert(k, v);
        &i = i + 1;
    };
    term result;
};

defn filter<K, V>(map: HashMap<K, V>, pred: (K, V) -> Bool) 
    [true][term.len() <= map.len()] 
    -> HashMap<K, V> 
{
    let result: HashMap<K, V> = new_map();
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, v) = map.entries[i];
        [pred(k, v)] {
            &result = result.insert(k, v);
        };
        &i = i + 1;
    };
    term result;
};

defn clear<K, V>(map: HashMap<K, V>) 
    [true][term.len() == 0] 
    -> HashMap<K, V> 
{
    term HashMap { entries: [] };
};

// ===== ENTRY API =====

defn entry<K, V>(map: HashMap<K, V>, key: K) 
    [true][term.is_some() == map.contains_key(key)] 
    -> Option<V> 
{
    term map.get(key);
};

// ===== INTERNAL HELPERS =====

defn find_index<K, V>(map: HashMap<K, V>, key: K) 
    [map.contains_key(key)][term >= 0 && term < map.entries.len()] 
    -> Int 
{
    let i: Int = 0;
    [i < map.entries.len()] {
        let (k, _) = map.entries[i];
        [k == key] {
            term i;
        };
        &i = i + 1;
    };
    term -1;
};
