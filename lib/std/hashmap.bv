// HashMap - a hash map over the `obj HashMap<K, V>` in std/collections.bv
// Tier 9: Standard Library Extensions
//
// 2026-08-17 (storage + tuple correctness, plan
// 2026-08-17-hashmap-storage-tuple-correctness.md): rewritten on the TUPLE
// PAIR surface. `HashMap<K,V>` is a hand-written collection obj: state fields
// UNPACK to SoA columns (the compiler's efficiency decision), locals box. The
// element type is the `(K, V)` pair — `m.insert((k, v))`, `m.get(k)`,
// `m.contains(k)`, `m.remove(k)`, `m.Count#()`.
//
// USE: call the MEMBER methods directly on the map (`m.insert((k, v))`,
// `m.get(k)`) — a local map works, and a state map works in the node body.
// The defn-wrapper form (`insert(map, k, v)` returning a mutated map) is NOT
// safe: a map passed as a defn param then mutated via a member hits a
// pre-existing member-on-param codegen bug (BUGS.md). Iteration
// (keys/values/entries/foreach) is blocked on a pre-existing
// member-inline+foreach register-collision bug (BUGS.md).

import { HashMap } from "std/collections.bv";

defn new_map<K,V>() -> HashMap<K,V> {
    let m: HashMap<K,V> = 0;
    term m;
};

defn with_capacity<K,V>(capacity: Int) -> HashMap<K,V> {
    let m: HashMap<K,V> = 0;
    term m;
};

defn len<K,V>(map: HashMap<K,V>) -> Int {
    term map.Count#();
};

defn is_empty<K,V>(map: HashMap<K,V>) -> Bool {
    term map.Count#() == 0;
};

defn contains_key<K,V>(map: HashMap<K,V>, key: K) -> Bool {
    term map.contains(key);
};

defn get<K,V>(map: HashMap<K,V>, key: K) -> V {
    term map.get(key);
};
