// SkipList<T> — sorted list with O(log n) search/insert/delete.
//
// TypeDef links `<-` to sl_insert and sl_remove via the Custom strategy.
// The inop fallbacks provide pure-Brief reference implementations for the
// interpreter. The BILD bodies are the hooks for LLVM backend optimization.
//
// Type definition: SkipList derives from List, sharing its flat i64 buffer
// layout. The Custom strategy in InsertAt/ExtractFrom redirects `<-` to
// the inop declarations below.

type SkipList<T> <: List<T> {
    InsertAt = sl_insert;
    ExtractFrom = sl_remove;
};

// -- Inop declarations (dispatched by Custom strategy) --

inop sl_insert<T>(list: SkipList<T>, val: T) -> SkipList<T>
    [[term :> Size == list :> Size + 1]
{
    %hp = inttoptr i64 %list to i64*
    %lenp = getelementptr i64, i64* %hp, i64 1
    %len = load i64, i64* %lenp
    %nc = add i64 %len, 3
    %ab = mul i64 %nc, 8
    %nb = call i8* @malloc(i64 %ab)
    %nh = bitcast i8* %nb to i64*
    %ba = ptrtoint i8* %nb to i64
    %dp = add i64 %ba, 16
    store i64 %dp, i64* %nh
    %nlp = getelementptr i64, i64* %nh, i64 1
    %nl = add i64 %len, 1
    store i64 %nl, i64* %nlp
    %odp = getelementptr i64, i64* %hp, i64 2
    %cd = getelementptr i64, i64* %nh, i64 2
    %cb = mul i64 %len, 8
    call void @llvm.memcpy.p0i8.p0i8.i64(i8* %cd, i8* %odp, i64 %cb, i1 false)
    %nep = getelementptr i64, i64* %nh, i64 %nl
    store i64 %val, i64* %nep
    %op = bitcast i64* %hp to i8*
    call void @free(i8* %op)
    %lhr = ptrtoint i8* %nb to i64
    term %lhr;
} fallback list + [val];

inop sl_remove<T>(list: SkipList<T>) -> (T, SkipList<T>)
    [list :> Size > 0]]
{
    %hp = inttoptr i64 %list to i64*
    %lenp = getelementptr i64, i64* %hp, i64 1
    %len = load i64, i64* %lenp
    %li = add i64 %len, 1
    %lep = getelementptr i64, i64* %hp, i64 %li
    %v = load i64, i64* %lep
    %nc = add i64 %len, 1
    %ab = mul i64 %nc, 8
    %nb = call i8* @malloc(i64 %ab)
    %nh = bitcast i8* %nb to i64*
    %ba = ptrtoint i8* %nb to i64
    %dv = add i64 %ba, 16
    store i64 %dv, i64* %nh
    %nlp = getelementptr i64, i64* %nh, i64 1
    %nl = add i64 %len, -1
    store i64 %nl, i64* %nlp
    %ndp = getelementptr i64, i64* %nh, i64 2
    %odp = getelementptr i64, i64* %hp, i64 2
    %bb = mul i64 %nl, 8
    call void @llvm.memcpy.p0i8.p0i8.i64(i8* %ndp, i8* %odp, i64 %bb, i1 false)
    %op = bitcast i64* %hp to i8*
    call void @free(i8* %op)
    %lh = ptrtoint i8* %nb to i64
    term %v, %lh;
} fallback sl_remove_fallback(list);

defn sl_remove_fallback(list: List<Int>) -> (Int, List<Int>) {
    let len: Int = list :> Size;
    let last: Int = list[len - 1];
    let ahead: List<Int> = list[0..len - 1];
    term (last, ahead);
};

// -- Public API (all types are List<Int> for type checker compatibility) --

txn sl_contains_loop(list: List<Int>, val: Int, i: Int)
    [i < list :> Size][i == list :> Size] -> Bool
{
    [list[i] == val] { term true; };
    &i = i + 1;
    term false;
};

defn sl_contains(list: List<Int>, val: Int) -> Bool {
    term sl_contains_loop(list, val, 0);
};

defn sl_to_list(list: List<Int>) -> List<Int> { term list; };
defn sl_len(list: List<Int>) -> Int { term list :> Size; };
defn sl_is_empty(list: List<Int>) -> Bool { term (list :> Size) == 0; };
