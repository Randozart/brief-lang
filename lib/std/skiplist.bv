// SkipList<T> — sorted list with O(log n) search/insert/delete.
//
// TypeDef links `<-` to sl_insert and sl_remove via the Custom strategy.
// The defn bodies delegate to the List<- fallback for correctness, keeping
// the public API identical. A future optimization pass can replace these
// with Malloc#/Copy#/Free# based implementations.
//
// Type definition: SkipList derives from List, sharing its flat i64 buffer
// layout. The Custom strategy in InsertAt/ExtractFrom redirects `<-` to
// the defn declarations below.

type SkipList<T> <: List<T> {
    InsertAt <~ sl_insert;
    ExtractFrom <~ sl_remove;
};

// -- Defn wrappers (replacing former inop declarations) --

defn sl_insert<T>(list: SkipList<T>, val: T) -> SkipList<T>
    [[term :> Size == list :> Size + 1]
{
    term sl_append(list, val);
};

defn sl_append(list: List<Int>, val: Int) -> List<Int> {
    &list <- val;
    term list;
};

defn sl_remove<T>(list: SkipList<T>) -> (T, SkipList<T>)
    [list :> Size > 0]]
{
    term sl_remove_fallback(list);
};

defn sl_remove_fallback(list: List<Int>) -> (Int, List<Int>) {
    let len: Int = list :> Size;
    let last: Int = list[len - 1];
    let ahead: List<Int> = list[0..len - 1];
    term (last, ahead);
};

// -- Public API (all types are List<Int> for type checker compatibility) --

txn sl_contains_loop(list: List<Int>, val: Int, i: Int)
    [i < list :> Size][i == list :> Size] -> Bool
{
    [list[i] == val] { term true; };
    &i = i + 1;
    term false;
};

defn sl_contains(list: List<Int>, val: Int) -> Bool {
    term sl_contains_loop(list, val, 0);
};

defn sl_to_list(list: List<Int>) -> List<Int> { term list; };
defn sl_len(list: List<Int>) -> Int { term list :> Size; };
defn sl_is_empty(list: List<Int>) -> Bool { term (list :> Size) == 0; };
