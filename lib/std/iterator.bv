// Iterator - Iterator trait and adapters
// Tier 9: Standard Library Extensions
//
// All iterative operations use `txn` (convergent transaction) with
// `[pre][post]` contracts for looping.  The `_loop` suffix marks txns
// that take accumulator parameters (`result`, `i`) — the defn wrappers
// provide initial values so the public API is unchanged.

// ===== ITERATOR ADAPTERS =====

// Map over iterator
txn iter_map_loop<T, U>(list: List<T>, f: T -> U, result: List<U>, i: Int)
    [i < list .^Length][i == list .^Length] -> List<U>
{
    result = result.append(f(list[i]));
    i = i + 1;
    term result;
};

defn iter_map<T, U>(list: List<T>, f: T -> U) -> List<U> [true][term .^Length == list .^Length] {
    term iter_map_loop(list, f, [], 0);
};

// Filter iterator
txn iter_filter_loop<T>(list: List<T>, pred: T -> Bool, result: List<T>, i: Int)
    [i < list .^Length][i == list .^Length] -> List<T>
{
    when pred(list[i]) {
        result = result.append(list[i]);
    };
    i = i + 1;
    term result;
};

defn iter_filter<T>(list: List<T>, pred: T -> Bool) -> List<T> [true][term .^Length <= list .^Length] {
    term iter_filter_loop(list, pred, [], 0);
};

// Fold (reduce) iterator
txn iter_fold_loop<T, U>(list: List<T>, f: (U, T) -> U, acc: U, i: Int)
    [i < list .^Length][i == list .^Length] -> U
{
    acc = f(acc, list[i]);
    i = i + 1;
    term acc;
};

defn iter_fold<T, U>(list: List<T>, initial: U, f: (U, T) -> U) -> U [f != null][true] {
    term iter_fold_loop(list, f, initial, 0);
};

// Take first n items
txn iter_take_loop<T>(list: List<T>, n: Int, result: List<T>, i: Int)
    [i < n && i < list .^Length][i == n || i == list .^Length] -> List<T>
{
    result = result.append(list[i]);
    i = i + 1;
    term result;
};

defn iter_take<T>(list: List<T>, n: Int) -> List<T> [n >= 0][term .^Length == n.min(list .^Length)] {
    term iter_take_loop(list, n, [], 0);
};

// Skip first n items
txn iter_skip_loop<T>(list: List<T>, n: Int, result: List<T>, i: Int)
    [i < list .^Length][i == list .^Length] -> List<T>
{
    result = result.append(list[i]);
    i = i + 1;
    term result;
};

defn iter_skip<T>(list: List<T>, n: Int) -> List<T> [n >= 0][term .^Length == (list .^Length - n).max(0)] {
    term iter_skip_loop(list, n, [], n);
};

// Enumerate (index, value)
txn iter_enumerate_loop<T>(list: List<T>, result: List<(Int, T)>, i: Int)
    [i < list .^Length][i == list .^Length] -> List<(Int, T)>
{
    result = result.append((i, list[i]));
    i = i + 1;
    term result;
};

defn iter_enumerate<T>(list: List<T>) -> List<(Int, T)> [true][term .^Length == list .^Length] {
    term iter_enumerate_loop(list, [], 0);
};

// Find first matching
txn iter_find_loop<T>(list: List<T>, pred: T -> Bool, i: Int)
    [i < list .^Length][i == list .^Length] -> Option<T>
{
    when pred(list[i]) {
        term Some(list[i]);
    };
    i = i + 1;
    term None;
};

defn iter_find<T>(list: List<T>, pred: T -> Bool) -> Option<T> [pred != null][true] {
    term iter_find_loop(list, pred, 0);
};

// Check if any match
txn iter_any_loop<T>(list: List<T>, pred: T -> Bool, i: Int)
    [i < list .^Length][i == list .^Length] -> Bool
{
    when pred(list[i]) {
        term true;
    };
    i = i + 1;
    term false;
};

defn iter_any<T>(list: List<T>, pred: T -> Bool) -> Bool [true][term == true || term == false] {
    term iter_any_loop(list, pred, 0);
};

// Check if all match
txn iter_all_loop<T>(list: List<T>, pred: T -> Bool, i: Int)
    [i < list .^Length][i == list .^Length] -> Bool
{
    when !pred(list[i]) {
        term false;
    };
    i = i + 1;
    term true;
};

defn iter_all<T>(list: List<T>, pred: T -> Bool) -> Bool [true][term == true || term == false] {
    term iter_all_loop(list, pred, 0);
};

// Collect into list (identity for List)
defn iter_collect<T>(list: List<T>) -> List<T> [true][term .^Length == list .^Length] {
    term list;
};

// Chain two iterators (pure concatenation, no loop needed)
defn iter_chain<T>(a: List<T>, b: List<T>) -> List<T> [true][term .^Length == a .^Length + b .^Length] {
    term a + b;
};

// Flat map (map then flatten)
txn iter_flatmap_loop<T, U>(list: List<T>, f: T -> List<U>, result: List<U>, i: Int, j: Int)
    [i < list .^Length][i == list .^Length] -> List<U>
{
    let mapped = f(list[i]);
    when j < mapped .^Length {
        result = result.append(mapped[j]);
        j = j + 1;
    };
    i = i + 1;
    term result;
};

defn iter_flatmap<T, U>(list: List<T>, f: T -> List<U>) -> List<U> [f != null][true] {
    term iter_flatmap_loop(list, f, [], 0, 0);
};

// Partition into two lists
txn iter_partition_loop<T>(list: List<T>, pred: T -> Bool, trues: List<T>, falses: List<T>, i: Int)
    [i < list .^Length][i == list .^Length] -> (List<T>, List<T>)
{
    when pred(list[i]) {
        trues = trues.append(list[i]);
    };
    when !pred(list[i]) {
        falses = falses.append(list[i]);
    };
    i = i + 1;
    term (trues, falses);
};

defn iter_partition<T>(list: List<T>, pred: T -> Bool) -> (List<T>, List<T>) [pred != null][true] {
    term iter_partition_loop(list, pred, [], [], 0);
};

// Zip two iterators
txn iter_zip_loop<T, U>(a: List<T>, b: List<U>, result: List<(T, U)>, i: Int)
    [i < a .^Length && i < b .^Length][i == a .^Length || i == b .^Length] -> List<(T, U)>
{
    result = result.append((a[i], b[i]));
    i = i + 1;
    term result;
};

defn iter_zip<T, U>(a: List<T>, b: List<U>) -> List<(T, U)> [true][term .^Length == a .^Length.min(b .^Length)] {
    term iter_zip_loop(a, b, [], 0);
};

// Sum of numeric list (pure defn, delegates to fold)
defn iter_sum(list: List<Int>) -> Int [true][term >= 0] {
    term iter_fold_loop(list, |acc, x| acc + x, 0, 0);
};

// Product of numeric list (pure defn, delegates to fold)
defn iter_product(list: List<Int>) -> Int [true][term >= 0] {
    term iter_fold_loop(list, |acc, x| acc * x, 1, 0);
};

// Maximum element
txn iter_max_loop<T>(list: List<T>, max_val: T, i: Int)
    [i < list .^Length][i == list .^Length] -> Option<T>
{
    when list[i] > max_val {
        max_val = list[i];
    };
    i = i + 1;
    term Some(max_val);
};

defn iter_max<T>(list: List<T>) -> Option<T> [list .^Length > 0][true] {
    term iter_max_loop(list, list[0], 1);
};

// Minimum element
txn iter_min_loop<T>(list: List<T>, min_val: T, i: Int)
    [i < list .^Length][i == list .^Length] -> Option<T>
{
    when list[i] < min_val {
        min_val = list[i];
    };
    i = i + 1;
    term Some(min_val);
};

defn iter_min<T>(list: List<T>) -> Option<T> [list .^Length > 0][true] {
    term iter_min_loop(list, list[0], 1);
};
