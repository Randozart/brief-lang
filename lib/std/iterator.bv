// Iterator - Iterator trait and adapters
// Tier 9: Standard Library Extensions
//
// All iterative operations use `txn` (convergent transaction) with
// `[pre][post]` contracts for looping.  The `_loop` suffix marks txns
// that take accumulator parameters (`result`, `i`) — the defn wrappers
// provide initial values so the public API is unchanged.

// ===== ITERATOR ADAPTERS =====

// Map over iterator
txn iter_map_loop<T, U>(list: List<T>, f: T -> U, result: List<U>, i: Int)
    [i < list.Count#()][i == list.Count#()] -> List<U>
{
    result <- f(list[i]);
    i = i + 1;
    term result;
};

defn iter_map<T, U>(list: List<T>, f: T -> U) -> List<U> [true][term.Count#() == list.Count#()] {
    term iter_map_loop(list, f, [], 0);
};

// Filter iterator
txn iter_filter_loop<T>(list: List<T>, pred: T -> Bool, result: List<T>, i: Int)
    [i < list.Count#()][i == list.Count#()] -> List<T>
{
    when pred(list[i]) {
        result <- list[i];
    };
    i = i + 1;
    term result;
};

defn iter_filter<T>(list: List<T>, pred: T -> Bool) -> List<T> [true][term.Count#() <= list.Count#()] {
    term iter_filter_loop(list, pred, [], 0);
};

// Fold (reduce) iterator
txn iter_fold_loop<T, U>(list: List<T>, f: (U, T) -> U, acc: U, i: Int)
    [i < list.Count#()][i == list.Count#()] -> U
{
    acc = f(acc, list[i]);
    i = i + 1;
    term acc;
};

defn iter_fold<T, U>(list: List<T>, initial: U, f: (U, T) -> U) -> U [f != null][true] {
    term iter_fold_loop(list, f, initial, 0);
};

// Take first n items
txn iter_take_loop<T>(list: List<T>, n: Int, result: List<T>, i: Int)
    [i < n && i < list.Count#()][i == n || i == list.Count#()] -> List<T>
{
    result <- list[i];
    i = i + 1;
    term result;
};

defn iter_take<T>(list: List<T>, n: Int) -> List<T> [n >= 0][term.Count#() == n.min(list.Count#())] {
    term iter_take_loop(list, n, [], 0);
};

// Skip first n items
txn iter_skip_loop<T>(list: List<T>, n: Int, result: List<T>, i: Int)
    [i < list.Count#()][i == list.Count#()] -> List<T>
{
    result <- list[i];
    i = i + 1;
    term result;
};

defn iter_skip<T>(list: List<T>, n: Int) -> List<T> [n >= 0][term.Count#() == (list.Count#() - n).max(0)] {
    term iter_skip_loop(list, n, [], n);
};

// Enumerate (index, value)
txn iter_enumerate_loop<T>(list: List<T>, result: List<(Int, T)>, i: Int)
    [i < list.Count#()][i == list.Count#()] -> List<(Int, T)>
{
    result <- (i, list[i]);
    i = i + 1;
    term result;
};

defn iter_enumerate<T>(list: List<T>) -> List<(Int, T)> [true][term.Count#() == list.Count#()] {
    term iter_enumerate_loop(list, [], 0);
};

// Find first matching
// 2026-08-14 (stdlib-cleanup): `iter_find`/`iter_max`/`iter_min` returned
// `Option<T>` via `Some(...)`/`None` — the enum VALUE system (variant
// construction, `uni` matching) is not implemented end-to-end in the compiler
// (see BUGS.md "stdlib iterator.bv / hashmap.bv written aspirationally"). The
// adapters are removed until that feature lands; the rest of the file compiles
// and runs.

// Check if any match
txn iter_any_loop<T>(list: List<T>, pred: T -> Bool, i: Int)
    [i < list.Count#()][i == list.Count#()] -> Bool
{
    when pred(list[i]) {
        term true;
    };
    i = i + 1;
    term false;
};

defn iter_any<T>(list: List<T>, pred: T -> Bool) -> Bool [true][term == true || term == false] {
    term iter_any_loop(list, pred, 0);
};

// Check if all match
txn iter_all_loop<T>(list: List<T>, pred: T -> Bool, i: Int)
    [i < list.Count#()][i == list.Count#()] -> Bool
{
    when !pred(list[i]) {
        term false;
    };
    i = i + 1;
    term true;
};

defn iter_all<T>(list: List<T>, pred: T -> Bool) -> Bool [true][term == true || term == false] {
    term iter_all_loop(list, pred, 0);
};

// Collect into list (identity for List)
defn iter_collect<T>(list: List<T>) -> List<T> [true][term.Count#() == list.Count#()] {
    term list;
};

// Chain two iterators (concatenation)
// 2026-08-14 (stdlib-cleanup): the original `term a + b` needed a `+` (Concat)
// op on List, which the compiler never declared — rewrite as the canonical
// txn loop with InsertAt (the adapter pattern used by the other adapters).
txn iter_chain_loop<T>(a: List<T>, b: List<T>, result: List<T>, i: Int)
    [i < a.Count#() + b.Count#()][i == a.Count#() + b.Count#()] -> List<T>
{
    when i < a.Count#() {
        result <- a[i];
    };
    when i >= a.Count#() {
        result <- b[i - a.Count#()];
    };
    i = i + 1;
    term result;
};

defn iter_chain<T>(a: List<T>, b: List<T>) -> List<T> [true][term.Count#() == a.Count#() + b.Count#()] {
    term iter_chain_loop(a, b, [], 0);
};

// Flat map (map then flatten)
txn iter_flatmap_loop<T, U>(list: List<T>, f: T -> List<U>, result: List<U>, i: Int, j: Int)
    [i < list.Count#()][i == list.Count#()] -> List<U>
{
    let mapped = f(list[i]);
    when j < mapped.Count#() {
        result <- mapped[j];
        j = j + 1;
    };
    i = i + 1;
    term result;
};

defn iter_flatmap<T, U>(list: List<T>, f: T -> List<U>) -> List<U> [f != null][true] {
    term iter_flatmap_loop(list, f, [], 0, 0);
};

// Partition into two lists
txn iter_partition_loop<T>(list: List<T>, pred: T -> Bool, trues: List<T>, falses: List<T>, i: Int)
    [i < list.Count#()][i == list.Count#()] -> (List<T>, List<T>)
{
    when pred(list[i]) {
        trues <- list[i];
    };
    when !pred(list[i]) {
        falses <- list[i];
    };
    i = i + 1;
    term (trues, falses);
};

defn iter_partition<T>(list: List<T>, pred: T -> Bool) -> (List<T>, List<T>) [pred != null][true] {
    term iter_partition_loop(list, pred, [], [], 0);
};

// Zip two iterators
txn iter_zip_loop<T, U>(a: List<T>, b: List<U>, result: List<(T, U)>, i: Int)
    [i < a.Count#() && i < b.Count#()][i == a.Count#() || i == b.Count#()] -> List<(T, U)>
{
    result <- (a[i], b[i]);
    i = i + 1;
    term result;
};

defn iter_zip<T, U>(a: List<T>, b: List<U>) -> List<(T, U)> [true][term.Count#() == a.Count#().min(b.Count#())] {
    term iter_zip_loop(a, b, [], 0);
};

// Sum of numeric list (pure defn, delegates to fold)
defn iter_sum(list: List<Int>) -> Int [true][term >= 0] {
    term iter_fold_loop(list, (acc, x) -> acc + x, 0, 0);
};

// Product of numeric list (pure defn, delegates to fold)
defn iter_product(list: List<Int>) -> Int [true][term >= 0] {
    term iter_fold_loop(list, (acc, x) -> acc * x, 1, 0);
};
