// StringBuilder - Efficient string building
// Avoids O(n²) concatenation by using internal buffer

// ===== STRUCT DEFINITION =====

obj StringBuilder {
    buffer: String
};

// ===== CONSTRUCTION =====

defn new_builder() -> StringBuilder {
    term StringBuilder { buffer: "" };
};

defn with_capacity(capacity: Int) -> StringBuilder {
    term StringBuilder { buffer: "" };
};

// ===== APPEND OPERATIONS =====

defn append_char(builder: StringBuilder, c: Char) -> StringBuilder {
    term StringBuilder { buffer: builder.buffer + c as String };
};

defn append_str(builder: StringBuilder, s: String) -> StringBuilder {
    term StringBuilder { buffer: builder.buffer + s };
};

defn append_int(builder: StringBuilder, n: Int) -> StringBuilder {
    term StringBuilder { buffer: builder.buffer + n as String };
};

defn append_bool(builder: StringBuilder, b: Bool) -> StringBuilder {
    when b {
        term StringBuilder { buffer: builder.buffer + "true" };
    };
    term StringBuilder { buffer: builder.buffer + "false" };
};

defn append_float(builder: StringBuilder, f: Float) -> StringBuilder {
    term StringBuilder { buffer: builder.buffer + f as String };
};

// ===== CONVERSION =====

defn to_string(builder: StringBuilder) -> String {
    term builder.buffer;
};

defn clear(builder: StringBuilder) -> StringBuilder {
    term StringBuilder { buffer: "" };
};

// ===== METADATA =====

defn len(builder: StringBuilder)
    [true][term >= 0]
    -> Int
{
    term CharCount#(builder.buffer);
};

defn is_empty(builder: StringBuilder) -> Bool {
    term CharCount#(builder.buffer) == 0;
};

defn capacity(builder: StringBuilder)
    [true][term >= builder.buffer .^Length]
    -> Int
{
    term builder.buffer .^Length;
};
