// Process - Process spawning and environment
// Tier 8: Infrastructure

// ===== PROCESS SPAWNING (FFI) =====

frgn __spawn(command: String, args: List<String>) -> Result<Int, String>;
frgn __spawn_with_output(command: String, args: List<String>) -> Result<String, String>;
frgn __env_var(name: String) -> Result<String, String>;
frgn __set_env_var(name: String, value: String) -> Result<Void, String>;
frgn __current_dir() -> Result<String, String>;
frgn __set_current_dir(path: String) -> Result<Void, String>;

// ===== NATIVE WRAPPERS =====

defn spawn(command: String, args: List<String>) -> Int [command != ""][term >= -1] {
    let result = __spawn(command, args);
    [result.is_ok()] {
        term result.value;
    };
    term -1;
};

defn spawn_with_output(command: String, args: List<String>) -> String [command != ""][term.len() >= 0] {
    let result = __spawn_with_output(command, args);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn env_var(name: String) -> String [name != ""][term.len() >= 0] {
    let result = __env_var(name);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn set_env_var(name: String, value: String) -> Bool [name != ""][term == true || term == false] {
    let result = __set_env_var(name, value);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn current_dir() -> String [true][term.len() >= 0] {
    let result = __current_dir();
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn set_current_dir(path: String) -> Bool [path != ""][term == true || term == false] {
    let result = __set_current_dir(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

// ===== CONVENIENCE FUNCTIONS =====

defn run_command(command: String) -> Bool [command != ""][term == true || term == false] {
    let result = spawn(command, []);
    [result == 0] {
        term true;
    };
    term false;
};

defn run_command_with_args(command: String, args: List<String>) -> Bool [command != ""][term == true || term == false] {
    let result = spawn(command, args);
    [result == 0] {
        term true;
    };
    term false;
};

defn get_env_or_default(name: String, default: String) -> String [name != ""][term.len() >= 0] {
    let val = env_var(name);
    [val != ""] {
        term val;
    };
    term default;
};
