// Process - Process spawning and environment
// Tier 8: Infrastructure.
// 2026-08-23 (revival): Spawn#/SpawnWithOutput#/SetEnv#/GetCwd#/ChDir#
// registered with C runtime helpers (__briev_spawn etc. — system()/popen/
// setenv/getcwd/chdir). Commands are shell-interpreted single strings;
// pass arguments inside the command string. Result members use exhaustive
// match (no member syntax on enums).

import "std/result";

// ===== PROCESS SPAWNING (Intrinsics) =====

defn spawn_res(command: String) -> Result<Int, String> {
    let code = Spawn#(command);
    term Ok(code);
};

defn spawn_with_output_res(command: String) -> Result<String, String> {
    let output_text = SpawnWithOutput#(command);
    term Ok(output_text);
};

defn env_var_res(name: String) -> Result<String, String> {
    let val = get_env!(name);
    when val != "" {
        term Ok(val);
    };
    term Err("env var not found");
};

defn set_env_var_res(name: String, value: String) -> Result<Int, String> {
    let ret = SetEnv#(name, value);
    when ret == 0 {
        term Ok(ret);
    };
    term Err("setenv failed");
};

defn current_dir_res() -> Result<String, String> {
    let dir = GetCwd#();
    when dir != "" {
        term Ok(dir);
    };
    term Err("getcwd failed");
};

defn set_current_dir_res(path: String) -> Result<Int, String> {
    let ret = ChDir#(path);
    when ret == 0 {
        term Ok(ret);
    };
    term Err("chdir failed");
};

// ===== NATIVE WRAPPERS =====

defn run(command: String) -> Int [command != ""] {
    let result = spawn_res(command);
    term match result {
        Ok(code) => code,
        Err(_) => 0 - 1,
    };
};

defn spawn_with_output(command: String) -> String [command != ""] {
    let result = spawn_with_output_res(command);
    term match result {
        Ok(output_text) => output_text,
        Err(_) => "",
    };
};

defn env_var(name: String) -> String [name != ""] {
    let result = env_var_res(name);
    term match result {
        Ok(v) => v,
        Err(_) => "",
    };
};

defn set_env_var(name: String, value: String) -> Bool [name != ""] {
    let result = set_env_var_res(name, value);
    term match result {
        Ok(_) => true,
        Err(_) => false,
    };
};

defn current_dir() -> String {
    let result = current_dir_res();
    term match result {
        Ok(d) => d,
        Err(_) => "",
    };
};

defn set_current_dir(path: String) -> Bool [path != ""] {
    let result = set_current_dir_res(path);
    term match result {
        Ok(_) => true,
        Err(_) => false,
    };
};

// ===== CONVENIENCE FUNCTIONS =====

defn run_command(command: String) -> Bool [command != ""] {
    let result = run(command);
    term result == 0;
};

defn get_env_or_default(name: String, default: String) -> String [name != ""] {
    let val = env_var(name);
    when val != "" {
        term val;
    };
    term default;
};
