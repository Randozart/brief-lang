// Process - Process spawning and environment
// Tier 8: Infrastructure

import "std/result";

// ===== PROCESS SPAWNING (Intrinsics) =====
// Replaced: frgn __spawn/__spawn_with_output (TOML-based) with
// spawn#/spawn_with_output# intrinsics. Remaining frgns (env_var,
// set_env_var, etc.) have no intrinsic equivalent yet.

defn __spawn(command: String, args: List<String>) -> Result<Int, String> {
    term spawn#(command, args);
};

defn __spawn_with_output(command: String, args: List<String>) -> Result<String, String> {
    term spawn_with_output#(command, args);
};

// Replaced: frgn __env_var with getenv# intrinsic
defn __env_var(name: String) -> Result<String, String> {
    let val = getenv#(name);
    [val != ""] {
        term Ok(val);
    };
    term Err("env var not found");
};

// Replaced: frgn __set_env_var with setenv# intrinsic
defn __set_env_var(name: String, value: String) -> Result<Void, String> {
    let ret = setenv#(name, value);
    [ret == 0] {
        term Ok(void);
    };
    term Err("setenv failed");
};

// Replaced: frgn __current_dir with getcwd# intrinsic
defn __current_dir() -> Result<String, String> {
    let dir = getcwd#();
    [dir != ""] {
        term Ok(dir);
    };
    term Err("getcwd failed");
};

// Replaced: frgn __set_current_dir with chdir# intrinsic
defn __set_current_dir(path: String) -> Result<Void, String> {
    let ret = chdir#(path);
    [ret == 0] {
        term Ok(void);
    };
    term Err("chdir failed");
};

// ===== NATIVE WRAPPERS =====

defn spawn(command: String, args: List<String>) -> Int [command != ""][term >= -1] {
    let result = __spawn(command, args);
    [is_ok(result)] {
        term unwrap(result);
    };
    term -1;
};

defn spawn_with_output(command: String, args: List<String>) -> String [command != ""][term :> Size >= 0] {
    let result = __spawn_with_output(command, args);
    [is_ok(result)] {
        term unwrap(result);
    };
    term "";
};

defn env_var(name: String) -> String [name != ""][term :> Size >= 0] {
    let result = __env_var(name);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn set_env_var(name: String, value: String) -> Bool [name != ""][term == true || term == false] {
    let result = __set_env_var(name, value);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn current_dir() -> String [true][term :> Size >= 0] {
    let result = __current_dir();
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn set_current_dir(path: String) -> Bool [path != ""][term == true || term == false] {
    let result = __set_current_dir(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

// ===== CONVENIENCE FUNCTIONS =====

defn run_command(command: String) -> Bool [command != ""][term == true || term == false] {
    let result = spawn(command, []);
    [result == 0] {
        term true;
    };
    term false;
};

defn run_command_with_args(command: String, args: List<String>) -> Bool [command != ""][term == true || term == false] {
    let result = spawn(command, args);
    [result == 0] {
        term true;
    };
    term false;
};

defn get_env_or_default(name: String, default: String) -> String [name != ""][term :> Size >= 0] {
    let val = env_var(name);
    [val != ""] {
        term val;
    };
    term default;
};
