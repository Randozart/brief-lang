// LLVM compiler intrinsics for float math.
// These have matching signatures in both Brief and LLVM IR.
// Other intrinsics (ctpop, ctlz, cttz, abs, bitreverse, fabs)
// are hardcoded in emit_declares() due to extra i1 parameters.

frgn sqrt_f32(x: Float) -> Float               as intrinsic "llvm.sqrt.f32" ;
frgn sqrt_f64(x: Float) -> Float                as intrinsic "llvm.sqrt.f64" ;
frgn ceil_f32(x: Float) -> Float                as intrinsic "llvm.ceil.f32" ;
frgn ceil_f64(x: Float) -> Float                as intrinsic "llvm.ceil.f64" ;
frgn floor_f32(x: Float) -> Float               as intrinsic "llvm.floor.f32" ;
frgn floor_f64(x: Float) -> Float               as intrinsic "llvm.floor.f64" ;
