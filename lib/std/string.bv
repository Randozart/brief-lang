defn pad_center(s: String, width: Int) [width >= s.len()][term.len() == width.max(s.len())] -> String {
    let padding: Int = width - s.len();
    let left_pad: Int = padding / 2;
    let right_pad: Int = padding - left_pad;
    
    let sb = new_builder();
    let i: Int = 0;
    [i < left_pad] {
        sb = sb.append_char(' ');
        &i = i + 1;
    };
    sb = sb.append_str(s);
    &i = 0;
    [i < right_pad] {
        sb = sb.append_char(' ');
        &i = i + 1;
    };
    term sb.to_string();
};

defn truncate(s: String, max_len: Int) [max_len >= 0][term.len() <= max_len] -> String {
    [s.len() <= max_len] {
        term s;
    };
    term s[0..max_len];
};

defn truncate_with_ellipsis(s: String, max_len: Int) [max_len >= 3][term.len() <= max_len] -> String {
    [s.len() <= max_len] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s[0..max_len-3]);
    sb = sb.append_str("...");
    term sb.to_string();
};

defn ensure_prefix(s: String, prefix: String) [true][term.len() >= s.len()] -> String {
    [s.starts_with(prefix)] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(prefix);
    sb = sb.append_str(s);
    term sb.to_string();
};

defn ensure_suffix(s: String, suffix: String) [true][term.len() >= s.len()] -> String {
    [s.ends_with(suffix)] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s);
    sb = sb.append_str(suffix);
    term sb.to_string();
};

defn remove_prefix(s: String, prefix: String) [true][term.len() <= s.len()] -> String {
    [s.starts_with(prefix)] {
        term s[prefix.len()..s.len()];
    };
    term s;
};

defn remove_suffix(s: String, suffix: String) [true][term.len() <= s.len()] -> String {
    [s.ends_with(suffix)] {
        term s[0..s.len()-suffix.len()];
    };
    term s;
};

defn strip_chars(s: String, chars: String) [true][term.len() <= s.len()] -> String {
    // Strip from left
    let start: Int = 0;
    [start < s.len()] {
        let c = s[start..start+1];
        [chars.contains(c)] {
            &start = start + 1;
        };
        [!chars.contains(c)] {
            break;
        };
    };
    
    // Strip from right
    let end: Int = s.len();
    [end > start] {
        let c = s[end-1..end];
        [chars.contains(c)] {
            &end = end - 1;
        };
        [!chars.contains(c)] {
            break;
        };
    };
    
    term s[start..end];
};

defn is_empty_str(s: String) [true][term == (s.len() == 0)] -> Bool {
    term s.len() == 0;
};

defn is_blank(s: String) [true][term == true || term == false] -> Bool {
    let i: Int = 0;
    [i < s.len()] {
        [!s[i..i+1].is_whitespace()] {
            term false;
        };
        &i = i + 1;
    };
    term true;
};
