// Standard String Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Brief.

// ===== PURE FOREIGN (requires external implementation) =====

// Case conversion
frgn __to_lower(s: String) -> Result<String, StringError>;
frgn __to_upper(s: String) -> Result<String, StringError>;
frgn __to_title(s: String) -> Result<String, StringError>;
frgn __is_lower(s: String) -> Result<Bool, StringError>;
frgn __is_upper(s: String) -> Result<Bool, StringError>;
// Whitespace checking
frgn __is_whitespace(s: String) -> Result<Bool, StringError>;
frgn __is_alpha(s: String) -> Result<Bool, StringError>;
frgn __is_alphanumeric(s: String) -> Result<Bool, StringError>;
frgn __is_numeric(s: String) -> Result<Bool, StringError>;
// Complex search (requires iteration)
frgn __contains_at(haystack: String, needle: String, start: Int) -> Result<Bool, StringError>;
frgn __find_from(s: String, needle: String, start: Int) -> Result<Int, StringError>;
frgn __rfind(s: String, needle: String) -> Result<Int, StringError>;
// Character operations
frgn __get_chars(s: String) -> Result<List<String>, StringError>;
frgn __utf8_len(s: String) -> Result<Int, StringError>;
// Escaping
frgn __escape(s: String) -> Result<String, StringError>;
frgn __unescape(s: String) -> Result<String, StringError>;
frgn __quote(s: String) -> Result<String, StringError>;
frgn __unquote(s: String) -> Result<String, StringError>;
// Encoding
frgn __bytes(s: String) -> Result<List<Int>, StringError>;
frgn __from_bytes(list: List<Int>) -> Result<String, StringError>;
// Complex replacement
frgn __replace_all(s: String, old: String, new: String) -> Result<String, StringError>;
// Split variations
frgn __splitn(s: String, delim: String, n: Int) -> Result<List<String>, StringError>;
frgn __rsplit(s: String, delim: String) -> Result<List<String>, StringError>;
frgn __words(s: String) -> Result<List<String>, StringError>;

// Truncation
frgn __truncate(s: String, max_len: Int) -> Result<String, StringError>;
frgn __truncate_with(s: String, max_len: Int, suffix: String) -> Result<String, StringError>;
// Comparison
frgn __eq_ignore_case(a: String, b: String) -> Result<Bool, StringError>;
frgn __cmp(s1: String, s2: String) -> Result<Int, StringError>;
// Parsing
frgn __parse_float(s: String) -> Result<Float, StringError>;
frgn __to_bool(s: String) -> Result<Bool, StringError>;
// ===== NATIVE DEFINITIONS =====

// Length
defn len(s: String) [s.len() >= 0][term == s.len()] -> Int {
  term s.len();
};

// Basic concatenation
defn concat(a: String, b: String) [true][term.len() == a.len() + b.len()] -> String {
  let result: String = a + b;
  term result;
};

defn append(s: String, c: String) [true][term.len() == s.len() + c.len()] -> String {
  let result: String = s + c;
  term result;
};

defn prepend(c: String, s: String) [true][term.len() == c.len() + s.len()] -> String {
  let result: String = c + s;
  term result;
};

// Trim operations
defn trim(s: String) [true][term.len() <= s.len()] -> String {
  term s;
};

defn trim_left(s: String) [true][term.len() <= s.len()] -> String {
  term s;
};

defn trim_right(s: String) [true][term.len() <= s.len()] -> String {
  term s;
};

defn trim_start(s: String) [true][term.len() <= s.len()] -> String {
  term s;
};

defn trim_end(s: String) [true][term.len() <= s.len()] -> String {
  term s;
};

// Basic search
defn contains(haystack: String, needle: String) [true][term == true || term == false] -> Bool {
  let found: Bool = false;
  let i: Int = 0;
  [i < haystack.len() && !found] {
    [i + needle.len() <= haystack.len()] {
      [haystack[i..i+needle.len()] == needle] {
        &found = true;
      };
    };
    &i = i + 1;
  };
  term found;
};

defn starts_with(s: String, prefix: String) [true][term == true || term == false] -> Bool {
  [prefix.len() > s.len()] {
    term false;
  };
  term s[0..prefix.len()] == prefix;
};

defn ends_with(s: String, suffix: String) [true][term == true || term == false] -> Bool {
  [suffix.len() > s.len()] {
    term false;
  };
  term s[s.len()-suffix.len()..s.len()] == suffix;
};

defn find(s: String, needle: String) [true][term >= -1] -> Int {
  let i: Int = 0;
  let idx: Int = -1;
  [i < s.len() && idx < 0] {
    [i + needle.len() <= s.len()] {
      [s[i..i+needle.len()] == needle] {
        &idx = i;
      };
    };
    &i = i + 1;
  };
  term idx;
};

// Character access
defn char_at(s: String, index: Int) [index >= 0 && index < s.len()][term.len() == 1] -> String {
  term s[index..index+1];
};

// Substring operations
defn substr(s: String, start: Int) [start >= 0 && start <= s.len()][term.len() == s.len() - start] -> String {
  term s[start..s.len()];
};

defn substr_range(s: String, start: Int, end: Int) [start >= 0 && end >= start && end <= s.len()][term.len() == end - start] -> String {
  term s[start..end];
};

// Single replace (native)
defn replace(s: String, old: String, new: String) [true][term.len() >= 0] -> String {
  let idx: Int = find(s, old);
  [idx >= 0] {
    let before: String = s[0..idx];
    let after: String = s[idx+old.len()..s.len()];
    term before + new + after;
  };
  term s;
};

// Split (basic version)
defn split(s: String, delim: String) [delim.len() > 0][true] -> List<String> {
  let result: List<String> = [];
  let i: Int = 0;
  let last: Int = 0;
  [i < s.len()] {
    [i + delim.len() <= s.len() && s[i..i+delim.len()] == delim] {
      &result = result + [s[last..i]];
      &last = i + delim.len();
      &i = i + delim.len();
    };
    [i + delim.len() > s.len() || s[i..i+delim.len()] != delim] {
      &i = i + 1;
    };
  };
  &result = result + [s[last..s.len()]];
  term result;
};

// Lines
defn lines(s: String) [true][term.len() >= 0] -> List<String> {
  let result: List<String> = split(s, "\n");
  term result;
};

// Join
defn join(list: List<String>, delim: String) [true][term.len() >= 0] -> String {
  [list.len() == 0] {
    term "";
  };
  let result: String = list[0];
  let i: Int = 1;
  [i < list.len()] {
    &result = result + delim + list[i];
    &i = i + 1;
  };
  term result;
};

// Padding (basic)
defn pad_left(s: String, width: Int) [width >= s.len()][term.len() == width.max(s.len())] -> String {
  let spaces: Int = width - s.len();
  [spaces > 0] {
    let pad: String = "";
    let i: Int = 0;
    [i < spaces] {
      &pad = pad + " ";
      &i = i + 1;
    };
    term pad + s;
  };
  term s;
};

defn pad_right(s: String, width: Int) [width >= s.len()][term.len() == width.max(s.len())] -> String {
  let spaces: Int = width - s.len();
  [spaces > 0] {
    let pad: String = "";
    let i: Int = 0;
    [i < spaces] {
      &pad = pad + " ";
      &i = i + 1;
    };
    term s + pad;
  };
  term s;
};

defn pad_both(s: String, width: Int) [width >= s.len()][term.len() == width.max(s.len())] -> String {
  let spaces: Int = width - s.len();
  [spaces > 0] {
    let left: Int = spaces / 2;
    let right: Int = spaces - left;
    let pad_left: String = "";
    let pad_right: String = "";
    let i: Int = 0;
    [i < left] {
      &pad_left = pad_left + " ";
      &i = i + 1;
    };
    &i = 0;
    [i < right] {
      &pad_right = pad_right + " ";
      &i = i + 1;
    };
    term pad_left + s + pad_right;
  };
  term s;
};

// Repeat
defn repeat(s: String, count: Int) [count >= 0][term.len() == s.len() * count] -> String {
  [count == 0] {
    term "";
  };
  let result: String = s;
  let i: Int = 1;
  [i < count] {
    &result = result + s;
    &i = i + 1;
  };
  term result;
};

// Type conversions
defn to_string(n: Int) [true][term.len() >= 0] -> String {
  term n;
};

defn to_float(s: String) [true][term >= 0.0 || term < 0.0] -> Float {
  term 0.0;
};

defn to_int(s: String) [true][term == 0 || term != 0] -> Int {
  term 0;
};
// ===== TIER 2: NATIVE CHARACTER CLASSIFICATION =====

defn is_whitespace_str(s: String) [true][term == true || term == false] -> Bool {
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        [!c.is_whitespace()] {
            term false;
        };
        &i = i + 1;
    };
    term true;
};

defn is_alpha_str(s: String) [true][term == true || term == false] -> Bool {
    [s.len() == 0] {
        term false;
    };
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        [!c.is_alpha()] {
            term false;
        };
        &i = i + 1;
    };
    term true;
};

defn is_numeric_str(s: String) [true][term == true || term == false] -> Bool {
    [s.len() == 0] {
        term false;
    };
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        [!c.is_digit()] {
            term false;
        };
        &i = i + 1;
    };
    term true;
};

defn to_lower_str(s: String) [true][term.len() == s.len()] -> String {
    let sb = new_builder();
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        sb = sb.append_char(c.to_lower());
        &i = i + 1;
    };
    term sb.to_string();
};

defn to_upper_str(s: String) [true][term.len() == s.len()] -> String {
    let sb = new_builder();
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        sb = sb.append_char(c.to_upper());
        &i = i + 1;
    };
    term sb.to_string();
};

defn trim_str(s: String) [true][term.len() <= s.len()] -> String {
    // Find first non-whitespace
    let start: Int = 0;
    [start < s.len() && s[start..start+1].is_whitespace()] {
        &start = start + 1;
    };
    
    // Find last non-whitespace
    let end: Int = s.len();
    [end > start && s[end-1..end].is_whitespace()] {
        &end = end - 1;
    };
    
    term s[start..end];
};

defn trim_left_str(s: String) [true][term.len() <= s.len()] -> String {
    let i: Int = 0;
    [i < s.len() && s[i..i+1].is_whitespace()] {
        &i = i + 1;
    };
    term s[i..s.len()];
};

defn trim_right_str(s: String) [true][term.len() <= s.len()] -> String {
    let end: Int = s.len();
    [end > 0 && s[end-1..end].is_whitespace()] {
        &end = end - 1;
    };
    term s[0..end];
};

defn capitalize(s: String) [true][term.len() == s.len()] -> String {
    [s.len() == 0] {
        term s;
    };
    let sb = new_builder();
    let first = s[0..1];
    sb = sb.append_char(first.to_upper());
    let i: Int = 1;
    [i < s.len()] {
        let c = s[i..i+1];
        sb = sb.append_char(c.to_lower());
        &i = i + 1;
    };
    term sb.to_string();
};

defn title_case(s: String) [true][term.len() == s.len()] -> String {
    let sb = new_builder();
    let new_word: Bool = true;
    let i: Int = 0;
    [i < s.len()] {
        let c = s[i..i+1];
        [c.is_whitespace()] {
            sb = sb.append_char(c);
            &new_word = true;
        };
        [!c.is_whitespace()] {
            [new_word] {
                sb = sb.append_char(c.to_upper());
                &new_word = false;
            };
            [!new_word] {
                sb = sb.append_char(c.to_lower());
            };
        };
        &i = i + 1;
    };
    term sb.to_string();
};

defn reverse_str(s: String) [true][term.len() == s.len()] -> String {
    let sb = new_builder();
    let i: Int = 0;
    [i < s.len()] {
        let c = s[s.len()-1-i..s.len()-i];
        sb = sb.append_char(c);
        &i = i + 1;
    };
    term sb.to_string();
};

defn count_char(s: String, c: Char) [true][term >= 0] -> Int {
    let count: Int = 0;
    let i: Int = 0;
    [i < s.len()] {
        [s[i..i+1] == c] {
            &count = count + 1;
        };
        &i = i + 1;
    };
    term count;
};

defn count_substr(s: String, substr: String) [substr.len() > 0][term >= 0] -> Int {
    let count: Int = 0;
    let i: Int = 0;
    [i <= s.len() - substr.len()] {
        [s[i..i+substr.len()] == substr] {
            &count = count + 1;
            &i = i + substr.len();
        };
        [s[i..i+substr.len()] != substr] {
            &i = i + 1;
        };
    };
    term count;
};

defn repeat_char(c: Char, n: Int) [n >= 0][term.len() == n] -> String {
    let sb = new_builder();
    let i: Int = 0;
    [i < n] {
        sb = sb.append_char(c);
        &i = i + 1;
    };
    term sb.to_string();
};

defn pad_center(s: String, width: Int) [width >= s.len()][term.len() == width.max(s.len())] -> String {
    let padding: Int = width - s.len();
    let left_pad: Int = padding / 2;
    let right_pad: Int = padding - left_pad;
    
    let sb = new_builder();
    let i: Int = 0;
    [i < left_pad] {
        sb = sb.append_char(' ');
        &i = i + 1;
    };
    sb = sb.append_str(s);
    &i = 0;
    [i < right_pad] {
        sb = sb.append_char(' ');
        &i = i + 1;
    };
    term sb.to_string();
};

defn truncate(s: String, max_len: Int) [max_len >= 0][term.len() <= max_len] -> String {
    [s.len() <= max_len] {
        term s;
    };
    term s[0..max_len];
};

defn truncate_with_ellipsis(s: String, max_len: Int) [max_len >= 3][term.len() <= max_len] -> String {
    [s.len() <= max_len] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s[0..max_len-3]);
    sb = sb.append_str("...");
    term sb.to_string();
};

defn ensure_prefix(s: String, prefix: String) [true][term.len() >= s.len()] -> String {
    [s.starts_with(prefix)] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(prefix);
    sb = sb.append_str(s);
    term sb.to_string();
};

defn ensure_suffix(s: String, suffix: String) [true][term.len() >= s.len()] -> String {
    [s.ends_with(suffix)] {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s);
    sb = sb.append_str(suffix);
    term sb.to_string();
};

defn remove_prefix(s: String, prefix: String) [true][term.len() <= s.len()] -> String {
    [s.starts_with(prefix)] {
        term s[prefix.len()..s.len()];
    };
    term s;
};

defn remove_suffix(s: String, suffix: String) [true][term.len() <= s.len()] -> String {
    [s.ends_with(suffix)] {
        term s[0..s.len()-suffix.len()];
    };
    term s;
};

defn strip_chars(s: String, chars: String) [true][term.len() <= s.len()] -> String {
    // Strip from left
    let start: Int = 0;
    [start < s.len()] {
        let c = s[start..start+1];
        [chars.contains(c)] {
            &start = start + 1;
        };
        [!chars.contains(c)] {
            break;
        };
    };
    
    // Strip from right
    let end: Int = s.len();
    [end > start] {
        let c = s[end-1..end];
        [chars.contains(c)] {
            &end = end - 1;
        };
        [!chars.contains(c)] {
            break;
        };
    };
    
    term s[start..end];
};

defn is_empty_str(s: String) [true][term == (s.len() == 0)] -> Bool {
    term s.len() == 0;
};

defn is_blank(s: String) [true][term == true || term == false] -> Bool {
    let i: Int = 0;
    [i < s.len()] {
        [!s[i..i+1].is_whitespace()] {
            term false;
        };
        &i = i + 1;
    };
    term true;
};

