// Standard String Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Briev.
// Functions with name# syntax are intrinsics (compiler-known).

// ===== PURE FOREIGN (requires external implementation) =====

// Case conversion
// Whitespace checking
// Complex search (requires iteration)
// Character operations
// Escaping
// Encoding
import "std/ffi/string.bv";

defn bytes(s: String) -> Result<List<Int>, StringError> {
    term Ok(StrBytes#(s));
};
// Complex replacement
// Split variations
// Comparison
// Parsing
// ===== NATIVE DEFINITIONS =====

// Length
defn len(s: String) [s .^Length >= 0][term == s .^Length] -> Int {
  term s .^Length;
};

// Basic concatenation
defn concat(a: String, b: String) [true][term .^Length == a .^Length + b .^Length] -> String {
  let result: String = a + b;
  term result;
};

defn append(s: String, c: String) [true][term .^Length == s .^Length + c .^Length] -> String {
  let result: String = s + c;
  term result;
};

defn prepend(c: String, s: String) [true][term .^Length == c .^Length + s .^Length] -> String {
  let result: String = c + s;
  term result;
};

// Trim operations
defn trim(s: String) [true][term .^Length <= s .^Length] -> String {
  term s;
};

defn trim_left(s: String) [true][term .^Length <= s .^Length] -> String {
  term s;
};

defn trim_right(s: String) [true][term .^Length <= s .^Length] -> String {
  term s;
};

defn trim_start(s: String) [true][term .^Length <= s .^Length] -> String {
  term s;
};

defn trim_end(s: String) [true][term .^Length <= s .^Length] -> String {
  term s;
};

// Basic search
txn contains_loop(haystack: String, needle: String, i: Int)
    [i < haystack .^Length][i == haystack .^Length] -> Bool
{
  when i + needle .^Length <= haystack .^Length && haystack[i:i+needle .^Length] == needle {
    term true;
  };
  i = i + 1;
  term false;
};

defn contains(haystack: String, needle: String) [true][term == true || term == false] -> Bool {
  term contains_loop(haystack, needle, 0);
};

defn starts_with(s: String, prefix: String) [true][term == true || term == false] -> Bool {
  when prefix .^Length > s .^Length {
    term false;
  };
  term s[0:prefix .^Length] == prefix;
};

defn ends_with(s: String, suffix: String) [true][term == true || term == false] -> Bool {
  when suffix .^Length > s .^Length {
    term false;
  };
  let slen = s .^Length;
  let suflen = suffix .^Length;
  term s[slen - suflen:slen] == suffix;
};

txn find_loop(s: String, needle: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Int
{
  when i + needle .^Length <= s .^Length && s[i:i+needle .^Length] == needle {
    term i;
  };
  i = i + 1;
  term -1;
};

defn find(s: String, needle: String) [true][term >= -1] -> Int {
  term find_loop(s, needle, 0);
};

// Character access
defn char_at(s: String, index: Int) [index >= 0 && index < s .^Length][term .^Length == 1] -> String {
  term s[index:index+1];
};

// Substring operations
defn substr(s: String, start: Int) [start >= 0 && start <= s .^Length][term .^Length == s .^Length - start] -> String {
  term s[start:s .^Length];
};

defn substr_range(s: String, start: Int, end: Int) [start >= 0 && end >= start && end <= s .^Length][term .^Length == end - start] -> String {
  term s[start:end];
};

// Single replace (native)
defn replace(s: String, old: String, new: String) [true][term .^Length >= 0] -> String {
  let idx: Int = find(s, old);
  when idx >= 0 {
    let before: String = s[0:idx];
    let after: String = s[idx+old .^Length:s .^Length];
    term before + new + after;
  };
  term s;
};

// Split (basic version)
defn split(s: String, delim: String) [delim .^Length > 0][true] -> List<String> {
  let result: List<String> = [];
  let i: Int = 0;
  let last: Int = 0;
  when i < s .^Length {
    when i + delim .^Length <= s .^Length && s[i:i+delim .^Length] == delim {
      result = result + [s[last:i]];
      last = i + delim .^Length;
      i = i + delim .^Length;
    };
    when i + delim .^Length > s .^Length || s[i:i+delim .^Length] != delim {
      i = i + 1;
    };
  };
  result = result + [s[last:s .^Length]];
  term result;
};

// Lines
defn lines(s: String) [true][term .^Length >= 0] -> List<String> {
  let result: List<String> = split(s, "\n");
  term result;
};

// Join
txn join_loop(list: List<String>, delim: String, result: String, i: Int)
    [i < list .^Length][i == list .^Length] -> String
{
  result = result + delim + list[i];
  i = i + 1;
  term result;
};

defn join(list: List<String>, delim: String) [true][term .^Length >= 0] -> String {
  when list .^Length == 0 {
    term "";
  };
  term join_loop(list, delim, list[0], 1);
};

// Padding (basic)
defn pad_left(s: String, width: Int) [width >= s .^Length][term .^Length == width.max(s .^Length)] -> String {
  let spaces: Int = width - s .^Length;
  when spaces > 0 {
    let pad: String = "";
    let i: Int = 0;
    when i < spaces {
      pad = pad + " ";
      i = i + 1;
    };
    term pad + s;
  };
  term s;
};

defn pad_right(s: String, width: Int) [width >= s .^Length][term .^Length == width.max(s .^Length)] -> String {
  let spaces: Int = width - s .^Length;
  when spaces > 0 {
    let pad: String = "";
    let i: Int = 0;
    when i < spaces {
      pad = pad + " ";
      i = i + 1;
    };
    term s + pad;
  };
  term s;
};

defn pad_both(s: String, width: Int) [width >= s .^Length][term .^Length == width.max(s .^Length)] -> String {
  let spaces: Int = width - s .^Length;
  when spaces > 0 {
    let left: Int = spaces / 2;
    let right: Int = spaces - left;
    let pad_left: String = "";
    let pad_right: String = "";
    let i: Int = 0;
    when i < left {
      pad_left = pad_left + " ";
      i = i + 1;
    };
    i = 0;
    when i < right {
      pad_right = pad_right + " ";
      i = i + 1;
    };
    term pad_left + s + pad_right;
  };
  term s;
};

// Repeat
txn repeat_loop(s: String, count: Int, result: String, i: Int)
    [i < count][i == count] -> String
{
  result = result + s;
  i = i + 1;
  term result;
};

defn repeat(s: String, count: Int) [count >= 0][term .^Length == s .^Length * count] -> String {
  when count == 0 {
    term "";
  };
  term repeat_loop(s, count, s, 1);
};

// Type conversions
// 2026-08-04 (out-observability plan, Phase 3): `IntToStr#` was removed from
// the intrinsic table in ffd55677 (the casting graph's `Int → #String`
// ExtCall lane owns this conversion). Use the cast, which resolves through the
// graph — `.bv` emits `call ptr @int_to_str`, `.ebv` will emit a Briev digit
// loop. Undo: restore `term IntToStr#(n);` only if the intrinsic is ever
// re-registered.
defn to_string(n: Int) [true][term .^Length >= 0] -> String {
  term n as String;
};

defn to_float(s: String) [true][term >= 0.0 || term < 0.0] -> Float {
  // 2026-08-04 (Phase 3): was `term 0.0` — a stub. The casting graph owns
  // `#String → #Float` (ExtCall("str_to_float")); use the cast form.
  term s as Float;
};

defn to_int(s: String) [true][term == 0 || term != 0] -> Int {
  // 2026-08-04 (Phase 3): was `term 0` — a stub. The casting graph owns
  // `#String → #Int` (ExtCall("str_to_int")); use the cast form.
  term s as Int;
};
// ===== TIER 2: NATIVE CHARACTER CLASSIFICATION =====
// NOTE: All iterative functions use `txn` with `[pre][post]` convergence contracts.
// The `_loop` suffix marks the internal txn; the `defn` provides the public API.

txn is_whitespace_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    let c = s[i:i+1];
    when !c.is_whitespace() {
        term false;
    };
    i = i + 1;
    term true;
};

defn is_whitespace_str(s: String) [true][term == true || term == false] -> Bool {
    term is_whitespace_loop(s, 0);
};

txn is_alpha_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    let c = s[i:i+1];
    when !c.is_alpha() {
        term false;
    };
    i = i + 1;
    term true;
};

defn is_alpha_str(s: String) [true][term == true || term == false] -> Bool {
    when s .^Length == 0 {
        term false;
    };
    term is_alpha_loop(s, 0);
};

txn is_numeric_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    let c = s[i:i+1];
    when !c.is_digit() {
        term false;
    };
    i = i + 1;
    term true;
};

defn is_numeric_str(s: String) [true][term == true || term == false] -> Bool {
    when s .^Length == 0 {
        term false;
    };
    term is_numeric_loop(s, 0);
};

txn to_lower_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let c = s[i:i+1];
    sb = sb.append_char(c.to_lower());
    i = i + 1;
    term sb.to_string();
};

defn to_lower_str(s: String) [true][term .^Length == s .^Length] -> String {
    term to_lower_loop(s, new_builder(), 0);
};

txn to_upper_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let c = s[i:i+1];
    sb = sb.append_char(c.to_upper());
    i = i + 1;
    term sb.to_string();
};

defn to_upper_str(s: String) [true][term .^Length == s .^Length] -> String {
    term to_upper_loop(s, new_builder(), 0);
};

txn trim_left_loop(s: String, i: Int)
    [i < s .^Length && s[i:i+1].is_whitespace()][i == s .^Length || !s[i:i+1].is_whitespace()] -> String
{
    i = i + 1;
    term s[i:s .^Length];
};

defn trim_str(s: String) [true][term .^Length <= s .^Length] -> String {
    let start: Int = 0;
    when start < s .^Length && s[start:start+1].is_whitespace() {
        start = start + 1;
    };
    let end: Int = s .^Length;
    when end > start && s[end-1:end].is_whitespace() {
        end = end - 1;
    };
    term s[start:end];
};

defn trim_left_str(s: String) [true][term .^Length <= s .^Length] -> String {
    let i: Int = 0;
    when i < s .^Length && s[i:i+1].is_whitespace() {
        i = i + 1;
    };
    term s[i:s .^Length];
};

defn trim_right_str(s: String) [true][term .^Length <= s .^Length] -> String {
    let end: Int = s .^Length;
    when end > 0 && s[end-1:end].is_whitespace() {
        end = end - 1;
    };
    term s[0:end];
};

txn capitalize_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let c = s[i:i+1];
    sb = sb.append_char(c.to_lower());
    i = i + 1;
    term sb.to_string();
};

defn capitalize(s: String) [true][term .^Length == s .^Length] -> String {
    when s .^Length == 0 {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_char(s[0:1].to_upper());
    term capitalize_loop(s, sb, 1);
};

txn reverse_loop(s: String, sb: StringBuilder, i: Int)
    [i < s .^Length][i == s .^Length] -> String
{
    let c = s[s .^Length-1-i:s .^Length-i];
    sb = sb.append_char(c);
    i = i + 1;
    term sb.to_string();
};

defn reverse_str(s: String) [true][term .^Length == s .^Length] -> String {
    term reverse_loop(s, new_builder(), 0);
};

txn count_char_loop(s: String, c: String, count: Int, i: Int)
    [i < s .^Length][i == s .^Length] -> Int
{
    when s[i:i+1] == c {
        count = count + 1;
    };
    i = i + 1;
    term count;
};

defn count_char(s: String, c: Char) [true][term >= 0] -> Int {
    term count_char_loop(s, c, 0, 0);
};

txn is_blank_loop(s: String, i: Int)
    [i < s .^Length][i == s .^Length] -> Bool
{
    when !s[i:i+1].is_whitespace() {
        term false;
    };
    i = i + 1;
    term true;
};

defn is_blank(s: String) [true][term == true || term == false] -> Bool {
    term is_blank_loop(s, 0);
};

defn truncate(s: String, max_len: Int) [max_len >= 0][term .^Length <= max_len] -> String {
    when s .^Length <= max_len {
        term s;
    };
    term s[0:max_len];
};

defn truncate_with_ellipsis(s: String, max_len: Int) [max_len >= 3][term .^Length <= max_len] -> String {
    when s .^Length <= max_len {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s[0:max_len-3]);
    sb = sb.append_str("...");
    term sb.to_string();
};

defn ensure_prefix(s: String, prefix: String) [true][term .^Length >= s .^Length] -> String {
    when s.starts_with(prefix) {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(prefix);
    sb = sb.append_str(s);
    term sb.to_string();
};

defn ensure_suffix(s: String, suffix: String) [true][term .^Length >= s .^Length] -> String {
    when s.ends_with(suffix) {
        term s;
    };
    let sb = new_builder();
    sb = sb.append_str(s);
    sb = sb.append_str(suffix);
    term sb.to_string();
};

defn remove_prefix(s: String, prefix: String) [true][term .^Length <= s .^Length] -> String {
    when s.starts_with(prefix) {
        term s[prefix .^Length:s .^Length];
    };
    term s;
};

defn remove_suffix(s: String, suffix: String) [true][term .^Length <= s .^Length] -> String {
    when s.ends_with(suffix) {
        term s[0:s .^Length-suffix .^Length];
    };
    term s;
};

defn is_empty_str(s: String) [true][term == (s .^Length == 0)] -> Bool {
    term s .^Length == 0;
};

// 2026-07-30: CastTo/CastFrom on String is handled by the casting graph's
// hardcoded protocol lanes (#String→#Bit = extractvalue, #String→#Int =
// ExtCall("str_to_int"), etc.). The stub functions below are removed.
