// Math wrappers — dispatch to the right intrinsic based on byte width.
// Use via: import { sqrt } from "std/math" ;
// The defn guard compiles down to a single intrinsic call; the dead arm is
// eliminated at compile time since :> Bytes is a constant per target.

import { sqrt_f32, sqrt_f64 } from "std/llvm" ;

defn sqrt(x: Float) -> Float [x :> Bytes == 4 || x :> Bytes == 8]] {
    [x :> Bytes == 4] { term sqrt_f32(x); };
    [x :> Bytes == 8] { term sqrt_f64(x); };
    term x;
};
