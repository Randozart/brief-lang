// ── Array Operations ──────────────────────────────────────────────
// 2026-07-26: Pure-Brief iterator functions for Vector<T,N> and Slice<T>.
// No compiler magic — the LLVM auto-vectorizer recognizes the [i < N]
// convergence contract and vectorizes the load-apply-store loop.

txn array_map<T, U>(arr: Vector<T, N>, f: T -> U, result: Vector<U, N>, i: Int)
    [i < N][i == N] -> Vector<U, N>
{
    result[i] = f(arr[i]);
    &i = i + 1;
    term result;
};

txn array_filter<T>(arr: Vector<T, N>, pred: T -> Bool, result: Vector<T, N>, i: Int, j: Int)
    [i < N][i == N] -> Vector<T, N>
{
    when pred(arr[i]) {
        result[j] = arr[i];
        &j = j + 1;
    };
    &i = i + 1;
    term result;
};

txn array_fold<T, U>(arr: Vector<T, N>, f: (U, T) -> U, acc: U, i: Int)
    [i < N][i == N] -> U
{
    &acc = f(acc, arr[i]);
    &i = i + 1;
    term acc;
};

txn array_any<T>(arr: Vector<T, N>, pred: T -> Bool, i: Int)
    [i < N][i == N] -> Bool
{
    when pred(arr[i]) {
        term true;
    };
    &i = i + 1;
    term false;
};

txn array_all<T>(arr: Vector<T, N>, pred: T -> Bool, i: Int)
    [i < N][i == N] -> Bool
{
    when !pred(arr[i]) {
        term false;
    };
    &i = i + 1;
    term true;
};

txn array_sum(arr: Vector<Int, N>, i: Int)
    [i < N][i == N] -> Int
{
    let result: Int = 0;
    result = result + arr[i];
    &i = i + 1;
    term result;
};

txn array_product(arr: Vector<Int, N>, i: Int)
    [i < N][i == N] -> Int
{
    let result: Int = 1;
    result = result * arr[i];
    &i = i + 1;
    term result;
};
