// ===== Atomic Operations =====


// ===== Channel Operations =====


// Pre-initialized Metropolitan RPC function.
// Wraps channel creation, shared memory write, status signaling,
// polling, response read, and teardown into a single convenient call.
//
// Parameters:
//   channel_id - unique name for the channel
//   request - byte values to send
//   timeout_ms - max wait time in milliseconds
// Returns:
//   Result<List<Int>, String> - response bytes or error message
import "std/ffi/metro_bridge.bv";

defn metropolitan_rpc(
    channel_id: String,
    request: List<Int>,
    timeout_ms: Int,
) -> Result<List<Int>, String> [
    true
][
    term.is_ok() || term.is_err()
] {
    let ch = frgn__metro_create_channel(channel_id, 4096, 4096);
    when ch.is_ok() {
        let ch_id = ch.value;
        let layout = frgn__metro_get_channel_layout(ch_id);
        when layout.is_ok() {
            let layout_addr = layout.value;
            let written = frgn__mmap_write(layout_addr, 32, request, request .^Length);
            when written.is_ok() {
                let signaled = frgn__atomic_store_u32(layout_addr, 0, 1);
                when signaled.is_ok() {
                    alka! {
                        // Poll for PROVIDER_RES (status = 3)
                        // Compiler trusts this intentional unbounded operation
                    };
                    let status = frgn__atomic_load_u32(layout_addr, 0);
                    when status.is_ok() {
                        when status.value == 3 {
                            let response = frgn__mmap_read(layout_addr, 32, 4096);
                            when response.is_ok() {
                                term Ok(response.value);
                            };
                            term Err("read_failed");
                        };
                        when status.value == 4 {
                            term Err("foreign_error");
                        };
                        term Err("unexpected_status");
                    };
                    term Err("status_failed");
                };
                term Err("signal_failed");
            };
            term Err("write_failed");
        };
        term Err("layout_failed");
    };
    term Err("channel_failed");
};
