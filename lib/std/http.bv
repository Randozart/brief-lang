// Standard HTTP Library
// Foreign function declarations for WASM target

import <std/result>;
import "std/ffi/http.bv";

defn http_get(url: String) -> Result<String, String> [url.starts_with("http")] {
    // frgn__http_get already returns Result<String, String> — the C
    // runtime builds both sides; pass through.
    term frgn__http_get(url);
};

defn http_post(url: String, body: String) -> Result<String, String> [url.starts_with("http")] {
    term frgn__http_post(url, body);
};