// ── Non-Default Protocol Variants ───────────────────────────────
// 2026-07-23: Protocol declarations for non-default variants with bindings.
// Each CastTo/CastFrom requires a function that defines the transformation.
// The compiler proves round-trip identity for each pair.

proto ASCII: #String {
    CastTo(#String<UTF8>) = ascii_to_utf8(#Lh);
    CastFrom(#String<UTF8>) = utf8_to_ascii(#Lh);
};

proto UTF16: #String {
    CastTo(#String<UTF8>) = utf16_to_utf8(#Lh);
    CastFrom(#String<UTF8>) = utf8_to_utf16(#Lh);
};

proto Posit32: #Float {
    CastTo(#Float<IEEE754>) = Posit32_to_IEEE754(#Lh);
    CastFrom(#Float<IEEE754>) = IEEE754_to_Posit32(#Lh);
};
