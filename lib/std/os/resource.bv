// Phase 3: relocated from compiler Intrinsic enum to std/os/ module
// Auto-imported via prelude.

inop __sys_getrlimit(resource: Int) -> Int {
    %r = call i64 @__getrlimit__(i64 %resource);
    ret i64 %r;
};

inop __sys_setrlimit(resource: Int, packed: Int) -> Int {
    %r = call i64 @__setrlimit__(i64 %resource, i64 %packed);
    ret i64 %r;
};

