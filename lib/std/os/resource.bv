// 2026-07-15: Replaced inop with defn + SysCall#(GetRlimit/SetRlimit, ...);
// Uses prlimit64 (x86_64: 302) via abstract op.

defn getrlimit(resource: Int) -> Int {
    term SysCall#(GetRlimit, resource, 0, 0, 0, 0, 0);
};

defn setrlimit(resource: Int, packed: Int) -> Int {
    term SysCall#(SetRlimit, resource, packed, 0, 0, 0, 0);
};
