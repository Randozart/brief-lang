// 2026-07-15: Replaced inop with defn + Syscall#(GetUid/GetEuid/GetGid/GetEgid, ...);

defn getuid() -> Int {
    Syscall#(GetUid, 0, 0, 0, 0, 0, 0);
};

defn geteuid() -> Int {
    Syscall#(GetEuid, 0, 0, 0, 0, 0, 0);
};

defn getgid() -> Int {
    Syscall#(GetGid, 0, 0, 0, 0, 0, 0);
};

defn getegid() -> Int {
    Syscall#(GetEgid, 0, 0, 0, 0, 0, 0);
};
