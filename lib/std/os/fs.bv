// 2026-07-15: Simple ops → defn + Syscall#.
// file_open, file_stat, file_fstat need to_c_string (Phase 2).
// file_pread, file_pwrite deferred to Phase 2 (complex offset semantics).

defn file_close(fd: Int) -> Int {
    Syscall#(Close, fd, 0, 0, 0, 0, 0);
};

defn file_read(fd: Int, buf: Ptr<Byte>, count: Int) -> Int {
    Syscall#(Read, fd, buf, count, 0, 0, 0);
};

defn file_write(fd: Int, buf: Ptr<Byte>, count: Int) -> Int {
    Syscall#(Write, fd, buf, count, 0, 0, 0);
};

defn file_lseek(fd: Int, offset: Int, whence: Int) -> Int {
    Syscall#(LSeek, fd, offset, whence, 0, 0, 0);
};

defn file_ftruncate(fd: Int, length: Int) -> Int {
    Syscall#(FTruncate, fd, length, 0, 0, 0, 0);
};

defn file_fsync(fd: Int) -> Int {
    Syscall#(FSync, fd, 0, 0, 0, 0, 0);
};

defn file_dup(fd: Int) -> Int {
    Syscall#(Dup, fd, 0, 0, 0, 0, 0);
};

defn file_dup2(oldfd: Int, newfd: Int) -> Int {
    Syscall#(Dup2, oldfd, newfd, 0, 0, 0, 0);
};

defn file_fcntl(fd: Int, cmd: Int, arg: Int) -> Int {
    Syscall#(Fcntl, fd, cmd, arg, 0, 0, 0);
};
