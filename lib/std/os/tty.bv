// Phase 3: relocated from compiler Intrinsic enum to std/os/ module
// Auto-imported via prelude.
//
// 2026-07-15: Replaced inop with defn + Syscall#(IoCtl/Read, ...);.
// Terminal operations use the ioctl syscall with termios constants
// and the read syscall for key-by-key input.

defn tty_raw_mode(enable: Int) -> Int {
    Syscall#(IoCtl, 0, enable, 0, 0, 0, 0);
};

defn tty_size() -> Int {
    Syscall#(IoCtl, 0, 0, 0, 0, 0, 0);
};

defn tty_read_key(fd: Int) -> Int {
    Syscall#(Read, fd, 0, 1, 0, 0, 0);
};

defn ioctl(fd: Int, request: Int, argp: Ptr<Byte>) -> Int {
    Syscall#(IoCtl, fd, request, argp, 0, 0, 0);
};

defn isatty(fd: Int) -> Int {
    Syscall#(IoCtl, fd, 0, 0, 0, 0, 0);
};
