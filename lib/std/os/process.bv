// Process intrinsics
// Phase 3: relocated from compiler Intrinsic enum

inop spawn_with_output#(cmd: Ptr<Byte>, args: Ptr<Byte>) -> Int;
inop spawn#(cmd: Ptr<Byte>, args: Ptr<Byte>) -> Int;
inop getpid#() -> Int;
inop getppid#() -> Int;
inop argv#() -> List<String>;
inop exit#(code: Int) -> Void;
inop abort#() -> Void;
inop sleep#(seconds: Int) -> Int;
