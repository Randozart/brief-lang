// Atomic operation intrinsics
// Phase 3: relocated from compiler Intrinsic enum

inop atomic_load#(ptr: Ptr<Byte>) -> Int;
inop atomic_store#(ptr: Ptr<Byte>, val: Int) -> Int;
inop atomic_cas#(ptr: Ptr<Byte>, expected: Int, desired: Int) -> Int;
inop atomic_xchg#(ptr: Ptr<Byte>, val: Int) -> Int;
inop atomic_add#(ptr: Ptr<Byte>, val: Int) -> Int;
inop fence#() -> Int;
inop futex#(uaddr: Ptr<Int>, op: Int, val: Int, timeout: Ptr<Byte>, uaddr2: Ptr<Int>, val3: Int) -> Int;
