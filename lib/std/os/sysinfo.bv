// System information intrinsics
// Phase 3: relocated from compiler Intrinsic enum

inop uname#() -> String;
inop hostname#() -> String;
inop realpath#(path: Ptr<Byte>, resolved: Ptr<Byte>) -> Int;
inop pagesize#() -> Int;
inop cpu_count#() -> Int;
inop strerror#(errnum: Int) -> String;
inop strsignal#(signum: Int) -> String;
