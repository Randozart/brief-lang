// 2026-07-15: Replaced inop with defn + Syscall#(Socket/Bind/Listen/etc., ...);

defn socket(domain: Int, type_: Int, protocol: Int) -> Int {
    Syscall#(Socket, domain, type_, protocol, 0, 0, 0);
};

defn bind(fd: Int, addr: Ptr<Byte>, addrlen: Int) -> Int {
    Syscall#(Bind, fd, addr, addrlen, 0, 0, 0);
};

defn listen(fd: Int, backlog: Int) -> Int {
    Syscall#(Listen, fd, backlog, 0, 0, 0, 0);
};

defn accept(fd: Int, addr: Ptr<Byte>, addrlen: Ptr<Int>) -> Int {
    Syscall#(Accept, fd, addr, addrlen, 0, 0, 0);
};

defn connect(fd: Int, addr: Ptr<Byte>, addrlen: Int) -> Int {
    Syscall#(Connect, fd, addr, addrlen, 0, 0, 0);
};

defn send(fd: Int, buf: Ptr<Byte>, len: Int, flags: Int) -> Int {
    Syscall#(Send, fd, buf, len, flags, 0, 0);
};

defn recv(fd: Int, buf: Ptr<Byte>, len: Int, flags: Int) -> Int {
    Syscall#(Recv, fd, buf, len, flags, 0, 0);
};

defn sendto(fd: Int, buf: Ptr<Byte>, len: Int, flags: Int, dest: Ptr<Byte>, destlen: Int) -> Int {
    Syscall#(SendTo, fd, buf, len, flags, dest, destlen);
};

defn recvfrom(fd: Int, buf: Ptr<Byte>, len: Int, flags: Int, src: Ptr<Byte>, srclen: Ptr<Int>) -> Int {
    Syscall#(RecvFrom, fd, buf, len, flags, src, srclen);
};

defn setsockopt(fd: Int, level: Int, optname: Int, optval: Ptr<Byte>, optlen: Int) -> Int {
    Syscall#(SetSockOpt, fd, level, optname, optval, optlen, 0);
};

defn getsockopt(fd: Int, level: Int, optname: Int, optval: Ptr<Byte>, optlen: Ptr<Int>) -> Int {
    Syscall#(GetSockOpt, fd, level, optname, optval, optlen, 0);
};

defn shutdown(fd: Int, how: Int) -> Int {
    Syscall#(Shutdown, fd, how, 0, 0, 0, 0);
};
