frgn print(s: Ptr<Byte>) -> Int ;
frgn println(s: Ptr<Byte>) -> Int ;
frgn readln(buf: Ptr<Byte>, size: Int) -> Int ;
frgn getenv(name: Ptr<Byte>, buf: Ptr<Byte>, size: Int) -> Int ;
