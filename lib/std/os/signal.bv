// Phase 3: relocated from compiler Intrinsic enum to std/os/ module
// Auto-imported via prelude.

inop __sys_sigaction(sig_num: Int, action: Ptr<Byte>, old_action: Ptr<Byte>) -> Int {
    %r = call i64 @__sigaction__(i64 %sig_num, i64 %action, i64 %old_action);
    ret i64 %r;
};

inop __sys_sigprocmask(how: Int, set: Ptr<Byte>, old_set: Ptr<Byte>) -> Int {
    %r = call i64 @__sigprocmask__(i64 %how, i64 %set, i64 %old_set);
    ret i64 %r;
};

