// lib/std/json.bv — Pure-Briev JSON Parser
//
// Replaces all frgn __* declarations with pure-Briev recursive descent.
// The public API matches officina's needs: parse, is_array, length,
// get (by key), get_by_index.

import# "std/char";

// ===== Types =====

enum JsonValue {
    Null,
    BoolVal(Bool),
    IntVal(Int),
    FloatVal(Float),
    StrVal(String),
    Array(List<JsonValue>),
    Object(List<(String, JsonValue)>)
};

obj ParseFrame {
    value: JsonValue,
    pos: Int,
};

// Error helpers — typed per return type to help inference
defn err_value(x: String) -> Result<JsonValue, String> { term Err(x); };
defn ok_value(x: JsonValue) -> Result<JsonValue, String> { term Ok(x); };
defn err_string(x: String) -> Result<String, String> { term Err(x); };
defn ok_string(x: String) -> Result<String, String> { term Ok(x); };
defn err_int(x: String) -> Result<Int, String> { term Err(x); };
defn ok_int(x: Int) -> Result<Int, String> { term Ok(x); };
defn err_char(x: String) -> Result<Char, String> { term Err(x); };
defn err_frame(x: String) -> Result<ParseFrame, String> { term Err(x); };
defn ok_frame(x: ParseFrame) -> Result<ParseFrame, String> { term Ok(x); };

// Typed error constructors (enum variants don't unify with parent type)
defn e_utoken() -> String { term "unexpected_token"; };
defn e_invnum() -> String { term "invalid_number"; };
defn e_invesc() -> String { term "invalid_escape"; };
defn e_unexpend() -> String { term "unexpected_end"; };
defn e_expcolon() -> String { term "expected_colon"; };
defn e_expcomma() -> String { term "expected_comma"; };
defn e_expkey() -> String { term "expected_object_key"; };
// ===== Top-Level API =====

defn json_parse(s: String) -> Result<JsonValue, String> {
    let r: Result<ParseFrame, String> = parse_value(s, 0);
    uni r(Ok(f)) -> { term ok_value(f.value); };
    uni r(Err(e)) -> { term err_value(e); };
    term err_value("unreachable");
};

defn json_is_array(v: JsonValue) -> Result<Bool, String> {
    uni v(Array(_)) -> { term Ok(true); };
    term Ok(false);
};

defn json_length(v: JsonValue) -> Result<Int, String> {
    uni v(Array(list)) -> { term Ok(list .^Length); };
    term err_int(e_utoken());
};

defn json_get(v: JsonValue, key: String) -> Result<String, String> {
    uni v(Object(pairs)) -> {
        let result = find_pair(pairs, key, 0);
        uni result(Ok(val)) -> {
            uni val(StrVal(s)) -> { term Ok(s); };
        };
        term result;
    };
    term err_string(e_utoken());
};

txn find_pair(pairs: List<(String, JsonValue)>, key: String, i: Int)
    [i < pairs .^Length][i >= pairs .^Length || pairs[i][0] == key]
    -> Result<JsonValue, String>
{
    when pairs[i][0] == key {
        term ok_value(pairs[i][1]);
    };
    i = i + 1;
    when i >= pairs .^Length {
        term err_value(e_utoken());
    };
    term err_value(e_utoken());
};

defn json_get_by_index(v: JsonValue, i: Int) -> Result<JsonValue, String> {
    uni v(Array(list)) -> {
        when i >= 0 && i < list .^Length {
            term ok_value(list[i]);
        };
        term err_value(e_utoken());
    };
    term err_value(e_utoken());
};

// ===== Whitespace Skipper =====

txn skip_ws(s: String, pos: Int)
    [pos < (s .^Length) && is_whitespace(s[pos])]
    [pos >= (s .^Length) || !is_whitespace(s[pos])]
    -> Int
{
    pos = pos + 1;
    term pos;
};

// ===== Helper: conditional return (no if-expressions in let) =====

defn choose_if(b: Bool, t: Int, f: Int) -> Int {
    when b { term t; };
    term f;
};

defn choose_neg_if(b: Bool, val: Int) -> Int {
    when b { term val.negated(); };
    term val;
};

// ===== Value Dispatcher =====

defn parse_value(s: String, pos: Int) -> Result<ParseFrame, String> {
    let p = skip_ws(s, pos);
    when p >= s .^Length {
        term err_frame(e_unexpend());
    };
    let c: Char = s[p];
    when c == '{' { term parse_object(s, p); };
    when c == '[' { term parse_array(s, p); };
    when c == '"' { term parse_string(s, p); };
    when c == '-' || is_digit(c) { term parse_number(s, p); };
    when c == 't' { term parse_keyword(s, p, "true", BoolVal(true)); };
    when c == 'f' { term parse_keyword(s, p, "false", BoolVal(false)); };
    when c == 'n' { term err_frame(e_utoken()); };
    term err_frame(e_utoken());
};

// ===== Keyword Parser =====

defn parse_keyword(s: String, pos: Int, kw: String, val: JsonValue) -> Result<ParseFrame, String> {
    let klen = kw .^Length;
    when pos + klen <= s .^Length && s[pos .. pos + klen] == kw {
        term Ok(ParseFrame { value: val, pos: pos + klen });
    };
    term err_frame(e_utoken());
};

// ===== String Parser =====

defn parse_string(s: String, pos: Int) -> Result<ParseFrame, String> {
    when pos >= s .^Length || s[pos] != '"' {
        term err_frame(e_utoken());
    };
    let content = parse_str_chars(s, pos + 1, new_builder());
    uni content(Ok(frame)) -> {
        term Ok(ParseFrame { value: frame.value, pos: frame.pos + 1 });
    };
    term content;
};

txn parse_str_chars(s: String, pos: Int, sb: StringBuilder)
    [pos < (s .^Length) && s[pos] != '"']
    [pos < (s .^Length) && s[pos] == '"']
    -> Result<ParseFrame, String>
{
    when s[pos] == '\\' {
        pos = pos + 1;
        when pos < s .^Length {
            let esc: Char = s[pos];
            when esc == '"' { sb = sb.append_char('"');  };
            when esc == '\\' { sb = sb.append_char('\\'); };
            when esc == '/' { sb = sb.append_char('/');  };
            when esc == 'n' { sb = sb.append_char('\n'); };
            when esc == 'r' { sb = sb.append_char('\r'); };
            when esc == 't' { sb = sb.append_char('\t'); };
            when esc == 'b' { sb = sb.append_char('\b'); };
            when esc == 'f' { sb = sb.append_char('\f'); };
            when esc == 'u' {
                pos = pos + 1;
                let uc = parse_hex_escape(s, pos);
                uni uc(Ok(ch)) -> {
                    sb = sb.append_char(ch);
                    pos = pos + 4;
                };
                uni uc(Err(_)) -> {
                    term err_frame(e_invesc());
                };
            };
            pos = pos + 1;
        };
    };
    sb = sb.append_char(s[pos]);
    pos = pos + 1;
    term Ok(ParseFrame { value: StrVal(sb.to_string()), pos: pos });
};

defn parse_hex_escape(s: String, pos: Int) -> Result<Char, String> {
    [pos + 4 <= s .^Length
        && is_hex_digit(s[pos])
        && is_hex_digit(s[pos+1])
        && is_hex_digit(s[pos+2])
        && is_hex_digit(s[pos+3])]
    {
        let d0 = hex_digit_to_int(s[pos]);
        let d1 = hex_digit_to_int(s[pos+1]);
        let d2 = hex_digit_to_int(s[pos+2]);
        let d3 = hex_digit_to_int(s[pos+3]);
        let code = d0 * 4096 + d1 * 256 + d2 * 16 + d3;
        term Ok(int_to_char(code));
    };
    term err_char(e_invesc());
};

// ===== Number Parser =====

defn parse_number(s: String, pos: Int) -> Result<ParseFrame, String> {
    let is_neg: Bool = s[pos] == '-';
    let ipos: Int = choose_if(is_neg, pos + 1, pos);
    when !is_digit(s[ipos]) {
        term err_frame(e_invnum());
    };
    let digits = parse_int_digits(s, ipos, 0);
    uni digits(Ok(frame)) -> {
        let after_int = frame.pos;
        let raw_val = frame.value;
        uni raw_val(IntVal(n)) -> {
            when after_int < s .^Length && s[after_int] == '.' {
                let frac = parse_float_remainder(s, after_int, is_neg, n);
                uni frac(Ok(fr)) -> { term Ok(fr); };
                term frac;
            };
            when after_int < s .^Length && (s[after_int] == 'e' || s[after_int] == 'E') {
                let fp = parse_exponent(s, after_int, IntVal(n), is_neg);
                uni fp(Ok(fr)) -> { term Ok(fr); };
                term fp;
            };
            let final_n: Int = choose_neg_if(is_neg, n);
            term Ok(ParseFrame { value: IntVal(final_n), pos: after_int });
        };
        term err_frame(e_invnum());
    };
    term digits;
};

txn parse_int_digits(s: String, pos: Int, val: Int)
    [pos < (s .^Length) && is_digit(s[pos])]
    [pos >= (s .^Length) || !is_digit(s[pos])]
    -> Result<ParseFrame, String>
{
    let d = digit_to_int(s[pos]);
    val = val * 10 + d;
    pos = pos + 1;
    term Ok(ParseFrame { value: IntVal(val), pos: pos });
};

defn parse_float_remainder(s: String, pos: Int, is_neg: Bool, int_part: Int) -> Result<ParseFrame, String> {
    let frac_start = pos + 1;
    when !is_digit(s[frac_start]) {
        term err_frame(e_invnum());
    };
    let frac = parse_float_digits(s, frac_start, 0.0, 1.0);
    uni frac(Ok(fr)) -> {
        uni fr.value(FloatVal(f)) -> {
            let int_f = int_part as Float;
            let total: Float = int_f + f;
            when is_neg {
                let full: Float = -total;
                when fr.pos < s .^Length && (s[fr.pos] == 'e' || s[fr.pos] == 'E') {
                    let exp = parse_exponent(s, fr.pos, FloatVal(full), false);
                    uni exp(Ok(ef)) -> { term Ok(ef); };
                    term exp;
                };
                term Ok(ParseFrame { value: FloatVal(full), pos: fr.pos });
            };
            when fr.pos < s .^Length && (s[fr.pos] == 'e' || s[fr.pos] == 'E') {
                let exp = parse_exponent(s, fr.pos, FloatVal(total), false);
                uni exp(Ok(ef)) -> { term Ok(ef); };
                term exp;
            };
            term Ok(ParseFrame { value: FloatVal(total), pos: fr.pos });
        };
        term err_frame(e_invnum());
    };
    term frac;
};

txn parse_float_digits(s: String, pos: Int, frac: Float, place: Float)
    [pos < (s .^Length) && is_digit(s[pos])]
    [pos >= (s .^Length) || !is_digit(s[pos])]
    -> Result<ParseFrame, String>
{
    let d = digit_to_int(s[pos]) as Float;
    frac = frac + d / (place * 10.0);
    place = place * 10.0;
    pos = pos + 1;
    term Ok(ParseFrame { value: FloatVal(frac), pos: pos });
};

defn parse_exponent(s: String, pos: Int, base: JsonValue, base_is_neg: Bool) -> Result<ParseFrame, String> {
    let ep = pos + 1;
    when ep >= s .^Length {
        term err_frame(e_invnum());
    };
    let is_neg_exp: Bool = s[ep] == '-';
    let has_plus: Bool = s[ep] == '+';
    let exp_start: Int = choose_if(is_neg_exp || has_plus, ep + 1, ep);
    when !is_digit(s[exp_start]) {
        term err_frame(e_invnum());
    };
    let exp_val = parse_int_digits(s, exp_start, 0);
    uni exp_val(Ok(fr)) -> {
        uni fr.value(IntVal(e)) -> {
            let pow = ten_pow(e);
            let full = parse_exponent_apply(base, pow, is_neg_exp);
            uni full(Ok(result)) -> { term Ok(ParseFrame { value: result, pos: fr.pos }); };
            term full;
        };
        term err_frame(e_invnum());
    };
    term exp_val;
};

defn parse_exponent_apply(base: JsonValue, pow: Float, is_neg_exp: Bool) -> Result<JsonValue, String> {
    uni base(FloatVal(f)) -> {
        when is_neg_exp {
            term ok_value(FloatVal(f / pow));
        };
        term ok_value(FloatVal(f * pow));
    };
    uni base(IntVal(n)) -> {
        let f = n as Float;
        when is_neg_exp {
            term ok_value(FloatVal(f / pow));
        };
        term ok_value(FloatVal(f * pow));
    };
    term err_value(e_invnum());
};

txn ten_pow_loop(e: Int, result: Float)
    [e > 0][e == 0] -> Float
{
    result = result * 10.0;
    e = e - 1;
    term result;
};

defn ten_pow(e: Int) -> Float {
    when e <= 0 {
        term 1.0;
    };
    term ten_pow_loop(e, 1.0);
};

// ===== Array Parser =====

defn parse_array(s: String, pos: Int) -> Result<ParseFrame, String> {
    when pos >= s .^Length || s[pos] != '[' {
        term err_frame(e_utoken());
    };
    let after_bracket = pos + 1;
    let p = skip_ws(s, after_bracket);
    when p < s .^Length && s[p] == ']' {
        term Ok(ParseFrame { value: Array([]), pos: p + 1 });
    };
    let result = parse_array_elems(s, p, []);
    uni result(Ok(frame)) -> {
        when frame.pos < s .^Length && s[frame.pos] == ']' {
            term Ok(ParseFrame { value: Array(frame.value), pos: frame.pos + 1 });
        };
        term err_frame(e_expcomma());
    };
    term result;
};

txn parse_array_elems(s: String, pos: Int, elems: List<JsonValue>)
    [pos < (s .^Length) && s[pos] != ']']
    [pos < (s .^Length) && s[pos] == ']']
    -> Result<ParseFrame, String>
{
    let val = parse_value(s, pos);
    uni val(Ok(frame)) -> {
        elems = elems + [frame.value];
        pos = frame.pos;
        pos = skip_ws(s, pos);
        when pos < s .^Length && s[pos] == ',' {
            pos = pos + 1;
            pos = skip_ws(s, pos);
        };
        term Ok(ParseFrame { value: Array(elems), pos: pos });
    };
    term val;
};

// ===== Object Parser =====

defn parse_object(s: String, pos: Int) -> Result<ParseFrame, String> {
    when pos >= s .^Length || s[pos] != '{' {
        term err_frame(e_utoken());
    };
    let after_brace = pos + 1;
    let p = skip_ws(s, after_brace);
    when p < s .^Length && s[p] == '}' {
        term Ok(ParseFrame { value: Object([]), pos: p + 1 });
    };
    let result = parse_object_pairs(s, p, []);
    uni result(Ok(frame)) -> {
        when frame.pos < s .^Length && s[frame.pos] == '}' {
            term Ok(ParseFrame { value: Object(frame.value), pos: frame.pos + 1 });
        };
        term err_frame(e_expcomma());
    };
    term result;
};

txn parse_object_pairs(s: String, pos: Int, pairs: List<(String, JsonValue)>)
    [pos < (s .^Length) && s[pos] != '}']
    [pos < (s .^Length) && s[pos] == '}']
    -> Result<ParseFrame, String>
{
    when s[pos] != '"' {
        term err_frame(e_expkey());
    };
    let key_res = parse_string(s, pos);
    uni key_res(Ok(kf)) -> {
        uni kf.value(StrVal(key)) -> {
            pos = skip_ws(s, kf.pos);
            when pos >= s .^Length || s[pos] != ':' {
                term err_frame(e_expcolon());
            };
            pos = skip_ws(s, pos + 1);
            let val_res = parse_value(s, pos);
            uni val_res(Ok(vf)) -> {
                pos = skip_ws(s, vf.pos);
                pairs = pairs + [(key, vf.value)];
                when pos < s .^Length && s[pos] == ',' {
                    pos = pos + 1;
                    pos = skip_ws(s, pos);
                };
                term Ok(ParseFrame { value: Object(pairs), pos: pos });
            };
            term val_res;
        };
        term err_frame(e_utoken());
    };
    term key_res;
};

defn parse_object(s: String, pos: Int) -> Result<ParseFrame, String> {
    when pos >= s .^Length || s[pos] != '{' {
        term err_frame(e_utoken());
    };
    let after_brace: Int = pos + 1;
    let p: Int = skip_ws(s, after_brace);
    when p < s .^Length && s[p] == '}' {
        term Ok(ParseFrame { value: Object([]), pos: p + 1 });
    };
    let result = parse_object_pairs(s, p, []);
    uni result(Ok(frame)) -> {
        when frame.pos < s .^Length && s[frame.pos] == '}' {
            term Ok(ParseFrame { value: Object(frame.value), pos: frame.pos + 1 });
        };
        term err_frame(e_expcomma());
    };
    term result;
};

defn parse_object(s: String, pos: Int) -> Result<ParseFrame, String> {
    when pos >= s .^Length || s[pos] != '{' {
        term err_frame(e_utoken());
    };
    let after_brace: Int = pos + 1;
    let p: Int = skip_ws(s, after_brace);
    when p < s .^Length && s[p] == '}' {
        term Ok(ParseFrame { value: Object([]), pos: p + 1 });
    };
    let result = parse_object_pairs(s, p, []);
    uni result(Ok(frame)) -> {
        when frame.pos < s .^Length && s[frame.pos] == '}' {
            term Ok(ParseFrame { value: Object(frame.value), pos: frame.pos + 1 });
        };
        term err_frame(e_expcomma());
    };
    term result;
};

txn parse_object_pairs(s: String, pos: Int, pairs: List<(String, JsonValue)>)
    [pos < (s .^Length) && s[pos] != '}']
    [pos < (s .^Length) && s[pos] == '}']
    -> Result<ParseFrame, String>
{
    when s[pos] != '"' {
        term err_frame(e_expkey());
    };
    let key_res = parse_string(s, pos);
    uni key_res(Ok(kf)) -> {
        uni kf.value(StrVal(key)) -> {
            pos = skip_ws(s, kf.pos);
            when pos >= s .^Length || s[pos] != ':' {
                term err_frame(e_expcolon());
            };
            pos = skip_ws(s, pos + 1);
            let val_res = parse_value(s, pos);
            uni val_res(Ok(vf)) -> {
                pos = skip_ws(s, vf.pos);
                pairs = pairs + [(key, vf.value)];
                when pos < s .^Length && s[pos] == ',' {
                    pos = pos + 1;
                    pos = skip_ws(s, pos);
                };
                term Ok(ParseFrame { value: Object(pairs), pos: pos });
            };
            term val_res;
        };
        term err_frame(e_utoken());
    };
    term key_res;
};
