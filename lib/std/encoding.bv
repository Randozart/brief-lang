  };
  term result;
};

// Simple URL decode (basic version - only decodes %20)
defn url_decode_simple(s: String) [true][term :> Size <= s :> Size] -> String {
  let result: String = "";
  let i: Int = 0;
  [i < s :> Size] {
    [i + 2 < s :> Size && s[i..i+1] == "%" && s[i+1..i+3] == "20"] {
      &result = result + " ";
      &i = i + 3;
    } {
      &result = result + s[i..i+1];
      &i = i + 1;
    };
  };
  term result;
};

// Check if char is hex digit
defn is_hex_digit(c: String) [c :> Size == 1][term == true || term == false] -> Bool {
  [c >= "0" && c <= "9"] { term true; };
  [c >= "a" && c <= "f"] { term true; };
  [c >= "A" && c <= "F"] { term true; };
  term false;
};

// Check if string is valid hex
defn is_hex_string(s: String) [true][term == true || term == false] -> Bool {
  [s :> Size == 0] { term false; };
  let i: Int = 0;
  let valid: Bool = true;
  [i < s :> Size && valid] {
    [is_hex_digit(s[i..i+1])] {
      &valid = true;
    } {
      &valid = false;
    };
    &i = i + 1;
  };
  term valid;
};

// Reverse string (useful for some encodings)
defn reverse_string(s: String) [true][term :> Size == s :> Size] -> String {
  [s :> Size <= 1] { term s; };
  let result: String = "";
  let i: Int = s :> Size - 1;
  [i >= 0] {
    &result = result + s[i..i+1];
    &i = i - 1;
  };
  term result;
};

// Count occurrences (useful for validation)
defn count_char(s: String, c: String) [c :> Size == 1][term >= 0] -> Int {
  let count: Int = 0;
  let i: Int = 0;
  [i < s :> Size] {
    [s[i..i+1] == c] {
      &count = count + 1;
    };
    &i = i + 1;
  };
  term count;
};