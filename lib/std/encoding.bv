// ===== NATIVE DEFINITIONS =====

// Simple hex digit to int
import "std/ffi/encoding.bv";

defn hex_digit_to_int(c: String) [c :> Size == 1][term >= 0 && term <= 15] -> Int {
  [c == "0"] { term 0; };
  [c == "1"] { term 1; };
  [c == "2"] { term 2; };
  [c == "3"] { term 3; };
  [c == "4"] { term 4; };
  [c == "5"] { term 5; };
  [c == "6"] { term 6; };
  [c == "7"] { term 7; };
  [c == "8"] { term 8; };
  [c == "9"] { term 9; };
  [c == "a" || c == "A"] { term 10; };
  [c == "b" || c == "B"] { term 11; };
  [c == "c" || c == "C"] { term 12; };
  [c == "d" || c == "D"] { term 13; };
  [c == "e" || c == "E"] { term 14; };
  [c == "f" || c == "F"] { term 15; };
  term 0;
};

// Int to hex digit
defn int_to_hex_digit(n: Int) [n >= 0 && n <= 15][term :> Size == 1] -> String {
  [n == 0] { term "0"; };
  [n == 1] { term "1"; };
  [n == 2] { term "2"; };
  [n == 3] { term "3"; };
  [n == 4] { term "4"; };
  [n == 5] { term "5"; };
  [n == 6] { term "6"; };
  [n == 7] { term "7"; };
  [n == 8] { term "8"; };
  [n == 9] { term "9"; };
  [n == 10] { term "a"; };
  [n == 11] { term "b"; };
  [n == 12] { term "c"; };
  [n == 13] { term "d"; };
  [n == 14] { term "e"; };
  [n == 15] { term "f"; };
  term "0";
};

// Simple byte to hex (for single byte)
defn byte_to_hex(b: Int) [b >= 0 && b <= 255][term :> Size == 2] -> String {
  let high: Int = b / 16;
  let low: Int = b % 16;
  term int_to_hex_digit(high) + int_to_hex_digit(low);
};

// Simple URL encode (basic version - only encodes spaces)
txn url_encode_loop(s: String, result: String, i: Int)
    [i < s :> Size][i == s :> Size] -> String
{
  let c: String = s[i..i+1];
  [c == " "] {
    &result = result + "%20";
  } {
    &result = result + c;
  };
  &i = i + 1;
  term result;
};

defn url_encode_simple(s: String) [true][term :> Size >= s :> Size] -> String {
  term url_encode_loop(s, "", 0);
};

// Simple URL decode (basic version - only decodes %20)
txn url_decode_loop(s: String, result: String, i: Int)
    [i < s :> Size][i == s :> Size] -> String
{
  [i + 2 < s :> Size && s[i..i+1] == "%" && s[i+1..i+3] == "20"] {
    &result = result + " ";
    &i = i + 3;
  } {
    &result = result + s[i..i+1];
    &i = i + 1;
  };
  term result;
};

defn url_decode_simple(s: String) [true][term :> Size <= s :> Size] -> String {
  term url_decode_loop(s, "", 0);
};

// Check if string is valid hex
txn is_hex_loop(s: String, i: Int)
    [i < s :> Size][i == s :> Size] -> Bool
{
  [!is_hex_digit(s[i..i+1])] {
    term false;
  };
  &i = i + 1;
  term true;
};

defn is_hex_string(s: String) [true][term == true || term == false] -> Bool {
  [s :> Size == 0] { term false; };
  term is_hex_loop(s, 0);
};

// Reverse string (useful for some encodings)
txn reverse_string_loop(s: String, result: String, i: Int)
    [i >= 0][i < 0] -> String
{
  &result = result + s[i..i+1];
  &i = i - 1;
  term result;
};

defn reverse_string(s: String) [true][term :> Size == s :> Size] -> String {
  [s :> Size <= 1] { term s; };
  term reverse_string_loop(s, "", s :> Size - 1);
};

// Count occurrences (useful for validation)
txn count_char_loop(s: String, c: String, count: Int, i: Int)
    [i < s :> Size][i == s :> Size] -> Int
{
  [s[i..i+1] == c] {
    &count = count + 1;
  };
  &i = i + 1;
  term count;
};

defn count_char(s: String, c: String) [c :> Size == 1][term >= 0] -> Int {
  term count_char_loop(s, c, 0, 0);
};
