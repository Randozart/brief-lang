// 2026-07-26: Browser console API wrappers for frgn from #Web.
// Each declaration wraps a browser console method as a Brief function.
// The GLUE [web] target generates JS import stubs from the type signatures
// — no compiler knowledge of these function names.

frgn console_log(msg: String) as log from #Web;
frgn console_warn(msg: String) as warn from #Web;
frgn console_error(msg: String) as error from #Web;
