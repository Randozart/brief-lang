// GPU compute intrinsic wrappers.
//
// These expose SPIR-V built-in functions as Briev intrinsic calls.
// The SPIR-V backend recognizes them and emits the correct
// SPIR-V LLVM IR built-in calls. On CPU (fallback), these
// resolve via the intrinsic codegen in the LLVM backend.
//
// Users import and call these as regular functions:
//   import { get_global_id } from "std/gpu.bv";
//   let id: Int = get_global_id(0);
//
// Implementation note: previously declared as `frgn`, replaced with
// `defn` wrappers around the intrinsic `#`-calls. The intrinsics
// provide native codegen in the LLVM backend and work across all
// targets (GPU via SPIR-V, CPU via LLVM stub).

/// Global work-item ID for the given dimension (0, 1, or 2).
/// Returns a unique thread identifier within the entire grid.
defn get_global_id(dim: Int) -> Int {
    term GetGlobalId#(dim);
};

/// Local work-item ID within the workgroup for the given dimension.
/// Returns the thread's position within its workgroup (0..block_size-1).
defn get_local_id(dim: Int) -> Int {
    term GetLocalId#(dim);
};

/// Workgroup ID for the given dimension.
/// Returns which workgroup this thread belongs to.
defn get_group_id(dim: Int) -> Int {
    term GetGroupId#(dim);
};

/// Number of workgroups in the given dimension.
/// Returns the total grid size for this dimension.
defn get_num_groups(dim: Int) -> Int {
    term GetNumGroups#(dim);
};

/// Workgroup-level barrier.
/// Synchronizes all threads in the workgroup. All threads must
/// reach the barrier before any thread continues past it.
defn barrier() -> Bool {
    term Barrier#();
};
