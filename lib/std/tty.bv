// TTY — Terminal I/O for Brief
//
// Provides ergonomic terminal operations: raw mode, size detection,
// and single-key reading. All operations route through the intrinsic
// system which emits native LLVM IR for I/O operations.
//
// Previously used `frgn` declarations to call brief_rt.c directly;
// now uses the TTY intrinsic `#`-calls which provide native codegen.
//
// Import:
//   import tty from "std/tty.bv";
//
// Usage:
//   tty.raw_mode(true);     // enable raw mode
//   let size: Int = tty.size();
//   let key: Int = tty.read_key();

import "link/brief_rt.c";

defn __tty_raw_mode(enable: Int) -> Int {
    term tty_raw_mode#(enable);
};

defn __tty_size() -> Int {
    term tty_size#();
};

defn __tty_read_key() -> Int {
    term tty_read_key#();
};

defn raw_mode(enable: Bool) -> Bool {
    term __tty_raw_mode(if enable { 1 } else { 0 }) == 1;
};

defn size() -> Int {
    term __tty_size();
};

// Returns the column count of the terminal.
defn cols(size: Int) -> Int {
    term size / 10000;
};

// Returns the row count of the terminal.
defn rows(size: Int) -> Int {
    term size % 10000;
};

defn read_key() -> Int {
    term __tty_read_key();
};
