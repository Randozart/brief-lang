// IO - File and console I/O operations
// Tier 8: Infrastructure

// ===== CONSOLE IO (Native) =====

defn print(msg: String) -> Bool [msg != ""][result == true] {
    term true;
};

defn println(msg: String) -> Bool [msg != ""][result == true] {
    term print(msg + "\n");
};

defn input() -> String [true][result.len() >= 0] {
    term "";
};

// ===== FILE IO (FFI Signatures) =====

frgn __read_file(path: String) -> Result<String, String>;
frgn __write_file(path: String, content: String) -> Result<Void, String>;
frgn __file_exists(path: String) -> Result<Bool, String>;
frgn __delete_file(path: String) -> Result<Void, String>;
frgn __list_directory(path: String) -> Result<String, String>;
frgn __create_dir(path: String) -> Result<Void, String>;

// ===== NATIVE WRAPPERS =====

defn read_file(path: String) -> String [path != ""][result.len() >= 0] {
    let result = __read_file(path);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn write_file(path: String, content: String) -> Bool [path != ""][result == true || result == false] {
    let result = __write_file(path, content);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn file_exists(path: String) -> Bool [path != ""][result == true || result == false] {
    let result = __file_exists(path);
    [result.is_ok()] {
        term result.value;
    };
    term false;
};

defn delete_file(path: String) -> Bool [path != ""][result == true || result == false] {
    let result = __delete_file(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn list_directory(path: String) -> String [path != ""][result.len() >= 0] {
    let result = __list_directory(path);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn create_dir(path: String) -> Bool [path != ""][result == true || result == false] {
    let result = __create_dir(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

// ===== PATH OPERATIONS (Native) =====

defn join_path(parts: List<String>) -> String [parts.len() > 0][result.len() >= 0] {
    let result = new_builder();
    let i: Int = 0;
    [i < parts.len()] {
        [i > 0] {
            result = result.append_char('/');
        };
        result = result.append_str(parts[i]);
        &i = i + 1;
    };
    term result.to_string();
};

defn split_path(path: String) -> String [path != ""][result.len() >= 0] {
    term path;
};

defn file_extension(path: String) -> String [path != ""][result.len() >= 0] {
    term "";
};

defn file_stem(path: String) -> String [path != ""][result.len() >= 0] {
    term path;
};

defn directory(path: String) -> String [path != ""][result.len() >= 0] {
    term ".";
};

defn absolute_path(path: String) -> String [path != ""][result.len() >= 0] {
    term path;
};

defn normalize_path(path: String) -> String [path != ""][result.len() >= 0] {
    term path;
};

// ===== FILE TYPE OPERATIONS =====

defn is_file(path: String) -> Bool [path != ""][result == true || result == false] {
    [file_exists(path)] {
        let ext = file_extension(path);
        [ext != ""] {
            term true;
        };
    };
    term false;
};

defn is_dir(path: String) -> Bool [path != ""][result == true || result == false] {
    term !is_file(path);
};

// ===== ERROR TYPE =====

enum IOError {
    IONotFound(String),
    IOPermissionDenied,
    IOAlreadyExists,
    IOInvalidData,
    IOTimedOut,
    IOOther(String)
}
