// IO - File, console, and event-driven I/O operations
// Tier 8: Infrastructure
//
// This file provides:
//   1. Console IO (print, println, input) — existing sync API
//   2. Event-driven IO (pump + sleep + accessors) — reactive event model
//   3. File IO — existing FFI wrappers
//
// The event model uses rct txn + frgn + @ link exclusively.
// No magic, no compiler-generated functions.
//
// Usage:
//   import io from "std/io.bv";
//   import { char_at } from "std/string.bv";
//   rct txn my_handler [io.io_ready]] {
//       [char_at(io.__io_buffer, 0) == 'a'] { ... };
//       io.consume();
//   };
//
import "link/brief_rt.c";

// ===== FFI DECLARATIONS =====
//
// __raw_poll: non-blocking read of all pending events from the OS.
// Guaranteed non-blocking because __wait_for_event already determined
// that data is available. Returns a raw byte buffer.
frgn __raw_poll() -> String ;

// __wait_for_event: blocks the thread until at least one event source
// has data. Maps to epoll_wait (Linux), kevent (BSD), wfi (ARM), hlt (x86).
// Declared as the LAST rct txn in dispatch order so it only fires when
// no other transaction's precondition is true.
frgn __wait_for_event() -> Void ;

// ===== CONSOLE IO (Native) =====
// Uses transparent FFI — no compiler magic.
// __print and __print_int are provided by brief_rt.c (linked via "link/brief_rt.c").

frgn #out __print(msg: String) -> Bool ;
frgn #out __print_int(n: Int) -> Bool ;

defn print(msg: String) -> Bool [msg != ""][term == true] {
    term __print(msg);
};

defn println(msg: String) -> Bool [msg != ""][term == true] {
    term __print(msg + "\n");
};

defn print_int(n: Int) -> Bool [[term == true] {
    term __print_int(n);
};

defn input() -> String [true][term :> Size >= 0] {
    term "";
};

// ===== EVENT-DRIVEN IO =====

// __io_pending trigger — set by brief_rt.c when any event arrives.
// Also declared in std/system.bv with the same @ link name.
// The linker deduplicates @__io_pending.
trg __io_pending: Bool @ link __io_pending;

// Internal buffer populated by the pump transaction on each tick
// that has pending events.
let __io_buffer: String = "";

// Public flag: set to true by the pump when new data is available.
// User transactions gate on this:
//   rct txn my_handler [io.io_ready]] { ... &io.io_ready = false; term; };
let io_ready: Bool = false;

// ── PUMP TRANSACTION ──
//
// Fires when __io_pending is signaled by brief_rt.c (via signal handler,
// timer, epoll, or interrupt).
//
// Calls the non-blocking FFI poll to drain all pending events into
// the buffer, then signals io_ready for downstream consumers.
rct txn __io_pump [__io_pending == true]] {
    &__io_buffer = __raw_poll();
    &io_ready = true;
    term;
};

// ── SLEEP TRANSACTION ──
//
// Fires when no other transaction has a true precondition (including
// __io_pump). Calls __wait_for_event which blocks until an event
// arrives, then the next tick re-evaluates all preconditions.
//
// Because rct txn uses first-true-wins dispatch, and this transaction
// has precondition [true], it will only fire if all earlier transactions
// had false preconditions. This is the "equilibrium sleep" pattern.
rct txn __io_sleep [true][term == true] {
    __wait_for_event();
    term;
};

// ── CONVENIENCE ──
//
// Resets io_ready after consuming the event data.
// Call at the end of your handler:
//   rct txn my_handler [io.io_ready]] {
//       let c = char_at(io.__io_buffer, 0);
//       io.consume();
//   };
defn consume() -> Bool {
    &io_ready = false;
    term true;
};

// ===== FILE IO (FFI Signatures) =====

frgn __read_file(path: String) -> Result<String, String> from "std::fs::read_to_string";
frgn __write_file(path: String, content: String) -> Result<Void, String> from "std::fs::write";
frgn __file_exists(path: String) -> Result<Bool, String> from "std::fs::metadata";
frgn __delete_file(path: String) -> Result<Void, String> from "std::fs::remove_file";
frgn __list_directory(path: String) -> Result<String, String> from "std::fs::read_dir";
frgn __create_dir(path: String) -> Result<Void, String> from "std::fs::create_dir";

// ===== NATIVE WRAPPERS =====

defn read_file(path: String) -> String [path != ""][term :> Size >= 0] {
    let result = __read_file(path);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn write_file(path: String, content: String) -> Bool [path != ""][term == true || term == false] {
    let result = __write_file(path, content);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn file_exists(path: String) -> Bool [path != ""][term == true || term == false] {
    let result = __file_exists(path);
    [result.is_ok()] {
        term result.value;
    };
    term false;
};

defn delete_file(path: String) -> Bool [path != ""][term == true || term == false] {
    let result = __delete_file(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

defn list_directory(path: String) -> String [path != ""][term :> Size >= 0] {
    let result = __list_directory(path);
    [result.is_ok()] {
        term result.value;
    };
    term "";
};

defn create_dir(path: String) -> Bool [path != ""][term == true || term == false] {
    let result = __create_dir(path);
    [result.is_ok()] {
        term true;
    };
    term false;
};

// ===== PATH OPERATIONS (Native) =====

defn join_path(parts: List<String>) -> String [parts :> Size > 0][term :> Size >= 0] {
    let result = new_builder();
    let i: Int = 0;
    [i < parts :> Size] {
        [i > 0] {
            result = result.append_char('/');
        };
        result = result.append_str(parts[i]);
        &i = i + 1;
    };
    term result.to_string();
};

defn split_path(path: String) -> String [path != ""][term :> Size >= 0] {
    term path;
};

defn file_extension(path: String) -> String [path != ""][term :> Size >= 0] {
    term "";
};

defn file_stem(path: String) -> String [path != ""][term :> Size >= 0] {
    term path;
};

defn directory(path: String) -> String [path != ""][term :> Size >= 0] {
    term ".";
};

defn absolute_path(path: String) -> String [path != ""][term :> Size >= 0] {
    term path;
};

defn normalize_path(path: String) -> String [path != ""][term :> Size >= 0] {
    term path;
};

// ===== FILE TYPE OPERATIONS =====

defn is_file(path: String) -> Bool [path != ""][term == true || term == false] {
    [file_exists(path)] {
        let ext = file_extension(path);
        [ext != ""] {
            term true;
        };
    };
    term false;
};

defn is_dir(path: String) -> Bool [path != ""][term == true || term == false] {
    term !is_file(path);
};

// ===== ERROR TYPE =====

enum IOError {
    IONotFound(String),
    IOPermissionDenied,
    IOAlreadyExists,
    IOInvalidData,
    IOTimedOut,
    IOOther(String)
}