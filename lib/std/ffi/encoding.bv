// Standard Encoding Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Briev.
//
// Note: Most encoding functions require bit manipulation 
// and complex algorithms, so they are mostly foreign.

// ===== PURE FOREIGN (requires bit manipulation/complex algorithms) =====

// Base64
frgn frgn__base64_encode(data: String) -> Result<String, EncodingError> : __base64_encode from "lib/runtime/briev_rt.c";
frgn frgn__base64_decode(s: String) -> Result<String, EncodingError> : __base64_decode from "lib/runtime/briev_rt.c";
frgn frgn__base64_url_encode(data: String) -> Result<String, EncodingError> : __base64_url_encode from "lib/runtime/briev_rt.c";
frgn frgn__base64_url_decode(s: String) -> Result<String, EncodingError> : __base64_url_decode from "lib/runtime/briev_rt.c";
// Hex
frgn frgn__hex_encode(data: String) -> Result<String, EncodingError> : __hex_encode from "lib/runtime/briev_rt.c";
frgn frgn__hex_decode(s: String) -> Result<String, EncodingError> : __hex_decode from "lib/runtime/briev_rt.c";
frgn frgn__hex_encode_bytes(list: List<Int>) -> Result<String, EncodingError> : __hex_encode_bytes from "lib/runtime/briev_rt.c";
frgn frgn__hex_decode_bytes(s: String) -> Result<List<Int>, EncodingError> : __hex_decode_bytes from "lib/runtime/briev_rt.c";

// URL Encoding
frgn frgn__url_encode(s: String) -> Result<String, EncodingError> : __url_encode from "lib/runtime/briev_rt.c";
frgn frgn__url_decode(s: String) -> Result<String, EncodingError> : __url_decode from "lib/runtime/briev_rt.c";
frgn frgn__url_encode_component(s: String) -> Result<String, EncodingError> : __url_encode_component from "lib/runtime/briev_rt.c";
frgn frgn__url_decode_component(s: String) -> Result<String, EncodingError> : __url_decode_component from "lib/runtime/briev_rt.c";
// HTML Encoding
frgn frgn__html_escape(s: String) -> Result<String, EncodingError> : __html_escape from "lib/runtime/briev_rt.c";
frgn frgn__html_unescape(s: String) -> Result<String, EncodingError> : __html_unescape from "lib/runtime/briev_rt.c";
// Unicode
frgn frgn__UTF8_encode(s: String) -> Result<List<Int>, EncodingError> : __UTF8_encode from "lib/runtime/briev_rt.c";
frgn frgn__UTF8_decode(list: List<Int>) -> Result<String, EncodingError> : __UTF8_decode from "lib/runtime/briev_rt.c";
frgn frgn__codepoint_to_char(code: Int) -> Result<String, EncodingError> : __codepoint_to_char from "lib/runtime/briev_rt.c";
frgn frgn__char_to_codepoint(c: String) -> Result<Int, EncodingError> : __char_to_codepoint from "lib/runtime/briev_rt.c";
// Hashing
frgn frgn__md5(s: String) -> Result<String, EncodingError> : __md5 from "lib/runtime/briev_rt.c";
frgn frgn__sha1(s: String) -> Result<String, EncodingError> : __sha1 from "lib/runtime/briev_rt.c";
frgn frgn__sha256(s: String) -> Result<String, EncodingError> : __sha256 from "lib/runtime/briev_rt.c";
frgn frgn__sha512(s: String) -> Result<String, EncodingError> : __sha512 from "lib/runtime/briev_rt.c";
// UUID
frgn frgn__uuid_v4() -> Result<String, EncodingError> : __uuid_v4 from "lib/runtime/briev_rt.c";
frgn frgn__is_uuid(s: String) -> Result<Bool, EncodingError> : __is_uuid from "lib/runtime/briev_rt.c";
// URI Components
frgn frgn__uri_parse(s: String) -> Result<Data, EncodingError> : __uri_parse from "lib/runtime/briev_rt.c";
frgn frgn__uri_build(data: Data) -> Result<String, EncodingError> : __uri_build from "lib/runtime/briev_rt.c";
frgn frgn__uri_get_param(url: String, key: String) -> Result<String, EncodingError> : __uri_get_param from "lib/runtime/briev_rt.c";
