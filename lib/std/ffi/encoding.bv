// Standard Encoding Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Brief.
//
// Note: Most encoding functions require bit manipulation 
// and complex algorithms, so they are mostly foreign.

// ===== PURE FOREIGN (requires bit manipulation/complex algorithms) =====

// Base64
frgn __base64_encode(data: String) -> Result<String, EncodingError> as frgn__base64_encode from "link/brief_rt.c" fallback "";
frgn __base64_decode(s: String) -> Result<String, EncodingError> as frgn__base64_decode from "link/brief_rt.c" fallback "";
frgn __base64_url_encode(data: String) -> Result<String, EncodingError> as frgn__base64_url_encode from "link/brief_rt.c" fallback "";
frgn __base64_url_decode(s: String) -> Result<String, EncodingError> as frgn__base64_url_decode from "link/brief_rt.c" fallback "";
// Hex
frgn __hex_encode(data: String) -> Result<String, EncodingError> as frgn__hex_encode from "link/brief_rt.c" fallback "";
frgn __hex_decode(s: String) -> Result<String, EncodingError> as frgn__hex_decode from "link/brief_rt.c" fallback "";
frgn __hex_encode_bytes(list: List<Int>) -> Result<String, EncodingError> as frgn__hex_encode_bytes from "link/brief_rt.c" fallback "";
frgn __hex_decode_bytes(s: String) -> Result<List<Int>, EncodingError> as frgn__hex_decode_bytes from "link/brief_rt.c" fallback [];

// URL Encoding
frgn __url_encode(s: String) -> Result<String, EncodingError> as frgn__url_encode from "link/brief_rt.c" fallback "";
frgn __url_decode(s: String) -> Result<String, EncodingError> as frgn__url_decode from "link/brief_rt.c" fallback "";
frgn __url_encode_component(s: String) -> Result<String, EncodingError> as frgn__url_encode_component from "link/brief_rt.c" fallback "";
frgn __url_decode_component(s: String) -> Result<String, EncodingError> as frgn__url_decode_component from "link/brief_rt.c" fallback "";
// HTML Encoding
frgn __html_escape(s: String) -> Result<String, EncodingError> as frgn__html_escape from "link/brief_rt.c" fallback "";
frgn __html_unescape(s: String) -> Result<String, EncodingError> as frgn__html_unescape from "link/brief_rt.c" fallback "";
// Unicode
frgn __utf8_encode(s: String) -> Result<List<Int>, EncodingError> as frgn__utf8_encode from "link/brief_rt.c" fallback [];
frgn __utf8_decode(list: List<Int>) -> Result<String, EncodingError> as frgn__utf8_decode from "link/brief_rt.c" fallback "";
frgn __codepoint_to_char(code: Int) -> Result<String, EncodingError> as frgn__codepoint_to_char from "link/brief_rt.c" fallback "";
frgn __char_to_codepoint(c: String) -> Result<Int, EncodingError> as frgn__char_to_codepoint from "link/brief_rt.c" fallback 0;
// Hashing
frgn __md5(s: String) -> Result<String, EncodingError> as frgn__md5 from "link/brief_rt.c" fallback "";
frgn __sha1(s: String) -> Result<String, EncodingError> as frgn__sha1 from "link/brief_rt.c" fallback "";
frgn __sha256(s: String) -> Result<String, EncodingError> as frgn__sha256 from "link/brief_rt.c" fallback "";
frgn __sha512(s: String) -> Result<String, EncodingError> as frgn__sha512 from "link/brief_rt.c" fallback "";
// UUID
frgn __uuid_v4() -> Result<String, EncodingError> as frgn__uuid_v4 from "link/brief_rt.c" fallback "";
frgn __is_uuid(s: String) -> Result<Bool, EncodingError> as frgn__is_uuid from "link/brief_rt.c" fallback false;
// URI Components
frgn __uri_parse(s: String) -> Result<Data, EncodingError> as frgn__uri_parse from "link/brief_rt.c" fallback "";
frgn __uri_build(data: Data) -> Result<String, EncodingError> as frgn__uri_build from "link/brief_rt.c" fallback "";
frgn __uri_get_param(url: String, key: String) -> Result<String, EncodingError> as frgn__uri_get_param from "link/brief_rt.c" fallback "";
