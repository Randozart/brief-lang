// Standard Time Library
//
// Functions marked with 'frgn' require foreign implementation.
// Functions with 'defn' are implemented natively in Briv.

// ===== PURE FOREIGN (requires system time) =====

// Current time
frgn frgn__now() -> Result<Int, TimeError> : __now from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__now_millis() -> Result<Int, TimeError> : __now_millis from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__now_micros() -> Result<Int, TimeError> : __now_micros from "lib/runtime/briv_rt.c" fallback 0;
// Time component extraction
frgn frgn__year(timestamp: Int) -> Result<Int, TimeError> : __year from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__month(timestamp: Int) -> Result<Int, TimeError> : __month from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__day(timestamp: Int) -> Result<Int, TimeError> : __day from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__hour(timestamp: Int) -> Result<Int, TimeError> : __hour from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__minute(timestamp: Int) -> Result<Int, TimeError> : __minute from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__second(timestamp: Int) -> Result<Int, TimeError> : __second from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__weekday(timestamp: Int) -> Result<Int, TimeError> : __weekday from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__yearday(timestamp: Int) -> Result<Int, TimeError> : __yearday from "lib/runtime/briv_rt.c" fallback 0;
// Time creation
frgn frgn__timestamp(year: Int, month: Int, day: Int) -> Result<Int, TimeError> : __timestamp from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__timestamp_full(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Result<Int, TimeError> : __timestamp_full from "lib/runtime/briv_rt.c" fallback 0;
// Formatting
frgn frgn__format_timestamp(timestamp: Int, format: String) -> Result<String, TimeError> : __format_timestamp from "lib/runtime/briv_rt.c" fallback "";
frgn frgn__format_date(timestamp: Int) -> Result<String, TimeError> : __format_date from "lib/runtime/briv_rt.c" fallback "";
frgn frgn__format_time(timestamp: Int) -> Result<String, TimeError> : __format_time from "lib/runtime/briv_rt.c" fallback "";
frgn frgn__format_datetime(timestamp: Int) -> Result<String, TimeError> : __format_datetime from "lib/runtime/briv_rt.c" fallback "";
// Parsing
frgn frgn__parse_timestamp(s: String) -> Result<Int, TimeError> : __parse_timestamp from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__parse_datetime(s: String) -> Result<Int, TimeError> : __parse_datetime from "lib/runtime/briv_rt.c" fallback 0;
