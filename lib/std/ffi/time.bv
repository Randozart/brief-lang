// Time differences - native


// Constants - these could be frgn or defn
frgn __seconds_per_minute() -> Result<Int, TimeError> as frgn__seconds_per_minute from "link/brief_rt.c" fallback 0;
frgn __seconds_per_hour() -> Result<Int, TimeError> as frgn__seconds_per_hour from "link/brief_rt.c" fallback 0;
frgn __seconds_per_day() -> Result<Int, TimeError> as frgn__seconds_per_day from "link/brief_rt.c" fallback 0;
frgn __millis_per_second() -> Result<Int, TimeError> as frgn__millis_per_second from "link/brief_rt.c" fallback 0;
frgn __micros_per_second() -> Result<Int, TimeError> as frgn__micros_per_second from "link/brief_rt.c" fallback 0;
