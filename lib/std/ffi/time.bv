// Constants - these could be frgn or defn
frgn frgn__seconds_per_minute() -> Result<Int, TimeError> : __seconds_per_minute from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__seconds_per_hour() -> Result<Int, TimeError> : __seconds_per_hour from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__seconds_per_day() -> Result<Int, TimeError> : __seconds_per_day from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__millis_per_second() -> Result<Int, TimeError> : __millis_per_second from "lib/runtime/briv_rt.c" fallback 0;
frgn frgn__micros_per_second() -> Result<Int, TimeError> : __micros_per_second from "lib/runtime/briv_rt.c" fallback 0;
