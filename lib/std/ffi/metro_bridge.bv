// Metropolitan FFI Bridge
// Low-level shared memory and atomic primitives.
// These frgn declarations resolve through the metropolitan.dbvs binding file
// to implementations in the Rust compiler's FFI registry.
//
// Usage:
//   import "std/metro_bridge.bv";
//
//   txn example [true]] {
//       let fd = __shm_open("my_shm", 0x0202, 420);
//       [fd.is_ok()] { term fd.value; };
//       term 0;
//   };

// ===== SHM Operations =====
// Int fd, address, or flags
// String name, data

frgn frgn__shm_open(name: String, flags: Int, mode: Int) -> Result<Int, ShmError> : __shm_open from "lib/runtime/briev_rt.c";
frgn frgn__shm_unlink(name: String) -> Result<Void, ShmError> : __shm_unlink from "lib/runtime/briev_rt.c";
frgn frgn__ftruncate_shm(fd: Int, length: Int) -> Result<Void, ShmError> : __ftruncate_shm from "lib/runtime/briev_rt.c";
frgn frgn__shm_list() -> Result<List<String>, ShmError> : __shm_list from "lib/runtime/briev_rt.c";
frgn frgn__shm_exists(name: String) -> Result<Bool, ShmError> : __shm_exists from "lib/runtime/briev_rt.c";
frgn frgn__shm_size(name: String) -> Result<Int, ShmError> : __shm_size from "lib/runtime/briev_rt.c";

// ===== MMAP Operations =====

frgn frgn__mmap_anonymous(length: Int, prot: Int, flags: Int) -> Result<Int, MmapError> : __mmap_anonymous from "lib/runtime/briev_rt.c";
frgn frgn__munmap(addr: Int, length: Int) -> Result<Void, MmapError> : __munmap from "lib/runtime/briev_rt.c";
frgn frgn__msync(addr: Int, length: Int, flags: Int) -> Result<Void, MmapError> : __msync from "lib/runtime/briev_rt.c";
frgn frgn__mmap_write(addr: Int, offset: Int, data: List<Int>, length: Int) -> Result<Void, MmapError> : __mmap_write from "lib/runtime/briev_rt.c";
frgn frgn__mmap_read(addr: Int, offset: Int, length: Int) -> Result<List<Int>, MmapError> : __mmap_read from "lib/runtime/briev_rt.c";
frgn frgn__mmap_read_u32(addr: Int, offset: Int) -> Result<Int, MmapError> : __mmap_read_u32 from "lib/runtime/briev_rt.c";
frgn frgn__mmap_write_u32(addr: Int, offset: Int, value: Int) -> Result<Void, MmapError> : __mmap_write_u32 from "lib/runtime/briev_rt.c";

// ===== Atomic Operations =====

frgn frgn__atomic_load_u32(addr: Int, offset: Int) -> Result<Int, AtomicError> : __atomic_load_u32 from "lib/runtime/briev_rt.c";
frgn frgn__atomic_store_u32(addr: Int, offset: Int, value: Int) -> Result<Void, AtomicError> : __atomic_store_u32 from "lib/runtime/briev_rt.c";
frgn frgn__atomic_cas_u32(addr: Int, offset: Int, expected: Int, new_value: Int) -> Result<Int, AtomicError> : __atomic_cas_u32 from "lib/runtime/briev_rt.c";
frgn frgn__atomic_fence() -> Result<Void, AtomicError> : __atomic_fence from "lib/runtime/briev_rt.c";
frgn frgn__atomic_xchg_u32(addr: Int, offset: Int, value: Int) -> Result<Int, AtomicError> : __atomic_xchg_u32 from "lib/runtime/briev_rt.c";
frgn frgn__atomic_add_u32(addr: Int, offset: Int, value: Int) -> Result<Int, AtomicError> : __atomic_add_u32 from "lib/runtime/briev_rt.c";

// ===== Channel Operations =====

frgn frgn__metro_create_channel(channel_id: String, input_size: Int, output_size: Int) -> Result<String, String> : __metro_create_channel from "lib/runtime/briev_rt.c";
frgn frgn__metro_destroy_channel(channel_id: String) -> Result<Void, String> : __metro_destroy_channel from "lib/runtime/briev_rt.c";
frgn frgn__metro_generate_c_header(channel_id: String) -> Result<String, String> : __metro_generate_c_header from "lib/runtime/briev_rt.c";
frgn frgn__metro_get_channel_layout(channel_id: String) -> Result<Int, String> : __metro_get_channel_layout from "lib/runtime/briev_rt.c";

// Pre-initialized Metropolitan RPC function.
// Wraps channel creation, shared memory write, status signaling,
// polling, response read, and teardown into a single convenient call.
//
// Parameters:
//   channel_id - unique name for the channel
//   request - byte values to send
//   timeout_ms - max wait time in milliseconds
// Returns:
//   Result<List<Int>, String> - response bytes or error message
                        // Poll for PROVIDER_RES (status = 3)
                        // Compiler trusts this intentional unbounded operation
