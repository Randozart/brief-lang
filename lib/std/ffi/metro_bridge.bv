// Metropolitan FFI Bridge
// Low-level shared memory and atomic primitives.
// These frgn declarations resolve through the metropolitan.dbvs binding file
// to implementations in the Rust compiler's FFI registry.
//
// Usage:
//   import "std/metro_bridge.bv";
//
//   txn example [true]] {
//       let fd = __shm_open("my_shm", 0x0202, 420);
//       [fd.is_ok()] { term fd.value; };
//       term 0;
//   };

// ===== SHM Operations =====
// Int fd, address, or flags
// String name, data

frgn __shm_open(name: String, flags: Int, mode: Int) -> Result<Int, ShmError>;
frgn __shm_unlink(name: String) -> Result<Void, ShmError>;
frgn __ftruncate_shm(fd: Int, length: Int) -> Result<Void, ShmError>;
frgn __shm_list() -> Result<List<String>, ShmError>;
frgn __shm_exists(name: String) -> Result<Bool, ShmError>;
frgn __shm_size(name: String) -> Result<Int, ShmError>;

// ===== MMAP Operations =====

frgn __mmap_anonymous(length: Int, prot: Int, flags: Int) -> Result<Int, MmapError>;
frgn __munmap(addr: Int, length: Int) -> Result<Void, MmapError>;
frgn __msync(addr: Int, length: Int, flags: Int) -> Result<Void, MmapError>;
frgn __mmap_write(addr: Int, offset: Int, data: List<Int>, length: Int) -> Result<Void, MmapError>;
frgn __mmap_read(addr: Int, offset: Int, length: Int) -> Result<List<Int>, MmapError>;
frgn __mmap_read_u32(addr: Int, offset: Int) -> Result<Int, MmapError>;
frgn __mmap_write_u32(addr: Int, offset: Int, value: Int) -> Result<Void, MmapError>;

// ===== Atomic Operations =====

frgn __atomic_load_u32(addr: Int, offset: Int) -> Result<Int, AtomicError>;
frgn __atomic_store_u32(addr: Int, offset: Int, value: Int) -> Result<Void, AtomicError>;
frgn __atomic_cas_u32(addr: Int, offset: Int, expected: Int, new_value: Int) -> Result<Int, AtomicError>;
frgn __atomic_fence() -> Result<Void, AtomicError>;
frgn __atomic_xchg_u32(addr: Int, offset: Int, value: Int) -> Result<Int, AtomicError>;
frgn __atomic_add_u32(addr: Int, offset: Int, value: Int) -> Result<Int, AtomicError>;

// ===== Channel Operations =====

frgn __metro_create_channel(channel_id: String, input_size: Int, output_size: Int) -> Result<String, String>;
frgn __metro_destroy_channel(channel_id: String) -> Result<Void, String>;
frgn __metro_generate_c_header(channel_id: String) -> Result<String, String>;
frgn __metro_get_channel_layout(channel_id: String) -> Result<Int, String>;

// Pre-initialized Metropolitan RPC function.
// Wraps channel creation, shared memory write, status signaling,
// polling, response read, and teardown into a single convenient call.
//
// Parameters:
//   channel_id - unique name for the channel
//   request - byte values to send
//   timeout_ms - max wait time in milliseconds
// Returns:
//   Result<List<Int>, String> - response bytes or error message
defn metropolitan_rpc(
    channel_id: String,
    request: List<Int>,
    timeout_ms: Int,
) -> Result<List<Int>, String> [
    true
][
    term.is_ok() || term.is_err()
] {
    let ch = __metro_create_channel(channel_id, 4096, 4096);
    [ch.is_ok()] {
        let ch_id = ch.value;
        let layout = __metro_get_channel_layout(ch_id);
        [layout.is_ok()] {
            let layout_addr = layout.value;
            let written = __mmap_write(layout_addr, 32, request, request :> Size);
            [written.is_ok()] {
                let signaled = __atomic_store_u32(layout_addr, 0, 1);
                [signaled.is_ok()] {
                    alka! {
                        // Poll for PROVIDER_RES (status = 3)
                        // Compiler trusts this intentional unbounded operation
                    };
                    let status = __atomic_load_u32(layout_addr, 0);
                    [status.is_ok()] {
                        [status.value == 3] {
                            let response = __mmap_read(layout_addr, 32, 4096);
                            [response.is_ok()] {
                                term Ok(response.value);
                            };
                            term Err("read_failed");
                        };
                        [status.value == 4] {
                            term Err("foreign_error");
                        };
                        term Err("unexpected_status");
                    };
                    term Err("status_failed");
                };
                term Err("signal_failed");
            };
            term Err("write_failed");
        };
        term Err("layout_failed");
    };
    term Err("channel_failed");
};
