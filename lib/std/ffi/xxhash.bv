// xxhash — xxHash Fast Hash Function Bindings
// Tier 3: Data & Encoding
//
// Provides Briv wrappers for the xxHash family of non-cryptographic
// hash functions. xxHash is extremely fast and has excellent
// distribution properties.
//
// Raw FFI:
//   XXH64(data_ptr: Int, len: Int, seed: Int) -> Int
//   XXH32(data_ptr: Int, len: Int, seed: Int) -> Int
//
// Convenience wrappers accept String directly:
//   xxh64(str: String, seed: Int) -> Int
//   xxh32(str: String, seed: Int) -> Int
//
// Usage:
//   import { xxh64, xxh32 } from "std/xxhash.bv";
//   let h = xxh64("hello", 0);
//   OUT__print_int(h);
//

// ===== RAW FFI DECLARATIONS =====
// Parameters: data pointer (Int = raw address), length (Int), seed (Int)
// Returns: 64-bit or 32-bit hash value

frgn frgn__xxh64(data_ptr: Int, len: Int, seed: Int) -> Int : XXH64 from "lib/std/c/xxhash/xxhash.c" fallback 0;
frgn frgn__xxh32(data_ptr: Int, len: Int, seed: Int) -> Int : XXH32 from "lib/std/c/xxhash/xxhash.c" fallback 0;

// ===== CONVENIENCE WRAPPERS =====
