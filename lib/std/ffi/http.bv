// Standard HTTP Library
// Foreign function declarations for WASM target

frgn frgn__http_get(url: String) -> Result<String, HttpError> : __http_get from "lib/runtime/briev_rt.c";
frgn frgn__http_post(url: String, body: String) -> Result<String, HttpError> : __http_post from "lib/runtime/briev_rt.c";
