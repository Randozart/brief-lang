// Standard HTTP Library
// Foreign function declarations for WASM target

frgn __http_get(url: String) -> Result<String, HttpError> as frgn__http_get from "lib/runtime/briv_rt.c" fallback "";
frgn __http_post(url: String, body: String) -> Result<String, HttpError> as frgn__http_post from "lib/runtime/briv_rt.c" fallback "";
