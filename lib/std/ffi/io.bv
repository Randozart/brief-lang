// 2026-07-19: Terminal I/O FFI. Replaces Print#/PutChar# intrinsics.
// !Print(x)/!PrintLn(x) dispatched by print plugin (Mid stage).
// Provided by brief_rt.c via std/brief_rt.bv.

frgn __print_int(n: Int) -> Void from "std/brief_rt.bv";
frgn __print_str(msg: String) -> Void from "std/brief_rt.bv";
frgn __print_float(f: Float) -> Void from "std/brief_rt.bv";
frgn __print_char(c: Int) -> Void from "std/brief_rt.bv";
