// 2026-07-19: Terminal I/O FFI. Replaces Print#/PutChar# intrinsics.
// !Print(x)/!PrintLn(x) dispatched by print plugin (Mid stage).
// Provided by brief_rt.c via std/brief_rt.bv.

// 2026-07-21: Return Int (not Void) to match C's int64_t return type.
// LTO inlining requires the call site and definition signatures to match
// (mismatched return types prevent LTO from inlining frgn functions).
frgn __print_int(n: Int) -> Int as frgn__print_int from "lib/runtime/brief_rt.c" fallback 0;
frgn __print_str(msg: String) -> Void as frgn__print_str from "lib/runtime/brief_rt.c" fallback;
frgn __print_float(f: Float) -> Int as frgn__print_float from "lib/runtime/brief_rt.c" fallback 0;
frgn __print_char(c: Int) -> Int as frgn__print_char from "lib/runtime/brief_rt.c" fallback 0;
