// OUT Library — Observable Output
//
// Provides output functions via Brief intrinsics. Intrinsics handle
// observability natively — the compiler cannot eliminate them.
//
// Replaced: sig #out wrappers (frgn-based) with raw intrinsic calls.
// Intrinsics provide native LLVM codegen with observability built in.
//
// Usage:
//   import { print_int, print_float, print_str, putchar } from "std/out.bv";
//   print_int(42);
//   print_str("hello");
//   putchar(65);

import "link/brief_rt.c";

/// Print an integer to stdout.
defn print_int(n: Int) -> Bool {
    term Print#(n);
};

/// Print a character to stdout. The arg is a `#Char` value, so the generic
/// `Print#` convenience intrinsic routes it to `__print_char` (2026-08-01).
defn putchar(c: Char) -> Int {
    term Print#(c);
};

/// Print a string to stdout (no newline).
defn print_str(msg: String) -> Bool {
    term Print#(msg);
};

/// Print a float to stdout.
defn print_float(f: Float) -> Bool {
    term Print#(f);
};

/// Print a string followed by newline.
defn println(msg: String) -> Bool {
    term PrintLn#(msg);
};
