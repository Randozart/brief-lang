// Token - Lexer token type definition
// Tier 3: Lexer Components

// ===== TOKEN ENUM =====

enum Token {
    // Literals
    TokenInt(Int),
    TokenFloat(Float),
    TokenString(String),
    TokenChar(Char),
    
    // Keywords (grouped by category)
    
    // State and constants
    KeywordLet,
    KeywordConst,
    KeywordState,
    
    // Transactions
    KeywordTxn,
    KeywordRct,
    KeywordAsync,
    KeywordTerm,
    KeywordEscape,
    
    // Functions
    KeywordDefn,
    KeywordSig,
    KeywordSign,
    KeywordSignature,
    
    // FFI
    KeywordFrgn,
    KeywordSyscall,
    KeywordResource,
    KeywordRsrc,
    
    // Types
    KeywordStruct,
    KeywordRstruct,
    KeywordEnum,
    KeywordType,
    
    // Control
    KeywordImport,
    KeywordFrom,
    KeywordAs,
    KeywordForall,
    KeywordExists,
    KeywordWithin,
    
    // Hardware
    KeywordTrg,
    KeywordLink,
    KeywordBank,
    
    // Assembly
    KeywordAsm,
    KeywordStage,
    KeywordOn,
    
    // Rendered Brief
    KeywordRender,
    
    // Boolean literals
    KeywordTrue,
    KeywordFalse,
    
    // Result types
    KeywordOk,
    KeywordErr,
    
    // Operators (single char)
    OpPlus,          // +
    OpMinus,         // -
    OpStar,          // *
    OpSlash,         // /
    OpPercent,       // %
    OpEq,            // =
    OpBang,          // !
    OpAmp,           // &
    OpPipe,          // |
    OpCaret,         // ^
    OpTilde,         // ~
    OpQuestion,      // ?
    OpAt,            // @
    OpDot,           // .
    OpColon,         // :
    OpSemicolon,     // ;
    OpComma,         // ,
    
    // Operators (multi-char)
    OpEqEq,          // ==
    OpNeq,           // !=
    OpLt,            // <
    OpGt,            // >
    OpLtEq,          // <=
    OpGtEq,          // >=
    OpAnd,           // &&
    OpOr,            // ||
    OpAmpAmp,        // && (alias)
    OpPipePipe,      // || (alias)
    OpLtLt,          // <<
    OpGtGt,          // >>
    OpArrow,         // ->
    OpFatArrow,      // =>
    OpSlashSlash,    // //
    OpDotDot,        // ..
    OpDotDotEq,      // ..=
    OpPlusEq,        // +=
    OpMinusEq,       // -=
    OpStarEq,        // *=
    OpSlashEq,       // /=
    OpPercentEq,     // %=
    OpAmpEq,         // &=
    OpPipeEq,        // |=
    OpCaretEq,       // ^=
    OpLtLtEq,        // <<=
    OpGtGtEq,        // >>=
    
    // Delimiters
    DelimLParen,     // (
    DelimRParen,     // )
    DelimLBrace,     // {
    DelimRBrace,     // }
    DelimLBracket,   // [
    DelimRBracket,   // ]
    
    // Special
    TokenIdentifier(String),
    TokenComment(String),
    TokenWhitespace(String),
    TokenNewline,
    TokenEof,
    TokenError(String)
}

// ===== TOKEN UTILITIES =====

// Check if token is a keyword
defn is_keyword(tok: Token) -> Bool {
    unification tok(KeywordLet) = true;
    unification tok(KeywordConst) = true;
    unification tok(KeywordTxn) = true;
    unification tok(KeywordRct) = true;
    unification tok(KeywordAsync) = true;
    unification tok(KeywordDefn) = true;
    unification tok(KeywordSig) = true;
    unification tok(KeywordFrgn) = true;
    unification tok(KeywordStruct) = true;
    unification tok(KeywordEnum) = true;
    unification tok(KeywordImport) = true;
    unification tok(KeywordTrue) = true;
    unification tok(KeywordFalse) = true;
    term false;
};

// Get keyword as string
defn keyword_to_string(tok: Token) -> String {
    unification tok(KeywordLet) = "let";
    unification tok(KeywordConst) = "const";
    unification tok(KeywordTxn) = "txn";
    unification tok(KeywordRct) = "rct";
    unification tok(KeywordAsync) = "async";
    unification tok(KeywordTerm) = "term";
    unification tok(KeywordEscape) = "escape";
    unification tok(KeywordDefn) = "defn";
    unification tok(KeywordSig) = "sig";
    unification tok(KeywordFrgn) = "frgn";
    unification tok(KeywordSyscall) = "syscall";
    unification tok(KeywordStruct) = "struct";
    unification tok(KeywordRstruct) = "rstruct";
    unification tok(KeywordEnum) = "enum";
    unification tok(KeywordImport) = "import";
    unification tok(KeywordFrom) = "from";
    unification tok(KeywordAs) = "as";
    unification tok(KeywordTrue) = "true";
    unification tok(KeywordFalse) = "false";
    term "";
};

// Check if token is an operator
defn is_operator(tok: Token) -> Bool {
    unification tok(OpPlus) = true;
    unification tok(OpMinus) = true;
    unification tok(OpStar) = true;
    unification tok(OpSlash) = true;
    unification tok(OpEqEq) = true;
    unification tok(OpNeq) = true;
    unification tok(OpLt) = true;
    unification tok(OpGt) = true;
    // ... etc
    term false;
};

// Get operator precedence (higher = binds tighter)
defn operator_precedence(tok: Token) -> Int {
    // Multiplication/division (highest)
    unification tok(OpStar) = 11;
    unification tok(OpSlash) = 11;
    unification tok(OpPercent) = 11;
    
    // Addition/subtraction
    unification tok(OpPlus) = 10;
    unification tok(OpMinus) = 10;
    
    // Comparisons
    unification tok(OpLt) = 8;
    unification tok(OpGt) = 8;
    unification tok(OpLtEq) = 8;
    unification tok(OpGtEq) = 8;
    
    // Equality
    unification tok(OpEqEq) = 7;
    unification tok(OpNeq) = 7;
    
    // Logical AND
    unification tok(OpAnd) = 5;
    
    // Logical OR
    unification tok(OpOr) = 4;
    
    // Assignment (lowest)
    unification tok(OpEq) = 1;
    
    term 0;
};

// Check if operator is right-associative
defn is_right_associative(tok: Token) -> Bool {
    unification tok(OpEq) = true;
    unification tok(OpPlusEq) = true;
    unification tok(OpMinusEq) = true;
    term false;
};

// Token equality
defn token_eq(a: Token, b: Token) -> Bool {
    // Compare variants
    term false;  // Placeholder - needs pattern matching on both
};

// Token to string (for error messages)
defn token_to_string(tok: Token) -> String {
    let mut sb = new_builder();
    
    unification tok(TokenInt(n)) = {
        sb = sb.append_str("Int(");
        sb = sb.append_int(n);
        sb = sb.append_char(')');
    };
    
    unification tok(TokenFloat(f)) = {
        sb = sb.append_str("Float(");
        // Float to string would go here
        sb = sb.append_char(')');
    };
    
    unification tok(TokenString(s)) = {
        sb = sb.append_str("String(\"");
        sb = sb.append_str(s);
        sb = sb.append_str("\")");
    };
    
    unification tok(TokenChar(c)) = {
        sb = sb.append_str("Char('");
        sb = sb.append_char(c);
        sb = sb.append_str("')");
    };
    
    unification tok(TokenIdentifier(name)) = {
        sb = sb.append_str("Identifier(");
        sb = sb.append_str(name);
        sb = sb.append_char(')');
    };
    
    unification tok(TokenEof) = {
        sb = sb.append_str("Eof");
    };
    
    unification tok(TokenError(msg)) = {
        sb = sb.append_str("Error(");
        sb = sb.append_str(msg);
        sb = sb.append_char(')');
    };
    
    // Keywords
    [is_keyword(tok)] {
        sb = sb.append_str("Keyword(");
        sb = sb.append_str(keyword_to_string(tok));
        sb = sb.append_char(')');
    };
    
    term sb.to_string();
};

// Check if token is a literal
defn is_literal(tok: Token) -> Bool {
    unification tok(TokenInt(_)) = true;
    unification tok(TokenFloat(_)) = true;
    unification tok(TokenString(_)) = true;
    unification tok(TokenChar(_)) = true;
    unification tok(KeywordTrue) = true;
    unification tok(KeywordFalse) = true;
    term false;
};

// Get literal value as string
defn literal_to_string(tok: Token) -> String {
    unification tok(TokenInt(n)) = String(n);
    unification tok(TokenFloat(f)) = String(f);
    unification tok(TokenString(s)) = s;
    unification tok(TokenChar(c)) = char_to_string(c);
    unification tok(KeywordTrue) = "true";
    unification tok(KeywordFalse) = "false";
    term "";
};
