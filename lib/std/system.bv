// System Triggers — Standard OS-level event triggers for Regular Brief
// These triggers map to OS events (signals, stdin, filesystem, network)
// and provide a reactive I/O model without blocking calls.
//
// Uses the `#io` pragma syntax to declare OS-linked triggers without
// needing to know the underlying C runtime symbol names.
// On bare-metal/FPGA, use `trg name: Type @ 0xADDRESS` instead.
//
// Import this file:
//   import system from "std/system.bv";
//
// Then use in reactive transactions:
//   rct txn handle_sigint [sigint] { ... term; };

// ===== SIGNAL TRIGGERS =====

// SIGINT (Ctrl+C) — fires when user sends interrupt signal
#io sigint;

// SIGTERM — fires when process receives termination signal
#io sigterm;

// SIGHUP — fires when terminal hangs up
#io sighup;

// ===== STDIN TRIGGERS =====

// stdin_ready — fires when stdin has data available to read
#io stdin_ready;

// stdin_line — fires when a complete line is available on stdin
#io stdin_line;

// ===== TIMER TRIGGERS =====

// clock_tick_1hz — fires once per second
#io timer(1hz) -> trg clock_tick_1hz: Int;

// clock_tick_100hz — fires 100 times per second (every 10ms)
#io timer(100hz) -> trg clock_tick_100hz: Int;

// ===== HELPER TRANSACTIONS =====

// Reactive stdin reader — accumulates lines from stdin
let stdin_buffer: List<String> = [];

rct txn read_stdin_line [sigint == false && stdin_ready == true] {
    &stdin_buffer = stdin_buffer + [stdin_line];
    term;
};

// Reactive signal handler — sets state on signals
let shutting_down: Bool = false;

rct txn handle_sigint [sigint == true] {
    &shutting_down = true;
    term;
};

// Reactive timer counter
let tick_count: Int = 0;

rct txn count_ticks [clock_tick_1hz > 0] {
    &tick_count = tick_count + 1;
    term;
};
