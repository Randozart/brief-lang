// Queue<T> - FIFO data structure
// Implemented as a list with enqueue/dequeue semantics

// ===== STRUCT DEFINITION =====

struct Queue<T> {
    items: List<T>
};

// ===== CONSTRUCTION =====

defn new_queue<T>() -> Queue<T> [true][term.is_empty()] {
    term Queue { items: [] };
};

defn with_capacity<T>(capacity: Int) -> Queue<T> [capacity > 0][term.is_empty()] {
    term Queue { items: [] };
};

// ===== OPERATIONS =====

defn enqueue<T>(queue: Queue<T>, item: T) [true][term.len() == queue.len() + 1] -> Queue<T> {
    &queue.items <- item;
    term queue;
};

defn dequeue<T>(queue: Queue<T>) [!queue.is_empty()][term.len() == queue.len() - 1] -> Queue<T> {
    [queue.is_empty()] {
        term queue;
    };
    <- &queue.items[0];
    term queue;
};

defn front<T>(queue: Queue<T>) [!queue.is_empty()][true] -> Option<T> {
    [queue.is_empty()] {
        term None;
    };
    term Some(queue.items[0]);
};

defn head<T>(queue: Queue<T>) [!queue.is_empty()][true] -> T {
    term queue.items[0];
};

// ===== METADATA =====

defn len<T>(queue: Queue<T>) [true][term >= 0] -> Int {
    term queue.items.len();
};

defn is_empty<T>(queue: Queue<T>) [true][term == true || term == false] -> Bool {
    term queue.items.len() == 0;
};

// ===== CONVERSION =====

defn to_list<T>(queue: Queue<T>) [true][term.len() == queue.len()] -> List<T> {
    term queue.items;
};

defn from_list<T>(items: List<T>) [true][term.len() == items.len()] -> Queue<T> {
    term Queue { items: items };
};
