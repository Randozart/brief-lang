defn new_stack<T>() -> Stack<T> [true][term .^Length == 0] {
    term [] :> AsStack;
};
defn with_capacity<T>(capacity: Int) -> Stack<T> [capacity > 0][term .^Length == 0] {
    term [] :> AsStack;
};
defn push<T>(stack: Stack<T>, item: T) -> Stack<T> {
    term &stack <- item;
};
defn pop<T>(stack: Stack<T>)
    [stack .^Length > 0][term :> 1 .^Length == stack .^Length - 1] -> (T, Stack<T>)
{
    let v: T = <- &stack;
    term (v, stack);
};
defn peek<T>(stack: Stack<T>) -> Option<T> {
    term stack :> Top;
};
defn top<T>(stack: Stack<T>) -> T {
    uni stack :> Top(Some(v)) = { term v; };
};
defn len<T>(stack: Stack<T>) -> Int {
    term stack .^Length;
};
defn is_empty<T>(stack: Stack<T>) -> Bool {
    term (stack .^Length) == 0;
};
defn to_list<T>(stack: Stack<T>) -> List<T> {
    let result: List<T> = [];
    let s: Stack<T> = stack;
    when !s.is_empty() {
        let v: T = <- &s;
        result = [v] + result;
    };
    term result;
};
txn from_list_loop<T>(items: List<T>, result: Stack<T>, i: Int)
    [i < items .^Length][i == items .^Length] -> Stack<T>
{
    &result <- items[i];
    i = i + 1;
    term result;
};
defn from_list<T>(items: List<T>) -> Stack<T> {
    term from_list_loop(items, new_stack(), 0);
};
