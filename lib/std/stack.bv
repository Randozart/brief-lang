// Stack<T> - LIFO data structure
// Delegates to native Value::Stack via __builtin_* FFI functions

import { __builtin_Stack_new, __builtin_Stack_push,
         __builtin_Stack_pop, __builtin_Stack_peek,
         __builtin_Stack_len, __builtin_Stack_is_empty,
         __builtin_Stack_clear }
    from "std/__builtin/stack.bv";

struct Stack<T> {};

defn new_stack<T>() -> Stack<T> [true][term.is_empty()] {
    term __builtin_Stack_new();
};

defn with_capacity<T>(capacity: Int) -> Stack<T> [capacity > 0][term.is_empty()] {
    term __builtin_Stack_new();
};

defn push<T>(stack: Stack<T>, item: T) [true][term :> Size == stack :> Size + 1 && term.len() == stack.len() + 1] -> Stack<T> {
    term __builtin_Stack_push(stack, item);
};

defn pop<T>(stack: Stack<T>) [!stack.is_empty()][term :> Size == stack :> Size - 1] -> Stack<T> {
    let pair: Option<(T, Stack<T>)> = __builtin_Stack_pop(stack);
    uni pair(Some((_, new_stack))) => { term new_stack; };
    term stack;
};

defn peek<T>(stack: Stack<T>) [!stack.is_empty()][true] -> Option<T> {
    term __builtin_Stack_peek(stack);
};

defn top<T>(stack: Stack<T>) [!stack.is_empty()][true] -> T {
    uni __builtin_Stack_peek(stack)(Some(v)) => { term v; };
    term stack.top(); // unreachable if precondition holds
};

defn len<T>(stack: Stack<T>) [true][term >= 0] -> Int {
    term __builtin_Stack_len(stack);
};

defn is_empty<T>(stack: Stack<T>) [true][term == true || term == false] -> Bool {
    term __builtin_Stack_is_empty(stack);
};

defn to_list<T>(stack: Stack<T>) [true][term :> Size == stack :> Size] -> List<T> {
    let result: List<T> = [];
    let s: Stack<T> = stack;
    [!s.is_empty()] {
        uni __builtin_Stack_pop(s)(Some((item, rest))) => {
            &result = result + [item];
            &s = rest;
        };
    };
    term result;
};

txn from_list_loop<T>(items: List<T>, result: Stack<T>, i: Int)
    [i < items :> Size][i == items :> Size] -> Stack<T>
{
    &result = __builtin_Stack_push(result, items[i]);
    &i = i + 1;
    term result;
};

defn from_list<T>(items: List<T>) [true][term :> Size == items :> Size] -> Stack<T> {
    term from_list_loop(items, new_stack(), 0);
};
