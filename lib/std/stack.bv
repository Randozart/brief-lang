// Stack<T> - LIFO data structure
// Implemented as a list with push/pop semantics

// ===== STRUCT DEFINITION =====

struct Stack<T> {
    items: List<T>
};

// ===== CONSTRUCTION =====

defn new_stack<T>() -> Stack<T> [true][result.is_empty()] {
    term Stack { items: [] };
};

defn with_capacity<T>(capacity: Int) -> Stack<T> [capacity > 0][result.is_empty()] {
    term Stack { items: [] };
};

// ===== OPERATIONS =====

defn push<T>(stack: Stack<T>, item: T) [true][result.len() == stack.len() + 1] -> Stack<T> {
    term Stack { items: stack.items + [item] };
};

defn pop<T>(stack: Stack<T>) [!stack.is_empty()][result.len() == stack.len() - 1] -> Stack<T> {
    [stack.is_empty()] {
        term stack;
    };
    let items: List<T> = stack.items[0..stack.len()-1];
    term Stack { items: items };
};

defn peek<T>(stack: Stack<T>) [!stack.is_empty()][true] -> Option<T> {
    [stack.is_empty()] {
        term None;
    };
    term Some(stack.items[stack.len()-1]);
};

defn top<T>(stack: Stack<T>) [!stack.is_empty()][true] -> T {
    term stack.items[stack.len()-1];
};

// ===== METADATA =====

defn len<T>(stack: Stack<T>) [true][result >= 0] -> Int {
    term stack.items.len();
};

defn is_empty<T>(stack: Stack<T>) [true][result == true || result == false] -> Bool {
    term stack.items.len() == 0;
};

// ===== CONVERSION =====

defn to_list<T>(stack: Stack<T>) [true][result.len() == stack.len()] -> List<T> {
    term stack.items;
};

defn from_list<T>(items: List<T>) [true][result.len() == items.len()] -> Stack<T> {
    term Stack { items: items };
};
