schema lib/glue.dbvs;
// GLUE Adapter Registry
//
// Each entry describes a target language's bridge metadata:
//   language, types_module, file_extension, llvm_triple, c_type_map
//
// The types_module is a .bv file declaring foreign type names in Brief's
// type universe. Bridge files import these and meld Brief types to them.
//
// c_type_map maps each Brief type name to its C ABI representation.
// This is the lingua franca — every language understands C types at
// the FFI boundary, even if they then map to native types internally.
//
// Rust: i64 via LLVM LTO, C ABI for non-LLVM path
// Python: C ABI via ctypes, zero-copy via meld onto PyObject heap
rust, glue/rust/types.bv, rs, x86_64-unknown-linux-gnu, {Int:int64_t Float:double Bool:bool Char:char String:cstring}
python, glue/python/types.bv, py, any, {Int:int64_t Float:double Bool:bool Char:char String:cstring}
