// Proof Engine - Symbolic execution and contract verification
// Tier 6: Proof Engine

// ===== SYMBOLIC VALUES =====

enum SymbolicValue {
    SymInt(Int),
    SymFloat(Float),
    SymBool(Bool),
    SymString(String),
    SymChar(Char),
    SymVar(String),  // Symbolic variable
    SymBinaryOp(String, Box<SymbolicValue>, Box<SymbolicValue>),  // op, left, right
    SymUnaryOp(String, Box<SymbolicValue>),  // op, operand
    SymUnknown  // For complex expressions
}

// ===== SYMBOLIC STATE =====

struct SymbolicState {
    vars: HashMap<String, SymbolicValue>,  // Variable bindings
    path_constraints: List<SymbolicValue>,  // Path conditions
    visited: HashSet<String>  // Prevent infinite loops
}

// ===== STATE OPERATIONS =====

defn initial_state() -> SymbolicState {
    term SymbolicState {
        vars: new_map(),
        path_constraints: [],
        visited: new_set()
    };
}

defn state_assign(state: SymbolicState, name: String, value: SymbolicValue) -> SymbolicState {
    let vars = state.vars;
    vars = vars.insert(name, value);
    term SymbolicState {
        vars: vars,
        path_constraints: state.path_constraints,
        visited: state.visited
    };
}

defn state_lookup(state: SymbolicState, name: String) -> Option<SymbolicValue> {
    term state.vars.get(name);
}

defn state_add_constraint(state: SymbolicState, constraint: SymbolicValue) -> SymbolicState {
    let constraints = state.path_constraints;
    constraints = constraints.append(constraint);
    term SymbolicState {
        vars: state.vars,
        path_constraints: constraints,
        visited: state.visited
    };
}

defn state_mark_visited(state: SymbolicState, key: String) -> SymbolicState {
    let visited = state.visited;
    visited = visited.insert(key);
    term SymbolicState {
        vars: state.vars,
        path_constraints: state.path_constraints,
        visited: visited
    };
}

defn state_is_visited(state: SymbolicState, key: String) -> Bool {
    term state.visited.contains(key);
}

// ===== SYMBOLIC EXPRESSION EVALUATION =====

defn eval_symbolic(expr: Expr, state: SymbolicState) -> SymbolicValue {
    // Literals
    uni expr(ExprInt(n)) = {
        term SymInt(n);
    };
    
    uni expr(ExprFloat(f)) = {
        term SymFloat(f);
    };
    
    uni expr(ExprBool(b)) = {
        term SymBool(b);
    };
    
    uni expr(ExprChar(c)) = {
        term SymChar(c);
    };
    
    uni expr(ExprString(s)) = {
        term SymString(s);
    };
    
    // Variables
    uni expr(ExprVar(name)) = {
        [state.vars.contains_key(name)] {
            term state.vars.get(name).unwrap();
        };
        term SymVar(name);
    };
    
    // Prior state (@var)
    uni expr(ExprPriorState(name)) = {
        term SymVar("@" + name);
    };
    
    // Binary operations
    uni expr(ExprBinOp(op, left, right)) = {
        let left_sym = eval_symbolic(*left, state);
        let right_sym = eval_symbolic(*right, state);
        term SymBinaryOp(op, Box::new(left_sym), Box::new(right_sym));
    };
    
    // Unary operations
    uni expr(ExprUnaryOp(op, operand)) = {
        let operand_sym = eval_symbolic(*operand, state);
        term SymUnaryOp(op, Box::new(operand_sym));
    };
    
    // Unknown for complex expressions
    term SymUnknown;
}

// ===== SIMPLIFICATION =====

defn simplify(sym: SymbolicValue) -> SymbolicValue {
    uni sym(SymBinaryOp(op, left, right)) = {
        let left_simp = simplify(*left);
        let right_simp = simplify(*right);
        
        // Constant folding
        uni (left_simp, right_simp) = (SymInt(l), SymInt(r)) = {
            [op == "+"] { term SymInt(l + r); };
            [op == "-"] { term SymInt(l - r); };
            [op == "*"] { term SymInt(l * r); };
            [op == "/"] { [r != 0] { term SymInt(l / r); }; };
            [op == "%"] { [r != 0] { term SymInt(l % r); }; };
        };
        
        uni (left_simp, right_simp) = (SymFloat(l), SymFloat(r)) = {
            [op == "+"] { term SymFloat(l + r); };
            [op == "-"] { term SymFloat(l - r); };
            [op == "*"] { term SymFloat(l * r); };
            [op == "/"] { [r != 0.0] { term SymFloat(l / r); }; };
        };
        
        uni (left_simp, right_simp) = (SymBool(l), SymBool(r)) = {
            [op == "&&"] { term SymBool(l && r); };
            [op == "||"] { term SymBool(l || r); };
            [op == "=="] { term SymBool(l == r); };
            [op == "!="] { term SymBool(l != r); };
        };
        
        // Identity operations
        uni (op, left_simp, right_simp) = ("+", SymInt(0), _) = {
            term right_simp;
        };
        uni (op, left_simp, right_simp) = ("+", _, SymInt(0)) = {
            term left_simp;
        };
        uni (op, left_simp, right_simp) = ("*", SymInt(1), _) = {
            term right_simp;
        };
        uni (op, left_simp, right_simp) = ("*", _, SymInt(1)) = {
            term left_simp;
        };
        uni (op, left_simp, right_simp) = ("*", _, SymInt(0)) = {
            term SymInt(0);
        };
        uni (op, left_simp, right_simp) = ("*", SymInt(0), _) = {
            term SymInt(0);
        };
        
        term SymBinaryOp(op, Box::new(left_simp), Box::new(right_simp));
    };
    
    uni sym(SymUnaryOp(op, operand)) = {
        let operand_simp = simplify(*operand);
        
        uni (op, operand_simp) = ("-", SymInt(n)) = {
            term SymInt(-n);
        };
        uni (op, operand_simp) = ("!", SymBool(b)) = {
            term SymBool(!b);
        };
        
        term SymUnaryOp(op, Box::new(operand_simp));
    };
    
    term sym;
}

// ===== CONSTRAINT SOLVING =====

defn check_constraint(constraint: SymbolicValue) -> Bool {
    let simp = simplify(constraint);
    uni simp(SymBool(b)) = {
        term b;
    };
    term true;  // Unknown constraints assumed satisfiable
}

defn constraints_satisfiable(constraints: List<SymbolicValue>) -> Bool {
    let i: Int = 0;
    [i < constraints.len()] {
        [!check_constraint(constraints[i])] {
            term false;
        };
        &i = i + 1;
    };
    term true;
}

// ===== PATH EXPLORATION =====

struct ExecutionPath {
    statements: List<Statement>,
    constraints: List<SymbolicValue>,
    final_state: SymbolicState,
    feasible: Bool
}

defn explore_paths(stmts: List<Statement>, initial: SymbolicState) -> List<ExecutionPath> {
    let paths: List<ExecutionPath> = [];
    let work_queue: List<(List<Statement>, SymbolicState, List<SymbolicValue>)> = [];
    
    // Start with initial state
    work_queue = work_queue.append((stmts, initial, []));
    
    let iterations: Int = 0;
    [iterations < 1000 && work_queue.len() > 0] {
        let (remaining, state, constraints) = work_queue[0];
        work_queue = work_queue.drop(1);
        
        [remaining.len() == 0] {
            // Complete path
            paths = paths.append(ExecutionPath {
                statements: stmts,
                constraints: constraints,
                final_state: state,
                feasible: constraints_satisfiable(constraints)
            });
        };
        [remaining.len() > 0] {
            let stmt = remaining[0];
            let rest = remaining.drop(1);
            
            // Handle guarded statements (branching)
            uni stmt(StmtGuarded(condition, body)) = {
                // Evaluate condition symbolically
                let cond_sym = eval_symbolic(*condition, state);
                let cond_simp = simplify(cond_sym);
                
                // True branch
                uni cond_simp(SymBool(true)) = {
                    let new_state = state_add_constraint(state, cond_simp);
                    let new_stmts = body;
                    new_stmts = new_stmts.append_all(rest);
                    work_queue = work_queue.append((new_stmts, new_state, constraints));
                };
                
                // False branch
                uni cond_simp(SymBool(false)) = {
                    // Skip guarded block
                    work_queue = work_queue.append((rest, state, constraints));
                };
                
                // Unknown - explore both paths
                [!uni cond_simp(SymBool(_)) = true] {
                    // True path
                    let true_state = state_add_constraint(state, SymBool(true));
                    let true_stmts = body;
                    true_stmts = true_stmts.append_all(rest);
                    work_queue = work_queue.append((true_stmts, true_state, constraints));
                    
                    // False path
                    let false_state = state_add_constraint(state, SymBool(false));
                    work_queue = work_queue.append((rest, false_state, constraints));
                };
            };
            
            // Non-branching statement
            [!uni stmt(StmtGuarded(_, _)) = true] {
                let new_state = execute_statement_symbolic(stmt, state);
                work_queue = work_queue.append((rest, new_state, constraints));
            };
        };
        
        &iterations = iterations + 1;
    };
    
    term paths;
}

defn execute_statement_symbolic(stmt: Statement, state: SymbolicState) -> SymbolicState {
    uni stmt(StmtLet(name, _, Some(init), _, _)) = {
        let value = eval_symbolic(*init, state);
        term state_assign(state, name, value);
    };
    
    uni stmt(StmtAssign(lhs, rhs, _)) = {
        // Extract variable name from lhs
        uni *lhs(ExprVar(name)) = {
            let value = eval_symbolic(*rhs, state);
            term state_assign(state, name, value);
        };
        term state;
    };
    
    uni stmt(StmtOnExit(body)) = {
        // Execute cleanup body inline for symbolic analysis
        let i: Int = 0;
        let st = state;
        [i < body.len()] {
            &st = execute_statement_symbolic(body[i], st);
            &i = i + 1;
        };
        term st;
    };
    
    uni stmt(StmtAlka(_)) = {
        // Opaque passthrough, no symbolic effect
        term state;
    };
    
    uni stmt(StmtLocalTrigger(_, _, _)) = {
        // Local trigger: no symbolic effect
        term state;
    };
    
    term state;
}

// ===== CONTRACT VERIFICATION =====

struct ProofResult {
    verified: Bool,
    counterexample: Option<CounterExample>,
    paths_explored: Int
}

struct CounterExample {
    inputs: HashMap<String, SymbolicValue>,
    path: ExecutionPath,
    violation: String
}

defn verify_contract(txn: Transaction) -> ProofResult {
    // Create initial symbolic state with prior state variables
    let initial = initial_state();
    
    // Add prior state for each parameter
    let i: Int = 0;
    [i < txn.params.len()] {
        let param = txn.params[i];
        initial = state_assign(initial, "@" + param.name, SymVar("@old_" + param.name));
        &i = i + 1;
    };
    
    // Explore all paths through transaction
    let paths = explore_paths(txn.body, initial);
    
    // Check each path
    let all_verified = true;
    let counterexample: Option<CounterExample> = None;
    
    let i: Int = 0;
    [i < paths.len()] {
        let path = paths[i];
        
        // Check if path is feasible
        [path.feasible] {
            // Evaluate postcondition on final state
            let post_sym = eval_symbolic(txn.contract.postcondition, path.final_state);
            let post_simp = simplify(post_sym);
            
            // Check if postcondition holds
            uni post_simp(SymBool(false)) = {
                &all_verified = false;
                &counterexample = Some(CounterExample {
                    inputs: path.final_state.vars,
                    path: path,
                    violation: "Postcondition not satisfied"
                });
            };
        };
        
        &i = i + 1;
    };
    
    term ProofResult {
        verified: all_verified,
        counterexample: counterexample,
        paths_explored: paths.len()
    };
}

defn verify_precondition(precondition: Expr, state: SymbolicState) -> Bool {
    let pre_sym = eval_symbolic(precondition, state);
    let pre_simp = simplify(pre_sym);
    
    uni pre_simp(SymBool(true)) = {
        term true;
    };
    uni pre_simp(SymBool(false)) = {
        term false;
    };
    term true;  // Unknown preconditions assumed satisfiable
}

defn verify_postcondition(postcondition: Expr, state: SymbolicState) -> Bool {
    let post_sym = eval_symbolic(postcondition, state);
    let post_simp = simplify(post_sym);
    
    uni post_simp(SymBool(true)) = {
        term true;
    };
    uni post_simp(SymBool(false)) = {
        term false;
    };
    term true;  // Unknown postconditions need manual verification
}

// ===== MUTUAL EXCLUSION CHECKING =====

struct ConflictResult {
    has_conflict: Bool,
    conflicting_txns: List<String>,
    explanation: String
}

defn check_mutual_exclusion(txn1: Transaction, txn2: Transaction) -> ConflictResult {
    // Both must be async and reactive to have conflicts
    [!txn1.is_async || !txn2.is_async] {
        term ConflictResult {
            has_conflict: false,
            conflicting_txns: [],
            explanation: "At least one transaction is not async"
        };
    };
    
    [!txn1.is_reactive || !txn2.is_reactive] {
        term ConflictResult {
            has_conflict: false,
            conflicting_txns: [],
            explanation: "At least one transaction is not reactive"
        };
    };
    
    // Check if they write to the same variables
    let writes1 = collect_writes(txn1.body);
    let writes2 = collect_writes(txn2.body);
    
    let i: Int = 0;
    [i < writes1.len()] {
        let j: Int = 0;
        [j < writes2.len()] {
            [writes1[i] == writes2[j]] {
                term ConflictResult {
                    has_conflict: true,
                    conflicting_txns: [txn1.name, txn2.name],
                    explanation: "Both transactions write to variable: " + writes1[i]
                };
            };
            &j = j + 1;
        };
        &i = i + 1;
    };
    
    term ConflictResult {
        has_conflict: false,
        conflicting_txns: [],
        explanation: "No conflicting writes detected"
    };
}

defn collect_writes(stmts: List<Statement>) -> List<String> {
    let writes: List<String> = [];
    
    let i: Int = 0;
    [i < stmts.len()] {
        uni stmts[i](StmtLet(name, _, _, _, _)) = {
            writes = writes.append(name);
        };
        uni stmts[i](StmtAssign(lhs, _, _)) = {
            uni *lhs(ExprVar(name)) = {
                writes = writes.append(name);
            };
            uni *lhs(ExprFieldAccess(obj, field)) = {
                // Field writes count as writing the base variable
                let obj_reads = collect_reads_expr(*obj);
                writes = writes.append_all(obj_reads);
            };
            uni *lhs(ExprIndex(arr, _)) = {
                let arr_reads = collect_reads_expr(*arr);
                writes = writes.append_all(arr_reads);
            };
        };
        uni stmts[i](StmtGuarded(_, body)) = {
            let nested = collect_writes(body);
            writes = writes.append_all(nested);
        };
        uni stmts[i](StmtLoop(body)) = {
            let nested = collect_writes(body);
            writes = writes.append_all(nested);
        };
        uni stmts[i](StmtWhile(_, body)) = {
            let nested = collect_writes(body);
            writes = writes.append_all(nested);
        };
        uni stmts[i](StmtFor(name, _, body)) = {
            writes = writes.append(name);
            let nested = collect_writes(body);
            writes = writes.append_all(nested);
        };
        uni stmts[i](StmtOnExit(body)) = {
            let nested = collect_writes(body);
            writes = writes.append_all(nested);
        };
        uni stmts[i](StmtIf(_, then_body, else_body)) = {
            let then_writes = collect_writes(then_body);
            let else_writes = collect_writes(else_body);
            writes = writes.append_all(then_writes);
            writes = writes.append_all(else_writes);
        };
        &i = i + 1;
    };
    
    term writes;
}

// ===== DEADLOCK DETECTION =====

struct DeadlockResult {
    has_deadlock: Bool,
    cycle: List<String>,
    explanation: String
}

defn detect_deadlock(txns: List<Transaction>) -> DeadlockResult {
    // Build dependency graph
    let deps: HashMap<String, List<String>> = new_map();
    
    let i: Int = 0;
    [i < txns.len()] {
        let txn = txns[i];
        let reads = collect_reads(txn.body);
        let writes = collect_writes(txn.body);
        
        // Find transactions that write to variables this one reads
        let txn_deps: List<String> = [];
        let j: Int = 0;
        [j < txns.len()] {
            [i != j] {
                let other_writes = collect_writes(txns[j].body);
                let k: Int = 0;
                [k < reads.len()] {
                    let l: Int = 0;
                    [l < other_writes.len()] {
                        [reads[k] == other_writes[l]] {
                            txn_deps = txn_deps.append(txns[j].name);
                        };
                        &l = l + 1;
                    };
                    &k = k + 1;
                };
            };
            &j = j + 1;
        };
        
        deps = deps.insert(txn.name, txn_deps);
        &i = i + 1;
    };
    
    // Check for cycles using DFS
    let visited: HashSet<String> = new_set();
    let rec_stack: HashSet<String> = new_set();
    
    let i: Int = 0;
    [i < txns.len()] {
        [!visited.contains(txns[i].name)] {
            let (has_cycle, cycle) = dfs_cycle(txns[i].name, deps, visited, rec_stack, []);
            [has_cycle] {
                term DeadlockResult {
                    has_deadlock: true,
                    cycle: cycle,
                    explanation: "Circular dependency detected"
                };
            };
        };
        &i = i + 1;
    };
    
    term DeadlockResult {
        has_deadlock: false,
        cycle: [],
        explanation: "No deadlock detected"
    };
}

defn dfs_cycle(node: String, deps: HashMap<String, List<String>>, 
               visited: HashSet<String>, rec_stack: HashSet<String>,
               path: List<String>) -> (Bool, List<String>) {
    let visited = visited;
    let rec_stack = rec_stack;
    let path = path;
    
    visited = visited.insert(node);
    rec_stack = rec_stack.insert(node);
    path = path.append(node);
    
    [deps.contains_key(node)] {
        let neighbors = deps.get(node).unwrap();
        let i: Int = 0;
        [i < neighbors.len()] {
            let neighbor = neighbors[i];
            [!visited.contains(neighbor)] {
                let (has_cycle, cycle) = dfs_cycle(neighbor, deps, visited, rec_stack, path);
                [has_cycle] {
                    term (true, cycle);
                };
            };
            [rec_stack.contains(neighbor)] {
                // Found cycle
                term (true, path.append(neighbor));
            };
            &i = i + 1;
        };
    };
    
    rec_stack = rec_stack.remove(node);
    term (false, []);
}

defn collect_reads_expr(expr: Expr) -> List<String> {
    uni expr(ExprVar(name)) = {
        term [name];
    };
    
    uni expr(ExprPriorState(name)) = {
        term ["@" + name];
    };
    
    uni expr(ExprBinOp(_, left, right)) = {
        let left_reads = collect_reads_expr(*left);
        let right_reads = collect_reads_expr(*right);
        term left_reads.append_all(right_reads);
    };
    
    uni expr(ExprUnaryOp(_, operand)) = {
        term collect_reads_expr(*operand);
    };
    
    uni expr(ExprFieldAccess(obj, _)) = {
        term collect_reads_expr(*obj);
    };
    
    uni expr(ExprIndex(arr, idx)) = {
        let arr_reads = collect_reads_expr(*arr);
        let idx_reads = collect_reads_expr(*idx);
        term arr_reads.append_all(idx_reads);
    };
    
    uni expr(ExprCall(_, args)) = {
        let reads: List<String> = [];
        let i: Int = 0;
        [i < args.len()] {
            reads = reads.append_all(collect_reads_expr(args[i]));
            &i = i + 1;
        };
        term reads;
    };
    
    uni expr(ExprList(items)) = {
        let reads: List<String> = [];
        let i: Int = 0;
        [i < items.len()] {
            reads = reads.append_all(collect_reads_expr(items[i]));
            &i = i + 1;
        };
        term reads;
    };
    
    uni expr(ExprStruct(_, fields)) = {
        let reads: List<String> = [];
        let i: Int = 0;
        [i < fields.len()] {
            reads = reads.append_all(collect_reads_expr(fields[i].1));
            &i = i + 1;
        };
        term reads;
    };
    
    // Literals don't read variables
    term [];
}

defn collect_reads(stmts: List<Statement>) -> List<String> {
    let reads: List<String> = [];
    
    let i: Int = 0;
    [i < stmts.len()] {
        uni stmts[i](StmtLet(_, _, Some(init), _, _)) = {
            reads = reads.append_all(collect_reads_expr(*init));
        };
        uni stmts[i](StmtAssign(lhs, rhs, _)) = {
            reads = reads.append_all(collect_reads_expr(*lhs));
            reads = reads.append_all(collect_reads_expr(*rhs));
        };
        uni stmts[i](StmtTerm(values, _)) = {
            let j: Int = 0;
            [j < values.len()] {
                [values[j].is_some()] {
                    reads = reads.append_all(collect_reads_expr(values[j].unwrap()));
                };
                &j = j + 1;
            };
        };
        uni stmts[i](StmtGuarded(condition, body)) = {
            reads = reads.append_all(collect_reads_expr(*condition));
            reads = reads.append_all(collect_reads(body));
        };
        uni stmts[i](StmtLoop(body)) = {
            reads = reads.append_all(collect_reads(body));
        };
        uni stmts[i](StmtWhile(cond, body)) = {
            reads = reads.append_all(collect_reads_expr(*cond));
            reads = reads.append_all(collect_reads(body));
        };
        uni stmts[i](StmtFor(_, iter, body)) = {
            reads = reads.append_all(collect_reads_expr(*iter));
            reads = reads.append_all(collect_reads(body));
        };
        uni stmts[i](StmtOnExit(body)) = {
            reads = reads.append_all(collect_reads(body));
        };
        uni stmts[i](StmtIf(cond, then_body, else_body)) = {
            reads = reads.append_all(collect_reads_expr(*cond));
            reads = reads.append_all(collect_reads(then_body));
            reads = reads.append_all(collect_reads(else_body));
        };
        uni stmts[i](StmtExpr(expr)) = {
            reads = reads.append_all(collect_reads_expr(*expr));
        };
        &i = i + 1;
    };
    
    term reads;
}

// ===== VERIFICATION CONDITIONS =====

struct VerificationCondition {
    assumptions: List<SymbolicValue>,
    conclusion: SymbolicValue
}

defn generate_vc(txn: Transaction) -> VerificationCondition {
    // Generate verification condition from contract
    let pre_sym = eval_symbolic(txn.contract.precondition, initial_state());
    let post_sym = eval_symbolic(txn.contract.postcondition, initial_state());
    
    term VerificationCondition {
        assumptions: [pre_sym],
        conclusion: post_sym
    };
}

defn check_vc(vc: VerificationCondition) -> Result<(), String> {
    // Check if assumptions imply conclusion
    // For each assumption, add to path constraints
    let state = initial_state();
    
    let i: Int = 0;
    [i < vc.assumptions.len()] {
        state = state_add_constraint(state, vc.assumptions[i]);
        &i = i + 1;
    };
    
    // Check if conclusion holds
    let conclusion_simp = simplify(vc.conclusion);
    uni conclusion_simp(SymBool(false)) = {
        term Err("Verification condition failed");
    };
    
    term Ok(());
}

// ===== UTILITY FUNCTIONS =====

defn sym_to_string(sym: SymbolicValue) -> String {
    uni sym(SymInt(n)) = {
        term String(n);
    };
    uni sym(SymFloat(f)) = {
        term String(f);
    };
    uni sym(SymBool(b)) = {
        [b] { term "true"; };
        term "false";
    };
    uni sym(SymString(s)) = {
        term "\"" + s + "\"";
    };
    uni sym(SymChar(c)) = {
        term "'" + char_to_string(c) + "'";
    };
    uni sym(SymVar(name)) = {
        term name;
    };
    uni sym(SymBinaryOp(op, left, right)) = {
        let sb = new_builder();
        sb = sb.append_char('(');
        sb = sb.append_str(sym_to_string(*left));
        sb = sb.append_str(" ");
        sb = sb.append_str(op);
        sb = sb.append_str(" ");
        sb = sb.append_str(sym_to_string(*right));
        sb = sb.append_char(')');
        term sb.to_string();
    };
    uni sym(SymUnaryOp(op, operand)) = {
        let sb = new_builder();
        sb = sb.append_char('(');
        sb = sb.append_str(op);
        sb = sb.append_str(sym_to_string(*operand));
        sb = sb.append_char(')');
        term sb.to_string();
    };
    uni sym(SymUnknown) = {
        term "?";
    };
    term "?";
}
