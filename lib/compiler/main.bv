// Brief Compiler - Main Entry Point (Ouroboros)
// This file uses the Brief-written compiler library to compile Brief programs
// Supports multiple backends: rust, wasm, webstack

import std.io;
import std.string;
import std.string_builder;
import std.collections;
import std.option;
import std.result;

import token;
import ast;
import lexer;
import parser;
import call_graph;

// ===== COMPILER STATE =====

struct CompilerState {
    source: String,
    file_path: String,
    verbose: Bool,
    backend: String,
}

// ===== MAIN ENTRY POINT =====

// ===== UTILITY =====

defn is_strict_extension(path: String) -> Bool {
    let len = path.len();
    [len >= 4] {
        [path[len - 4] == '.' && path[len - 3] == 's' && path[len - 2] == 'b' && path[len - 1] == 'v'] { term true; };
    };
    [len >= 5] {
        [path[len - 5] == '.' && path[len - 4] == 's' && path[len - 3] == 'e' && path[len - 2] == 'b' && path[len - 1] == 'v'] { term true; };
        [path[len - 5] == '.' && path[len - 4] == 's' && path[len - 3] == 'r' && path[len - 2] == 'b' && path[len - 1] == 'v'] { term true; };
    };
    term false;
}

// ===== COMPILE =====

defn compile_file(path: String, backend: String, verbose: Bool) -> Result<String, String> [path.len() > 0][result.is_ok() || result.is_err()] {
    let source_result = __read_file(path);
    uni source_result(Ok(source)) = {
        let state = CompilerState {
            source: source,
            file_path: path,
            verbose: verbose,
            backend: backend,
        };

        let token_result = tokenize(state.source);
        uni token_result(Ok(pair)) = {
            let (tokens, lexer_state) = pair;

            [state.verbose] {
                let sb = new_builder();
                sb = sb.append_str("[Lexer] Tokenized ");
                sb = sb.append_str(state.file_path);
                sb = sb.append_str(" (");
                sb = sb.append_str(String(tokens.len()));
                sb = sb.append_str(" tokens)");
            };

            let parser = new_parser(tokens);
            // Detect strict mode from file extension
            let strict = is_strict_extension(state.file_path);
            let parser = set_strict_mode(parser, strict);
            let parse_result = parse_program_from_state(parser);
            uni parse_result(Ok(program)) = {
                [state.verbose] {
                    let sb = new_builder();
                    sb = sb.append_str("[Parser] Parsed ");
                    sb = sb.append_str(state.file_path);
                    sb = sb.append_str(" (");
                    sb = sb.append_str(String(program.items.len()));
                    sb = sb.append_str(" items)");
                };

                // Run call graph analysis for acyclicity-based optimizations
                let cg_result = analyze_call_graph(program);

                [state.verbose] {
                    let sb = new_builder();
                    sb = sb.append_str("[CallGraph] Nodes: ");
                    sb = sb.append_str(String(cg_result.node_count));
                    sb = sb.append_str(", Edges: ");
                    sb = sb.append_str(String(cg_result.edge_count));
                    sb = sb.append_str(", Has cycles: ");
                    sb = sb.append_str(String(cg_result.has_cycle));
                };

                // Route to the correct backend
                let output: String;
                [state.backend == "wasm"] {
                    output = compile_to_wasm(program, cg_result);
                };
                [state.backend == "webstack"] {
                    output = compile_to_webstack(program, cg_result);
                };
                [state.backend == "rust" || state.backend == ""] {
                    output = generate_rust(program, state, cg_result);
                };
                term Ok(output);
            };
            uni parse_result(Err(e)) = {
                term Err("Parse error: " + e);
            };
        };
        uni token_result(Err(e)) = {
            term Err("Lex error: " + e);
        };
    };
    uni source_result(Err(_e)) = {
        term Err("IO error: Failed to read file: " + path);
    };
}

// Compile to direct WASM binary using the wasm backend
defn compile_to_wasm(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    output = output.append_str(";; WASM binary generation\n");

    // Emit acyclicity annotation
    [!cg.has_cycle] {
        output = output.append_str(";; Call graph: acyclic -- static dispatch enabled\n");
    };
    [cg.has_cycle] {
        output = output.append_str(";; Call graph: cyclic -- dynamic dispatch required\n");
        output = output.append_str(";; Cycles detected: ");
        output = output.append_str(String(len(cg.cycles)));
        output = output.append_str("\n");
    };

    output = output.append_str(";; Function count: ");
    output = output.append_str(String(program.items.len()));
    output = output.append_str("\n");
    term output.to_string();
}

// Compile to webstack (Rust + wasm-bindgen)
defn compile_to_webstack(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    output = output.append_str("// Webstack output\n");

    // Emit acyclicity annotation
    [!cg.has_cycle] {
        output = output.append_str("// Call graph: acyclic -- static dispatch enabled\n");
    };
    [cg.has_cycle] {
        output = output.append_str("// Call graph: cyclic -- dynamic dispatch required\n");
        output = output.append_str("// Cycles detected: ");
        output = output.append_str(String(len(cg.cycles)));
        output = output.append_str("\n");
    };

    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopTxn(txn)) = {
            output = output.append_str("// Transaction: ");
            output = output.append_str(txn.name);
            output = output.append_str("\n");
        };
        &i = i + 1;
    };
    output = output.append_str("\n");
    output = output.append_str("fn main() {\n");
    output = output.append_str("    println!(\"Hello from Brief Webstack!\");\n");
    output = output.append_str("}\n");
    term output.to_string();
}

// ===== GENERATE RUST OUTPUT (default) =====

defn generate_rust(program: Program, state: CompilerState, cg: CallGraphResult) -> String [state.source.len() > 0][result.len() > 0] {
    let output = new_builder();

    output = output.append_str("// Generated by Brief Compiler (self-hosted)\n");
    output = output.append_str("// Source: ");
    output = output.append_str(state.file_path);
    output = output.append_str("\n");

    // Emit acyclicity annotation
    [!cg.has_cycle] {
        output = output.append_str("// Call graph: acyclic -- static dispatch enabled\n");
    };
    [cg.has_cycle] {
        output = output.append_str("// Call graph: cyclic -- dynamic dispatch required\n");
        output = output.append_str("// Cycles detected: ");
        output = output.append_str(String(len(cg.cycles)));
        output = output.append_str("\n");
    };

    output = output.append_str("\nfn main() {\n");
    output = output.append_str("    println!(\"Hello from Brief!\");\n");
    output = output.append_str("}\n");

    term output.to_string();
}

// ===== CLI HELPERS =====

defn print_usage() -> String [true][result.len() > 0] {
    let sb = new_builder();
    sb = sb.append_str("Brief Compiler (self-hosted)\n");
    sb = sb.append_str("Usage: brief-compile [options] <file.bv>\n");
    sb = sb.append_str("Options:\n");
    sb = sb.append_str("  --wasm       Generate direct WASM binary\n");
    sb = sb.append_str("  --webstack   Generate Rust + wasm-bindgen code\n");
    sb = sb.append_str("  --verbose    Show detailed compilation info\n");
    sb = sb.append_str("  --strict     Enable strict mode (reject [true] contracts, verify all constraints)\n");
    term sb.to_string();
}

defn parse_args(args: List<String>) -> (String, String, Bool, Bool) {
    let file_path: String = "";
    let backend: String = "rust";
    let verbose: Bool = false;
    let strict: Bool = false;

    let i: Int = 0;
    [i < args.len()] {
        [args[i] == "--wasm"] {
            &backend = "wasm";
        };
        [args[i] == "--webstack"] {
            &backend = "webstack";
        };
        [args[i] == "--verbose"] {
            &verbose = true;
        };
        [args[i] == "--strict"] {
            &strict = true;
        };
        [args[i] != "--wasm" && args[i] != "--webstack" && args[i] != "--verbose" && args[i] != "--strict"] {
            [file_path == ""] {
                &file_path = args[i];
            };
        };
        &i = i + 1;
    };

    term (file_path, backend, verbose, strict);
}

// ===== MAIN TRANSACTION =====

txn compile_main [true][term] {
    let args: List<String> = [];
    let (file_path, backend, verbose, strict_flag) = parse_args(args);

    [file_path == ""] {
        term;
    };

    // Combine CLI strict flag with extension-based detection
    let strict = strict_flag || is_strict_extension(file_path);

    let result = compile_file(file_path, backend, verbose);
    uni result(Ok(output)) = {
        [verbose] {
            let sb = new_builder();
            sb = sb.append_str("[Output] Compiled to ");
            sb = sb.append_str(backend);
            sb = sb.append_str(" (");
            sb = sb.append_str(String(output.len()));
            sb = sb.append_str(" chars)");
        };
        term;
    };
    uni result(Err(e)) = {
        term;
    };
};
