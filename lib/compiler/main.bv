// Brief Compiler - Main Entry Point (Minimal Ouroboros)
// This file uses the Brief-written compiler library to compile Brief programs
// Proof of self-hosting: Brief compiles a program that uses the Brief compiler library

import std.io;
import std.string;
import std.string_builder;
import std.collections;
import std.option;
import std.result;

import token;
import ast;
import lexer;
import parser;

// ===== COMPILER STATE =====

struct CompilerState {
    source: String,
    file_path: String,
    verbose: Bool
}

// ===== MAIN ENTRY POINT =====

defn compile_file(path: String, verbose: Bool) -> Result<String, String> [true][true] {
    // Step 1: Read source file
    let result = __read_file(path);
    uni result(Ok(source)) = {
        let state = CompilerState {
            source: source,
            file_path: path,
            verbose: verbose
        };
        
        // Step 2: Tokenize
        let lexer = new_lexer(state.source);
        let result = tokenize(lexer);
        uni result(Ok(pair)) = {
            let (tokens, new_state) = pair;
            
            [state.verbose] {
                let sb = new_builder();
                sb = sb.append_str("[Lexer] Tokenized ");
                sb = sb.append_str(state.file_path);
                sb = sb.append_str(" (");
                sb = sb.append_str(String(tokens.len()));
                sb = sb.append_str(" tokens)");
            };
            
            // Step 3: Parse
            let parser = new_parser(tokens);
            let result = parse_program_from_state(parser);
            uni result(Ok(program)) = {
                [state.verbose] {
                    let sb = new_builder();
                    sb = sb.append_str("[Parser] Parsed ");
                    sb = sb.append_str(state.file_path);
                    sb = sb.append_str(" (");
                    sb = sb.append_str(String(program.items.len()));
                    sb = sb.append_str(" items)");
                };
                
                // Step 4: Generate Rust output
                let output = generate_rust(program, state);
                term Ok(output);
            };
            uni result(Err(e)) = {
                term Err("Parse error: " + e);
            };
        };
        uni result(Err(e)) = {
            term Err("Lex error: " + e);
        };
    };
    uni result(Err(_e)) = {
        term Err("IO error: Failed to read file: " + path);
    };
}

// ===== GENERATE RUST OUTPUT =====

defn generate_rust(program: Program, state: CompilerState) -> String [true][true] {
    let output = new_builder();
    
    // Header
    output = output.append_str("// Generated by Brief Compiler (self-hosted)\n");
    output = output.append_str("// Source: ");
    output = output.append_str(state.file_path);
    output = output.append_str("\n\n");
    output = output.append_str("fn main() {\n");
    output = output.append_str("    println!(\"Hello from Brief!\");\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

// ===== CLI HELPERS =====

defn print_usage() -> String [true][true] {
    let sb = new_builder();
    sb = sb.append_str("Brief Compiler (self-hosted)\n");
    sb = sb.append_str("Usage: brief-compile <file.bv> [--verbose]\n");
    sb = sb.append_str("  --verbose  Show detailed compilation info\n");
    term sb.to_string();
}

defn parse_args(args: List<String>) -> String [true][true] {
    let file_path: String = "";
    
    let i: Int = 0;
    [i < args.len()] {
        [args[i] != "--verbose"] {
            [file_path == ""] {
                &file_path = args[i];
            };
        };
        &i = i + 1;
    };
    
    term file_path;
}

// ===== MAIN TRANSACTION =====

txn compile_main [true][true] {
    let args: List<String> = [];
    let file_path = parse_args(args);
    let verbose: Bool = false;
    
    [file_path == ""] {
        term;
    };
    
    let result = compile_file(file_path, verbose);
    uni result(Ok(output)) = {
        term;
    };
    uni result(Err(e)) = {
        term;
    };
};
