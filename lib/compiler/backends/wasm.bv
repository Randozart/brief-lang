// WASM Backend for Brief Compiler
// Generates .wasm binary modules from Brief programs
// Uses guard-based execution for branchless code generation

import "call_graph";
import "std/string";

// ===== WASM TYPES =====

enum WasmType {
    I32,
    I64,
    F32,
    F64
}

enum WasmValueType {
    ValI32,
    ValI64,
    ValF32,
    ValF64
}

// ===== WASM SECTION TYPES =====

enum SectionType {
    SecCustom,
    SecType,
    SecImport,
    SecFunction,
    SecTable,
    SecMemory,
    SecGlobal,
    SecExport,
    SecStart,
    SecElement,
    SecCode,
    SecData
}

// raw byte data

// ===== WASM MODULE STRUCTURE =====

obj WasmModule {
    types: List<FunctionType>,
    functions: List<FunctionBody>,
    imports: List<Import>,
    exports: List<Export>,
    memories: List<Memory>,
    globals: List<Global>,
    data_segments: List<DataSegment>,
    code: CodeSection
}

obj FunctionType {
    params: List<WasmValueType>,
    results: List<WasmValueType>
}

obj FunctionBody {
    locals: List<WasmValueType>,
    code: List<u8>
}

obj Import {
    module: String,
    name: String,
    kind: ImportKind
}

enum ImportKind {
    ImportFunc(TypeIndex),
    ImportMem(Memory),
    ImportGlobal(GlobalType)
}

obj Memory {
    min: u32,
    max: Option<u32>
}

obj Global {
    global_type: GlobalType,
    init_expr: List<u8>
}

obj GlobalType {
    value_type: WasmValueType,
    mutable: Bool
}

obj Export {
    name: String,
    kind: ExportKind
}

enum ExportKind {
    ExportFunc(u32),
    ExportMem(u32),
    ExportGlobal(u32)
}

obj DataSegment {
    memory_index: u32,
    offset_expr: List<u8>,
    data: List<u8>
}

// ===== WASM INSTRUCTION ENCODING =====

defn encode_i32_const(value: i32) -> List<u8> {
    // LEB128 encoding for i32
    let result: List<u8> = [];
    let val: u32 = u32(value);
    [val > 0x7F] {
        result = append(result, u8(val & 0x7F | 0x80));
        val = val >> 7;
    };
    result = append(result, u8(val & 0x7F));
    term result;
}

defn encode_opcode(opcode: u8) -> List<u8> {
    term [opcode];
}

defn encode_end() -> List<u8> {
    term [0x0B]; // end opcode
}

defn encode_block(result_type: WasmValueType) -> List<u8> {
    // block with optional result type
    let block_type: u8;
    uni result_type(I32) = { block_type = 0x7F; };
    uni result_type(I64) = { block_type = 0x7E; };
    uni result_type(F32) = { block_type = 0x7D; };
    uni result_type(F64) = { block_type = 0x7C; };
    term [0x02, block_type]; // block opcode + block type
}

// ===== BRIEF TYPE TO WASM TYPE =====

defn brief_type_to_wasm(brief_type: Type) -> WasmType {
    uni brief_type(TypeInt) = { term I32; };
    uni brief_type(TypeUInt) = { term I32; };
    uni brief_type(TypeFloat) = { term F64; };
    uni brief_type(TypeBool) = { term I32; };
    uni brief_type(TypeChar) = { term I32; };
    uni brief_type(TypeString) = { term I32; }; // pointer to string data
    term I32; // default
}

defn value_type(wasm_type: WasmType) -> WasmValueType {
    uni wasm_type(I32) = { term ValI32; };
    uni wasm_type(I64) = { term ValI64; };
    uni wasm_type(F32) = { term ValF32; };
    uni wasm_type(F64) = { term ValF64; };
}

// ===== MODULE BUILDING =====

defn build_wasm_module(program: Program, cg: CallGraphResult) -> List<u8> {
    let bytes: List<u8> = [];

    // Magic number + version
    bytes = append_all(bytes, [0x00, 0x61, 0x73, 0x6D]); // \0asm
    bytes = append_all(bytes, [0x01, 0x00, 0x00, 0x00]); // version 1

    // Collect sections
    let func_types: List<FunctionType> = [];
    let func_bodies: List<FunctionBody> = [];
    let imports: List<Import> = [];
    let exports: List<Export> = [];

    // Process each transaction
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopTxn(txn)) = {
            // Create function type for this transaction
            let params: List<WasmValueType> = [];
            let results: List<WasmValueType> = [];

            // Map parameters to WASM types
            let j: Int = 0;
            [j < txn.params.len()] {
                let param_type = brief_type_to_wasm(txn.params[j].param_type);
                params = append(params, value_type(param_type));
                j = j + 1;
            };

            // Add result type for term statements
            let has_result: Bool = has_term_value(txn.body);
            [has_result] {
                results = append(results, ValI32);
            };

            func_types = append(func_types, FunctionType {
                params: params,
                results: results
            });

            // Generate function body
            let body_bytes = generate_transaction_body(txn);
            func_bodies = append(func_bodies, FunctionBody {
                locals: [],
                code: body_bytes
            });

            // Export each transaction
            exports = append(exports, Export {
                name: txn.name,
                kind: ExportFunc(i)
            });
        };
        i = i + 1;
    };

    // Emit type section
    bytes = append_all(bytes, encode_section(SecType, encode_type_section(func_types)));

    // Emit function section
    let func_indices: List<u32> = [];
    let fi: Int = 0;
    [fi < func_bodies.len()] {
        func_indices = append(func_indices, u32(fi));
        fi = fi + 1;
    };
    bytes = append_all(bytes, encode_section(SecFunction, encode_function_section(func_indices)));

    // Emit export section
    bytes = append_all(bytes, encode_section(SecExport, encode_export_section(exports)));

    // Emit code section
    bytes = append_all(bytes, encode_section(SecCode, encode_code_section(func_bodies)));

    // Emit memory section (default: 1 page)
    bytes = append_all(bytes, encode_section(SecMemory, [0x00, 0x01, 0x00]));

    term bytes;
}

// ===== SECTION ENCODING =====

defn encode_section(section_id: u8, content: List<u8>) -> List<u8> {
    let result: List<u8> = [section_id];
    result = append_all(result, encode_leb128_u32(u32(content.len())));
    term append_all(result, content);
}

defn encode_leb128_u32(value: u32) -> List<u8> {
    let result: List<u8> = [];
    let val = value;
    [val > 0x7F] {
        result = append(result, u8(val & 0x7F | 0x80));
        val = val >> 7;
    };
    result = append(result, u8(val & 0x7F));
    term result;
}

defn encode_type_section(types: List<FunctionType>) -> List<u8> {
    let result: List<u8> = encode_leb128_u32(u32(types.len()));
    let i: Int = 0;
    [i < types.len()] {
        result = append_all(result, encode_function_type(types[i]));
        i = i + 1;
    };
    term result;
}

defn encode_function_type(ft: FunctionType) -> List<u8> {
    let result: List<u8> = [0x60]; // functype
    result = append_all(result, encode_leb128_u32(u32(ft.params.len())));
    let i: Int = 0;
    [i < ft.params.len()] {
        result = append(result, encode_value_type(ft.params[i]));
        i = i + 1;
    };
    result = append_all(result, encode_leb128_u32(u32(ft.results.len())));
    let i: Int = 0;
    [i < ft.results.len()] {
        result = append(result, encode_value_type(ft.results[i]));
        i = i + 1;
    };
    term result;
}

defn encode_value_type(vt: WasmValueType) -> u8 {
    uni vt(ValI32) = 0x7F;
    uni vt(ValI64) = 0x7E;
    uni vt(ValF32) = 0x7D;
    uni vt(ValF64) = 0x7C;
    term 0x7F; // default i32
}

defn encode_function_section(indices: List<u32>) -> List<u8> {
    term encode_leb128_u32(u32(indices.len()));
}

defn encode_export_section(exports: List<Export>) -> List<u8> {
    let result: List<u8> = encode_leb128_u32(u32(exports.len()));
    let i: Int = 0;
    [i < exports.len()] {
        result = append_all(result, encode_export(exports[i]));
        i = i + 1;
    };
    term result;
}

defn encode_export(exp: Export) -> List<u8> {
    let result: List<u8> = [];
    // Encode export name as UTF-8 length-prefixed string
    result = append_all(result, encode_leb128_u32(u32(exp.name.len())));
    let j: Int = 0;
    [j < exp.name.len()] {
        result = append(result, u8(exp.name[j]));
        j = j + 1;
    };
    uni exp.kind(ExportFunc(idx)) = {
        result = append(result, 0x00); // func export
        result = append_all(result, encode_leb128_u32(idx));
    };
    uni exp.kind(ExportMem(idx)) = {
        result = append(result, 0x02); // mem export
        result = append_all(result, encode_leb128_u32(idx));
    };
    uni exp.kind(ExportGlobal(idx)) = {
        result = append(result, 0x03); // global export
        result = append_all(result, encode_leb128_u32(idx));
    };
    term result;
}

defn encode_code_section(bodies: List<FunctionBody>) -> List<u8> {
    let result: List<u8> = encode_leb128_u32(u32(bodies.len()));
    let i: Int = 0;
    [i < bodies.len()] {
        result = append_all(result, encode_function_body(bodies[i]));
        i = i + 1;
    };
    term result;
}

defn encode_function_body(body: FunctionBody) -> List<u8> {
    // Body size + locals + code
    let body_content: List<u8> = [];

    // Locals declaration: count and types
    [body.locals.len() > 0] {
        body_content = append_all(body_content, encode_leb128_u32(u32(body.locals.len())));
        let i: Int = 0;
        [i < body.locals.len()] {
            body_content = append_all(body_content, [0x01]); // count = 1
            body_content = append(body_content, encode_value_type(body.locals[i]));
            i = i + 1;
        };
    };
    [!body.locals.len() > 0] {
        body_content = append_all(body_content, [0x00]); // no locals
    };

    body_content = append_all(body_content, body.code);

    // Encode body size prefix
    let size = u32(body_content.len());
    term append_all(encode_leb128_u32(size), body_content);
}

// ===== TRANSACTION BODY GENERATION =====

defn generate_transaction_body(txn: Transaction) -> List<u8> {
    let bytes: List<u8> = [];
    // Generate code from transaction body
    let i: Int = 0;
    [i < txn.body.len()] {
        bytes = append_all(bytes, generate_statement(txn.body[i]));
        i = i + 1;
    };
    bytes = append_all(bytes, [0x0B]); // end
    term bytes;
}

defn generate_statement(stmt: Statement) -> List<u8> {
    uni stmt(StmtAssign(name, expr)) = {
        // Local set: store value to local variable
        term append_all(generate_expression(expr), [0x21, u8(local_index(name))]); // local.set
    };
    uni stmt(StmtExpression(expr)) = {
        term append_all(generate_expression(expr), [0x1A]); // drop
    };
    uni stmt(StmtPass) = {
        term []; // no-op
    };
    uni stmt(StmtGuarded(guard, body)) = {
        // Guarded block: if condition then body else skip
        let condition_bytes = generate_expression(guard);
        let body_bytes: List<u8> = [];
        let i: Int = 0;
        [i < body.len()] {
            body_bytes = append_all(body_bytes, generate_statement(body[i]));
            i = i + 1;
        };
        term append_all(append_all(append_all(condition_bytes, [0x04, 0x40]), body_bytes), [0x0B]); // if block end
    };
    term [];
}

defn generate_expression(expr: Expr) -> List<u8> {
    uni expr(ExprInt(val)) = {
        // i32.const
        term append_all([0x41], encode_i32_const(val));
    };
    uni expr(ExprBool(val)) = {
        [val] { term [0x41, 0x01]; }; // i32.const 1
        term [0x41, 0x00]; // i32.const 0
    };
    uni expr(ExprVar(name)) = {
        // local.get
        term [0x20, u8(local_index(name))];
    };
    uni expr(ExprBinOp("+", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x6A]); // i32.add
    };
    uni expr(ExprBinOp("-", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x6B]); // i32.sub
    };
    uni expr(ExprBinOp("*", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x6C]); // i32.mul
    };
    uni expr(ExprBinOp("==", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x46]); // i32.eq
    };
    uni expr(ExprBinOp("<", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x48]); // i32.lt_s
    };
    uni expr(ExprBinOp(">", l, r)) = {
        term append_all(append_all(generate_expression(l), generate_expression(r)), [0x4A]); // i32.gt_s
    };
    uni expr(ExprUnaryOp("!", e)) = {
        term append_all(generate_expression(e), [0x45]); // i32.eqz
    };
    term []; // default no-op
}

defn local_index(name: String) -> Int {
    // Simple locals: params first, then locals
    // This is a simplified local index lookup
    term 0;
}

defn has_term_value(body: List<Statement>) -> Bool {
    let i: Int = 0;
    [i < body.len()] {
        uni body[i](StmtTerm(_)) = { term true; };
        i = i + 1;
    };
    term false;
}

// ===== UTILITY FUNCTIONS =====

// Append all items from second list to first
defn append_all(list1: List<u8>, list2: List<u8>) -> List<u8> {
    let result = list1;
    let i: Int = 0;
    [i < list2.len()] {
        result = append(result, list2[i]);
        i = i + 1;
    };
    term result;
}

// Generate a complete WASM module string representation for debugging
defn wasm_module_to_string(module: WasmModule) -> String {
    let sb = new_builder();
    sb = sb.append_str("WasmModule(");
    sb = sb.append_str("types=");
    sb = sb.append_str(String(module.types.len()));
    sb = sb.append_str(", functions=");
    sb = sb.append_str(String(module.functions.len()));
    sb = sb.append_str(", exports=");
    sb = sb.append_str(String(module.exports.len()));
    sb = sb.append_str(")");
    term sb.to_string();
}