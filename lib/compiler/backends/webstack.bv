// Webstack Backend for Brief Compiler
// Generates Rust code with wasm-bindgen glue for web frontends

import "call_graph";
//
// The webstack pipeline:
//   1. Collect signals (state variables) and transactions
//   2. Generate Rust struct with state + reactive engine
//   3. Generate wasm-bindgen JS glue
//   4. Optionally compile via wasm-pack
//
// This is the production web frontend target, distinct from the
// direct WASM binary backend (wasm.bv).



// ============================================================================
// Webstack Code Generation
// ============================================================================

// Signal tracking for reactive dependency graph
struct SignalInfo {
    name: String,
    signal_type: String,
    initializer: String,
    index: Int,
}

// Transaction tracking for reactive dispatch
struct TransactionInfo {
    name: String,
    index: Int,
    guard: String,
}

// Generate the Rust state struct with all reactive signals
defn generate_state_struct(signals: List<SignalInfo>) -> String {
    let output = new_builder();
    output = output.append_str("#[wasm_bindgen]\n");
    output = output.append_str("pub struct State {\n");
    
    let i: Int = 0;
    [i < signals.len()] {
        output = output.append_str("    ");
        output = output.append_str(signals[i].name);
        output = output.append_str(": ");
        output = output.append_str(signals[i].signal_type);
        output = output.append_str(",\n");
        &i = i + 1;
    };
    
    output = output.append_str("}\n\n");
    term output.to_string();
}

// Generate the reactive transaction dispatch engine
defn generate_reactive_engine(txns: List<TransactionInfo>) -> String {
    let output = new_builder();
    output = output.append_str("impl State {\n");
    output = output.append_str("    pub fn poll_dispatch(&mut self) -> bool {\n");
    output = output.append_str("        let mut changed = false;\n");
    
    let i: Int = 0;
    [i < txns.len()] {
        output = output.append_str("        ");
        output = output.append_str("// Transaction: ");
        output = output.append_str(txns[i].name);
        output = output.append_str("\n");
        output = output.append_str("        if ");
        output = output.append_str(txns[i].guard);
        output = output.append_str(" {\n");
        output = output.append_str("            changed = true;\n");
        output = output.append_str("        }\n");
        &i = i + 1;
    };
    
    output = output.append_str("        changed\n");
    output = output.append_str("    }\n");
    output = output.append_str("}\n");
    term output.to_string();
}

// Generate wasm-bindgen JS glue for signal access
defn generate_js_glue(state_name: String, signals: List<SignalInfo>) -> String {
    let output = new_builder();
    output = output.append_str("// Generated JS glue for webstack\n");
    output = output.append_str("import init, { State } from './");
    output = output.append_str(state_name);
    output = output.append_str(".js';\n\n");
    
    output = output.append_str("let state = null;\n\n");
    output = output.append_str("export async function init_state() {\n");
    output = output.append_str("    await init();\n");
    output = output.append_str("    state = State.new();\n");
    output = output.append_str("}\n\n");
    
    let i: Int = 0;
    [i < signals.len()] {
        output = output.append_str("export function get_");
        output = output.append_str(signals[i].name);
        output = output.append_str("() {\n");
        output = output.append_str("    return state.");
        output = output.append_str(signals[i].name);
        output = output.append_str(";\n");
        output = output.append_str("}\n\n");
        &i = i + 1;
    };
    
    term output.to_string();
}

// Main entry point: generate complete webstack output
defn generate_webstack(program: Program, program_name: String, cg: CallGraphResult) -> WebstackOutput {
    let signals: List<SignalInfo> = [];
    let txns: List<TransactionInfo> = [];
    
    // Collect signals and transactions from the program
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopTxn(txn)) = {
            // Register as reactive transaction - construct temp info directly
            signals = signals;
            txns = txns.append({
                name: txn.name,
                index: txns.len(),
                guard: expr_to_string(txn.contract.pre_condition),
            });
            
            // Collect signal declarations from body
            let j: Int = 0;
            [j < txn.body.len()] {
                uni txn.body[j](StmtLet(let_stmt)) = {
                    signals = signals.append({
                        name: let_stmt.name,
                        signal_type: type_to_webstack_type(let_stmt.ty),
                        initializer: initializer_to_string(let_stmt.expr),
                        index: signals.len(),
                    });
                };
                &j = j + 1;
            };
        };
        uni program.items[i](TopDefn(defn)) = {
            uni defn.body[0](StmtLet(let_stmt)) = {
                signals = signals.append({
                    name: let_stmt.name,
                    signal_type: type_to_webstack_type(let_stmt.ty),
                    initializer: initializer_to_string(let_stmt.expr),
                    index: signals.len(),
                });
            };
        };
        &i = i + 1;
    };
    
    // Emit acyclicity annotation in Rust output
    let acyc_comment: String;
    [!cg.has_cycle] {
        &acyc_comment = "// Call graph: acyclic -- static dispatch enabled\n";
    };
    [cg.has_cycle] {
        &acyc_comment = "// Call graph: cyclic -- dynamic dispatch required\n";
    };

    // Generate components
    let rust_code = acyc_comment;
    rust_code = rust_code + generate_state_struct(signals);
    rust_code = rust_code + generate_reactive_engine(txns);
    let js_glue = generate_js_glue(program_name, signals);
    
    term WebstackOutput {
        rust_code,
        js_glue,
        signal_count: signals.len(),
        txn_count: txns.len(),
    };
}

// ============================================================================
// Type Helpers
// ============================================================================

// Map Brief types to Rust/wasm-bindgen types
defn type_to_webstack_type(brief_type: Type) -> String {
    uni brief_type(TypeInt) = { term "i32".to_string() };
    uni brief_type(TypeFloat) = { term "f64".to_string() };
    uni brief_type(TypeBool) = { term "bool".to_string() };
    uni brief_type(TypeString) = { term "String".to_string() };
    uni brief_type(TypeU64) = { term "u64".to_string() };
    term "JsValue".to_string();
}

// Convert initializer expr to Rust initializer string
defn initializer_to_string(expr: Option<Expr>) -> String {
    uni expr(Some(expr_val)) = {
        term expr_to_string(expr_val);
    };
    term "Default::default()".to_string();
}

// Convert an expression to a Rust expression string
defn expr_to_string(expr: Expr) -> String {
    uni expr(ExprInt(value)) = { term String(value); };
    uni expr(ExprBool(value)) = {
        [value] { term "true".to_string(); };
        term "false".to_string();
    };
    uni expr(ExprVar(name)) = { term name; };
    term "0".to_string();
}

// ============================================================================
// Output Types
// ============================================================================

struct WebstackOutput {
    rust_code: String,
    js_glue: String,
    signal_count: Int,
    txn_count: Int,
}

// ============================================================================
// Exports
// ============================================================================

export defn compile_webstack(program: Program, output: &mut String, cg: CallGraphResult) {
    let result = generate_webstack(program, "app", cg);
    output = output.append_str(result.rust_code);
    output = output.append_str("\n// JS Glue:\n");
    output = output.append_str(result.js_glue);
}
