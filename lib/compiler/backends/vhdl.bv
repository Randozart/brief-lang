// VHDL Backend for Brief Compiler
// Generates synthesizable VHDL from Brief programs
// Brief transactions map to concurrent processes and signals

import "call_graph";
import "std/string";

// ===== VHDL TYPES =====

enum VhdlDataType {
    StdLogic,
    StdLogicVector(Int),
    Real,
    Array(Int, VhdlDataType)
}

enum PortDirection {
    In,
    Out,
    InOut
}

// ===== VHDL STRUCTS =====

obj Entity {
    name: String,
    ports: List<Port>,
    generics: List<GenericParam>
}

obj Architecture {
    entity_name: String,
    name: String,
    signals: List<Signal>,
    processes: List<Process>
}

obj Port {
    name: String,
    direction: PortDirection,
    data_type: VhdlDataType
}

obj GenericParam {
    name: String,
    data_type: VhdlDataType,
    default_value: String
}

obj Signal {
    name: String,
    data_type: VhdlDataType,
    default_value: Option<String>
}

obj Process {
    sensitivity_list: List<String>,
    statements: List<String>,
    name: String
}

// ===== TYPE MAPPING =====

defn brief_type_to_vhdl(brief_type: Type) -> VhdlDataType {
    uni brief_type(TypeBool) = { term StdLogic; };
    uni brief_type(TypeInt) = { term StdLogicVector(32); };
    uni brief_type(TypeChar) = { term StdLogicVector(8); };
    uni brief_type(TypeFloat) = { term Real; };
    uni brief_type(TypeUInt) = { term StdLogicVector(32); };
    uni brief_type(TypeVoid) = { term StdLogic; };
    term StdLogicVector(32); // default
}

defn vhdl_type_str(data_type: VhdlDataType) -> String {
    uni data_type(StdLogic) = "std_logic";
    uni data_type(StdLogicVector(width)) = {
        term "std_logic_vector(" + String(width - 1) + " downto 0)";
    };
    uni data_type(Real) = "real";
    uni data_type(Array(size, elem)) = {
        term "array(0 to " + String(size - 1) + ") of " + vhdl_type_str(elem);
    };
    term "std_logic";
}

defn port_direction_str(dir: PortDirection) -> String {
    uni dir(In) = "in";
    uni dir(Out) = "out";
    uni dir(InOut) = "inout";
    term "in";
}

// ===== ENTITY GENERATION =====

defn generate_entity(name: String, ports: List<Port>, generics: List<GenericParam>) -> String {
    let sb = new_builder();
    sb = sb.append_str("entity ");
    sb = sb.append_str(name);
    sb = sb.append_str(" is\n");

    [generics.len() > 0] {
        sb = sb.append_str("  generic (\n");
        let i: Int = 0;
        [i < generics.len()] {
            sb = sb.append_str("    ");
            sb = sb.append_str(generics[i].name);
            sb = sb.append_str(": ");
            sb = sb.append_str(vhdl_type_str(generics[i].data_type));
            [generics[i].default_value != ""] {
                sb = sb.append_str(" := ");
                sb = sb.append_str(generics[i].default_value);
            };
            [i < generics.len() - 1] { sb = sb.append_str(";"); };
            sb = sb.append_str("\n");
            i = i + 1;
        };
        sb = sb.append_str("  );\n");
    };

    sb = sb.append_str("  port (\n");
    let i: Int = 0;
    [i < ports.len()] {
        sb = sb.append_str("    ");
        sb = sb.append_str(ports[i].name);
        sb = sb.append_str(": ");
        sb = sb.append_str(port_direction_str(ports[i].direction));
        sb = sb.append_str(" ");
        sb = sb.append_str(vhdl_type_str(ports[i].data_type));
        [i < ports.len() - 1] { sb = sb.append_str(";"); };
        sb = sb.append_str("\n");
        i = i + 1;
    };
    sb = sb.append_str("  );\n");
    sb = sb.append_str("end entity ");
    sb = sb.append_str(name);
    sb = sb.append_str(";\n");
    term sb.to_string();
}

// ===== ARCHITECTURE GENERATION =====

defn generate_architecture(entity_name: String, signals: List<Signal>, processes: List<Process>) -> String {
    let sb = new_builder();
    sb = sb.append_str("architecture behavioral of ");
    sb = sb.append_str(entity_name);
    sb = sb.append_str(" is\n");

    // Signal declarations
    [signals.len() > 0] {
        let i: Int = 0;
        [i < signals.len()] {
            sb = sb.append_str("  signal ");
            sb = sb.append_str(signals[i].name);
            sb = sb.append_str(": ");
            sb = sb.append_str(vhdl_type_str(signals[i].data_type));
            [signals[i].default_value != None] {
                uni signals[i].default_value(Some(dv)) = {
                    sb = sb.append_str(" := ");
                    sb = sb.append_str(dv);
                };
            };
            sb = sb.append_str(";\n");
            i = i + 1;
        };
    };

    sb = sb.append_str("begin\n");

    // Process bodies
    let i: Int = 0;
    [i < processes.len()] {
        sb = sb.append_str("  ");
        sb = sb.append_str(processes[i].name);
        sb = sb.append_str(": process (");
        let j: Int = 0;
        [j < processes[i].sensitivity_list.len()] {
            sb = sb.append_str(processes[i].sensitivity_list[j]);
            [j < processes[i].sensitivity_list.len() - 1] { sb = sb.append_str(", "); };
            j = j + 1;
        };
        sb = sb.append_str(") is\n");
        sb = sb.append_str("  begin\n");

        let j: Int = 0;
        [j < processes[i].statements.len()] {
            sb = sb.append_str("    ");
            sb = sb.append_str(processes[i].statements[j]);
            sb = sb.append_str("\n");
            j = j + 1;
        };

        sb = sb.append_str("  end process ");
        sb = sb.append_str(processes[i].name);
        sb = sb.append_str(";\n");
        i = i + 1;
    };

    sb = sb.append_str("end behavioral;\n");
    term sb.to_string();
}

// ===== TRANSACTION TO VHDL =====

defn transaction_to_vhdl(txn: Transaction, state_names: List<String>) -> Process {
    // Create a VHDL process from a Brief transaction
    let process_name = txn.name + "_proc";
    let stmts: List<String> = [];

    // Extract state variable reads/writes from body
    let i: Int = 0;
    [i < txn.body.len()] {
        stmts = append(stmts, statement_to_vhdl(txn.body[i]));
        i = i + 1;
    };

    // Sensitivity: clock and reset
    let sens_list: List<String> = ["clk", "rst"];

    term Process {
        sensitivity_list: sens_list,
        statements: stmts,
        name: process_name
    };
}

defn statement_to_vhdl(stmt: Statement) -> String {
    uni stmt(StmtAssign(name, expr)) = {
        term name + " <= " + expr_to_vhdl(expr) + ";";
    };
    uni stmt(StmtGuarded(guard, body)) = {
        let result = "if " + expr_to_vhdl(guard) + " then\n";
        let i: Int = 0;
        [i < body.len()] {
            result = result + "      " + statement_to_vhdl(body[i]) + "\n";
            i = i + 1;
        };
        term result + "    end if;";
    };
    uni stmt(StmtExpression(expr)) = {
        term expr_to_vhdl(expr) + ";";
    };
    uni stmt(StmtPass) = {
        term "-- pass";
    };
    term "-- unknown statement";
}

defn expr_to_vhdl(expr: Expr) -> String {
    uni expr(ExprInt(val)) = { term String(val); };
    uni expr(ExprBool(v)) = { [v] { term "'1'"; }; term "'0'"; };
    uni expr(ExprVar(name)) = { term name; };
    uni expr(ExprBinOp("+", l, r)) = {
        term expr_to_vhdl(l) + " + " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("-", l, r)) = {
        term expr_to_vhdl(l) + " - " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("*", l, r)) = {
        term expr_to_vhdl(l) + " * " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("==", l, r)) = {
        term expr_to_vhdl(l) + " = " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("<", l, r)) = {
        term expr_to_vhdl(l) + " < " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp(">", l, r)) = {
        term expr_to_vhdl(l) + " > " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("&&", l, r)) = {
        term expr_to_vhdl(l) + " and " + expr_to_vhdl(r);
    };
    uni expr(ExprBinOp("||", l, r)) = {
        term expr_to_vhdl(l) + " or " + expr_to_vhdl(r);
    };
    uni expr(ExprUnaryOp("!", e)) = {
        term "not " + expr_to_vhdl(e);
    };
    term "0";
}

// ===== MAIN GENERATION ENTRY POINT =====

defn generate_vhdl(program: Program, cg: CallGraphResult) -> (String, String) {
    let entity_name: String;
    let ports: List<Port> = [];
    let signals: List<Signal> = [];
    let processes: List<Process> = [];
    let state_names: List<String> = [];

    // Collect state declarations as entity ports
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopState(decl)) = {
            state_names = append(state_names, decl.name);
            ports = append(ports, Port {
                name: decl.name,
                direction: Out,
                data_type: brief_type_to_vhdl(decl.state_type)
            });
            signals = append(signals, Signal {
                name: decl.name,
                data_type: brief_type_to_vhdl(decl.state_type),
                default_value: None
            });
        };
        i = i + 1;
    };

    // Add clock and reset ports
    ports = append(ports, Port { name: "clk", direction: In, data_type: StdLogic });
    ports = append(ports, Port { name: "rst", direction: In, data_type: StdLogic });

    // Convert each transaction to a process
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopTxn(txn)) = {
            processes = append(processes, transaction_to_vhdl(txn, state_names));
        };
        i = i + 1;
    };

    // Determine entity name from file or default
    entity_name = "brief_top";

    let entity_str = generate_entity(entity_name, ports, []);
    let arch_str = generate_architecture(entity_name, signals, processes);
    term (entity_str, arch_str);
}

defn generate_guard_cache_test(guard_expr: Expr) -> String {
    term "-- guard cache check: " + expr_to_vhdl(guard_expr) + "\n";
}