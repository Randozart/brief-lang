// SystemVerilog Backend for Brief Compiler
// Generates synthesizable SystemVerilog from Brief programs
// Uses modern SV features for concise, efficient RTL

import "call_graph";
import "std/string";

// ===== SV TYPES =====

enum SvDataType {
    Logic(Int),
    Bit(Int),
    IntLiteral(Int),
    Real
}

enum PortDirection {
    Input,
    Output,
    Inout
}

// ===== SV STRUCTS =====

struct Module {
    name: String,
    ports: List<Port>,
    wires: List<Wire>,
    regs: List<Reg>,
    always_blocks: List<AlwaysBlock>
}

struct Port {
    name: String,
    direction: PortDirection,
    data_type: SvDataType
}

struct Wire {
    name: String,
    data_type: SvDataType
}

struct Reg {
    name: String,
    data_type: SvDataType,
    init_value: Option<String>
}

struct AlwaysBlock {
    kind: String, // "always_ff", "always_comb", "always_latch"
    sensitivity: String,
    body: String
}

// ===== TYPE MAPPING =====

defn brief_type_to_sv(brief_type: Type) -> SvDataType {
    uni brief_type(TypeBool) = { term Logic(1); };
    uni brief_type(TypeInt) = { term Logic(32); };
    uni brief_type(TypeUInt) = { term Logic(32); };
    uni brief_type(TypeChar) = { term Logic(8); };
    uni brief_type(TypeFloat) = { term Real; };
    term Logic(32); // default
}

defn sv_type_str(data_type: SvDataType) -> String {
    uni data_type(Logic(width)) = {
        [width == 1] { term "logic"; };
        term "logic [" + String(width - 1) + ":0]";
    };
    uni data_type(Bit(width)) = {
        [width == 1] { term "bit"; };
        term "bit [" + String(width - 1) + ":0]";
    };
    uni data_type(Int(width)) = {
        term "int [" + String(width - 1) + ":0]";
    };
    uni data_type(Real) = "real";
    term "logic";
}

defn port_direction_str(dir: PortDirection) -> String {
    uni dir(Input) = "input";
    uni dir(Output) = "output";
    uni dir(Inout) = "inout";
    term "input";
}

// ===== MODULE GENERATION =====

defn generate_module(module: Module) -> String {
    let sb = new_builder();
    sb = sb.append_str("module ");
    sb = sb.append_str(module.name);
    sb = sb.append_str(" (\n");

    // Port list
    let i: Int = 0;
    [i < module.ports.len()] {
        sb = sb.append_str("  ");
        sb = sb.append_str(port_direction_str(module.ports[i].direction));
        sb = sb.append_str(" ");
        sb = sb.append_str(sv_type_str(module.ports[i].data_type));
        sb = sb.append_str(" ");
        sb = sb.append_str(module.ports[i].name);
        [i < module.ports.len() - 1] { sb = sb.append_str(","); };
        sb = sb.append_str("\n");
        &i = i + 1;
    };

    sb = sb.append_str(");\n\n");

    // Wire declarations
    [module.wires.len() > 0] {
        let i: Int = 0;
        [i < module.wires.len()] {
            sb = sb.append_str("wire ");
            sb = sb.append_str(sv_type_str(module.wires[i].data_type));
            sb = sb.append_str(" ");
            sb = sb.append_str(module.wires[i].name);
            sb = sb.append_str(";\n");
            &i = i + 1;
        };
        sb = sb.append_str("\n");
    };

    // Register declarations
    [module.regs.len() > 0] {
        let i: Int = 0;
        [i < module.regs.len()] {
            sb = sb.append_str("reg ");
            sb = sb.append_str(sv_type_str(module.regs[i].data_type));
            sb = sb.append_str(" ");
            sb = sb.append_str(module.regs[i].name);
            [module.regs[i].init_value != None] {
                uni module.regs[i].init_value(Some(iv)) = {
                    sb = sb.append_str(" = ");
                    sb = sb.append_str(iv);
                };
                sb = sb.append_str(";\n");
            };
            [!module.regs[i].init_value != None] {
                sb = sb.append_str(";\n");
            };
            &i = i + 1;
        };
        sb = sb.append_str("\n");
    };

    // Always blocks
    let i: Int = 0;
    [i < module.always_blocks.len()] {
        sb = sb.append_str(module.always_blocks[i].kind);
        sb = sb.append_str(" @(");
        sb = sb.append_str(module.always_blocks[i].sensitivity);
        sb = sb.append_str(") begin\n");
        sb = sb.append_str(module.always_blocks[i].body);
        sb = sb.append_str("end\n\n");
        &i = i + 1;
    };

    sb = sb.append_str("endmodule\n");
    term sb.to_string();
}

// ===== TRANSACTION TO SV =====

defn transaction_to_always(txn: Transaction) -> AlwaysBlock {
    let body_str = build_transaction_body_string(txn.body);

    term AlwaysBlock {
        kind: "always_ff",
        sensitivity: "posedge clk or posedge rst",
        body: body_str
    };
}

defn build_transaction_body_string(body: List<Statement>) -> String {
    let result = "";
    let i: Int = 0;
    [i < body.len()] {
        result = result + "  " + statement_to_sv(body[i]) + "\n";
        &i = i + 1;
    };
    term result;
}

defn statement_to_sv(stmt: Statement) -> String {
    uni stmt(StmtAssign(name, expr)) = {
        term name + " <= " + expr_to_sv(expr) + ";";
    };
    uni stmt(StmtGuarded(guard, body)) = {
        let result = "if (" + expr_to_sv(guard) + ") begin\n";
        let i: Int = 0;
        [i < body.len()] {
            result = result + "    " + statement_to_sv(body[i]) + "\n";
            &i = i + 1;
        };
        term result + "  end";
    };
    uni stmt(StmtExpression(expr)) = {
        term expr_to_sv(expr) + ";";
    };
    uni stmt(StmtPass) = "// pass";
    term "// unknown";
}

defn expr_to_sv(expr: Expr) -> String {
    uni expr(ExprInt(val)) = { term String(val); };
    uni expr(ExprBool(v)) = { [v] { term "1'b1"; }; term "1'b0"; };
    uni expr(ExprVar(name)) = { term name; };
    uni expr(ExprBinOp("+", l, r)) = { term expr_to_sv(l) + " + " + expr_to_sv(r); };
    uni expr(ExprBinOp("-", l, r)) = { term expr_to_sv(l) + " - " + expr_to_sv(r); };
    uni expr(ExprBinOp("*", l, r)) = { term expr_to_sv(l) + " * " + expr_to_sv(r); };
    uni expr(ExprBinOp("==", l, r)) = { term expr_to_sv(l) + " == " + expr_to_sv(r); };
    uni expr(ExprBinOp("!=", l, r)) = { term expr_to_sv(l) + " != " + expr_to_sv(r); };
    uni expr(ExprBinOp("<", l, r)) = { term expr_to_sv(l) + " < " + expr_to_sv(r); };
    uni expr(ExprBinOp(">", l, r)) = { term expr_to_sv(l) + " > " + expr_to_sv(r); };
    uni expr(ExprBinOp("&&", l, r)) = { term expr_to_sv(l) + " && " + expr_to_sv(r); };
    uni expr(ExprBinOp("||", l, r)) = { term expr_to_sv(l) + " || " + expr_to_sv(r); };
    uni expr(ExprUnaryOp("!", e)) = { term "!" + expr_to_sv(e); };
    uni expr(ExprUnaryOp("~", e)) = { term "~" + expr_to_sv(e); };
    term "0";
}

// ===== MAIN GENERATION ENTRY POINT =====

defn generate_verilog(program: Program, cg: CallGraphResult) -> String {
    let module_name: String = "brief_top";
    let ports: List<Port> = [];
    let wires: List<Wire> = [];
    let regs: List<Reg> = [];
    let always_blocks: List<AlwaysBlock> = [];

    // Collect state declarations as ports and registers
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopState(decl)) = {
            ports = append(ports, Port {
                name: decl.name,
                direction: Output,
                data_type: brief_type_to_sv(decl.state_type)
            });
            regs = append(regs, Reg {
                name: decl.name,
                data_type: brief_type_to_sv(decl.state_type),
                init_value: None
            });
        };
        &i = i + 1;
    };

    // Add clock and reset
    ports = append(ports, Port { name: "clk", direction: Input, data_type: Logic(1) });
    ports = append(ports, Port { name: "rst", direction: Input, data_type: Logic(1) });

    // Convert each transaction to an always block
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopTxn(txn)) = {
            always_blocks = append(always_blocks, transaction_to_always(txn));
        };
        &i = i + 1;
    };

    // Guard cache register
    regs = append(regs, Reg {
        name: "guard_cache",
        data_type: Logic(1),
        init_value: Some("1'b1")
    });

    let module = Module {
        name: module_name,
        ports: ports,
        wires: wires,
        regs: regs,
        always_blocks: always_blocks
    };

    term generate_module(module);
}

// ===== GUARD CACHE HELPERS =====

defn emit_guard_cache_check(guard_expr: Expr) -> String {
    term "// guard cache: " + expr_to_sv(guard_expr) + "\n";
}