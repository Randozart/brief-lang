// C Backend - Generate C code for bootstrapping and embedded
// Tier 7 Part 4

import "call_graph";

defn generate_c(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    
    // Header
    output = output.append_str("// Generated by Briev Compiler\n");

    // Emit acyclicity annotation
    when !cg.has_cycle {
        output = output.append_str("// Call graph: acyclic -- static dispatch enabled\n");
    };
    when cg.has_cycle {
        output = output.append_str("// Call graph: cyclic -- dynamic dispatch required\n");
    };

    output = output.append_str("#include <stdio.h>\n");
    output = output.append_str("#include <stdbool.h>\n");
    output = output.append_str("#include <stdint.h>\n\n");
    
    // Generate state declarations
    output = output.append_str("// Global state\n");
    let i: Int = 0;
    when i < program.items.len() {
        uni program.items[i](TopState(decl)) = {
            output = output.append_str(type_to_c(decl.state_type));
            output = output.append_str(" ");
            output = output.append_str(decl.name);
            when decl.initial_value.is_some() {
                output = output.append_str(" = ");
                output = output.append_str(expr_to_c(decl.initial_value.unwrap()));
            };
            output = output.append_str(";\n");
        };
        i = i + 1;
    };
    
    output = output.append_str("\n");
    
    // Generate transactions
    let j: Int = 0;
    when j < program.items.len() {
        uni program.items[j](TopTxn(txn)) = {
            output = output.append_str(generate_c_transaction(txn));
            output = output.append_str("\n");
        };
        j = j + 1;
    };
    
    // Generate reactor
    output = output.append_str(generate_c_reactor(program, cg));
    
    // Generate main
    output = output.append_str("\nint main(void) {\n");
    output = output.append_str("    reactor_loop();\n");
    output = output.append_str("    return 0;\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn type_to_c(ty: Type) -> String {
    uni ty(TypeInt) = { term "int64_t"; };
    uni ty(TypeUInt) = { term "uint64_t"; };
    uni ty(TypeFloat) = { term "double"; };
    uni ty(TypeBool) = { term "bool"; };
    uni ty(TypeChar) = { term "char"; };
    uni ty(TypeVoid) = { term "void"; };
    term "void";
}

defn generate_c_transaction(txn: Transaction) -> String {
    let output = new_builder();
    
    output = output.append_str("bool ");
    output = output.append_str(txn.name);
    output = output.append_str("(void) {\n");
    output = output.append_str("    // Check precondition\n");
    output = output.append_str("    if (!(");
    output = output.append_str(expr_to_c(txn.contract.precondition));
    output = output.append_str(")) {\n");
    output = output.append_str("        return false;\n");
    output = output.append_str("    }\n\n");
    
    output = output.append_str("    // Transaction body\n");
    output = output.append_str(generate_c_block(txn.body));
    output = output.append_str("\n    return true;\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn generate_c_block(stmts: List<Statement>) -> String {
    let output = new_builder();
    
    let i: Int = 0;
    when i < stmts.len() {
        output = output.append_str(generate_c_statement(stmts[i]));
        i = i + 1;
    };
    
    term output.to_string();
}

defn generate_c_statement(stmt: Statement) -> String {
    uni stmt(StmtLet(name, var_type, init, _modifiers, address_expr)) = {
        let output = new_builder();
        when address_expr.is_some() {
            let addr_code = expr_to_c(address_expr.unwrap());
            output = output.append_str("uint32_t* ");
            output = output.append_str(name);
            output = output.append_str(" = (uint32_t*)(");
            output = output.append_str(addr_code);
            output = output.append_str(");\n");
            term output.to_string();
        };
        output = output.append_str(type_to_c(var_type.unwrap()));
        output = output.append_str(" ");
        output = output.append_str(name);
        when init.is_some() {
            output = output.append_str(" = ");
            output = output.append_str(expr_to_c(init.unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtAssign(lhs, rhs, _modifiers)) = {
        let output = new_builder();
        output = output.append_str(expr_to_c(lhs));
        output = output.append_str(" = ");
        output = output.append_str(expr_to_c(rhs));
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtTerm(values, _modifiers)) = {
        let output = new_builder();
        output = output.append_str("return");
        when values.len() > 0 {
            output = output.append_str(" ");
            output = output.append_str(expr_to_c(values[0].unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtGuarded(condition, body)) = {
        let output = new_builder();
        output = output.append_str("if (");
        output = output.append_str(expr_to_c(condition));
        output = output.append_str(") {\n");
        output = output.append_str(generate_c_block(body));
        output = output.append_str("}\n");
        term output.to_string();
    };
    
    uni stmt(StmtOnExit(body)) = {
        let output = new_builder();
        output = output.append_str("/* #on_exit cleanup */\n");
        output = output.append_str(generate_c_block(body));
        term output.to_string();
    };
    
    uni stmt(StmtAlka(block)) = {
        let output = new_builder();
        output = output.append_str("/* ");
        let prefix = "alka: ";
        when block.dangerous { prefix = "alka! "; };
        output = output.append_str(prefix);
        output = output.append_str(block.content);
        output = output.append_str(" */\n");
        term output.to_string();
    };
    
    uni stmt(StmtLocalTrigger(name, _, trigger_expr)) = {
        let output = new_builder();
        when is_some(trigger_expr) {
            let expr_code = expr_to_c(unwrap(trigger_expr));
            output = output.append_str("/* trg! ");
            output = output.append_str(name);
            output = output.append_str(": await ");
            output = output.append_str(expr_code);
            output = output.append_str(" */\n");
        };
        when !is_some(trigger_expr) {
            output = output.append_str("/* trg! ");
            output = output.append_str(name);
            output = output.append_str(": await external event */\n");
        };
        term output.to_string();
    };
    
    term "";
}

defn expr_to_c(expr: Expr) -> String {
    uni expr(ExprInt(n)) = {
        term String(n);
    };
    uni expr(ExprFloat(f)) = {
        term String(f);
    };
    uni expr(ExprBool(b)) = {
        when b { term "true"; };
        term "false";
    };
    uni expr(ExprVar(name)) = {
        term name;
    };
    uni expr(ExprPriorState(name)) = {
        term name + "_old";
    };
    uni expr(ExprBinOp(op, left, right)) = {
        let sb = new_builder();
        sb = sb.append_str("(");
sb = sb.append_str(expr_to_c(left));
        sb = sb.append_str(" ");
        sb = sb.append_str(op_to_c(op));
        sb = sb.append_str(" ");
        sb = sb.append_str(expr_to_c(right));
        sb = sb.append_str(")");
        term sb.to_string();
    };
    term "0";
}

defn generate_c_reactor(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    
    output = output.append_str("void reactor_loop(void) {\n");
    output = output.append_str("    while (1) {\n");
    
    // Use acyclic dispatch when call graph has no cycles
    when !cg.has_cycle {
        output = output.append_str("        // Acyclic: direct static dispatch\n");
        let i: Int = 0;
        when i < program.items.len() {
            uni program.items[i](TopTxn(txn)) = {
                output = output.append_str("        ");
                output = output.append_str(txn.name);
                output = output.append_str("();\n");
            };
            i = i + 1;
        };
    };
    when cg.has_cycle {
        output = output.append_str("        // Cyclic: guarded dispatch with depth limit\n");
        let i: Int = 0;
        when i < program.items.len() {
            uni program.items[i](TopTxn(txn)) = {
                output = output.append_str("        ");
                output = output.append_str(txn.name);
                output = output.append_str("();\n");
            };
            i = i + 1;
        };
    };
    
    output = output.append_str("    }\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}
