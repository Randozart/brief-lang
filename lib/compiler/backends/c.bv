// C Backend - Generate C code for bootstrapping and embedded
// Tier 7 Part 4

defn generate_c(program: Program) -> String {
    let output = new_builder();
    
    // Header
    output = output.append_str("// Generated by Brief Compiler\n");
    output = output.append_str("#include <stdio.h>\n");
    output = output.append_str("#include <stdbool.h>\n");
    output = output.append_str("#include <stdint.h>\n\n");
    
    // Generate state declarations
    output = output.append_str("// Global state\n");
    let i: Int = 0;
    [i < program.items.len()] {
        unification program.items[i](TopState(decl)) = {
            output = output.append_str(type_to_c(decl.state_type));
            output = output.append_str(" ");
            output = output.append_str(decl.name);
            [decl.initial_value.is_some()] {
                output = output.append_str(" = ");
                output = output.append_str(expr_to_c(decl.initial_value.unwrap()));
            };
            output = output.append_str(";\n");
        };
        &i = i + 1;
    };
    
    output = output.append_str("\n");
    
    // Generate transactions
    let j: Int = 0;
    [j < program.items.len()] {
        unification program.items[j](TopTxn(txn)) = {
            output = output.append_str(generate_c_transaction(txn));
            output = output.append_str("\n");
        };
        &j = j + 1;
    };
    
    // Generate reactor
    output = output.append_str(generate_c_reactor(program));
    
    // Generate main
    output = output.append_str("\nint main(void) {\n");
    output = output.append_str("    reactor_loop();\n");
    output = output.append_str("    return 0;\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn type_to_c(ty: Type) -> String {
    unification ty(TypeInt) = { term "int64_t"; };
    unification ty(TypeUInt) = { term "uint64_t"; };
    unification ty(TypeFloat) = { term "double"; };
    unification ty(TypeBool) = { term "bool"; };
    unification ty(TypeChar) = { term "char"; };
    unification ty(TypeVoid) = { term "void"; };
    term "void"
}

defn generate_c_transaction(txn: Transaction) -> String {
    let output = new_builder();
    
    output = output.append_str("bool ");
    output = output.append_str(txn.name);
    output = output.append_str("(void) {\n");
    output = output.append_str("    // Check precondition\n");
    output = output.append_str("    if (!(");
    output = output.append_str(expr_to_c(txn.contract.precondition));
    output = output.append_str(")) {\n");
    output = output.append_str("        return false;\n");
    output = output.append_str("    }\n\n");
    
    output = output.append_str("    // Transaction body\n");
    output = output.append_str(generate_c_block(txn.body));
    output = output.append_str("\n    return true;\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn generate_c_block(stmts: List<Statement>) -> String {
    let output = new_builder();
    
    let i: Int = 0;
    [i < stmts.len()] {
        output = output.append_str(generate_c_statement(stmts[i]));
        &i = i + 1;
    };
    
    term output.to_string();
}

defn generate_c_statement(stmt: Statement) -> String {
    unification stmt(StmtLet(name, var_type, init)) = {
        let output = new_builder();
        output = output.append_str(type_to_c(var_type.unwrap()));
        output = output.append_str(" ");
        output = output.append_str(name);
        [init.is_some()] {
            output = output.append_str(" = ");
            output = output.append_str(expr_to_c(init.unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    unification stmt(StmtAssign(lhs, rhs)) = {
        let output = new_builder();
        output = output.append_str(expr_to_c(*lhs));
        output = output.append_str(" = ");
        output = output.append_str(expr_to_c(*rhs));
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    unification stmt(StmtTerm(values)) = {
        let output = new_builder();
        output = output.append_str("return");
        [values.len() > 0] {
            output = output.append_str(" ");
            output = output.append_str(expr_to_c(values[0].unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    unification stmt(StmtGuarded(condition, body)) = {
        let output = new_builder();
        output = output.append_str("if (");
        output = output.append_str(expr_to_c(*condition));
        output = output.append_str(") {\n");
        output = output.append_str(generate_c_block(body));
        output = output.append_str("}\n");
        term output.to_string();
    };
    
    term String::new()
}

defn expr_to_c(expr: Expr) -> String {
    unification expr(ExprInt(n)) = {
        term String(n);
    };
    unification expr(ExprFloat(f)) = {
        term String(f);
    };
    unification expr(ExprBool(b)) = {
        [b] { term "true"; };
        term "false";
    };
    unification expr(ExprVar(name)) = {
        term name;
    };
    unification expr(ExprPriorState(name)) = {
        term name + "_old";
    };
    unification expr(ExprBinOp(op, left, right)) = {
        let sb = new_builder();
        sb = sb.append_str("(");
        sb = sb.append_str(expr_to_c(*left));
        sb = sb.append_str(" ");
        [op == "+"] { sb = sb.append_str("+"); };
        [op == "-"] { sb = sb.append_str("-"); };
        [op == "*"] { sb = sb.append_str("*"); };
        [op == "/"] { sb = sb.append_str("/"); };
        [op == "=="] { sb = sb.append_str("=="); };
        [op == "!="] { sb = sb.append_str("!="); };
        [op == "<"] { sb = sb.append_str("<"); };
        [op == ">"] { sb = sb.append_str(">"); };
        [op == "&&"] { sb = sb.append_str("&&"); };
        [op == "||"] { sb = sb.append_str("||"); };
        sb = sb.append_str(" ");
        sb = sb.append_str(expr_to_c(*right));
        sb = sb.append_str(")");
        term sb.to_string();
    };
    term "0"
}

defn generate_c_reactor(program: Program) -> String {
    let output = new_builder();
    
    output = output.append_str("void reactor_loop(void) {\n");
    output = output.append_str("    while (1) {\n");
    
    // Call each transaction
    let i: Int = 0;
    [i < program.items.len()] {
        unification program.items[i](TopTxn(txn)) = {
            output = output.append_str("        ");
            output = output.append_str(txn.name);
            output = output.append_str("();\n");
        };
        &i = i + 1;
    };
    
    output = output.append_str("    }\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}
