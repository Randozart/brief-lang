// LLVM Backend — Generates LLVM IR (.ll) from Brief AST
// Mirrors src/backend/llvm.rs in Brief
// Tier 7 — Self-Hosted Parity

// ===== Helper struct — mirrors call_graph::CallGraphResult
// We inline this type here so the file can compile standalone
struct CgResult {
    node_count: Int,
    edge_count: Int,
    has_cycle: Bool
}

// ===== ENTRY POINT =====

defn generate_llvm(program: Program, cg: CgResult) -> String {
    let output = new_builder();

    output = output.append_str("; ModuleID = 'program.ll'\n");
    output = output.append_str("source_filename = \"program.bv\"\n");
    output = output.append_str("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n");
    output = output.append_str("target triple = \"x86_64-unknown-linux-gnu\"\n\n");

    output = output.append_str("declare void @llvm.assume(i1) #1\n");
    output = output.append_str("declare void @__wait_for_event() #1\n\n");

    [!cg.has_cycle] {
        output = output.append_str("; Call graph: acyclic\n\n");
    };
    [cg.has_cycle] {
        output = output.append_str("; Call graph: cyclic\n\n");
    };

    output = output.append_str(emit_state_type(program));
    output = output.append_str("@global_state = global %State zeroinitializer\n\n");

    let i: Int = 0;
    [i < len(program.items)] {
        uni program.items[i](TopTxn(txn)) = {
            output = output.append_str(emit_txn(txn));
            output = output.append_str("\n");
        };
        &i = i + 1;
    };

    let j: Int = 0;
    [j < len(program.items)] {
        uni program.items[j](TopDefn(defn)) = {
            output = output.append_str(emit_defn(defn));
            output = output.append_str("\n");
        };
        &j = j + 1;
    };

    output = output.append_str(emit_init_state(program));
    output = output.append_str("\n");

    output = output.append_str(emit_reactor(program, cg));
    output = output.append_str("\n");

    output = output.append_str("attributes #0 = {\n");
    output = output.append_str("    mustprogress\n    nofree\n    norecurse\n");
    output = output.append_str("    nosync\n    nounwind\n    willreturn\n");
    output = output.append_str("    memory(argmem: readwrite)\n}\n");
    output = output.append_str("attributes #1 = { nocallback nofree nosync nounwind willreturn memory(argmem: write) }\n");

    term output.to_string();
}

// ===== TYPE HELPERS =====

defn llvm_type(ty: Type) -> String {
    uni ty(TypeInt) = { term "i64"; };
    uni ty(TypeUInt) = { term "i64"; };
    uni ty(TypeBool) = { term "i8"; };
    uni ty(TypeFloat) = { term "float"; };
    uni ty(TypeChar) = { term "i32"; };
    uni ty(TypeString) = { term "i8*"; };
    uni ty(TypeData) = { term "i8*"; };
    uni ty(TypeVoid) = { term "void"; };
    term "i64";
}

defn align_of(ty: String) -> Int {
    [ty == "i64"] { term 8; };
    [ty == "float"] { term 4; };
    [ty == "i8"] { term 1; };
    [ty == "i32"] { term 4; };
    term 8;
}

// ===== STATE TYPE =====

defn emit_state_type(program: Program) -> String {
    let sb = new_builder();
    sb = sb.append_str("%State = type { ");
    let first: Bool = true;
    let i: Int = 0;
    [i < len(program.items)] {
        uni program.items[i](TopState(decl)) = {
            [!first] { sb = sb.append_str(", "); };
            sb = sb.append_str(llvm_type(decl.state_type));
            &first = false;
        };
        &i = i + 1;
    };
    sb = sb.append_str(" }\n");
    term sb.to_string();
}

// ===== INIT STATE =====

defn emit_init_state(program: Program) -> String {
    let sb = new_builder();
    sb = sb.append_str("define void @init_state() local_unnamed_addr #0 {\n");
    sb = sb.append_str("  entry:\n");
    let idx: Int = 0;
    let i: Int = 0;
    [i < len(program.items)] {
        uni program.items[i](TopState(decl)) = {
            [decl.initial_value.is_some()] {
                let ty = llvm_type(decl.state_type);
                let val_str = expr_const(decl.initial_value.unwrap());
                sb = sb.append_str("  store volatile ");
                sb = sb.append_str(ty);
                sb = sb.append_str(" ");
                sb = sb.append_str(val_str);
                sb = sb.append_str(", ");
                sb = sb.append_str(ty);
                sb = sb.append_str("* getelementptr inbounds (%State, %State* @global_state, i32 0, i32 ");
                sb = sb.append_str(String(idx));
                sb = sb.append_str("), align ");
                sb = sb.append_str(String(align_of(ty)));
                sb = sb.append_str("\n");
            };
            &idx = idx + 1;
        };
        &i = i + 1;
    };
    sb = sb.append_str("  ret void\n}\n");
    term sb.to_string();
}

// ===== TRANSACTION =====

defn emit_txn(txn: Transaction) -> String {
    let sb = new_builder();
    sb = sb.append_str("define void @");
    sb = sb.append_str(txn.name);
    sb = sb.append_str("(%State* noalias nocapture %state) local_unnamed_addr #0 {\n");
    sb = sb.append_str("entry:\n");
    sb = sb.append_str(emit_body(txn.body));
    sb = sb.append_str("}\n");
    term sb.to_string();
}

// ===== DEFINITION =====

defn emit_defn(defn: Definition) -> String {
    let sb = new_builder();
    sb = sb.append_str("define i64 @");
    sb = sb.append_str(defn.name);
    sb = sb.append_str("(");
    let i: Int = 0;
    [i < len(defn.params)] {
        [i > 0] { sb = sb.append_str(", "); };
        sb = sb.append_str(llvm_type(defn.params[i].param_type));
        sb = sb.append_str(" %arg");
        sb = sb.append_str(String(i));
        &i = i + 1;
    };
    sb = sb.append_str(") local_unnamed_addr #0 {\nentry:\n");
    let j: Int = 0;
    [j < len(defn.params)] {
        let p = defn.params[j];
        uni p.param_type(TypeBool) = {
            sb = sb.append_str("  %arg_c" + String(j) + " = zext i8 %arg" + String(j) + " to i64\n");
        };
        uni p.param_type(TypeChar) = {
            sb = sb.append_str("  %arg_c" + String(j) + " = zext i32 %arg" + String(j) + " to i64\n");
        };
        uni p.param_type(TypeString) = {
            sb = sb.append_str("  %arg_c" + String(j) + " = ptrtoint i8* %arg" + String(j) + " to i64\n");
        };
        uni p.param_type(TypeFloat) = {
            sb = sb.append_str("  %arg_i" + String(j) + " = bitcast float %arg" + String(j) + " to i32\n");
            sb = sb.append_str("  %arg_c" + String(j) + " = zext i32 %arg_i" + String(j) + " to i64\n");
        };
        &j = j + 1;
    };
    sb = sb.append_str(emit_body(defn.body));
    sb = sb.append_str("}\n");
    term sb.to_string();
}

// ===== BODY / STATEMENTS =====

defn emit_body(body: List<Statement>) -> String {
    let sb = new_builder();
    let i: Int = 0;
    [i < len(body)] {
        sb = sb.append_str(emit_stmt(body[i]));
        &i = i + 1;
    };
    term sb.to_string();
}

defn emit_stmt(stmt: Statement) -> String {
    uni stmt(StmtExpr(exp)) = {
        let dummy = expr_to_ir(exp, 0);
        term "";
    };
    uni stmt(StmtAlka(block)) = {
        term block.content + "\n";
    };
    uni stmt(StmtTerm(values, _mods)) = {
        [len(values) > 0 && values[0].is_some()] {
            term "  ret i64 0\n";
        };
        term "  ret void\n";
    };
    uni stmt(StmtEscape(expr)) = {
        [expr.is_some()] { term "  ret i64 0\n"; };
        term "  ret void\n";
    };
    uni stmt(StmtLocalTrigger(_name, _ty, _expr)) = {
        term "  ; trg!\n";
    };
    uni stmt(StmtOnExit(_body, _span)) = {
        term "  ; on_exit\n";
    };
    uni stmt(StmtGuarded(cond, _body)) = {
        term "  ; guard\n";
    };
    uni stmt(StmtAssign(_lhs, _rhs, _mods)) = {
        term "  ; assign\n";
    };
    uni stmt(StmtLet(_name, _ty, _init, _mods, _addr_expr)) = {
        term "  ; let\n";
    };
    uni stmt(StmtUnification(_name, _pat, _expr)) = {
        term "  ; uni\n";
    };
    term "  ; unknown\n";
}

// ===== EXPRESSIONS =====

defn expr_to_ir(expr: Expr, reg: Int) -> String {
    uni expr(ExprInt(n)) = {
        term "%tmp" + String(reg) + " = add i64 0, " + String(n) + "\n";
    };
    uni expr(ExprBool(b)) = {
        [b] { term "%tmp" + String(reg) + " = add i64 0, 1\n"; };
        term "%tmp" + String(reg) + " = add i64 0, 0\n";
    };
    uni expr(ExprVar(_name)) = {
        term "%tmp" + String(reg) + " = add i64 0, 0\n";
    };
    term "%tmp" + String(reg) + " = add i64 0, 0 ; fallback\n";
}

defn expr_const(expr: Expr) -> String {
    uni expr(ExprInt(n)) = { term String(n); };
    uni expr(ExprBool(b)) = { [b] { term "1"; }; term "0"; };
    uni expr(ExprString(s)) = { term "c\"" + s + "\\00\""; };
    term "0";
}

// ===== REACTOR =====

defn emit_reactor(program: Program, cg: CgResult) -> String {
    let sb = new_builder();
    sb = sb.append_str("define void @reactor_tick() local_unnamed_addr #0 {\n");
    sb = sb.append_str("  call void @__wait_for_event()\n");
    sb = sb.append_str("  ret void\n}\n\n");
    sb = sb.append_str("define i32 @main() local_unnamed_addr #0 {\n");
    sb = sb.append_str("  call void @init_state()\n");
    sb = sb.append_str("  br label %tick\n");
    sb = sb.append_str("tick:\n  call void @reactor_tick()\n");
    sb = sb.append_str("  br label %tick\n}\n");
    term sb.to_string();
}