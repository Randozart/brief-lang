// Rust Backend - Generate Rust code for bootstrapping
// Tier 7 Part 3

import "call_graph";

defn generate_rust(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    
    // Header
    output = output.append_str("// Generated by Briv Compiler\n");

    // Emit acyclicity annotation
    [!cg.has_cycle] {
        output = output.append_str("// Call graph: acyclic -- static dispatch enabled\n");
    };
    [cg.has_cycle] {
        output = output.append_str("// Call graph: cyclic -- dynamic dispatch required\n");
    };

    output = output.append_str("use std::collections::HashMap;\n\n");
    
    // Generate state declarations
    output = output.append_str("// Global state\n");
    let i: Int = 0;
    [i < program.items.len()] {
        uni program.items[i](TopState(decl)) = {
            output = output.append_str("static mut ");
            output = output.append_str(decl.name);
            output = output.append_str(": ");
            output = output.append_str(type_to_rust(decl.state_type));
            output = output.append_str(" = ");
            [decl.initial_value.is_some()] {
                output = output.append_str(expr_to_rust(decl.initial_value.unwrap()));
            };
            [!decl.initial_value.is_some()] {
                output = output.append_str("Default::default()");
            };
            output = output.append_str(";\n");
        };
        i = i + 1;
    };
    
    output = output.append_str("\n");
    
    // Generate transactions
    let j: Int = 0;
    [j < program.items.len()] {
        uni program.items[j](TopTxn(txn)) = {
            output = output.append_str(generate_rust_transaction(txn));
            output = output.append_str("\n");
        };
        j = j + 1;
    };
    
    // Generate reactor
    output = output.append_str(generate_rust_reactor(program, cg));
    
    // Generate main
    output = output.append_str("\nfn main() {\n");
    output = output.append_str("    reactor_loop();\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn less_than_str() -> String { term "<"; }
defn greater_than_str() -> String { term ">"; }

defn type_to_rust(ty: Type) -> String {
    uni ty(TypeInt) = { term "i64"; };
    uni ty(TypeUInt) = { term "u64"; };
    uni ty(TypeFloat) = { term "f64"; };
    uni ty(TypeBool) = { term "bool"; };
    uni ty(TypeString) = { term "String"; };
    uni ty(TypeChar) = { term "char"; };
    uni ty(TypeVoid) = { term "()"; };
    uni ty(TypeList(inner)) = {
        let sb = new_builder();
        sb = sb.append_str("Vec");
        sb = sb.append_str(less_than_str());
        sb = sb.append_str(type_to_rust(inner));
        sb = sb.append_str(greater_than_str());
        term sb.to_string();
    };
term "()";
}

defn generate_rust_transaction(txn: Transaction) -> String {
    let output = new_builder();
    
    output = output.append_str("fn ");
    output = output.append_str(txn.name);
    output = output.append_str("() -> bool {\n");
    output = output.append_str("    // Check precondition\n");
    output = output.append_str("    if !(");
    output = output.append_str(expr_to_rust(txn.contract.precondition));
    output = output.append_str(") {\n");
    output = output.append_str("        return false;\n");
    output = output.append_str("    }\n\n");
    
    output = output.append_str("    unsafe {\n");
    output = output.append_str("        // Transaction body\n");
    output = output.append_str(generate_rust_block(txn.body));
    output = output.append_str("    }\n\n");
    
    output = output.append_str("    true\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}

defn generate_rust_block(stmts: List<Statement>) -> String {
    let output = new_builder();
    
    let i: Int = 0;
    [i < stmts.len()] {
        output = output.append_str(generate_rust_statement(stmts[i]));
        i = i + 1;
    };
    
    term output.to_string();
}

defn generate_rust_statement(stmt: Statement) -> String {
    uni stmt(StmtLet(name, var_type, init, _modifiers, address_expr)) = {
        let output = new_builder();
        [address_expr.is_some()] {
            let addr_code = expr_to_rust(address_expr.unwrap());
            output = output.append_str("let ");
            output = output.append_str(name);
            output = output.append_str(": *const u32 = ");
            output = output.append_str(addr_code);
            output = output.append_str(" as *const u32;\n");
            term output.to_string();
        };
        output = output.append_str("let ");
        output = output.append_str(name);
        [var_type.is_some()] {
            output = output.append_str(": ");
            output = output.append_str(type_to_rust(var_type.unwrap()));
        };
        [init.is_some()] {
            output = output.append_str(" = ");
            output = output.append_str(expr_to_rust(init.unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtAssign(lhs, rhs, _modifiers)) = {
        let output = new_builder();
        output = output.append_str(expr_to_rust(lhs));
        output = output.append_str(" = ");
        output = output.append_str(expr_to_rust(rhs));
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtTerm(values, _modifiers)) = {
        let output = new_builder();
        output = output.append_str("return ");
        [values.len() > 0] {
            output = output.append_str(expr_to_rust(values[0].unwrap()));
        };
        output = output.append_str(";\n");
        term output.to_string();
    };
    
    uni stmt(StmtGuarded(condition, body)) = {
        let output = new_builder();
        output = output.append_str("if ");
        output = output.append_str(expr_to_rust(condition));
        output = output.append_str(" {\n");
        output = output.append_str(generate_rust_block(body));
        output = output.append_str("}\n");
        term output.to_string();
    };
    
    uni stmt(StmtOnExit(body)) = {
        let output = new_builder();
        output = output.append_str("// #on_exit cleanup\n");
        output = output.append_str(generate_rust_block(body));
        term output.to_string();
    };
    
    uni stmt(StmtAlka(block)) = {
        let output = new_builder();
        let prefix = "// alka {} = ";
        [block.dangerous] { prefix = "// alka! {} = "; };
        output = output.append_str(prefix);
        output = output.append_str(block.content);
        output = output.append_str("\n");
        term output.to_string();
    };
    
    uni stmt(StmtLocalTrigger(name, _, trigger_expr)) = {
        let output = new_builder();
        [is_some(trigger_expr)] {
            let expr_code = expr_to_rust(unwrap(trigger_expr));
            output = output.append_str("// trg! ");
            output = output.append_str(name);
            output = output.append_str(": await ");
            output = output.append_str(expr_code);
            output = output.append_str("\n");
        };
        [!is_some(trigger_expr)] {
            output = output.append_str("// trg! ");
            output = output.append_str(name);
            output = output.append_str(": await external event\n");
        };
        term output.to_string();
    };
    
    term "";
}

defn expr_to_rust(expr: Expr) -> String {
    uni expr(ExprInt(n)) = {
        term String(n);
    };
    uni expr(ExprFloat(f)) = {
        term String(f);
    };
    uni expr(ExprBool(b)) = {
        [b] { term "true"; };
        term "false";
    };
    uni expr(ExprVar(name)) = {
        term name;
    };
    uni expr(ExprPriorState(name)) = {
        term name + "_old";
    };
    uni expr(ExprBinOp(op, left, right)) = {
        let sb = new_builder();
        sb = sb.append_str("(");
sb = sb.append_str(expr_to_rust(left));
        sb = sb.append_str(" ");
        sb = sb.append_str(op_to_rust(op));
        sb = sb.append_str(" ");
        sb = sb.append_str(expr_to_rust(right));
        sb = sb.append_str(")");
        term sb.to_string();
    };
    term "/* expr */".to_string();
}

defn generate_rust_reactor(program: Program, cg: CallGraphResult) -> String {
    let output = new_builder();
    
    output = output.append_str("fn reactor_loop() {\n");
    output = output.append_str("    loop {\n");
    
    // Use acyclic dispatch when call graph has no cycles
    [!cg.has_cycle] {
        output = output.append_str("        // Acyclic: direct static dispatch\n");
        let i: Int = 0;
        [i < program.items.len()] {
            uni program.items[i](TopTxn(txn)) = {
                output = output.append_str("        ");
                output = output.append_str(txn.name);
                output = output.append_str("();\n");
            };
            i = i + 1;
        };
    };
    [cg.has_cycle] {
        output = output.append_str("        // Cyclic: guarded dispatch with depth limit\n");
        let i: Int = 0;
        [i < program.items.len()] {
            uni program.items[i](TopTxn(txn)) = {
                output = output.append_str("        ");
                output = output.append_str(txn.name);
                output = output.append_str("();\n");
            };
            i = i + 1;
        };
    };
    
    output = output.append_str("    }\n");
    output = output.append_str("}\n");
    
    term output.to_string();
}
