// Parser - Recursive descent parser for Brief
// Tier 4: Parser Components

import token;
import ast;
import std.collections;

// ===== PARSER STATE =====

struct ParserState {
    tokens: List<Token>,
    position: Int,
    current_token: Token,
    strict_mode: Bool
}

// ===== PARSER CONSTRUCTION =====

defn new_parser(tokens: List<Token>) -> ParserState {
    let current = unwrap_or(get(tokens, 0), TokenEof);
    term ParserState {
        tokens: tokens,
        position: 0,
        current_token: current,
        strict_mode: false
    };
}

// ===== TOKEN ACCESS =====

defn current_token(state: ParserState) -> Token {
    term state.current_token;
}

defn peek_token(state: ParserState, offset: Int) -> Token {
    let pos = state.position + offset;
    [pos < len(state.tokens)] {
        term state.tokens[pos];
    };
    term TokenEof;
}

defn advance(state: ParserState) -> ParserState {
    let new_pos = state.position + 1;
    [new_pos < len(state.tokens)] {
        let new_current = state.tokens[new_pos];
        term ParserState {
            tokens: state.tokens,
            position: new_pos,
            current_token: new_current,
            strict_mode: state.strict_mode
        };
    };
    term ParserState {
        tokens: state.tokens,
        position: new_pos,
        current_token: TokenEof,
        strict_mode: state.strict_mode
    };
}

defn expect_token(state: ParserState, expected: Token) -> Result<ParserState, String> {
    [current_token(state) == expected] {
        term Ok(advance(state));
    };
    term Err("Expected " + token_to_string(expected) + " but got " + token_to_string(current_token(state)));
}

defn match_token(state: ParserState, token: Token) -> (Bool, ParserState) {
    [current_token(state) == token] {
        term (true, advance(state));
    };
    term (false, state);
}

// ===== PROGRAM PARSING =====

defn parse_program(state: ParserState) -> Result<Program, String> {
    let items: List<TopLevel> = [];
    
    [current_token(state) != TokenEof] {
        let result = parse_top_level(state);
        uni result(Ok(pair)) = {
            let (item, new_state) = pair;
            &items = append(items, item);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Ok(Program { items: items, strict_mode: StrictOff });
}

// ===== STRICT MODE =====

defn set_strict_mode(state: ParserState, strict: Bool) -> ParserState {
    term ParserState {
        tokens: state.tokens,
        position: state.position,
        current_token: state.current_token,
        strict_mode: strict
    };
}

defn token_to_string(tok: Token) -> String {
    uni tok(TokenIdentifier(text)) = { term text; };
    uni tok(OpPlus) = { term "+"; };
    uni tok(OpMinus) = { term "-"; };
    uni tok(OpStar) = { term "*"; };
    uni tok(OpSlash) = { term "/"; };
    uni tok(OpEq) = { term "="; };
    uni tok(OpEqEq) = { term "=="; };
    uni tok(OpNotEq) = { term "!="; };
    uni tok(OpLt) = { term "<"; };
    uni tok(OpGt) = { term ">"; };
    uni tok(OpLtEq) = { term "<="; };
    uni tok(OpGtEq) = { term ">="; };
    uni tok(OpAndAnd) = { term "&&"; };
    uni tok(OpOrOr) = { term "||"; };
    uni tok(OpNot) = { term "!"; };
    uni tok(OpAt) = { term "@"; };
    uni tok(OpDot) = { term "."; };
    uni tok(OpColon) = { term ":"; };
    uni tok(OpSemicolon) = { term ";"; };
    uni tok(OpComma) = { term ","; };
    uni tok(OpArrow) = { term "->"; };
    uni tok(OpTilde) = { term "~"; };
    uni tok(OpQuestion) = { term "?"; };
    uni tok(DelimLParen) = { term "("; };
    uni tok(DelimRParen) = { term ")"; };
    uni tok(DelimLBrace) = { term "{"; };
    uni tok(DelimRBrace) = { term "}"; };
    uni tok(DelimLBracket) = { term "["; };
    uni tok(DelimRBracket) = { term "]"; };
    uni tok(KeywordTxn) = { term "txn"; };
    uni tok(KeywordDefn) = { term "defn"; };
    uni tok(KeywordLet) = { term "let"; };
    uni tok(KeywordTerm) = { term "term"; };
    uni tok(KeywordEscape) = { term "escape"; };
    uni tok(KeywordIf) = { term "if"; };
    uni tok(KeywordElse) = { term "else"; };
    uni tok(KeywordTrue) = { term "true"; };
    uni tok(KeywordFalse) = { term "false"; };
    term "";
}

defn parse_alka_block(state: ParserState) -> Result<(Statement, ParserState), String> {
    // Consume the alka keyword (already matched by caller)
    &state = advance(state);
    
    let dangerous = false;
    uni current_token(state)(OpNot) = {
        &dangerous = true;
        &state = advance(state);
    };
    
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let content_parts: List<String> = [];
    let brace_depth = 1;
    [brace_depth > 0] {
        let tok = current_token(state);
        uni tok(DelimLBrace) = {
            &brace_depth = brace_depth + 1;
            &content_parts = append(content_parts, "{");
            &state = advance(state);
        };
        uni tok(DelimRBrace) = {
            &brace_depth = brace_depth - 1;
            [brace_depth > 0] {
                &content_parts = append(content_parts, "}");
            };
            &state = advance(state);
        };
        [!uni tok(DelimLBrace) = true] {
            [!uni tok(DelimRBrace) = true] {
                &content_parts = append(content_parts, token_to_string(tok));
                &state = advance(state);
            };
        };
    };
    
    let result = expect_token(state, OpSemicolon);
    uni result(Ok(new_state)) = {
        let sb = new_builder();
        let i: Int = 0;
        [i < content_parts.len()] {
            [i > 0] { sb = append_str(sb, " "); };
            sb = append_str(sb, content_parts[i]);
            &i = i + 1;
        };
        let content = sb.to_string();
        let alka = AlkaBlock { dangerous: dangerous, content: content };
        term Ok((StmtAlka(alka), new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

// ===== HASHTAG MODIFIER PARSING =====

defn parse_hashtag_modifiers(state: ParserState) -> Result<(List<Hashtag>, ParserState), String> {
    let modifiers: List<Hashtag> = [];
    
    [current_token(state) == HashBang || current_token(state) == HashBracket] {
        let tag_type = current_token(state);
        &state = advance(state);
        
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            let modifier = Hashtag {
                name: name,
                value: None,
                mandatory: tag_type == HashBang,
                fallback: [],
                scoped: None
            };
            &state = advance(state);
            &modifiers = append(modifiers, modifier);
        };
        [!is_identifier(tok)] {
            term Err("Expected hashtag name after #[");
        };
    };
    
    term Ok((modifiers, state));
}

defn parse_top_level(state: ParserState) -> Result<(TopLevel, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordLet) = {
        let result = parse_state_decl(state);
        uni result(Ok(pair)) = {
            let (decl, new_state) = pair;
            term Ok((TopState(decl), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordConst) = {
        let result = parse_constant(state);
        uni result(Ok(pair)) = {
            let (c, new_state) = pair;
            term Ok((TopConst(c), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordTxn) = {
        let result = parse_transaction(state);
        uni result(Ok(pair)) = {
            let (t, new_state) = pair;
            term Ok((TopTxn(t), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordRct) = {
        let result = parse_transaction(state);
        uni result(Ok(pair)) = {
            let (t, new_state) = pair;
            term Ok((TopTxn(t), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordDefn) = {
        let result = parse_definition(state);
        uni result(Ok(pair)) = {
            let (d, new_state) = pair;
            term Ok((TopDefn(d), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordSig) = {
        let result = parse_signature(state);
        uni result(Ok(pair)) = {
            let (s, new_state) = pair;
            term Ok((TopSig(s), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordStruct) = {
        let result = parse_struct(state);
        uni result(Ok(pair)) = {
            let (struct_def, new_state) = pair;
            term Ok((TopStruct(struct_def), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordEnum) = {
        let result = parse_enum(state);
        uni result(Ok(pair)) = {
            let (enum_def, new_state) = pair;
            term Ok((TopEnum(enum_def), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordImport) = {
        let result = parse_import(state);
        uni result(Ok(pair)) = {
            let (imp, new_state) = pair;
            term Ok((TopImport(imp), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Err("Unexpected token: " + token_to_string(tok));
}

// ===== TRANSACTION PARSING =====

defn parse_transaction(state: ParserState) -> Result<(Transaction, ParserState), String> {
    let is_async = false;
    let is_reactive = false;
    
    [current_token(state) == KeywordRct] {
        &is_reactive = true;
        &state = advance(state);
    };
    
    [current_token(state) == KeywordAsync] {
        &is_async = true;
        &state = advance(state);
    };
    
    let result = expect_token(state, KeywordTxn);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected transaction name");
    };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_params(state);
    uni result(Ok(pair)) = {
        let (params, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_contract(state);
    uni result(Ok(pair)) = {
        let (contract, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let body: List<Statement> = [];
    [current_token(state) == DelimLBrace] {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            &body = stmts;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpSemicolon] {
        &state = advance(state);
    };
    
    let modifiers: List<Hashtag> = [];
    [current_token(state) == HashBang || current_token(state) == HashBracket] {
        let result = parse_hashtag_modifiers(state);
        uni result(Ok(pair)) = {
            let (mods, new_state) = pair;
            &modifiers = mods;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let txn_obj = Transaction {
        name: unwrap_identifier(tok),
        is_async: is_async,
        is_reactive: is_reactive,
        type_params: type_params,
        params: params,
        contract: contract,
        body: body,
        modifiers: modifiers,
        dependencies: []
    };
    
    term Ok((txn_obj, state));
}

// ===== DEFINITION PARSING =====

defn parse_definition(state: ParserState) -> Result<(Definition, ParserState), String> {
    let result = expect_token(state, KeywordDefn);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected function name");
    };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_params(state);
    uni result(Ok(pair)) = {
        let (params, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let output_type: Option<Type> = None;
    [current_token(state) == OpArrow] {
        &state = advance(state);
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (ty, new_state) = pair;
            &output_type = Some(ty);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_contract(state);
    uni result(Ok(pair)) = {
        let (contract, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let body: List<Statement> = [];
    [current_token(state) == DelimLBrace] {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            &body = stmts;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpSemicolon] {
        &state = advance(state);
    };
    
    let modifiers: List<Hashtag> = [];
    [current_token(state) == HashBang || current_token(state) == HashBracket] {
        let result = parse_hashtag_modifiers(state);
        uni result(Ok(pair)) = {
            let (mods, new_state) = pair;
            &modifiers = mods;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let defn_obj = Definition {
        name: unwrap_identifier(tok),
        type_params: type_params,
        params: params,
        output_type: output_type,
        contract: contract,
        body: body,
        modifiers: modifiers
    };
    
    term Ok((defn_obj, state));
}

// ===== CONTRACT PARSING =====

defn parse_contract(state: ParserState) -> Result<(Contract, ParserState), String> {
    let result = expect_token(state, DelimLBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_expression(state);
    uni result(Ok(pair)) = {
        let (pre, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimLBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_expression(state);
    uni result(Ok(pair)) = {
        let (post, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    // Strict mode check: reject [true] contracts
    [state.strict_mode] {
        uni pre(ExprBool(b)) = {
            [b] { term Err("Strict mode: precondition [true] is not allowed - specify actual state requirements"); };
        };
        uni post(ExprBool(b)) = {
            [b] { term Err("Strict mode: postcondition [true] is not allowed - specify actual state guarantees"); };
        };
    };
    
    let watchdog: Option<Watchdog> = None;
    [current_token(state) == OpQuestion || current_token(state) == OpBang] {
        let is_required = current_token(state) == OpBang;
        &state = advance(state);
        
        let result = expect_token(state, DelimLBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (cond, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        &watchdog = Some(Watchdog {
            condition: cond,
            is_required: is_required
        });
    };
    
    let contract = Contract {
        precondition: pre,
        postcondition: post,
        watchdog: watchdog
    };
    
    term Ok((contract, state));
}

// ===== EXPRESSION PARSING =====

defn parse_or_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_and_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpOr] {
            &ms_state = advance(ms_state);
            let result = parse_or_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("||", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_and_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_equality_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpAnd] {
            &ms_state = advance(ms_state);
            let result = parse_and_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("&&", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_equality_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_comparison_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpEqEq] {
            &ms_state = advance(ms_state);
            let result = parse_comparison_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("==", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpNeq] {
            &ms_state = advance(ms_state);
            let result = parse_comparison_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("!=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_comparison_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_additive_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpLt] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("<", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpGt] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop(">", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpLtEq] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("<=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpGtEq] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop(">=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_additive_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_multiplicative_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpPlus] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("+", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpMinus] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("-", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_multiplicative_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_unary_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpStar] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("*", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpSlash] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("/", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpPercent] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("%", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_unary_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    [current_token(state) == OpMinus] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("-", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpBang] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("!", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpTilde] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("~", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term parse_primary_expr(state);
}

defn parse_primary_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(TokenInt(n)) = {
        &state = advance(state);
        term Ok((make_int(n), state));
    };
    
    uni tok(TokenFloat(f)) = {
        &state = advance(state);
        term Ok((make_float(f), state));
    };
    
    uni tok(TokenString(s)) = {
        &state = advance(state);
        term Ok((make_string(s), state));
    };
    
    uni tok(TokenChar(c)) = {
        &state = advance(state);
        term Ok((make_char(c), state));
    };
    
    uni tok(KeywordTrue) = {
        &state = advance(state);
        term Ok((make_bool(true), state));
    };
    
    uni tok(KeywordFalse) = {
        &state = advance(state);
        term Ok((make_bool(false), state));
    };
    
    uni tok(TokenIdentifier(_)) = {
        let name = unwrap_identifier(tok);
        &state = advance(state);
        
        [current_token(state) == DelimLParen] {
            &state = advance(state);
            let result = parse_expr_list(state);
            uni result(Ok(pair)) = {
                let (args, new_state) = pair;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            let result = expect_token(state, DelimRParen);
            uni result(Ok(new_state)) = {
                term Ok((make_call(name, args), new_state));
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((make_var(name), state));
    };
    
    uni tok(OpAt) = {
        &state = advance(state);
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
            term Ok((make_prior_state(name), state));
        };
        term Err("Expected identifier after @");
    };
    
    uni tok(DelimLParen) = {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = {
            term Ok((expr, new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(DelimLBracket) = {
        &state = advance(state);
        let result = parse_expr_list(state);
        uni result(Ok(pair)) = {
            let (elements, new_state) = pair;
            term Ok((ExprList(elements), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Err("Unexpected token in expression: " + token_to_string(tok));
}

defn parse_expr_list(state: ParserState) -> Result<(List<Expr>, ParserState), String> {
    let elements: List<Expr> = [];
    let state: ParserState = state;
    
    [current_token(state) != DelimRParen && current_token(state) != DelimRBracket] {
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &elements = append(elements, expr);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    term Ok((elements, state));
}

defn parse_expression(state: ParserState) -> Result<(Expr, ParserState), String> {
    term parse_or_expr(state);
}

// ===== STATEMENT PARSING =====

defn parse_statement(state: ParserState) -> Result<(Statement, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordLet) = {
        let result = parse_let(state);
        uni result(Ok(pair)) = {
            let (stmt, new_state) = pair;
            term Ok((stmt, new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(Hash) = {
        // Block pragma: #identifier { body };
        &state = advance(state);
        let pragma_name = current_token(state);
        uni pragma_name(TokenIdentifier(name)) = {
            &state = advance(state);
            [name == "on_exit" || name == "on_cleanup"] {
                let result = expect_token(state, DelimLBrace);
                uni result(Ok(new_state)) = {
                    &state = new_state;
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
                
                let body: List<Statement> = [];
                [current_token(state) != DelimRBrace] {
                    let result = parse_statement(state);
                    uni result(Ok(pair)) = {
                        let (stmt, new_state) = pair;
                        &body = append(body, stmt);
                        &state = new_state;
                    };
                    uni result(Err(e)) = {
                        term Err(e);
                    };
                };
                
                let result = expect_token(state, DelimRBrace);
                uni result(Ok(new_state)) = {
                    &state = new_state;
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
                
                let result = expect_token(state, OpSemicolon);
                uni result(Ok(new_state)) = {
                    term Ok((StmtOnExit(body), new_state));
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
            };
            term Err("Unknown block pragma: #" + name);
        };
        [!is_identifier(pragma_name)] {
            term Err("Expected pragma name after #");
        };
    };
    
    uni tok(KeywordTrg) = {
        &state = advance(state);
        // Check for trg! (local trigger) vs trg (top-level)
        [current_token(state) == OpNot] {
            &state = advance(state);
            // Parse trg! name: Type = expr;
            let tok_name = current_token(state);
            uni tok_name(TokenIdentifier(name)) = {
                &state = advance(state);
            };
            [!is_identifier(tok_name)] {
                term Err("Expected local trigger name after trg!");
            };
            
            let result = expect_token(state, OpColon);
            uni result(Ok(new_state)) = { &state = new_state; };
            uni result(Err(e)) = { term Err(e); };
            
            let result = parse_type(state);
            uni result(Ok(pair)) = {
                let (ty, new_state) = pair;
                &state = new_state;
            };
            uni result(Err(e)) = { term Err(e); };
            
            let trigger_expr: Option<Expr> = None;
            [current_token(state) == OpEq] {
                &state = advance(state);
                let result = parse_expression(state);
                uni result(Ok(pair)) = {
                    let (expr_val, new_state) = pair;
                    &trigger_expr = Some(expr_val);
                    &state = new_state;
                };
                uni result(Err(e)) = { term Err(e); };
            };
            
            let result = expect_token(state, OpSemicolon);
            uni result(Ok(new_state)) = {
                term Ok((StmtLocalTrigger(name, ty, trigger_expr), new_state));
            };
            uni result(Err(e)) = { term Err(e); };
        };
        term Err("trg at statement level requires 'trg!' (with bang)");
    };
    
    [is_identifier(tok) || tok == OpAt] {
        // Check for alka escape hatch before parsing as expression
        uni tok(TokenIdentifier(name)) = {
            [name == "alka" || name == "ALKA"] {
                let result = parse_alka_block(state);
                uni result(Ok(pair)) = {
                    term Ok(pair);
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
            };
        };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        [current_token(state) == OpEq] {
            &state = advance(state);
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (rhs, new_state) = pair;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            let result = expect_token(state, OpSemicolon);
            uni result(Ok(new_state)) = {
                term Ok((StmtAssign(expr, rhs, []), new_state));
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
    };
    
    uni tok(KeywordTerm) = {
        &state = advance(state);
        
        let values: List<Option<Expr>> = [];
        [current_token(state) != OpSemicolon] {
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (expr, new_state) = pair;
                &values = append(values, Some(expr));
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            [current_token(state) == OpComma] {
                &state = advance(state);
            };
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtTerm(values, []), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordEscape) = {
        &state = advance(state);
        
        let value: Option<Expr> = None;
        [current_token(state) != OpSemicolon] {
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (expr, new_state) = pair;
                &value = Some(expr);
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtEscape(value), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordUnification) = {
        &state = advance(state);
        
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected pattern name after uni");
        };
        
        let result = expect_token(state, DelimLParen);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let pattern_tok = current_token(state);
        uni pattern_tok(TokenIdentifier(pattern)) = {
            &state = advance(state);
        };
        [!is_identifier(pattern_tok)] {
            term Err("Expected pattern in parentheses");
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpEq);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtUnification(name, pattern, expr), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(DelimLBracket) = {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (condition, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let body: List<Statement> = [];
        [current_token(state) == DelimLBrace] {
            let result = parse_block(state);
            uni result(Ok(pair)) = {
                let (stmts, new_state) = pair;
                &body = stmts;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        [current_token(state) != DelimLBrace] {
            let result = parse_statement(state);
            uni result(Ok(pair)) = {
                let (stmt, new_state) = pair;
                &body = append(body, stmt);
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((StmtGuarded(condition, body), state));
    };
    
    uni tok(DelimLBrace) = {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            term Ok((ExprBlock(stmts), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [true] {
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtExpr(expr), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
}

defn parse_let(state: ParserState) -> Result<(Statement, ParserState), String> {
    let result = expect_token(state, KeywordLet);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    // Check for tuple destructuring: let (a, b) = expr;
    uni current_token(state)(DelimLParen) = {
        &state = advance(state);
        let names: List<String> = [];
        
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &names = append(names, name);
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected identifier after ( in tuple destructuring");
        };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
            let tok2 = current_token(state);
            uni tok2(TokenIdentifier(name2)) = {
                &names = append(names, name2);
                &state = advance(state);
            };
            [!is_identifier(tok2)] {
                term Err("Expected identifier after comma in tuple destructuring");
            };
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = { &state = new_state; };
        uni result(Err(e)) = { term Err(e); };
        
        let var_type: Option<Type> = None;
        [current_token(state) == OpColon] {
            &state = advance(state);
            let result = parse_type(state);
            uni result(Ok(pair)) = {
                let (ty, new_state) = pair;
                &var_type = Some(ty);
                &state = new_state;
            };
            uni result(Err(e)) = { term Err(e); };
        };
        
        let result = expect_token(state, OpEq);
        uni result(Ok(new_state)) = { &state = new_state; };
        uni result(Err(e)) = { term Err(e); };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            let sb = new_builder();
            let i: Int = 0;
            [i < names.len()] {
                [i > 0] { sb = append_str(sb, ","); };
                sb = append_str(sb, names[i]);
                &i = i + 1;
            };
            let joined = sb.to_string();
            term Ok((StmtLet(joined, var_type, Some(ExprTupleDestructure(names, expr)), [], None), new_state));
        };
        uni result(Err(e)) = { term Err(e); };
    };
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected variable name");
    };
    
    let var_type: Option<Type> = None;
    [current_token(state) == OpColon] {
        &state = advance(state);
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (ty, new_state) = pair;
            &var_type = Some(ty);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let address_expr: Option<Expr> = None;
    [current_token(state) == OpAt] {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (addr_expr, new_state) = pair;
            &address_expr = Some(addr_expr);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let init_value: Option<Expr> = None;
    [current_token(state) == OpEq] {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &init_value = Some(expr);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = expect_token(state, OpSemicolon);
    uni result(Ok(new_state)) = {
        term Ok((StmtLet(name, var_type, init_value, [], None), new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_block(state: ParserState) -> Result<(List<Statement>, ParserState), String> {
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let stmts: List<Statement> = [];
    [current_token(state) != DelimRBrace] {
        let result = parse_statement(state);
        uni result(Ok(pair)) = {
            let (stmt, new_state) = pair;
            &stmts = append(stmts, stmt);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = expect_token(state, DelimRBrace);
    uni result(Ok(new_state)) = {
        term Ok((stmts, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

// ===== TYPE PARSING =====

defn parse_type(state: ParserState) -> Result<(Type, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordInt) = {
        &state = advance(state);
        term Ok((TypeInt, state));
    };
    
    uni tok(KeywordUInt) = {
        &state = advance(state);
        term Ok((TypeUInt, state));
    };
    
    uni tok(KeywordFloat) = {
        &state = advance(state);
        term Ok((TypeFloat, state));
    };
    
    uni tok(KeywordString) = {
        &state = advance(state);
        term Ok((TypeString, state));
    };
    
    uni tok(KeywordBool) = {
        &state = advance(state);
        term Ok((TypeBool, state));
    };
    
    uni tok(KeywordChar) = {
        &state = advance(state);
        term Ok((TypeChar, state));
    };
    
    uni tok(KeywordVoid) = {
        &state = advance(state);
        term Ok((TypeVoid, state));
    };
    
    uni tok(KeywordData) = {
        &state = advance(state);
        term Ok((TypeData, state));
    };
    
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
        
        // Check for generic type: Name<T, U, ...>
        [current_token(state) == OpLt] {
            &state = advance(state);
            let args: List<Type> = [];
            
            [current_token(state) != OpGt] {
                let result = parse_type(state);
                uni result(Ok(pair)) = {
                    let (arg_type, new_state) = pair;
                    &args = append(args, arg_type);
                    &state = new_state;
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
                
                [current_token(state) == OpComma] {
                    &state = advance(state);
                };
            };
            
            [current_token(state) == OpGt] {
                &state = advance(state);
            };
            
            term Ok((TypeNamed(name, args), state));
        };
        
        // Plain named type
        term Ok((TypeNamed(name, []), state));
    };
    
    term Err("Unknown type: " + token_to_string(tok));
}

defn parse_type_params(state: ParserState) -> Result<(List<String>, ParserState), String> {
    let result = expect_token(state, OpLt);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let params: List<String> = [];
    [current_token(state) != OpGt] {
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &params = append(params, name);
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected type parameter name");
        };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, OpGt);
    uni result(Ok(new_state)) = {
        term Ok((params, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_params(state: ParserState) -> Result<(List<Param>, ParserState), String> {
    let result = expect_token(state, DelimLParen);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let params: List<Param> = [];
    [current_token(state) != DelimRParen] {
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected parameter name");
        };
        
        let result = expect_token(state, OpColon);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (param_type, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let param = Param {
            name: name,
            param_type: param_type
        };
        &params = append(params, param);
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, DelimRParen);
    uni result(Ok(new_state)) = {
        term Ok((params, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

// ===== SIGNATURE PARSING =====

defn parse_signature(state: ParserState) -> Result<(Signature, ParserState), String> {
    let result = expect_token(state, KeywordSig);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected signature name"); };
    
    let result = expect_token(state, DelimLParen);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let input_type: Type = TypeVoid;
    [current_token(state) != DelimRParen] {
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (ty, new_state) = pair;
            &input_type = ty;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let result = expect_token(state, DelimRParen);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = expect_token(state, OpArrow);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_type(state);
    uni result(Ok(pair)) = {
        let (output_ty, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = { term Err(e); };
    
    let source: Option<String> = None;
    let bound_defn: Option<String> = None;
    
    let sig = Signature {
        name: unwrap_identifier(tok),
        input_type: input_type,
        output_type: output_ty,
        source: source,
        bound_defn: bound_defn
    };
    
    term Ok((sig, state));
}

// ===== STRUCT PARSING =====

defn parse_struct(state: ParserState) -> Result<(StructDefinition, ParserState), String> {
    let result = expect_token(state, KeywordStruct);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected struct name"); };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let fields: List<StructField> = [];
    [current_token(state) != DelimRBrace] {
        let result = parse_struct_field(state);
        uni result(Ok(pair)) = {
            let (field, new_state) = pair;
            &fields = append(fields, field);
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, DelimRBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let variants: List<StructVariant> = [];
    [current_token(state) == DelimLBracket] {
        let result = parse_struct_variants(state);
        uni result(Ok(pair)) = {
            let (vars, new_state) = pair;
            &variants = vars;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let methods: List<Transaction> = [];
    
    let modifiers: List<Hashtag> = [];
    [current_token(state) == HashBang || current_token(state) == HashBracket] {
        let result = parse_hashtag_modifiers(state);
        uni result(Ok(pair)) = {
            let (mods, new_state) = pair;
            &modifiers = mods;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let struct_def = StructDefinition {
        name: unwrap_identifier(tok),
        fields: fields,
        methods: methods,
        modifiers: modifiers,
        variants: variants
    };
    
    term Ok((struct_def, state));
}

// ===== STRUCT VARIANT PARSING =====

defn parse_struct_variants(state: ParserState) -> Result<(List<StructVariant>, ParserState), String> {
    let variants: List<StructVariant> = [];
    let st = state;
    
    [current_token(st) == DelimLBracket] {
        let result = parse_struct_variant(st);
        uni result(Ok(pair)) = {
            let (variant, new_state) = pair;
            &variants = append(variants, variant);
            &st = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Ok((variants, st));
}

defn parse_struct_variant(state: ParserState) -> Result<(StructVariant, ParserState), String> {
    let result = expect_token(state, DelimLBracket);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let discriminant = parse_expression(state);
    uni discriminant(Ok(pair)) = {
        let (disc_expr, new_state) = pair;
        &state = new_state;
    };
    uni discriminant(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBracket);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_struct_variant_fields(state);
    uni result(Ok(pair)) = {
        let (fields, additions, removals, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let contract = Contract {
        precondition: disc_expr,
        postcondition: ExprBool(true),
        watchdog: None
    };
    
    let variant = StructVariant {
        contract: contract,
        fields: fields,
        additions: additions,
        removals: removals
    };
    
    term Ok((variant, state));
}

defn parse_struct_variant_fields(state: ParserState) -> Result<(List<StructField>, List<StructField>, List<String>, ParserState), String> {
    let fields: List<StructField> = [];
    let additions: List<StructField> = [];
    let removals: List<String> = [];
    let st = state;
    
    [current_token(st) != DelimRBrace] {
        [current_token(st) == OpPlus] {
            &st = advance(st);
            let tok = current_token(st);
            uni tok(TokenIdentifier(name)) = {
                &st = advance(st);
                let result = expect_token(st, OpColon);
                uni result(Ok(new_state)) = { &st = new_state; };
                uni result(Err(e)) = { term Err(e); };
                
                let result = parse_type(st);
                uni result(Ok(pair)) = {
                    let (ty, new_state) = pair;
                    &st = new_state;
                };
                uni result(Err(e)) = { term Err(e); };
                
                let field = StructField {
                    name: name,
                    field_type: ty,
                    default_value: None
                };
                &additions = append(additions, field);
            };
            [!is_identifier(tok)] { term Err("Expected field name after +"); };
        };
        
        [current_token(st) == OpMinus] {
            &st = advance(st);
            let tok = current_token(st);
            uni tok(TokenIdentifier(name)) = {
                &st = advance(st);
                &removals = append(removals, name);
            };
            [!is_identifier(tok)] { term Err("Expected field name after -"); };
        };
        
        [is_identifier(current_token(st))] {
            let tok = current_token(st);
            uni tok(TokenIdentifier(name)) = {
                &st = advance(st);
                let result = expect_token(st, OpColon);
                uni result(Ok(new_state)) = { &st = new_state; };
                uni result(Err(e)) = { term Err(e); };
                
                let result = parse_type(st);
                uni result(Ok(pair)) = {
                    let (ty, new_state) = pair;
                    &st = new_state;
                };
                uni result(Err(e)) = { term Err(e); };
                
                let field = StructField {
                    name: name,
                    field_type: ty,
                    default_value: None
                };
                &fields = append(fields, field);
            };
        };
        
        [current_token(st) == OpComma] {
            &st = advance(st);
        };
        [current_token(st) == OpSemicolon] {
            &st = advance(st);
        };
    };
    
    term Ok((fields, additions, removals, st));
}

defn parse_struct_field(state: ParserState) -> Result<(StructField, ParserState), String> {
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected field name"); };
    
    let result = expect_token(state, OpColon);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_type(state);
    uni result(Ok(pair)) = {
        let (field_type, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = { term Err(e); };
    
    let default_value: Option<Expr> = None;
    
    let field = StructField {
        name: unwrap_identifier(tok),
        field_type: field_type,
        default_value: default_value
    };
    
    term Ok((field, state));
}

// ===== ENUM PARSING =====

defn parse_enum(state: ParserState) -> Result<(EnumDefinition, ParserState), String> {
    let result = expect_token(state, KeywordEnum);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected enum name"); };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let variants: List<EnumVariant> = [];
    [current_token(state) != DelimRBrace] {
        let result = parse_enum_variant(state);
        uni result(Ok(pair)) = {
            let (variant, new_state) = pair;
            &variants = append(variants, variant);
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, DelimRBrace);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let enum_def = EnumDefinition {
        name: unwrap_identifier(tok),
        type_params: type_params,
        variants: variants
    };
    
    term Ok((enum_def, state));
}

defn parse_enum_variant(state: ParserState) -> Result<(EnumVariant, ParserState), String> {
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected variant name"); };
    
    [current_token(state) == DelimLParen] {
        &state = advance(state);
        let types: List<Type> = [];
        
        [current_token(state) != DelimRParen] {
            let result = parse_type(state);
            uni result(Ok(pair)) = {
                let (ty, new_state) = pair;
                &types = append(types, ty);
                &state = new_state;
            };
            uni result(Err(e)) = { term Err(e); };
            
            [current_token(state) == OpComma] {
                &state = advance(state);
            };
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = { &state = new_state; };
        uni result(Err(e)) = { term Err(e); };
        
        term Ok((VariantTuple(name, types), state));
    };
    
    term Ok((VariantSimple(name), state));
}

// ===== IMPORT PARSING =====

defn parse_import(state: ParserState) -> Result<(Import, ParserState), String> {
    let result = expect_token(state, KeywordImport);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let path = parse_import_path(state);
    uni path(Ok(pair)) = {
        let (path_str, new_state) = pair;
        &state = new_state;
    };
    uni path(Err(e)) = { term Err(e); };
    
    let items: List<ImportItem> = [];
    let alias: Option<String> = None;
    
    let imp = Import {
        path: path_str,
        items: items,
        alias: alias
    };
    
    term Ok((imp, state));
}

defn parse_import_path(state: ParserState) -> Result<(String, ParserState), String> {
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
        
        [current_token(state) == OpDot] {
            let mut_path = name;
            [current_token(state) == OpDot] {
                &state = advance(state);
                let tok2 = current_token(state);
                uni tok2(TokenIdentifier(next)) = {
                    &state = advance(state);
                    &mut_path = mut_path + "." + next;
                };
            };
            term Ok((mut_path, state));
        };
        
        term Ok((name, state));
    };
    term Err("Expected import path");
}

// ===== CONSTANT PARSING =====

defn parse_constant(state: ParserState) -> Result<(Constant, ParserState), String> {
    let result = expect_token(state, KeywordConst);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected constant name"); };
    
    let result = expect_token(state, OpColon);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_type(state);
    uni result(Ok(pair)) = {
        let (const_type, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = { term Err(e); };
    
    let result = expect_token(state, OpEq);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_expression(state);
    uni result(Ok(pair)) = {
        let (value, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = { term Err(e); };
    
    let result = expect_token(state, OpSemicolon);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let const_def = Constant {
        name: unwrap_identifier(tok),
        const_type: const_type,
        value: value
    };
    
    term Ok((const_def, state));
}

// ===== STATE DECLARATION PARSING =====

defn parse_state_decl(state: ParserState) -> Result<(StateDecl, ParserState), String> {
    let result = expect_token(state, KeywordLet);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = { &state = advance(state); };
    [!is_identifier(tok)] { term Err("Expected state name"); };
    
    let result = expect_token(state, OpColon);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let result = parse_type(state);
    uni result(Ok(pair)) = {
        let (state_type, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = { term Err(e); };
    
    let initial_value: Option<Expr> = None;
    [current_token(state) == OpEq] {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &initial_value = Some(expr);
            &state = new_state;
        };
        uni result(Err(e)) = { term Err(e); };
    };
    
    let result = expect_token(state, OpSemicolon);
    uni result(Ok(new_state)) = { &state = new_state; };
    uni result(Err(e)) = { term Err(e); };
    
    let decl = StateDecl {
        name: unwrap_identifier(tok),
        state_type: state_type,
        initial_value: initial_value
    };
    
    term Ok((decl, state));
}
