// Parser - Recursive descent parser for Brief
// Tier 4: Parser Components

import token;
import ast;
import std.collections;

// ===== PARSER STATE =====

struct ParserState {
    tokens: List<Token>,
    position: Int,
    current_token: Token
}

// ===== PARSER CONSTRUCTION =====

defn new_parser(tokens: List<Token>) -> ParserState {
    let current = unwrap_or(get(tokens, 0), TokenEof);
    term ParserState {
        tokens: tokens,
        position: 0,
        current_token: current
    };
}

// ===== TOKEN ACCESS =====

defn current_token(state: ParserState) -> Token {
    term state.current_token;
}

defn peek_token(state: ParserState, offset: Int) -> Token {
    let pos = state.position + offset;
    [pos < len(state.tokens)] {
        term state.tokens[pos];
    };
    term TokenEof;
}

defn advance(state: ParserState) -> ParserState {
    let new_pos = state.position + 1;
    [new_pos < len(state.tokens)] {
        let new_current = state.tokens[new_pos];
        term ParserState {
            tokens: state.tokens,
            position: new_pos,
            current_token: new_current
        };
    };
    term ParserState {
        tokens: state.tokens,
        position: new_pos,
        current_token: TokenEof
    };
}

defn expect_token(state: ParserState, expected: Token) -> Result<ParserState, String> {
    [current_token(state) == expected] {
        term Ok(advance(state));
    };
    term Err("Expected " + token_to_string(expected) + " but got " + token_to_string(current_token(state)));
}

defn match_token(state: ParserState, token: Token) -> (Bool, ParserState) {
    [current_token(state) == token] {
        term (true, advance(state));
    };
    term (false, state);
}

// ===== PROGRAM PARSING =====

defn parse_program(state: ParserState) -> Result<Program, String> {
    let items: List<TopLevel> = [];
    
    [current_token(state) != TokenEof] {
        let result = parse_top_level(state);
        uni result(Ok(pair)) = {
            let (item, new_state) = pair;
            &items = append(items, item);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Ok(Program { items: items });
}

defn parse_top_level(state: ParserState) -> Result<(TopLevel, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordLet) = {
        let result = parse_state_decl(state);
        uni result(Ok(pair)) = {
            let (decl, new_state) = pair;
            term Ok((TopState(decl), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordConst) = {
        let result = parse_constant(state);
        uni result(Ok(pair)) = {
            let (c, new_state) = pair;
            term Ok((TopConst(c), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordTxn) = {
        let result = parse_transaction(state);
        uni result(Ok(pair)) = {
            let (t, new_state) = pair;
            term Ok((TopTxn(t), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordRct) = {
        let result = parse_transaction(state);
        uni result(Ok(pair)) = {
            let (t, new_state) = pair;
            term Ok((TopTxn(t), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordDefn) = {
        let result = parse_definition(state);
        uni result(Ok(pair)) = {
            let (d, new_state) = pair;
            term Ok((TopDefn(d), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordSig) = {
        let result = parse_signature(state);
        uni result(Ok(pair)) = {
            let (s, new_state) = pair;
            term Ok((TopSig(s), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordStruct) = {
        let result = parse_struct(state);
        uni result(Ok(pair)) = {
            let (struct_def, new_state) = pair;
            term Ok((TopStruct(struct_def), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordEnum) = {
        let result = parse_enum(state);
        uni result(Ok(pair)) = {
            let (enum_def, new_state) = pair;
            term Ok((TopEnum(enum_def), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordImport) = {
        let result = parse_import(state);
        uni result(Ok(pair)) = {
            let (imp, new_state) = pair;
            term Ok((TopImport(imp), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Err("Unexpected token: " + token_to_string(tok));
}

// ===== TRANSACTION PARSING =====

defn parse_transaction(state: ParserState) -> Result<(Transaction, ParserState), String> {
    let is_async = false;
    let is_reactive = false;
    
    [current_token(state) == KeywordRct] {
        &is_reactive = true;
        &state = advance(state);
    };
    
    [current_token(state) == KeywordAsync] {
        &is_async = true;
        &state = advance(state);
    };
    
    let result = expect_token(state, KeywordTxn);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected transaction name");
    };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_params(state);
    uni result(Ok(pair)) = {
        let (params, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_contract(state);
    uni result(Ok(pair)) = {
        let (contract, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let body: List<Statement> = [];
    [current_token(state) == DelimLBrace] {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            &body = stmts;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpSemicolon] {
        &state = advance(state);
    };
    
    let txn_obj = Transaction {
        name: unwrap_identifier(tok),
        is_async: is_async,
        is_reactive: is_reactive,
        type_params: type_params,
        params: params,
        contract: contract,
        body: body
    };
    
    term Ok((txn_obj, state));
}

// ===== DEFINITION PARSING =====

defn parse_definition(state: ParserState) -> Result<(Definition, ParserState), String> {
    let result = expect_token(state, KeywordDefn);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected function name");
    };
    
    let type_params: List<String> = [];
    [current_token(state) == OpLt] {
        let result = parse_type_params(state);
        uni result(Ok(pair)) = {
            let (params, new_state) = pair;
            &type_params = params;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_params(state);
    uni result(Ok(pair)) = {
        let (params, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let output_type: Option<Type> = None;
    [current_token(state) == OpArrow] {
        &state = advance(state);
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (ty, new_state) = pair;
            &output_type = Some(ty);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = parse_contract(state);
    uni result(Ok(pair)) = {
        let (contract, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let body: List<Statement> = [];
    [current_token(state) == DelimLBrace] {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            &body = stmts;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpSemicolon] {
        &state = advance(state);
    };
    
    let defn_obj = Definition {
        name: unwrap_identifier(tok),
        type_params: type_params,
        params: params,
        output_type: output_type,
        contract: contract,
        body: body
    };
    
    term Ok((defn_obj, state));
}

// ===== CONTRACT PARSING =====

defn parse_contract(state: ParserState) -> Result<(Contract, ParserState), String> {
    let result = expect_token(state, DelimLBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_expression(state);
    uni result(Ok(pair)) = {
        let (pre, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimLBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = parse_expression(state);
    uni result(Ok(pair)) = {
        let (post, new_state) = pair;
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = expect_token(state, DelimRBracket);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let watchdog: Option<Watchdog> = None;
    [current_token(state) == OpQuestion || current_token(state) == OpBang] {
        let is_required = current_token(state) == OpBang;
        &state = advance(state);
        
        let result = expect_token(state, DelimLBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (cond, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        &watchdog = Some(Watchdog {
            condition: cond,
            is_required: is_required
        });
    };
    
    let contract = Contract {
        precondition: pre,
        postcondition: post,
        watchdog: watchdog
    };
    
    term Ok((contract, state));
}

// ===== EXPRESSION PARSING =====

defn parse_or_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_and_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpOr] {
            &ms_state = advance(ms_state);
            let result = parse_or_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("||", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_and_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_equality_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpAnd] {
            &ms_state = advance(ms_state);
            let result = parse_and_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("&&", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_equality_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_comparison_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpEqEq] {
            &ms_state = advance(ms_state);
            let result = parse_comparison_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("==", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpNeq] {
            &ms_state = advance(ms_state);
            let result = parse_comparison_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("!=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_comparison_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_additive_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpLt] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("<", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpGt] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop(">", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpLtEq] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("<=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpGtEq] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop(">=", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_additive_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_multiplicative_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpPlus] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("+", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpMinus] {
            &ms_state = advance(ms_state);
            let result = parse_additive_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("-", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_multiplicative_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let result = parse_unary_expr(state);
    uni result(Ok(pair)) = {
        let (left, new_state) = pair;
        let ms_state: ParserState = new_state;
        let ml: Expr = left;
        
        [current_token(ms_state) == OpStar] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("*", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpSlash] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("/", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        [current_token(ms_state) == OpPercent] {
            &ms_state = advance(ms_state);
            let result = parse_multiplicative_expr(ms_state);
            uni result(Ok(pair)) = {
                let (right, new_state) = pair;
                &ms_state = new_state;
                &ml = make_binop("%", ml, right);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((ml, ms_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_unary_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    [current_token(state) == OpMinus] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("-", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpBang] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("!", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [current_token(state) == OpTilde] {
        &state = advance(state);
        let result = parse_unary_expr(state);
        uni result(Ok(pair)) = {
            let (operand, new_state) = pair;
            term Ok((make_unaryop("~", operand), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term parse_primary_expr(state);
}

defn parse_primary_expr(state: ParserState) -> Result<(Expr, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(TokenInt(n)) = {
        &state = advance(state);
        term Ok((make_int(n), state));
    };
    
    uni tok(TokenFloat(f)) = {
        &state = advance(state);
        term Ok((make_float(f), state));
    };
    
    uni tok(TokenString(s)) = {
        &state = advance(state);
        term Ok((make_string(s), state));
    };
    
    uni tok(TokenChar(c)) = {
        &state = advance(state);
        term Ok((make_char(c), state));
    };
    
    uni tok(KeywordTrue) = {
        &state = advance(state);
        term Ok((make_bool(true), state));
    };
    
    uni tok(KeywordFalse) = {
        &state = advance(state);
        term Ok((make_bool(false), state));
    };
    
    uni tok(TokenIdentifier(_)) = {
        let name = unwrap_identifier(tok);
        &state = advance(state);
        
        [current_token(state) == DelimLParen] {
            &state = advance(state);
            let result = parse_expr_list(state);
            uni result(Ok(pair)) = {
                let (args, new_state) = pair;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            let result = expect_token(state, DelimRParen);
            uni result(Ok(new_state)) = {
                term Ok((make_call(name, args), new_state));
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((make_var(name), state));
    };
    
    uni tok(OpAt) = {
        &state = advance(state);
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
            term Ok((make_prior_state(name), state));
        };
        term Err("Expected identifier after @");
    };
    
    uni tok(DelimLParen) = {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = {
            term Ok((expr, new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(DelimLBracket) = {
        &state = advance(state);
        let result = parse_expr_list(state);
        uni result(Ok(pair)) = {
            let (elements, new_state) = pair;
            term Ok((ExprList(elements), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    term Err("Unexpected token in expression: " + token_to_string(tok));
}

defn parse_expr_list(state: ParserState) -> Result<(List<Expr>, ParserState), String> {
    let elements: List<Expr> = [];
    let state: ParserState = state;
    
    [current_token(state) != DelimRParen && current_token(state) != DelimRBracket] {
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &elements = append(elements, expr);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    term Ok((elements, state));
}

defn parse_expression(state: ParserState) -> Result<(Expr, ParserState), String> {
    term parse_or_expr(state);
}

// ===== STATEMENT PARSING =====

defn parse_statement(state: ParserState) -> Result<(Statement, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordLet) = {
        let result = parse_let(state);
        uni result(Ok(pair)) = {
            let (stmt, new_state) = pair;
            term Ok((stmt, new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [is_identifier(tok) || tok == OpAt] {
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        [current_token(state) == OpEq] {
            &state = advance(state);
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (rhs, new_state) = pair;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            let result = expect_token(state, OpSemicolon);
            uni result(Ok(new_state)) = {
                term Ok((StmtAssign(expr, rhs), new_state));
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
    };
    
    uni tok(KeywordTerm) = {
        &state = advance(state);
        
        let values: List<Option<Expr>> = [];
        [current_token(state) != OpSemicolon] {
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (expr, new_state) = pair;
                &values = append(values, Some(expr));
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
            
            [current_token(state) == OpComma] {
                &state = advance(state);
            };
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtTerm(values), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordEscape) = {
        &state = advance(state);
        
        let value: Option<Expr> = None;
        [current_token(state) != OpSemicolon] {
            let result = parse_expression(state);
            uni result(Ok(pair)) = {
                let (expr, new_state) = pair;
                &value = Some(expr);
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtEscape(value), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(KeywordUnification) = {
        &state = advance(state);
        
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected pattern name after uni");
        };
        
        let result = expect_token(state, DelimLParen);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let pattern_tok = current_token(state);
        uni pattern_tok(TokenIdentifier(pattern)) = {
            &state = advance(state);
        };
        [!is_identifier(pattern_tok)] {
            term Err("Expected pattern in parentheses");
        };
        
        let result = expect_token(state, DelimRParen);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpEq);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtUnification(name, pattern, expr), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni tok(DelimLBracket) = {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (condition, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, DelimRBracket);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let body: List<Statement> = [];
        [current_token(state) == DelimLBrace] {
            let result = parse_block(state);
            uni result(Ok(pair)) = {
                let (stmts, new_state) = pair;
                &body = stmts;
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        [current_token(state) != DelimLBrace] {
            let result = parse_statement(state);
            uni result(Ok(pair)) = {
                let (stmt, new_state) = pair;
                &body = append(body, stmt);
                &state = new_state;
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        
        term Ok((StmtGuarded(condition, body), state));
    };
    
    uni tok(DelimLBrace) = {
        let result = parse_block(state);
        uni result(Ok(pair)) = {
            let (stmts, new_state) = pair;
            term Ok((ExprBlock(stmts), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    [true] {
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = expect_token(state, OpSemicolon);
        uni result(Ok(new_state)) = {
            term Ok((StmtExpr(expr), new_state));
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
}

defn parse_let(state: ParserState) -> Result<(Statement, ParserState), String> {
    let result = expect_token(state, KeywordLet);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let tok = current_token(state);
    uni tok(TokenIdentifier(name)) = {
        &state = advance(state);
    };
    [!is_identifier(tok)] {
        term Err("Expected variable name");
    };
    
    let var_type: Option<Type> = None;
    [current_token(state) == OpColon] {
        &state = advance(state);
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (ty, new_state) = pair;
            &var_type = Some(ty);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let init_value: Option<Expr> = None;
    [current_token(state) == OpEq] {
        &state = advance(state);
        let result = parse_expression(state);
        uni result(Ok(pair)) = {
            let (expr, new_state) = pair;
            &init_value = Some(expr);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = expect_token(state, OpSemicolon);
    uni result(Ok(new_state)) = {
        term Ok((StmtLet(name, var_type, init_value), new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_block(state: ParserState) -> Result<(List<Statement>, ParserState), String> {
    let result = expect_token(state, DelimLBrace);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let stmts: List<Statement> = [];
    [current_token(state) != DelimRBrace] {
        let result = parse_statement(state);
        uni result(Ok(pair)) = {
            let (stmt, new_state) = pair;
            &stmts = append(stmts, stmt);
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    let result = expect_token(state, DelimRBrace);
    uni result(Ok(new_state)) = {
        term Ok((stmts, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

// ===== TYPE PARSING =====

defn parse_type(state: ParserState) -> Result<(Type, ParserState), String> {
    let tok = current_token(state);
    
    uni tok(KeywordInt) = {
        &state = advance(state);
        term Ok((TypeInt, state));
    };
    
    uni tok(KeywordUInt) = {
        &state = advance(state);
        term Ok((TypeUInt, state));
    };
    
    uni tok(KeywordFloat) = {
        &state = advance(state);
        term Ok((TypeFloat, state));
    };
    
    uni tok(KeywordString) = {
        &state = advance(state);
        term Ok((TypeString, state));
    };
    
    uni tok(KeywordBool) = {
        &state = advance(state);
        term Ok((TypeBool, state));
    };
    
    uni tok(KeywordChar) = {
        &state = advance(state);
        term Ok((TypeChar, state));
    };
    
    uni tok(KeywordVoid) = {
        &state = advance(state);
        term Ok((TypeVoid, state));
    };
    
    term Err("Unknown type: " + token_to_string(tok));
}

defn parse_type_params(state: ParserState) -> Result<(List<String>, ParserState), String> {
    let result = expect_token(state, OpLt);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let params: List<String> = [];
    [current_token(state) != OpGt] {
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &params = append(params, name);
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected type parameter name");
        };
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, OpGt);
    uni result(Ok(new_state)) = {
        term Ok((params, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn parse_params(state: ParserState) -> Result<(List<Param>, ParserState), String> {
    let result = expect_token(state, DelimLParen);
    uni result(Ok(new_state)) = {
        &state = new_state;
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let params: List<Param> = [];
    [current_token(state) != DelimRParen] {
        let tok = current_token(state);
        uni tok(TokenIdentifier(name)) = {
            &state = advance(state);
        };
        [!is_identifier(tok)] {
            term Err("Expected parameter name");
        };
        
        let result = expect_token(state, OpColon);
        uni result(Ok(new_state)) = {
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let result = parse_type(state);
        uni result(Ok(pair)) = {
            let (param_type, new_state) = pair;
            &state = new_state;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        
        let param = Param {
            name: name,
            param_type: param_type
        };
        &params = append(params, param);
        
        [current_token(state) == OpComma] {
            &state = advance(state);
        };
    };
    
    let result = expect_token(state, DelimRParen);
    uni result(Ok(new_state)) = {
        term Ok((params, new_state));
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

