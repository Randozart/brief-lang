// AST - Abstract Syntax Tree definitions
// Tier 4: Parser Components

// ===== EXPRESSIONS =====

// Slice coordinate for multidimensional slicing
enum SliceCoordinate {
    SliceIndex(Expr),                    // single index: 5
    SliceRange(Option<Expr>, Option<Expr>),  // range: start..end
    SliceNamed(String, SliceCoordinate)  // named: time:0..10
}

enum Expr {
    // Literals
    ExprInt(Int),
    ExprFloat(Float),
    ExprString(String),
    ExprChar(Char),
    ExprBool(Bool),
    ExprTerm,
    
    // Variables
    ExprVar(String),
    ExprPriorState(String),  // @var
    
    // Binary operations
    ExprBinOp(String, Expr, Expr),  // op, left, right
    
    // Unary operations
    ExprUnaryOp(String, Expr),  // op, operand
    
    // Calls and access
    ExprCall(String, List<Expr>),  // name, args
    ExprFieldAccess(Expr, String),  // object, field
    ExprIndex(Expr, Expr),  // array, index
    ExprSlice(Expr, Option<Expr>, Option<Expr>, Option<Expr>, Option<Expr>),  // arr, start, end, stride, mask
    ExprMultiSlice(Expr, List<SliceCoordinate>, Option<Expr>),  // arr, coords, mask
    
    // Containers
    ExprList(List<Expr>),
    ExprTuple(List<Expr>),
    ExprTupleDestructure(List<String>, Expr),  // (a, b) = source_tuple
    
    // Type operations
    ExprCast(Expr, Type),  // expr, target_type
    
    // Blocks
    ExprBlock(List<Statement>),
    
    // Quantifiers
    ExprForAll(String, Expr),  // var, body
    ExprExists(String, Expr)   // var, body
}

// ===== HASHTAG MODIFIERS =====

obj Hashtag {
    name: String,
    value: Option<String>,
    mandatory: Bool,
    fallback: List<String>,
    scoped: Option<String>
}

// ===== STATEMENTS =====

obj AlkaBlock {
    dangerous: Bool,
    content: String
}

enum Statement {
    // Assignment
    StmtAssign(Expr, Expr, List<Hashtag>),  // lhs, rhs, modifiers
    
    // Let binding
    StmtLet(String, Option<Type>, Option<Expr>, List<Hashtag>, Option<Expr>),  // name, type, init, modifiers, address_expr
    
    // Expression statement
    StmtExpr(Expr),
    
    // Term statement
    StmtTerm(List<Option<Expr>>, List<Hashtag>),  // return values, modifiers
    
    // Local trigger: trg! name: Type = expr;
    StmtLocalTrigger(String, Type, Option<Expr>),  // name, type, expr
    
    // Escape statement
    StmtEscape(Option<Expr>),  // escape value
    
    // Alka escape hatch: alka { ... }; or alka! { ... };
    StmtAlka(AlkaBlock),
    
    // Block pragma: #on_exit { ... };
    StmtOnExit(List<Statement>),  // cleanup body
    
    // Guarded statement
    StmtGuarded(Expr, List<Statement>),  // condition, body
    
    // Unification
    StmtUnification(String, String, Expr),  // name, pattern, expr
    
    // Inline assembly
    StmtAsm(String, List<String>)  // asm code, clobbers
}

// ===== CONTRACTS =====

obj Contract {
    precondition: Expr,
    postcondition: Expr,
    watchdog: Option<Watchdog>
}

obj Watchdog {
    condition: Expr,
    is_required: Bool  // true = !, false = ?
}

// ===== DEFINITIONS =====

obj Definition {
    name: String,
    type_params: List<String>,
    params: List<Param>,
    output_type: Option<Type>,
    contract: Contract,
    body: List<Statement>,
    modifiers: List<Hashtag>
}

obj Transaction {
    name: String,
    is_async: Bool,
    is_reactive: Bool,
    type_params: List<String>,
    params: List<Param>,
    contract: Contract,
    body: List<Statement>,
    modifiers: List<Hashtag>,
    dependencies: List<String>
}

obj Param {
    name: String,
    param_type: Type
}

obj Signature {
    name: String,
    input_type: Type,
    output_type: Type,
    source: Option<String>,
    bound_defn: Option<String>
}

// ===== TYPE DEFINITIONS =====

obj Dimension {
    name: Option<String>,
    size: Int
}

enum Type {
    TypeInt,
    TypeUInt,
    TypeFloat,
    TypeString,
    TypeBool,
    TypeChar,
    TypeData,
    TypeVoid,
    TypeVector(Type, List<Dimension>),
    TypeOption(Type),
    TypeResult(Type, Type),
    TypeList(Type),
    TypeHashMap(Type, Type),
    TypeHashSet(Type),
    TypeStack(Type),
    TypeQueue(Type),
    TypeStringBuilder,
    TypeNamed(String, List<Type>),
    TypeTuple(List<Type>),
    TypeUnion(List<Type>),
    TypeSig(String),
    TypeConstrained(Type, BitRange)
}

obj BitRange {
    start: Int,
    end: Int
}

// ===== STRUCTS AND ENUMS =====

obj StructVariant {
    contract: Contract,
    fields: List<StructField>,
    additions: List<StructField>,
    removals: List<String>
}

obj StructDefinition {
    name: String,
    fields: List<StructField>,
    methods: List<Transaction>,
    modifiers: List<Hashtag>,
    variants: List<StructVariant>
}

obj StructField {
    name: String,
    field_type: Type,
    default_value: Option<Expr>
}

obj RStructDefinition {
    name: String,
    fields: List<StructField>,
    methods: List<Transaction>,
    view: Option<ViewBody>
}

obj EnumDefinition {
    name: String,
    type_params: List<String>,
    variants: List<EnumVariant>
}

enum EnumVariant {
    VariantSimple(String),
    VariantTuple(String, List<Type>),
    VariantStruct(String, List<StructField>)
}

// ===== VIEWS (Rendered Briv) =====

obj ViewBody {
    elements: List<ViewElement>
}

enum ViewElement {
    ViewHtml(String, List<ViewAttr>, List<ViewElement>),  // tag, attrs, children
    ViewComponent(String, List<ViewAttr>, List<ViewElement>),  // component, attrs, children
    ViewText(String),  // text content
    ViewExpr(Expr)  // embedded expression
}

enum ViewAttr {
    AttrNormal(String, String),  // name, value
    AttrBText(String, Expr),  // b-text binding
    AttrBShow(String, Expr),  // b-show binding
    AttrBTrigger(String, String),  // b-trigger binding
    AttrBModel(String, String)  // b-model binding
}

// ===== IMPORTS =====

obj Import {
    path: String,
    items: List<ImportItem>,
    alias: Option<String>
}

enum ImportItem {
    ImportAll,
    ImportNamed(String, Option<String>)  // name, alias
}

// ===== CONSTANTS AND STATE =====

obj Constant {
    name: String,
    const_type: Type,
    value: Expr
}

obj StateDecl {
    name: String,
    state_type: Type,
    initial_value: Option<Expr>
}

obj ForeignBinding {
    name: String,
    sig_type: Type,
    toml_path: Option<String>,
    target: String
}

enum ForeignTarget {
    FgNative,
    FgWasm,
    FgC,
    FgPython,
    FgJs,
    FgSwift,
    FgGo
}

enum FfiKind {
    FfiFrgn,
    FfiFrgnBang,
    FfiSyscall,
    FfiSyscallBang
}

enum ResultType {
    ResVoid,
    ResResult,
    ResOption
}

obj MemoryLayout {
    offset: Int,
    size: Int,
    alignment: Int
}

obj ForeignSignature {
    name: String,
    location: String,
    wasm_impl: Option<String>,
    wasm_setup: Option<String>,
    inputs: List<(String, Type)>,
    success_output: List<(String, Type)>,
    result_type: ResultType,
    error_type_name: String,
    error_fields: List<(String, Type)>,
    input_layout: Option<MemoryLayout>,
    output_layout: Option<MemoryLayout>,
    precondition: Option<String>,
    postcondition: Option<String>,
    buffer_mode: Option<String>,
    ffi_kind: Option<FfiKind>
}

obj FfiState {
    bindings: List<ForeignSignature>,
    wasm_glue: Option<String>,
    profiles: Option<String>
}

// ===== PROGRAM =====

enum StrictMode {
    StrictOff,
    StrictOn
}

enum TopLevel {
    TopDefn(Definition),
    TopTxn(Transaction),
    TopSig(Signature),
    TopStruct(StructDefinition),
    TopRStruct(RStructDefinition),
    TopEnum(EnumDefinition),
    TopImport(Import),
    TopConst(Constant),
    TopState(StateDecl),
    TopRender(String, ViewBody),  // name, body
    TopForeign(ForeignSignature)
}

obj Program {
    items: List<TopLevel>,
    strict_mode: StrictMode
}

// ===== UTILITY FUNCTIONS =====

// Get expression precedence
defn expr_precedence(expr: Expr) -> Int {
    uni expr(ExprBinOp(op, _, _)) = {
        [op == "*"] { term 11; };
        [op == "/"] { term 11; };
        [op == "%"] { term 11; };
        [op == "+"] { term 10; };
        [op == "-"] { term 10; };
        [op == "<"] { term 8; };
        [op == ">"] { term 8; };
        [op == "<="] { term 8; };
        [op == ">="] { term 8; };
        [op == "=="] { term 7; };
        [op == "!="] { term 7; };
        [op == "&&"] { term 5; };
        [op == "||"] { term 4; };
    };
    term 0;
}

// Check if expression is literal
defn is_literal_expr(expr: Expr) -> Bool {
    uni expr(ExprInt(_)) = true;
    uni expr(ExprFloat(_)) = true;
    uni expr(ExprString(_)) = true;
    uni expr(ExprChar(_)) = true;
    uni expr(ExprBool(_)) = true;
    term false;
}

// Get expression type (simple inference)
defn infer_expr_type(expr: Expr) -> Option<Type> {
    uni expr(ExprInt(_)) = Some(TypeInt);
    uni expr(ExprFloat(_)) = Some(TypeFloat);
    uni expr(ExprString(_)) = Some(TypeString);
    uni expr(ExprChar(_)) = Some(TypeChar);
    uni expr(ExprBool(_)) = Some(TypeBool);
    term None;
}

// Create binary expression
defn make_binop(op: String, left: Expr, right: Expr) -> Expr {
    term ExprBinOp(op, left, right);
}

// Create unary expression
defn make_unaryop(op: String, operand: Expr) -> Expr {
    term ExprUnaryOp(op, operand);
}

// Create variable expression
defn make_var(name: String) -> Expr {
    term ExprVar(name);
}

// Create prior state expression
defn make_prior_state(name: String) -> Expr {
    term ExprPriorState(name);
}

// Create call expression
defn make_call(name: String, args: List<Expr>) -> Expr {
    term ExprCall(name, args);
}

// Create integer literal
defn make_int(n: Int) -> Expr {
    term ExprInt(n);
}

// Create float literal
defn make_float(f: Float) -> Expr {
    term ExprFloat(f);
}

// Create bool literal
defn make_bool(b: Bool) -> Expr {
    term ExprBool(b);
}

// Create string literal
defn make_string(s: String) -> Expr {
    term ExprString(s);
}

// Create char literal
defn make_char(c: Char) -> Expr {
    term ExprChar(c);
}
