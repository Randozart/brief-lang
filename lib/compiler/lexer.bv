// Lexer - Tokenizer for Brief language
// Tier 3: Lexer Components

import "std/char";

// ===== LEXER STATE =====

obj LexerState {
    source: String,
    position: Int,
    line: Int,
    column: Int,
    start_pos: Int,  // Start of current token
    start_line: Int,
    start_column: Int
}

// ===== LEXER CONSTRUCTION =====

defn new_lexer(source: String) -> LexerState {
    term LexerState {
        source: source,
        position: 0,
        line: 1,
        column: 1,
        start_pos: 0,
        start_line: 1,
        start_column: 1
    };
}

// ===== CHARACTER ACCESS =====

defn current_char(state: LexerState) -> Option<Char> {
    [len(state.source) > state.position] {
        term Some(state.source[state.position..state.position+1].char_at(0));
    };
    term None;
}

defn peek_char(state: LexerState, offset: Int) -> Option<Char> {
    let pos = state.position + offset;
    [len(state.source) > pos] {
        term Some(state.source[pos..pos+1].char_at(0));
    };
    term None;
}

defn advance(state: LexerState) -> LexerState {
    let c = current_char(state);
    [is_some(c)] {
        let ch = unwrap(c);
        [ch == '\n'] {
            term LexerState {
                source: state.source,
                position: state.position + 1,
                line: state.line + 1,
                column: 1,
                start_pos: state.start_pos,
                start_line: state.start_line,
                start_column: state.start_column
            };
        };
    };
    term LexerState {
        source: state.source,
        position: state.position + 1,
        line: state.line,
        column: state.column + 1,
        start_pos: state.start_pos,
        start_line: state.start_line,
        start_column: state.start_column
    };
}

defn skip_chars(state: LexerState, count: Int) -> LexerState {
    let i: Int = 0;
    [i < count] {
        state = advance(state);
        i = i + 1;
    };
    term state;
}

// ===== TOKEN EXTRACTION =====

defn current_token_text(state: LexerState) -> String {
    term state.source[state.start_pos..state.position];
}

defn start_token(state: LexerState) -> LexerState {
    term LexerState {
        source: state.source,
        position: state.position,
        line: state.line,
        column: state.column,
        start_pos: state.position,
        start_line: state.line,
        start_column: state.column
    };
}

// ===== LEXING FUNCTIONS =====

// Skip whitespace
defn skip_whitespace(state: LexerState) -> LexerState {
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [is_whitespace(c)] {
            state = advance(state);
            term skip_whitespace(state);
        };
    };
    term state;
}

// Skip comment
defn skip_comment(state: LexerState) -> LexerState {
    // Assume // comment
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [c != '\n'] {
            state = advance(state);
            term skip_comment(state);
        };
    };
    term state;
}

// Read identifier or keyword
defn read_identifier(state: LexerState) -> (Token, LexerState) {
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [is_alphanumeric(c) || c == '_'] {
            state = advance(state);
            let (tok, state) = read_identifier(state);
            term (tok, state);
        };
    };
    
    // End of identifier - check if keyword
    let text = current_token_text(state);
    
    // Check keywords
    [text == "let"] { term (KeywordLet, state); };
    [text == "const"] { term (KeywordConst, state); };
    [text == "txn"] { term (KeywordTxn, state); };
        [text == "node"] { term (KeywordNode, state); };
    [text == "async"] { term (KeywordAsync, state); };
    [text == "term"] { term (KeywordTerm, state); };
    [text == "escape"] { term (KeywordEscape, state); };
    [text == "defn"] { term (KeywordDefn, state); };
    [text == "sig"] { term (KeywordSig, state); };
    [text == "frgn"] { term (KeywordFrgn, state); };
    [text == "obj"] { term (KeywordStruct, state); };
    [text == "enum"] { term (KeywordEnum, state); };
    [text == "data"] { term (KeywordData, state); };
    [text == "import"] { term (KeywordImport, state); };
    [text == "from"] { term (KeywordFrom, state); };
    [text == "as"] { term (KeywordAs, state); };
    [text == "true"] { term (KeywordTrue, state); };
    [text == "false"] { term (KeywordFalse, state); };
    [text == "trg"] { term (KeywordTrg, state); };
    [text == "trigger"] { term (KeywordTrg, state); };
    [text == "TRG"] { term (KeywordTrg, state); };
    [text == "TRIGGER"] { term (KeywordTrg, state); };
    [text == "rstruct"] { term (KeywordRstruct, state); };
    [text == "render"] { term (KeywordRender, state); };
    
    // Not a keyword - it's an identifier
    term (TokenIdentifier(text), state);
}

// Read number (int or float)
defn read_number(state: LexerState) -> (Token, LexerState) {
    // Check for hex
    [is_some(current_char(state)) && unwrap(current_char(state)) == '0'] {
        [is_some(peek_char(state, 1))] {
            let next = unwrap(peek_char(state, 1));
            [next == 'x' || next == 'X'] {
                state = advance(state);  // consume 0
                state = advance(state);  // consume x/X
                let (tok, state) = read_hex_number(state);
                term (tok, state);
            };
        };
    };
    
    // Read decimal
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [is_digit(c)] {
            state = advance(state);
            let (tok, state) = read_number(state);
            term (tok, state);
        };
        [c == '.'] {
            // Float
            [is_some(peek_char(state, 1))] {
                let next = unwrap(peek_char(state, 1));
                [is_digit(next)] {
                    state = advance(state);  // consume .
                    let (tok, state) = read_float_fraction(state);
                    term (tok, state);
                };
            };
        };
    };
    
    // End of number
    let text = current_token_text(state);
    term (TokenInt(to_int(text)), state);
}

defn read_hex_number(state: LexerState) -> (Token, LexerState) {
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [is_hex_digit(c)] {
            state = advance(state);
            let (tok, state) = read_hex_number(state);
            term (tok, state);
        };
    };
    
    let text = current_token_text(state);
    term (TokenInt(to_int(text)), state);
}

defn read_float_fraction(state: LexerState) -> (Token, LexerState) {
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [is_digit(c)] {
            state = advance(state);
            let (tok, state) = read_float_fraction(state);
            term (tok, state);
        };
    };
    
    let text = current_token_text(state);
    term (TokenFloat(to_float(text)), state);
}

// Read string literal
defn read_string(state: LexerState) -> (Token, LexerState) {
    // Skip opening quote
    state = advance(state);
    
    let sb = new_builder();
    
    [is_some(current_char(state))] {
        let c = unwrap(current_char(state));
        [c != '"'] {
            [c == '\\'] {
                // Escape sequence
                state = advance(state);
                [is_some(current_char(state))] {
                    let escaped = unwrap(current_char(state));
                    [escaped == 'n'] { sb = append_char(sb, '\n'); };
                    [escaped == 't'] { sb = append_char(sb, '\t'); };
                    [escaped == 'r'] { sb = append_char(sb, '\r'); };
                    [escaped == '\\'] { sb = append_char(sb, '\\'); };
                    [escaped == '"'] { sb = append_char(sb, '"'); };
                    state = advance(state);
                };
            };
            [c != '\\'] {
                sb = append_char(sb, c);
                state = advance(state);
            };
        };
    };
    
    // Skip closing quote
    [is_some(current_char(state)) && unwrap(current_char(state)) == '"'] {
        state = advance(state);
    };
    
    term (TokenString(to_string(sb)), state);
}

// Read char literal
defn read_char_literal(state: LexerState) -> (Token, LexerState) {
    // Skip opening quote
    state = advance(state);
    
    let c: Char = ' ';
    
    [is_some(current_char(state))] {
        let ch = unwrap(current_char(state));
        [ch != '\''] {
            [ch == '\\'] {
                // Escape sequence
                state = advance(state);
                [is_some(current_char(state))] {
                    let escaped = unwrap(current_char(state));
                    [escaped == 'n'] { c = '\n'; };
                    [escaped == 't'] { c = '\t'; };
                    [escaped == 'r'] { c = '\r'; };
                    [escaped == '\\'] { c = '\\'; };
                    [escaped == '\''] { c = '\''; };
                    state = advance(state);
                };
            };
            [ch != '\\'] {
                c = ch;
                state = advance(state);
            };
        };
    };
    
    // Skip closing quote
    [is_some(current_char(state)) && unwrap(current_char(state)) == '\''] {
        state = advance(state);
    };
    
    term (TokenChar(c), state);
}

// ===== MAIN LEXER FUNCTION =====

defn next_token(state: LexerState) -> Result<(Token, LexerState), String> {
    // Skip whitespace
    state = skip_whitespace(state);
    
    // Check for EOF
    [is_none(current_char(state))] {
        term Ok((TokenEof, state));
    };
    
    // Start new token
    state = start_token(state);
    
    let c = unwrap(current_char(state));
    
    // Single-char operators
    [c == '+'] { state = advance(state); term Ok((OpPlus, state)); };
    [c == '-'] { state = advance(state); term Ok((OpMinus, state)); };
    [c == '*'] { state = advance(state); term Ok((OpStar, state)); };
    [c == '/'] {
        // Check for comment
        [is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '/'] {
            state = advance(state);
            state = advance(state);
            state = skip_comment(state);
            term next_token(state);  // Recurse to get next token
        };
        state = advance(state);
        term Ok((OpSlash, state));
    };
    [c == '%'] { state = advance(state); term Ok((OpPercent, state)); };
    [c == '='] { state = advance(state); term Ok((OpEq, state)); };
    [c == '!'] { state = advance(state); term Ok((OpBang, state)); };
    [c == '&'] { state = advance(state); term Ok((OpAmp, state)); };
    [c == '|'] { state = advance(state); term Ok((OpPipe, state)); };
    [c == '^'] { state = advance(state); term Ok((OpCaret, state)); };
    [c == '~'] { state = advance(state); term Ok((OpTilde, state)); };
    [c == '?'] { state = advance(state); term Ok((OpQuestion, state)); };
    [c == '#'] {
        [is_some(peek_char(state, 1))] {
            let next = unwrap(peek_char(state, 1));
            [next == '!'] {
                state = advance(state);
                state = advance(state);
                term Ok((HashBang, state));
            };
            [next == '['] {
                state = advance(state);
                state = advance(state);
                term Ok((HashBracket, state));
            };
            [next == '('] {
                state = advance(state);
                state = advance(state);
                term Ok((HashParen, state));
            };
            [next == '?'] {
                state = advance(state);
                state = advance(state);
                term Ok((HashQuestion, state));
            };
            [is_alpha(next) || next == '_'] {
                state = advance(state);
                term Ok((Hash, state));
            };
        };
        state = advance(state);
        term Ok((TokenComment("#"), state));
    };
    [c == '@'] { state = advance(state); term Ok((OpAt, state)); };
    [c == '.'] { state = advance(state); term Ok((OpDot, state)); };
    [c == ':'] { state = advance(state); term Ok((OpColon, state)); };
    [c == ';'] { state = advance(state); term Ok((OpSemicolon, state)); };
    [c == ','] { state = advance(state); term Ok((OpComma, state)); };
    
    // Delimiters
    [c == '('] { state = advance(state); term Ok((DelimLParen, state)); };
    [c == ')'] { state = advance(state); term Ok((DelimRParen, state)); };
    [c == '{'] { state = advance(state); term Ok((DelimLBrace, state)); };
    [c == '}'] { state = advance(state); term Ok((DelimRBrace, state)); };
    [c == '['] { state = advance(state); term Ok((DelimLBracket, state)); };
    [c == ']'] { state = advance(state); term Ok((DelimRBracket, state)); };
    
    // Multi-char operators (check first)
    [c == '<'] {
        [is_some(peek_char(state, 1))] {
            let next = unwrap(peek_char(state, 1));
            [next == '='] {
                state = advance(state);
                state = advance(state);
                term Ok((OpLtEq, state));
            };
            [next == '<'] {
                state = advance(state);
                state = advance(state);
                term Ok((OpLtLt, state));
            };
            [next == '-'] {
                state = advance(state);
                state = advance(state);
                term Ok((OpArrow, state));
            };
        };
        state = advance(state);
        term Ok((OpLt, state));
    };
    
    [c == '>'] {
        [is_some(peek_char(state, 1))] {
            let next = unwrap(peek_char(state, 1));
            [next == '='] {
                state = advance(state);
                state = advance(state);
                term Ok((OpGtEq, state));
            };
            [next == '>'] {
                state = advance(state);
                state = advance(state);
                term Ok((OpGtGt, state));
            };
            [next == '='] {
                state = advance(state);
                state = advance(state);
                term Ok((OpFatArrow, state));
            };
        };
        state = advance(state);
        term Ok((OpGt, state));
    };
    
    [c == '|'] {
        [is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '|'] {
            state = advance(state);
            state = advance(state);
            term Ok((OpOr, state));
        };
    };
    
    [c == '&'] {
        [is_some(peek_char(state, 1)) && unwrap(peek_char(state, 1)) == '&'] {
            state = advance(state);
            state = advance(state);
            term Ok((OpAnd, state));
        };
    };
    
    // Literals
    [is_digit(c)] {
        let (tok, state) = read_number(state);
        term Ok((tok, state));
    };
    
    [is_alpha(c) || c == '_'] {
        let (tok, state) = read_identifier(state);
        term Ok((tok, state));
    };
    
    [c == '"'] {
        let (tok, state) = read_string(state);
        term Ok((tok, state));
    };
    
    [c == '\''] {
        let (tok, state) = read_char_literal(state);
        term Ok((tok, state));
    };
    
    // Unknown character
    term Err("Unexpected character: " + char_to_string(c));
}

// ===== FULL TOKENIZATION =====

defn tokenize(source: String) -> Result<List<Token>, String> {
    let tokens: List<Token> = [];
    let state = new_lexer(source);
    
    [true] {
        let result = next_token(state);
        [is_ok(result)] {
            let (tok, new_state) = unwrap(result);
            &tokens <- tok;
            state = new_state;
            [tok != TokenEof] {
                term tokenize_continue(source, tokens, state);
            };
        };
        [is_err(result)] {
            term Err(unwrap_err(result));
        };
    };
    
    term Ok(tokens);
}

defn tokenize_continue(source: String, tokens: List<Token>, state: LexerState) -> Result<List<Token>, String> {
    let result = next_token(state);
    [is_ok(result)] {
        let (tok, new_state) = unwrap(result);
        &tokens <- tok;
        [tok != TokenEof] {
            term tokenize_continue(source, tokens, new_state);
        };
    };
    [is_err(result)] {
        term Err(unwrap_err(result));
    };
    term Ok(tokens);
}
