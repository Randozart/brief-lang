// needs_state.bv — the first compiler pass written in Brief.
// 2026-08-04 (plan 2026-08-04-compiler-in-brief-dogfood-ffi): the compiler
// dogfoods its own GLUE FFI. This pass reads the tagged projection produced by
// src/analysis/needs_state_projection.rs and computes, per exported defn,
// whether it carries `ptr %state` — exactly the analysis in
// src/analysis/export_abi.rs — then returns a needs_state bitmask (bit i =
// export[i] needs state). The compiler links this .a natively (build.rs) and
// calls it through the C ABI, the same way any host language calls Brief.
//
// Projection format (see needs_state_projection.rs):
//   ns 1
//   state <n> <names...>
//   regular <n> <names...>
//   txn <n> <names...>
//   intrinsic <n> <names...>
//   export <n> <names...>
//   body <name> <count> <token...>      # token = kind:name, flat preorder
//
// Node kinds (mirror export_abi.rs EXACTLY):
//   stmts: t term, b termbang, e escape, x expression, l let, a assign,
//          g guarded, i if, f foreach, c block (walked)
//          m metadata (false), o any other (TRUE — conservative)
//   exprs: D field (TRUE), C call, B binary, U unary, L list, I identifier,
//          _ other (false)
//
// 2026-08-04 (rewrite): the pass is PURE string scanning. `when` is an if
// guard (not a while loop) in both the interpreter and the LLVM backend, so
// all iteration is RECURSION. String concat (`+`) codegens a register
// collision (see BUGS.md) and List<String> element reads return the generic
// `T`, so no collection is built — sections are located by re-scanning the
// projection string with `:` slices and `==`.

import "glue/c.bv";

// ── char / line primitives ──────────────────────────────────────────────

defn line_end(proj: String, i: Int, n: Int) -> Int {
    when i >= n { term i; };
    when proj[i:i+1] == "\n" { term i; };
    term line_end(proj, i + 1, n);
};

// ── token extraction ────────────────────────────────────────────────────
// token_at(line, idx): the idx-th space-separated token (0-based); "" if the
// line has fewer than idx+1 tokens. The projection uses single spaces.
defn token_at(line: String, idx: Int) -> String {
    let n: Int = line .^Len;
    term token_at_scan(line, 0, n, idx, 0, 0);
};
defn token_at_scan(line: String, i: Int, n: Int, idx: Int, cur: Int, start: Int) -> String {
    when cur == idx {
        when i >= n { term line[start:n]; };
        when line[i:i+1] == " " { term line[start:i]; };
        term token_at_scan(line, i + 1, n, idx, cur, start);
    };
    when i >= n { term ""; };
    when line[i:i+1] == " " { term token_at_scan(line, i + 1, n, idx, cur + 1, i + 1); };
    term token_at_scan(line, i + 1, n, idx, cur, start);
};

// has_token(line, name): is `name` one of the line's tokens?
defn has_token(line: String, name: String) -> Bool {
    term has_token_scan(line, 0, line .^Len, name, 0);
};
defn has_token_scan(line: String, i: Int, n: Int, name: String, start: Int) -> Bool {
    when i >= n { term line[start:n] == name; };
    when line[i:i+1] == " " {
        when line[start:i] == name { term true; };
        term has_token_scan(line, i + 1, n, name, i + 1);
    };
    term has_token_scan(line, i + 1, n, name, start);
};

// ── section lookup ──────────────────────────────────────────────────────
// in_section(proj, key, name): is `name` listed in the `key` section line?
defn in_section(proj: String, key: String, name: String) -> Bool {
    term scan_sections(proj, 0, proj .^Len, key, name);
};
defn scan_sections(proj: String, i: Int, n: Int, key: String, name: String) -> Bool {
    when i >= n { term false; };
    when i == 0 && line_has_key(proj, 0, n, key) { term line_has_name(proj, 0, n, key, name); };
    when proj[i:i+1] == "\n" && line_has_key(proj, i + 1, n, key) { term line_has_name(proj, i + 1, n, key, name); };
    term scan_sections(proj, i + 1, n, key, name);
};
defn line_has_key(proj: String, ls: Int, n: Int, key: String) -> Bool {
    let le: Int = line_end(proj, ls, n);
    let line: String = proj[ls:le];
    let klen: Int = key .^Len;
    when line .^Len >= klen + 1 && line[0:klen] == key && line[klen:klen+1] == " " { term true; };
    term false;
};
defn line_has_name(proj: String, ls: Int, n: Int, key: String, name: String) -> Bool {
    let le: Int = line_end(proj, ls, n);
    let line: String = proj[ls:le];
    let klen: Int = key .^Len;
    let rest: String = line[klen+1:line .^Len];
    term has_token(rest, name);
};

// section_line(proj, key): the text of the `key` section line ("" if absent).
defn section_line(proj: String, key: String) -> String {
    term find_section(proj, 0, proj .^Len, key);
};
defn find_section(proj: String, i: Int, n: Int, key: String) -> String {
    when i >= n { term ""; };
    when i == 0 && line_has_key(proj, 0, n, key) { term line_text(proj, 0, n); };
    when proj[i:i+1] == "\n" && line_has_key(proj, i + 1, n, key) { term line_text(proj, i + 1, n); };
    term find_section(proj, i + 1, n, key);
};
defn line_text(proj: String, ls: Int, n: Int) -> String {
    let le: Int = line_end(proj, ls, n);
    term proj[ls:le];
};

// ── token name after ':' ────────────────────────────────────────────────
defn token_name(tok: String) -> String {
    term tok_after_colon(tok, 0, tok .^Len);
};
defn tok_after_colon(tok: String, i: Int, n: Int) -> String {
    when i >= n { term ""; };
    when tok[i:i+1] == ":" { term tok[i+1:n]; };
    term tok_after_colon(tok, i + 1, n);
};

// ── the needs_state walk ───────────────────────────────────────────────
// body_needs(proj, name, depth) → 0/1: does the export's body reference
// state/regular/txn/intrinsic (directly) or another export (transitively)?
// depth is the recursion guard (a cycle → conservative 1, like export_abi.rs).
defn export_needs(proj: String, name: String, depth: Int) -> Int {
    when depth > 64 { term 1; };
    term scan_bodies(proj, 0, proj .^Len, name, depth);
};
defn scan_bodies(proj: String, i: Int, n: Int, name: String, depth: Int) -> Int {
    when i >= n { term 0; };
    when i == 0 && body_matches(proj, 0, n, name) { term body_needs(proj, 0, n, name, depth); };
    when proj[i:i+1] == "\n" && body_matches(proj, i + 1, n, name) { term body_needs(proj, i + 1, n, name, depth); };
    term scan_bodies(proj, i + 1, n, name, depth);
};
defn body_matches(proj: String, ls: Int, n: Int, name: String) -> Bool {
    let le: Int = line_end(proj, ls, n);
    let line: String = proj[ls:le];
    let t0: String = token_at(line, 0);
    let t1: String = token_at(line, 1);
    when t0 == "body" && t1 == name { term true; };
    term false;
};
// Walk the body line's tokens (indices 2..) of `line`.
defn body_needs(proj: String, ls: Int, n: Int, name: String, depth: Int) -> Int {
    let le: Int = line_end(proj, ls, n);
    let line: String = proj[ls:le];
    term walk_body_tokens(line, 2, proj, depth);
};
defn walk_body_tokens(line: String, idx: Int, proj: String, depth: Int) -> Int {
    let tok: String = token_at(line, idx);
    when tok .^Len == 0 { term 0; };
    let kind: String = tok[0:1];
    let nm: String = token_name(tok);
    let mine: Int = 0;
    when kind == "o" || kind == "D" { mine = 1; };
    when kind == "I" && in_section(proj, "state", nm) { mine = 1; };
    when kind == "C" && (in_section(proj, "intrinsic", nm) || in_section(proj, "regular", nm) || in_section(proj, "txn", nm)) {
        mine = 1;
    };
    when kind == "C" && in_section(proj, "export", nm) {
        let sub: Int = export_needs(proj, nm, depth + 1);
        when sub == 1 { mine = 1; };
    };
    when mine == 1 { term 1; };
    term walk_body_tokens(line, idx + 1, proj, depth);
};

// ── the export: compute the bitmask ────────────────────────────────────
export defn needs_state_compute(proj: CStr) -> Int {
    let text: String = proj;
    let el: String = section_line(text, "export");
    term compute_mask(text, el, 0, 0);
};
defn compute_mask(text: String, el: String, i: Int, mask: Int) -> Int {
    let name: String = token_at(el, i + 2);
    when name .^Len == 0 { term mask; };
    let needs: Int = export_needs(text, name, 0);
    let bit: Int = 1 << i;
    let m2: Int = mask;
    when needs == 1 { m2 = mask | bit; };
    term compute_mask(text, el, i + 1, m2);
};
