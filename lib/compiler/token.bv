// Token - Lexer token type definition
// Tier 3: Lexer Components

// ===== TOKEN ENUM =====

enum Token {
    // Literals
    TokenInt(Int),
    TokenFloat(Float),
    TokenString(String),
    TokenChar(Char),
    
    // Keywords (grouped by category)
    
    // State and constants
    KeywordLet,
    KeywordConst,
    KeywordState,
    
    // Transactions
    KeywordTxn,
    KeywordRct,
    KeywordAsync,
    KeywordTerm,
    KeywordEscape,
    
    // Functions
    KeywordDefn,
    KeywordSig,
    KeywordSign,
    KeywordSignature,
    
    // FFI
    KeywordFrgn,
    KeywordSyscall,
    KeywordResource,
    KeywordRsrc,
    
    // Types
    KeywordStruct,
    KeywordRstruct,
    KeywordEnum,
    KeywordType,
    KeywordData,
    KeywordData,
    
    // Control
    KeywordImport,
    KeywordFrom,
    KeywordAs,
    KeywordForall,
    KeywordExists,
    KeywordWithin,
    KeywordUnification,
    
    // Hardware
    KeywordTrg,
    KeywordLink,
    KeywordBank,
    
    // Assembly
    KeywordAsm,
    KeywordStage,
    KeywordOn,
    
    // Rendered Brief
    KeywordRender,
    
    // Boolean literals
    KeywordTrue,
    KeywordFalse,
    
    // Result types
    KeywordOk,
    KeywordErr,
    
    // Operators (single char)
    OpPlus,          // +
    OpMinus,         // -
    OpStar,          // *
    OpSlash,         // /
    OpPercent,       // %
    OpEq,            // =
    OpBang,          // !
    OpAmp,           // &
    OpPipe,          // |
    OpCaret,         // ^
    OpTilde,         // ~
    OpQuestion,      // ?
    OpAt,            // @
    OpDot,           // .
    OpColon,         // :
    OpSemicolon,     // ;
    OpComma,         // ,
    
    // Operators (multi-char)
    OpEqEq,          // ==
    OpNeq,           // !=
    OpLt,            // <
    OpGt,            // >
    OpLtEq,          // <=
    OpGtEq,          // >=
    OpAnd,           // &&
    OpOr,            // ||
    OpAmpAmp,        // && (alias)
    OpPipePipe,      // || (alias)
    OpLtLt,          // <<
    OpGtGt,          // >>
    OpArrow,         // ->
    OpFatArrow,      // =>
    OpSlashSlash,    // //
    OpDotDot,        // ..
    OpDotDotEq,      // ..=
    OpPlusEq,        // +=
    OpMinusEq,       // -=
    OpStarEq,        // *=
    OpSlashEq,       // /=
    OpPercentEq,     // %=
    OpAmpEq,         // &=
    OpPipeEq,        // |=
    OpCaretEq,       // ^=
    OpLtLtEq,        // <<=
    OpGtGtEq,        // >>=
    
    // Delimiters
    DelimLParen,     // (
    DelimRParen,     // )
    DelimLBrace,     // {
    DelimRBrace,     // }
    DelimLBracket,   // [
    DelimRBracket,   // ]
    
    // Hashtag modifiers
    Hash,            // # (block pragma prefix)
    HashBang,        // #!
    HashBracket,     // #[
    HashParen,       // #(
    HashQuestion,    // #?
    
    // Special
    TokenIdentifier(String),
    TokenComment(String),
    TokenWhitespace(String),
    TokenNewline,
    TokenEof,
    TokenError(String)
}

// ===== TOKEN UTILITIES =====

// Check if token is a keyword
defn is_keyword(tok: Token) -> Bool {
    uni tok(KeywordLet) = true;
    uni tok(KeywordConst) = true;
    uni tok(KeywordTxn) = true;
    uni tok(KeywordRct) = true;
    uni tok(KeywordAsync) = true;
    uni tok(KeywordDefn) = true;
    uni tok(KeywordSig) = true;
    uni tok(KeywordFrgn) = true;
    uni tok(KeywordStruct) = true;
    uni tok(KeywordEnum) = true;
    uni tok(KeywordImport) = true;
    uni tok(KeywordTrue) = true;
    uni tok(KeywordFalse) = true;
    uni tok(KeywordUnification) = true;
    term false;
};

// Get keyword as string
defn keyword_to_string(tok: Token) -> String {
    uni tok(KeywordLet) = "let";
    uni tok(KeywordConst) = "const";
    uni tok(KeywordTxn) = "txn";
    uni tok(KeywordRct) = "rct";
    uni tok(KeywordAsync) = "async";
    uni tok(KeywordTerm) = "term";
    uni tok(KeywordEscape) = "escape";
    uni tok(KeywordDefn) = "defn";
    uni tok(KeywordSig) = "sig";
    uni tok(KeywordFrgn) = "frgn";
    uni tok(KeywordSyscall) = "syscall";
    uni tok(KeywordStruct) = "struct";
    uni tok(KeywordRstruct) = "rstruct";
    uni tok(KeywordEnum) = "enum";
    uni tok(KeywordType) = "type";
    uni tok(KeywordData) = "data";
    uni tok(KeywordImport) = "import";
    uni tok(KeywordFrom) = "from";
    uni tok(KeywordAs) = "as";
    uni tok(KeywordTrue) = "true";
    uni tok(KeywordFalse) = "false";
    uni tok(KeywordUnification) = "unification";
    term "";
};

// Check if token is an operator
defn is_operator(tok: Token) -> Bool {
    uni tok(OpPlus) = true;
    uni tok(OpMinus) = true;
    uni tok(OpStar) = true;
    uni tok(OpSlash) = true;
    uni tok(OpEqEq) = true;
    uni tok(OpNeq) = true;
    uni tok(OpLt) = true;
    uni tok(OpGt) = true;
    // ... etc
    term false;
};

// Get operator precedence (higher = binds tighter)
defn operator_precedence(tok: Token) -> Int {
    // Multiplication/division (highest)
    uni tok(OpStar) = 11;
    uni tok(OpSlash) = 11;
    uni tok(OpPercent) = 11;
    
    // Addition/subtraction
    uni tok(OpPlus) = 10;
    uni tok(OpMinus) = 10;
    
    // Comparisons
    uni tok(OpLt) = 8;
    uni tok(OpGt) = 8;
    uni tok(OpLtEq) = 8;
    uni tok(OpGtEq) = 8;
    
    // Equality
    uni tok(OpEqEq) = 7;
    uni tok(OpNeq) = 7;
    
    // Logical AND
    uni tok(OpAnd) = 5;
    
    // Logical OR
    uni tok(OpOr) = 4;
    
    // Assignment (lowest)
    uni tok(OpEq) = 1;
    
    term 0;
};

// Check if operator is right-associative
defn is_right_associative(tok: Token) -> Bool {
    uni tok(OpEq) = true;
    uni tok(OpPlusEq) = true;
    uni tok(OpMinusEq) = true;
    term false;
};

// Token equality
defn token_eq(a: Token, b: Token) -> Bool {
    // Compare variants
    term false;  // Placeholder - needs pattern matching on both
};

// Token to string (for error messages)
defn token_to_string(tok: Token) -> String {
    let sb = new_builder();
    
    uni tok(TokenInt(n)) = {
        sb = append_str(sb, "Int(");
        sb = append_int(sb, n);
        sb = append_char(sb, ')');
    };
    
    uni tok(TokenFloat(f)) = {
        sb = append_str(sb, "Float(");
        // Float to string would go here
        sb = append_char(sb, ')');
    };
    
    uni tok(TokenString(s)) = {
        sb = append_str(sb, "String(\"");
        sb = append_str(sb, s);
        sb = append_str(sb, "\")");
    };
    
    uni tok(TokenChar(c)) = {
        sb = append_str(sb, "Char('");
        sb = append_char(sb, c);
        sb = append_str(sb, "')");
    };
    
    uni tok(TokenIdentifier(name)) = {
        sb = append_str(sb, "Identifier(");
        sb = append_str(sb, name);
        sb = append_char(sb, ')');
    };
    
    uni tok(TokenEof) = {
        sb = append_str(sb, "Eof");
    };
    
    uni tok(TokenError(msg)) = {
        sb = append_str(sb, "Error(");
        sb = append_str(sb, msg);
        sb = append_char(sb, ')');
    };
    
    // Keywords
    [is_keyword(tok)] {
        sb = append_str(sb, "Keyword(");
        sb = append_str(sb, keyword_to_string(tok));
        sb = append_char(sb, ')');
    };
    
    term to_string(sb);
};

// Check if token is a literal
defn is_literal(tok: Token) -> Bool {
    uni tok(TokenInt(_)) = true;
    uni tok(TokenFloat(_)) = true;
    uni tok(TokenString(_)) = true;
    uni tok(TokenChar(_)) = true;
    uni tok(KeywordTrue) = true;
    uni tok(KeywordFalse) = true;
    term false;
};

// Get literal value as string
defn literal_to_string(tok: Token) -> String {
    uni tok(TokenInt(n)) = String(n);
    uni tok(TokenFloat(f)) = String(f);
    uni tok(TokenString(s)) = s;
    uni tok(TokenChar(c)) = char_to_string(c);
    uni tok(KeywordTrue) = "true";
    uni tok(KeywordFalse) = "false";
    term "";
};

defn unwrap_identifier(tok: Token) -> String {
    uni tok(TokenIdentifier(name)) = name;
    term "";
};

defn is_identifier(tok: Token) -> Bool {
    uni tok(TokenIdentifier(_)) = true;
    term false;
};

defn is_string_token(tok: Token) -> Bool {
    uni tok(TokenString(_)) = true;
    term false;
};

defn unwrap_string(tok: Token) -> String {
    uni tok(TokenString(s)) = s;
    term "";
};
