// Type Checker - Type inference and verification
// Tier 5: Type Checker

// ===== TYPE CONTEXT =====

struct TypeContext {
    scopes: Stack<HashMap<String, Type>>,
    functions: HashMap<String, Definition>,
    transactions: HashMap<String, Transaction>,
    structs: HashMap<String, StructDefinition>,
    enums: HashMap<String, EnumDefinition>,
    type_aliases: HashMap<String, Type>,
    current_scope: Int
}

// ===== CONTEXT OPERATIONS =====

defn new_context() -> TypeContext {
    let ctx = TypeContext {
        scopes: new_stack(),
        functions: new_map(),
        transactions: new_map(),
        structs: new_map(),
        enums: new_map(),
        type_aliases: new_map(),
        current_scope: 0
    };
    let ctx = enter_scope(ctx);
    term ctx;
}

defn enter_scope(ctx: TypeContext) -> TypeContext {
    let scopes = ctx.scopes;
    let scopes = push(scopes, new_map());
    term TypeContext {
        scopes: scopes,
        functions: ctx.functions,
        transactions: ctx.transactions,
        structs: ctx.structs,
        enums: ctx.enums,
        type_aliases: ctx.type_aliases,
        current_scope: ctx.current_scope + 1
    };
}

defn exit_scope(ctx: TypeContext) -> TypeContext {
    let (popped, scopes) = unwrap(pop(ctx.scopes));
    term TypeContext {
        scopes: scopes,
        functions: ctx.functions,
        transactions: ctx.transactions,
        structs: ctx.structs,
        enums: ctx.enums,
        type_aliases: ctx.type_aliases,
        current_scope: ctx.current_scope - 1
    };
}

defn add_binding(ctx: TypeContext, name: String, ty: Type) -> Result<TypeContext, String> {
    let scopes = ctx.scopes;
    [!is_empty(scopes)] {
        let (current, rest) = unwrap(pop(scopes));
        let current = insert(current, name, ty);
        let scopes = push(rest, current);
        term Ok(TypeContext {
            scopes: scopes,
            functions: ctx.functions,
            transactions: ctx.transactions,
            structs: ctx.structs,
            enums: ctx.enums,
            type_aliases: ctx.type_aliases,
            current_scope: ctx.current_scope
        });
    };
    term Err("No active scope");
}

defn lookup_type(ctx: TypeContext, name: String) -> Option<Type> {
    let scopes = ctx.scopes;
    let i: Int = 0;
    [i < len(scopes)] {
        let scope = scopes[i];
        [contains_key(scope, name)] {
            term get(scope, name);
        };
        &i = i + 1;
    };
    term None;
}

defn add_function(ctx: TypeContext, d: Definition) -> TypeContext {
    let functions = ctx.functions;
    let functions = insert(functions, d.name, d);
    term TypeContext {
        scopes: ctx.scopes,
        functions: functions,
        transactions: ctx.transactions,
        structs: ctx.structs,
        enums: ctx.enums,
        type_aliases: ctx.type_aliases,
        current_scope: ctx.current_scope
    };
}

defn add_transaction(ctx: TypeContext, t: Transaction) -> TypeContext {
    let transactions = ctx.transactions;
    let transactions = insert(transactions, t.name, t);
    term TypeContext {
        scopes: ctx.scopes,
        functions: ctx.functions,
        transactions: transactions,
        structs: ctx.structs,
        enums: ctx.enums,
        type_aliases: ctx.type_aliases,
        current_scope: ctx.current_scope
    };
}

// ===== SUBSTITUTION (for uni) =====

struct Substitution {
    bindings: HashMap<String, Type>
}

defn empty_subst() -> Substitution {
    term Substitution {
        bindings: new_map()
    };
}

defn apply_subst(ty: Type, subst: Substitution) -> Type {
    uni ty(TypeNamed(name, args)) = {
        [contains_key(subst.bindings, name)] {
            let bound = unwrap(get(subst.bindings, name));
            term apply_subst(bound, subst);
        };
        [len(args) > 0] {
            let new_args: List<Type> = [];
            let i: Int = 0;
            [i < len(args)] {
                &new_args = append(new_args, apply_subst(args[i], subst));
                &i = i + 1;
            };
            term TypeNamed(name, new_args);
        };
        term ty;
    };
    uni ty(TypeVector(inner, dims)) = {
        term TypeVector(inner, dims);
    };
    uni ty(TypeOption(inner)) = {
        term TypeOption(inner);
    };
    uni ty(TypeResult(ok, err)) = {
        term TypeResult(ok, err);
    };
    term ty;
}

defn unify(t1: Type, t2: Type, subst: Substitution) -> Result<Substitution, String> {
    let t1 = apply_subst(t1, subst);
    let t2 = apply_subst(t2, subst);
    
    [t1 == t2] {
        term Ok(subst);
    };
    
    [is_type_var(t1)] {
        term unify_var(get_name(t1), t2, subst);
    };
    
    [is_type_var(t2)] {
        term unify_var(get_name(t2), t1, subst);
    };
    
    uni ty1(TypeNamed(name1, args1)) = {
        uni ty2(TypeNamed(name2, args2)) = {
            [name1 == name2] {
                [len(args1) == len(args2)] {
                    let new_subst = subst;
                    let i: Int = 0;
                    [i < len(args1)] {
                        let result = unify(args1[i], args2[i], new_subst);
                        uni result(Ok(s)) = {
                            &new_subst = s;
                        };
                        uni result(Err(e)) = {
                            term Err(e);
                        };
                        &i = i + 1;
                    };
                    term Ok(new_subst);
                };
                term Err("Type arity mismatch: " + name1 + " vs " + name2);
            };
            term Err("Cannot unify " + name1 + " with " + name2);
        };
        term Err("Type mismatch");
    };
    
    term Err("Type mismatch");
}

defn unify_var(name: String, ty: Type, subst: Substitution) -> Result<Substitution, String> {
    [occurs_check(name, ty, subst)] {
        term Err("Occurs check failed: " + name + " in " + type_to_string(ty));
    };
    
    let bindings = subst.bindings;
    let bindings = insert(bindings, name, ty);
    term Ok(Substitution { bindings: bindings });
}

defn occurs_check(name: String, ty: Type, subst: Substitution) -> Bool {
    uni ty(TypeNamed(other, args)) = {
        [name == other] {
            term true;
        };
        let i: Int = 0;
        [i < len(args)] {
            [occurs_check(name, args[i], subst)] {
                term true;
            };
            &i = i + 1;
        };
        term false;
    };
    uni ty(TypeVector(inner, _)) = {
        term occurs_check(name, inner, subst);
    };
    uni ty(TypeOption(inner)) = {
        term occurs_check(name, inner, subst);
    };
    uni ty(TypeResult(ok, err)) = {
        occurs_check(name, ok, subst) || occurs_check(name, err, subst);
    };
    term false;
}

// ===== TYPE INFERENCE =====

struct InferResult {
    ty: Type,
    subst: Substitution
}

defn infer_expr(expr: Expr, ctx: TypeContext) -> Result<InferResult, String> {
    uni expr(ExprInt(_)) = {
        term Ok(InferResult {
            ty: TypeInt,
            subst: empty_subst()
        });
    };
    
    uni expr(ExprFloat(_)) = {
        term Ok(InferResult {
            ty: TypeFloat,
            subst: empty_subst()
        });
    };
    
    uni expr(ExprString(_)) = {
        term Ok(InferResult {
            ty: TypeString,
            subst: empty_subst()
        });
    };
    
    uni expr(ExprChar(_)) = {
        term Ok(InferResult {
            ty: TypeChar,
            subst: empty_subst()
        });
    };
    
    uni expr(ExprBool(_)) = {
        term Ok(InferResult {
            ty: TypeBool,
            subst: empty_subst()
        });
    };
    
    uni expr(ExprVar(name)) = {
        let opt = lookup_type(ctx, name);
        [is_some(opt)] {
            term Ok(InferResult {
                ty: unwrap(opt),
                subst: empty_subst()
            });
        };
        term Err("Undefined variable: " + name);
    };
    
    uni expr(ExprBinOp(op, left, right)) = {
        let left_result = infer_expr(left, ctx);
        uni left_result(Ok(lr)) = {
            let right_result = infer_expr(right, ctx);
            uni right_result(Ok(rr)) = {
                let subst = lr.subst;
                let result = unify(lr.ty, rr.ty, subst);
                uni result(Ok(s)) = {
                    [op == "+" || op == "-" || op == "*" || op == "/"] {
                        term Ok(InferResult {
                            ty: lr.ty,
                            subst: s
                        });
                    };
                    [op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="] {
                        term Ok(InferResult {
                            ty: TypeBool,
                            subst: s
                        });
                    };
                    [op == "&&" || op == "||"] {
                        term Ok(InferResult {
                            ty: TypeBool,
                            subst: s
                        });
                    };
                    term Err("Unknown operator: " + op);
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
            };
            uni right_result(Err(e)) = {
                term Err(e);
            };
        };
        uni left_result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni expr(ExprCall(name, args)) = {
        [contains_key(ctx.functions, name)] {
            let d = unwrap(get(ctx.functions, name));
            
            let subst = empty_subst();
            let i: Int = 0;
            [i < len(args)] {
                let arg_result = infer_expr(args[i], ctx);
                uni arg_result(Ok(ar)) = {
                    let result = unify(ar.ty, d.params[i].param_type, subst);
                    uni result(Ok(s)) = {
                        &subst = s;
                    };
                    uni result(Err(e)) = {
                        term Err(e);
                    };
                };
                uni arg_result(Err(e)) = {
                    term Err(e);
                };
                &i = i + 1;
            };
            
            let output = d.output_type;
            [is_some(output)] {
                term Ok(InferResult {
                    ty: unwrap(output),
                    subst: subst
                });
            };
            term Ok(InferResult {
                ty: TypeVoid,
                subst: subst
            });
        };
        term Err("Undefined function: " + name);
    };
    
    uni expr(ExprTuple(elements)) = {
        let types: List<Type> = [];
        let i: Int = 0;
        [i < len(elements)] {
            let result = infer_expr(elements[i], ctx);
            uni result(Ok(ir)) = {
            let res_ty = ir.ty;
            let res_subst = ir.subst;
                &types = append(types, res_ty);
                &i = i + 1;
            };
            uni result(Err(e)) = { term Err(e); };
        };
        term Ok(InferResult { ty: TypeTuple(types), subst: empty_subst() });
    };
    
    uni expr(ExprTupleDestructure(_, source_expr)) = {
        let result = infer_expr(source_expr, ctx);
        uni result(Ok(res)) = { term Ok(res); };
        uni result(Err(e)) = { term Err(e); };
    };
    
    term Err("Cannot infer type for expression");
}

// ===== TYPE CHECKING =====

defn check_program(program: Program, strict_mode: Bool) -> Result<TypedProgram, String> {
    let ctx = new_context();
    
    let i: Int = 0;
    [i < len(program.items)] {
        uni program.items[i](TopDefn(d)) = {
            let ctx = add_function(ctx, d);
        };
        uni program.items[i](TopTxn(t)) = {
            let ctx = add_transaction(ctx, t);
        };
        uni program.items[i](TopStruct(struct_def)) = {
        };
        uni program.items[i](TopEnum(enum_def)) = {
        };
        &i = i + 1;
    };
    
    let i: Int = 0;
    [i < len(program.items)] {
        uni program.items[i](TopDefn(d)) = {
            let result = check_definition(d, ctx, strict_mode);
            uni result(Err(e)) = {
                term Err(e);
            };
            uni result(Ok(_)) = {
            };
        };
        uni program.items[i](TopTxn(t)) = {
            let result = check_transaction(t, ctx, strict_mode);
            uni result(Err(e)) = {
                term Err(e);
            };
            uni result(Ok(_)) = {
            };
        };
        &i = i + 1;
    };
    
    term Ok(program);
}

defn check_definition(d: Definition, ctx: TypeContext, strict_mode: Bool) -> Result<(), String> {
    let ctx = enter_scope(ctx);
    
    let i: Int = 0;
    [i < len(d.params)] {
        let result = add_binding(ctx, d.params[i].name, d.params[i].param_type);
        uni result(Ok(c)) = {
            &ctx = c;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        &i = i + 1;
    };
    
    let result = check_block(d.body, ctx);
    uni result(Ok((body_ty, _))) = {
        let output = d.output_type;
        [is_some(output)] {
            let subst = empty_subst();
            let result = unify(body_ty, unwrap(output), subst);
            uni result(Err(e)) = {
                term Err(e);
            };
            uni result(Ok(_)) = {
            };
        };
        term Ok(Unit);
    };
    uni result(Err(e)) = {
        term Err(e);
    };
}

defn check_transaction(t: Transaction, ctx: TypeContext, strict_mode: Bool) -> Result<(), String> {
    let ctx = enter_scope(ctx);
    
    let i: Int = 0;
    [i < len(t.params)] {
        let result = add_binding(ctx, t.params[i].name, t.params[i].param_type);
        uni result(Ok(c)) = {
            &ctx = c;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        &i = i + 1;
    };
    
    let result = infer_expr(t.contract.precondition, ctx);
    uni result(Ok((pre_ty, _))) = {
        [pre_ty != TypeBool] {
            term Err("Precondition must be Bool, got " + type_to_string(pre_ty));
        };
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    let result = infer_expr(t.contract.postcondition, ctx);
    uni result(Ok((post_ty, _))) = {
        [post_ty != TypeBool] {
            term Err("Postcondition must be Bool, got " + type_to_string(post_ty));
        };
    };
    uni result(Err(e)) = {
        term Err(e);
    };
    
    // Both [true] is always an error — defeats contract-first programming
    uni t.contract.precondition(ExprBool(pre_val)) = {
        [pre_val] {
            uni t.contract.postcondition(ExprBool(post_val)) = {
                [post_val] {
                    term Err("both precondition and postcondition are [true] — at least one side must specify meaningful constraints");
                };
            };
        };
    };
    
    // Strict mode: reject [true] contracts
    [strict_mode] {
        uni t.contract.precondition(ExprBool(pre_val)) = {
            [pre_val] {
                term Err("Strict mode: precondition [true] is not allowed");
            };
        };
        uni t.contract.postcondition(ExprBool(post_val)) = {
[post_val] {
                term Err("Strict mode: postcondition [true] is not allowed");
            };
        };
    };

    let block_result = check_block(t.body, ctx);
    uni block_result(Ok(_)) = {
        term Ok(Unit);
    };
    uni block_result(Err(e)) = {
        term Err(e);
    };
}

defn check_block(stmts: List<Statement>, ctx: TypeContext) -> Result<(Type, TypeContext), String> {
    let ctx = ctx;
    let last_ty: Type = TypeVoid;
    
    let i: Int = 0;
    [i < len(stmts)] {
        let result = check_statement(stmts[i], ctx);
        uni result(Ok((stmt_ty, new_ctx))) = {
            &last_ty = stmt_ty;
            &ctx = new_ctx;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        &i = i + 1;
    };
    
    term (last_ty, ctx);
}

defn check_statement(stmt: Statement, ctx: TypeContext) -> Result<(Type, TypeContext), String> {
    uni stmt(StmtLet(name, var_type, init, _modifiers, _)) = {
        let ctx = ctx;
        let ty: Type = TypeVoid;
        
        // Check for tuple destructuring via ExprTupleDestructure in init
        [is_some(init)] {
            let init_expr = unwrap(init);
            uni init_expr(ExprTupleDestructure(names, source_expr)) = {
let result = infer_expr(source_expr, ctx);
                uni result(Ok((init_ty, _))) = {
                    uni init_ty(TypeTuple(types)) = {
                        [types.len() == names.len()] {
                            let i: Int = 0;
                            [i < types.len()] {
                                &ctx = declare_variable(ctx, names[i], types[i]);
                                &i = i + 1;
                            };
                            term (TypeVoid, ctx);
                        };
                    };
                };
                uni result(Err(e)) = { term Err(e); };
            };
        };
        
        [is_some(init)] {
            let result = infer_expr(unwrap(init), ctx);
            uni result(Ok((init_ty, _))) = {
                [is_some(var_type)] {
                    let subst = empty_subst();
                    let result = unify(init_ty, unwrap(var_type), subst);
                    uni result(Ok(_)) = {
                        &ty = unwrap(var_type);
                    };
                    uni result(Err(e)) = {
                        term Err(e);
                    };
                };
                [!is_some(var_type)] {
                    &ty = init_ty;
                };
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        [is_some(var_type) && is_none(init)] {
            &ty = unwrap(var_type);
        };
        
        let result = add_binding(ctx, name, ty);
        uni result(Ok(c)) = {
            &ctx = c;
        };
        uni result(Err(e)) = {
            term Err(e);
        };
        term (TypeVoid, ctx);
    };
    
    uni stmt(StmtAssign(lhs, rhs, _modifiers)) = {
        let result = infer_expr(lhs, ctx);
        uni result(Ok((lhs_ty, _))) = {
            let result = infer_expr(rhs, ctx);
            uni result(Ok((rhs_ty, _))) = {
                let subst = empty_subst();
                let result = unify(lhs_ty, rhs_ty, subst);
                uni result(Ok(_)) = {
                    term (TypeVoid, ctx);
                };
                uni result(Err(e)) = {
                    term Err(e);
                };
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni stmt(StmtExpr(expr)) = {
        let result = infer_expr(expr, ctx);
        uni result(Ok((ty, _))) = {
            term (ty, ctx);
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni stmt(StmtTerm(values, _modifiers)) = {
        [len(values) == 0] {
            term (TypeVoid, ctx);
        };
        [len(values) == 1] {
            let result = infer_expr(unwrap(values[0]), ctx);
            uni result(Ok((ty, _))) = {
                term (ty, ctx);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        term (TypeVoid, ctx);
    };
    
    uni stmt(StmtEscape(value)) = {
        [is_some(value)] {
            let result = infer_expr(unwrap(value), ctx);
            uni result(Err(e)) = {
                term Err(e);
            };
            uni result(Ok(_)) = {
            };
        };
        term (TypeVoid, ctx);
    };
    
    uni stmt(StmtGuarded(condition, body)) = {
        let result = infer_expr(condition, ctx);
        uni result(Ok((cond_ty, _))) = {
            [cond_ty != TypeBool] {
                term Err("Guard condition must be Bool");
            };
            
            let result = check_block(body, ctx);
            uni result(Ok(_)) = {
                term (TypeVoid, ctx);
            };
            uni result(Err(e)) = {
                term Err(e);
            };
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni stmt(StmtUnification(name, pattern, expr)) = {
        let result = infer_expr(expr, ctx);
        uni result(Err(e)) = {
            term Err(e);
        };
        uni result(Ok(_)) = {
            term (TypeVoid, ctx);
        };
    };
    
    uni stmt(StmtOnExit(body)) = {
        let result = check_block(body, ctx);
        uni result(Ok((_, _))) = {
            term (TypeVoid, ctx);
        };
        uni result(Err(e)) = {
            term Err(e);
        };
    };
    
    uni stmt(StmtAlka(_)) = {
        // Opaque passthrough, no validation
        term (TypeVoid, ctx);
    };
    
    uni stmt(StmtLocalTrigger(name, ty, trigger_expr)) = {
        [is_some(trigger_expr)] {
            let result = infer_expr(unwrap(trigger_expr), ctx);
            uni result(Ok((expr_ty, _))) = {
                let subst = empty_subst();
                let result = unify(expr_ty, ty, subst);
                uni result(Err(e)) = { term Err(e); };
                uni result(Ok(_)) = {};
            };
            uni result(Err(e)) = { term Err(e); };
        };
        &ctx = declare_variable(ctx, name, ty);
        term (TypeVoid, ctx);
    };
    
    term (TypeVoid, ctx);
}

// ===== UTILITY FUNCTIONS =====

defn type_to_string(ty: Type) -> String {
    uni ty(TypeInt) = "Int";
    uni ty(TypeUInt) = "UInt";
    uni ty(TypeFloat) = "Float";
    uni ty(TypeString) = "String";
    uni ty(TypeBool) = "Bool";
    uni ty(TypeChar) = "Char";
    uni ty(TypeData) = "Data";
    uni ty(TypeVoid) = "Void";
    uni ty(TypeNamed(name, args)) = {
        let sb = new_builder();
        let sb = append_str(sb, name);
        [len(args) > 0] {
            let sb = append_char(sb, '<');
            let i: Int = 0;
            [i < len(args)] {
                [i > 0] {
                    let sb = append_str(sb, ", ");
                };
                let sb = append_str(sb, type_to_string(args[i]));
                &i = i + 1;
            };
            let sb = append_char(sb, '>');
        };
        term to_string(sb);
    };
    term "Unknown";
}
