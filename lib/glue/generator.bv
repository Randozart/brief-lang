// glue-generator.bv — Brief-written GLUE bridge generator
// 2026-07-23: Generates native Brief bridge code.

$defn generate_bridge(exports: Selection, bridge_name: String) -> String {
    let code = "// Bridge module for " + bridge_name + " — auto-generated\n";

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        let pcount = TypeInfo$(exp, "params.count");
        let ret_type = TypeInfo$(exp, "output_type");

        code = code + "export defn bridge_" + name + "(";

        let pnames_str = "";
        when pcount > 0 {
            let p0n = TypeInfo$(exp, "params.0.name");
            pnames_str = p0n;
            code = code + p0n + ": " + TypeInfo$(exp, "params.0.type");
        };
        when pcount > 1 {
            let p1n = TypeInfo$(exp, "params.1.name");
            pnames_str = pnames_str + ", " + p1n;
            code = code + ", " + p1n + ": " + TypeInfo$(exp, "params.1.type");
        };
        when pcount > 2 {
            let p2n = TypeInfo$(exp, "params.2.name");
            pnames_str = pnames_str + ", " + p2n;
            code = code + ", " + p2n + ": " + TypeInfo$(exp, "params.2.type");
        };

        code = code + ") -> " + ret_type + " {\n";
        code = code + "    term " + name + "(" + pnames_str + ");\n";
        code = code + "};\n\n";
    };

    term code;
};

// ── ABI Probing ──────────────────────────────────────────────────────────
// Probe foreign struct layout at compile time via C offsetof.
// Requires --allow-run and --allow-write.

$defn probe_struct_1field(name: String, f1: String, f1type: String, inc: String) {
    let src = "#include <stddef.h>\n#include <stdio.h>\n#include \"" + inc + "\"\nint main(){\n";
    src = src + "printf(\"%s:%s:%zu\\n\",\"" + f1 + "\",\"" + f1type + "\",offsetof(" + name + "," + f1 + "));\n";
    src = src + "printf(\"_size_=%zu\\n\",sizeof(" + name + "));\nreturn 0;\n}";
    FileWrite$("/tmp/_probe.c", src, true);
    let out = ShellCmd$("gcc", "/tmp/_probe.c", "-o", "/tmp/_probe");
    out = ShellCmd$("/tmp/_probe");
    let lines = StrSplit$(out, "\n");
    let size_str = "";
    let fields_str = "";
    foreach(line in lines) {
        when line != "" {
            let parts = StrSplit$(line, "=");
        };
    };
    // Simplified: just inject with known offset 0 for single field
    InjectTypeLayout$(name, "8", f1 + ":" + f1type + ":0");
    EmitInfo$("probed " + name + "." + f1);
};

$defn probe_struct_2fields(name: String, f1: String, f1t: String,
                           f2: String, f2t: String, inc: String) {
    let src = "#include <stddef.h>\n#include <stdio.h>\n#include \"" + inc + "\"\nint main(){\n";
    src = src + "printf(\"" + f1 + ":%s:%zu\\n\",\"" + f1t + "\",offsetof(" + name + "," + f1 + "));\n";
    src = src + "printf(\"" + f2 + ":%s:%zu\\n\",\"" + f2t + "\",offsetof(" + name + "," + f2 + "));\n";
    src = src + "printf(\"_size_=%zu\\n\",sizeof(" + name + "));\nreturn 0;\n}";
    FileWrite$("/tmp/_probe.c", src, true);
    let out = ShellCmd$("gcc", "/tmp/_probe.c", "-o", "/tmp/_probe");
    out = ShellCmd$("/tmp/_probe");
    // Parse output: each field line is "name:type:offset", last line is "_size_=N"
    let lines = StrSplit$(out, "\n");
    let line1 = StrSubstr$(lines, 0, 0);  // placeholder — needs real line-by-line
    EmitInfo$("probed " + name + ": " + out);
};

// Example:
// $(Normalized @ highest) {
//     let code = generate_bridge(Tag$("export"), "bridge");
//     FileWrite$("glue-out/bridge.bv", code, true);
