// 2026-07-22: Python type declarations for Briv's type universe.
// Types are defined against protocol hashwords (#String<UTF8>, #Int, etc.)
// so GLUE can find CastTo/CastFrom paths.

type PyBytes {
    !> maxbits: 64;
    !> alignment: 8;
    op CastTo(#Bits) = identity(#Lh);
    op CastFrom(#Bits) = identity(#Lh);
};

type PyString: #String {
    !> maxbits: 128;
    !> alignment: 8;
    op CastTo(#String<UTF8>) = ucs4_to_utf8(#Lh);
    op CastFrom(#String<UTF8>) = utf8_to_ucs4(#Lh);
    op CastTo(#String<ASCII>) = ucs4_to_ascii(#Lh);
    op CastFrom(#String<ASCII>) = ascii_to_ucs4(#Lh);
};

type PyInt: #Int {
    !> maxbits: 64;
    !> alignment: 8;
    op CastTo(#Int) = pylong_to_i64(#Lh);
    op CastFrom(#Int) = i64_to_pylong(#Lh);
};

// Zero-copy melds: if Briv CBuffer has same layout as PyBytes
meld PyBytes -> CBuffer {
    ptr -> ptr;
    len -> len;
};
