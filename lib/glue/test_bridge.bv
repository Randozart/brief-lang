// test_bridge.bv — Pure-Briv GLUE bridge demo
// Build: briv build lib/glue/test_bridge.bv --allow-write

export defn add(a: Int, b: Int) -> Int {
    term a + b;
};

export defn mul(a: Int, b: Int) -> Int {
    term a * b;
};

$defn generate_pure_bridge(exports: Selection, bridge_name: String) -> String {
    let code = "// Pure-Briv GLUE bridge for " + bridge_name + "\n\n";

    code += "struct PyMethodDef { name: Ptr; meth: Ptr; flags: Int; doc: Ptr; };\n";
    code += "struct PyModuleDef_Base { ob_refcnt: Int; ob_type: Ptr; m_init: Ptr; };\n";
    code += "struct PyModuleDef { m_base: PyModuleDef_Base; m_name: Ptr; m_doc: Ptr; m_size: Int; m_methods: Ptr; m_slots: Ptr; m_traverse: Ptr; m_clear: Ptr; m_free: Ptr; };\n\n";

    code += "frgn PyLong_FromLongLong(n: Int) -> Ptr from \"c\" fallback 0;\n";
    code += "frgn PyModule_Create2(defn: Ptr, api: Int) -> Ptr from \"c\" fallback 0;\n\n";

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        let pcount = TypeInfo$(exp, "params.count");
        code += "frgn " + name + "(";
        when pcount > 0 { code += "a: Int"; };
        when pcount > 1 { code += ", b: Int"; };
        code += ") -> Int from \"c\" fallback 0;\n";
    };

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        code += "export defn pybridge_" + name + "(self: Ptr, args: Ptr) -> Ptr {\n";
        code += "    let r: Int = " + name + "(0, 0);\n";
        code += "    term PyLong_FromLongLong(r);\n";
        code += "};\n\n";
    };

    // Build methods array dynamically from exports
    code += "let methods = [\n";
    let first = true;
    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        when !first { code += ",\n"; };
        code += "    PyMethodDef { name: \"" + name + "\"; meth: &pybridge_" + name + "; flags: 1; doc: null; }";
        first = false;
    };
    code += "\n];\n\n";

    code += "let moduledef = PyModuleDef {\n";
    code += "    m_base: PyModuleDef_Base { ob_refcnt: 1; ob_type: null; m_init: null; };\n";
    code += "    m_name: \"bridge\";\n";
    code += "    m_doc: null;\n";
    code += "    m_size: -1;\n";
    code += "    m_methods: &methods;\n";
    code += "    m_slots: null;\n";
    code += "    m_traverse: null;\n";
    code += "    m_clear: null;\n";
    code += "    m_free: null;\n";
    code += "};\n\n";

    code += "export defn PyInit_" + bridge_name + "() -> Ptr {\n";
    code += "    term PyModule_Create2(&moduledef, 1013);\n";
    code += "};\n";

    term code;
};

$(Normalized @ highest) {
    let exports = Tag$("export");
    when exports.IsEmpty$() {
        EmitInfo$("no exports found, nothing to generate");
    };

    let bridge_code = generate_pure_bridge(exports, "bridge");
    FileWrite$("glue-out/bridge_pure.bv", bridge_code, true);
    EmitInfo$("pure-Briv GLUE bridge: glue-out/bridge_pure.bv");
};
