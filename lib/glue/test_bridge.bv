// test_bridge.bv — GLUE-in-Brief demo
// Build: brief build lib/glue/test_bridge.bv

export defn add(a: Int, b: Int) -> Int {
    term a + b;
};

export defn greet(name: String) -> String {
    term "hello " + name;
};

export defn double(x: Float) -> Float {
    term x * 2.0;
};

$defn generate_python_bridge(exports: Selection, bridge_name: String) -> String {
    let code = "// Bridge module for " + bridge_name + " — auto-generated\n";
    code = code + "// Include in your project: brief build bridge.bv\n\n";

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        let pcount = TypeInfo$(exp, "params.count");
        let ret_type = TypeInfo$(exp, "output_type");

        code = code + "export defn bridge_" + name + "(";

        let pnames_str = "";
        when pcount > 0 {
            let p0n = TypeInfo$(exp, "params.0.name");
            pnames_str = p0n;
            code = code + p0n + ": " + TypeInfo$(exp, "params.0.type");
        };
        when pcount > 1 {
            let p1n = TypeInfo$(exp, "params.1.name");
            pnames_str = pnames_str + ", " + p1n;
            code = code + ", " + p1n + ": " + TypeInfo$(exp, "params.1.type");
        };
        when pcount > 2 {
            let p2n = TypeInfo$(exp, "params.2.name");
            pnames_str = pnames_str + ", " + p2n;
            code = code + ", " + p2n + ": " + TypeInfo$(exp, "params.2.type");
        };

        code = code + ") -> " + ret_type + " {\n";
        code = code + "    term " + name + "(" + pnames_str + ");\n";
        code = code + "};\n\n";
    };

    term code;
};

$(Normalized @ highest) {
    let bridge_name = "bridge";

    let exports = Tag$("export");
    when exports.IsEmpty$() {
        EmitInfo$("no exports found, nothing to generate");
    };

    let bridge_code = generate_python_bridge(exports, bridge_name);
    FileWrite$("glue-out/" + bridge_name + ".bv", bridge_code, true);
    EmitInfo$("GLUE bridge: wrote " + bridge_name + ".bv");

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        let pcount = TypeInfo$(exp, "params.count");
        let ret_type = TypeInfo$(exp, "output_type");
        EmitInfo$("  export " + name + "(..." + pcount + " args) -> " + ret_type);
    };
};
