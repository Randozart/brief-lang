// lib/pp/exprs.bv — AST pretty-printer for expressions and operators
// 2026-07-22: Phase 8 — AST Pretty-Printer Port to Briev

// ── Binary operators ──

defn pp_binop_add() -> String { term "+"; };
defn pp_binop_sub() -> String { term "-"; };
defn pp_binop_mul() -> String { term "*"; };
defn pp_binop_div() -> String { term "/"; };
defn pp_binop_mod() -> String { term "%"; };
defn pp_binop_eq() -> String { term "=="; };
defn pp_binop_neq() -> String { term "!="; };
defn pp_binop_lt() -> String { term "<"; };
defn pp_binop_gt() -> String { term ">"; };
defn pp_binop_le() -> String { term "<="; };
defn pp_binop_ge() -> String { term ">="; };
defn pp_binop_and() -> String { term "&&"; };
defn pp_binop_or() -> String { term "||"; };
defn pp_binop_bitand() -> String { term "&"; };
defn pp_binop_bitor() -> String { term "|"; };
defn pp_binop_bitxor() -> String { term "^"; };
defn pp_binop_shl() -> String { term "<<"; };
defn pp_binop_shr() -> String { term ">>"; };
defn pp_binop_concat() -> String { term "+"; };

defn pp_binop(kind: String) -> String {
    match kind {
        "Add" => { term "+"; };
        "Sub" => { term "-"; };
        "Mul" => { term "*"; };
        "Div" => { term "/"; };
        "Mod" => { term "%"; };
        "Eq" => { term "=="; };
        "Neq" => { term "!="; };
        "Lt" => { term "<"; };
        "Gt" => { term ">"; };
        "Le" => { term "<="; };
        "Ge" => { term ">="; };
        "And" => { term "&&"; };
        "Or" => { term "||"; };
        "BitAnd" => { term "&"; };
        "BitOr" => { term "|"; };
        "BitXor" => { term "^"; };
        "Shl" => { term "<<"; };
        "Shr" => { term ">>"; };
        "Concat" => { term "+"; };
        _ => { term "<?>"; };
    };
};

// ── Unary operators ──

defn pp_unary_op(kind: String) -> String {
    match kind {
        "Neg" => { term "-"; };
        "Not" => { term "!"; };
        "BitNot" => { term "~"; };
        _ => { term "<?>"; };
    };
};

// ── Expression formatting helpers ──

defn pp_binop_expr(lhs: String, op: String, rhs: String) -> String {
    term "(" + lhs + " " + op + " " + rhs + ")";
};

defn pp_unary_expr(op: String, expr: String) -> String {
    term op + expr;
};

defn pp_call(name: String, args: String) -> String {
    term name + "(" + args + ")";
};

defn pp_field(receiver: String, name: String) -> String {
    term receiver + "." + name;
};

defn pp_index(receiver: String, idx: String) -> String {
    term receiver + "[" + idx + "]";
};

defn pp_tuple(elems: String) -> String {
    term "(" + elems + ")";
};

defn pp_list(elems: String) -> String {
    term "[" + elems + "]";
};

defn pp_cast(expr: String, ty: String) -> String {
    term expr + " as " + ty;
};

defn pp_is_type(expr: String, ty: String) -> String {
    term expr + " is " + ty;
};

defn pp_deref(inner: String) -> String {
    term "*" + inner;
};

defn pp_addr_of(inner: String) -> String {
    term "&" + inner;
};
