// Language Mapper Template
//
// Briv FFI mapper for <LANGUAGE>.
// Transforms between <LANGUAGE> types and Briv types.
//
// For documentation, see: spec/MAPPER-GUIDE.md
//
// HOW TO USE THIS TEMPLATE:
// 1. Copy this file to lib/ffi/mappers/<lang>_mapper.bv
// 2. Replace all <LANG_*> placeholders with actual types
// 3. Implement the required functions
// 4. Add type-specific conversion functions
// 5. Write tests

// ============================================================
// Required Functions (Identity by default)
// ============================================================

defn map_input(value: Value) -> Value [true][term == value] {
    term value;
};

defn map_output(value: Value) -> Value [true][term == value] {
    term value;
};

defn map_error(err: Error) -> Error [true][term == err] {
    term err;
};

