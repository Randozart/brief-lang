// gen_python.bv — Tier 2: Python C extension bridge generator
// 2026-07-24: Generates CPython C extension (~150ns per call).
// Most efficient Python FFI: direct CPython API, no ctypes overhead.
//
// Supports up to 6 parameters with types: Int, Float, Bool, String, Ptr, Void.

$defn py_c_type(t: String) -> String {
    when t == "Int"    { term "long long"; };
    when t == "Float"  { term "double"; };
    when t == "Bool"   { term "long"; };
    when t == "String" { term "const char*"; };
    when t == "Ptr"    { term "void*"; };
    when t == "Void"   { term "void"; };
    term "long long";
};

$defn py_parse_fmt(t: String) -> String {
    when t == "Int"    { term "L"; };
    when t == "Float"  { term "d"; };
    when t == "Bool"   { term "l"; };
    when t == "String" { term "s"; };
    when t == "Ptr"    { term "O&"; };
    term "L";
};

$defn py_to_python(t: String, expr: String) -> String {
    when t == "Int"    { term "PyLong_FromLongLong(" + expr + ")"; };
    when t == "Float"  { term "PyFloat_FromDouble(" + expr + ")"; };
    when t == "Bool"   { term "PyBool_FromLong(" + expr + ")"; };
    when t == "String" { term "PyUnicode_FromString(" + expr + ")"; };
    when t == "Ptr"    { term "PyCapsule_New(" + expr + ", NULL, NULL)"; };
    when t == "Void"   { term "Py_RETURN_NONE"; };
    term "PyLong_FromLongLong(" + expr + ")";
};

$defn gen_python_bridge(exports: Selection, bridge_name: String) -> String {
    let code = "// Python C extension: " + bridge_name + " (auto-generated)\n";
    code += "#include <Python.h>\n#include <dlfcn.h>\n#include <stdint.h>\n\n";
    code += "static void* lib_handle = NULL;\n\n";

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        let pcount_str = TypeInfo$(exp, "params.count");
        let pcount = 0;
        match pcount_str {
            "1" => { pcount = 1; };
            "2" => { pcount = 2; };
            "3" => { pcount = 3; };
            "4" => { pcount = 4; };
            "5" => { pcount = 5; };
            "6" => { pcount = 6; };
            _ => {};
        };
        let ret = py_c_type(TypeInfo$(exp, "output_type"));

        let ctypes = "";
        let cargs = "";
        match pcount {
            1 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")); cargs = "carg_0"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n"; };
            2 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")) + ", " + py_c_type(TypeInfo$(exp, "params.1.type")); cargs = "carg_0, carg_1"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n" + "static " + py_c_type(TypeInfo$(exp, "params.1.type")) + " carg_1;\n"; };
            3 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")) + ", " + py_c_type(TypeInfo$(exp, "params.1.type")) + ", " + py_c_type(TypeInfo$(exp, "params.2.type")); cargs = "carg_0, carg_1, carg_2"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n" + "static " + py_c_type(TypeInfo$(exp, "params.1.type")) + " carg_1;\n" + "static " + py_c_type(TypeInfo$(exp, "params.2.type")) + " carg_2;\n"; };
            4 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")) + ", " + py_c_type(TypeInfo$(exp, "params.1.type")) + ", " + py_c_type(TypeInfo$(exp, "params.2.type")) + ", " + py_c_type(TypeInfo$(exp, "params.3.type")); cargs = "carg_0, carg_1, carg_2, carg_3"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n" + "static " + py_c_type(TypeInfo$(exp, "params.1.type")) + " carg_1;\n" + "static " + py_c_type(TypeInfo$(exp, "params.2.type")) + " carg_2;\n" + "static " + py_c_type(TypeInfo$(exp, "params.3.type")) + " carg_3;\n"; };
            5 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")) + ", " + py_c_type(TypeInfo$(exp, "params.1.type")) + ", " + py_c_type(TypeInfo$(exp, "params.2.type")) + ", " + py_c_type(TypeInfo$(exp, "params.3.type")) + ", " + py_c_type(TypeInfo$(exp, "params.4.type")); cargs = "carg_0, carg_1, carg_2, carg_3, carg_4"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n" + "static " + py_c_type(TypeInfo$(exp, "params.1.type")) + " carg_1;\n" + "static " + py_c_type(TypeInfo$(exp, "params.2.type")) + " carg_2;\n" + "static " + py_c_type(TypeInfo$(exp, "params.3.type")) + " carg_3;\n" + "static " + py_c_type(TypeInfo$(exp, "params.4.type")) + " carg_4;\n"; };
            6 => { ctypes = py_c_type(TypeInfo$(exp, "params.0.type")) + ", " + py_c_type(TypeInfo$(exp, "params.1.type")) + ", " + py_c_type(TypeInfo$(exp, "params.2.type")) + ", " + py_c_type(TypeInfo$(exp, "params.3.type")) + ", " + py_c_type(TypeInfo$(exp, "params.4.type")) + ", " + py_c_type(TypeInfo$(exp, "params.5.type")); cargs = "carg_0, carg_1, carg_2, carg_3, carg_4, carg_5"; code = code + "static " + py_c_type(TypeInfo$(exp, "params.0.type")) + " carg_0;\n" + "static " + py_c_type(TypeInfo$(exp, "params.1.type")) + " carg_1;\n" + "static " + py_c_type(TypeInfo$(exp, "params.2.type")) + " carg_2;\n" + "static " + py_c_type(TypeInfo$(exp, "params.3.type")) + " carg_3;\n" + "static " + py_c_type(TypeInfo$(exp, "params.4.type")) + " carg_4;\n" + "static " + py_c_type(TypeInfo$(exp, "params.5.type")) + " carg_5;\n"; };
            _ => {};
        };

        // Function pointer typedef and declaration
        code = code + "\ntypedef " + ret + " (*" + name + "_fn_t)(" + ctypes + ");\n";
        code = code + "static " + name + "_fn_t " + name + "_fn = NULL;\n\n";

        // Wrapper function
        code = code + "static PyObject* pybridge_" + name + "(PyObject* self, PyObject* args) {\n";
        code = code + "    (void)self;\n";

        let fmt = "";
        let pargs = "";
        match pcount {
            1 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")); pargs = "&carg_0"; };
            2 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")) + py_parse_fmt(TypeInfo$(exp, "params.1.type")); pargs = "&carg_0, &carg_1"; };
            3 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")) + py_parse_fmt(TypeInfo$(exp, "params.1.type")) + py_parse_fmt(TypeInfo$(exp, "params.2.type")); pargs = "&carg_0, &carg_1, &carg_2"; };
            4 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")) + py_parse_fmt(TypeInfo$(exp, "params.1.type")) + py_parse_fmt(TypeInfo$(exp, "params.2.type")) + py_parse_fmt(TypeInfo$(exp, "params.3.type")); pargs = "&carg_0, &carg_1, &carg_2, &carg_3"; };
            5 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")) + py_parse_fmt(TypeInfo$(exp, "params.1.type")) + py_parse_fmt(TypeInfo$(exp, "params.2.type")) + py_parse_fmt(TypeInfo$(exp, "params.3.type")) + py_parse_fmt(TypeInfo$(exp, "params.4.type")); pargs = "&carg_0, &carg_1, &carg_2, &carg_3, &carg_4"; };
            6 => { fmt = py_parse_fmt(TypeInfo$(exp, "params.0.type")) + py_parse_fmt(TypeInfo$(exp, "params.1.type")) + py_parse_fmt(TypeInfo$(exp, "params.2.type")) + py_parse_fmt(TypeInfo$(exp, "params.3.type")) + py_parse_fmt(TypeInfo$(exp, "params.4.type")) + py_parse_fmt(TypeInfo$(exp, "params.5.type")); pargs = "&carg_0, &carg_1, &carg_2, &carg_3, &carg_4, &carg_5"; };
            _ => {};
        };

        match pcount {
            0 => {};
            _ => { code = code + "    if (!PyArg_ParseTuple(args, \"" + fmt + "\", " + pargs + ")) return NULL;\n"; };
        };

        match TypeInfo$(exp, "output_type") {
            "Void" => { code = code + "    " + name + "_fn(" + cargs + ");\n"; code = code + "    Py_RETURN_NONE;\n"; };
            _ => { code = code + "    " + ret + " result = " + name + "_fn(" + cargs + ");\n"; code = code + "    return " + py_to_python(TypeInfo$(exp, "output_type"), "result") + ";\n"; };
        };
        code = code + "}\n";
    };

    // PyMethodDef array
    code = code + "\nstatic PyMethodDef methods[] = {\n";
    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        code = code + "    {\"" + name + "\", pybridge_" + name + ", METH_VARARGS, \"Brief export " + name + "\"},\n";
    };
    code = code + "    {NULL, NULL, 0, NULL}\n};\n\n";

    code = code + "static struct PyModuleDef module_def = {\n";
    code = code + "    PyModuleDef_HEAD_INIT,\n";
    code = code + "    \"" + bridge_name + "\",\n";
    code = code + "    \"Brief bridge (Metropolitan FFI)\",\n";
    code = code + "    0,\n";
    code = code + "    methods\n";
    code = code + "};\n\n";

    code = code + "PyMODINIT_FUNC PyInit_" + bridge_name + "(void) {\n";
    code = code + "    lib_handle = dlopen(NULL, RTLD_LAZY | RTLD_LOCAL);\n";
    code = code + "    if (!lib_handle) { PyErr_SetString(PyExc_RuntimeError, dlerror()); return NULL; }\n\n";

    foreach(exp in exports) {
        let name = TypeInfo$(exp, "name");
        code = code + "    " + name + "_fn = (" + name + "_fn_t)dlsym(lib_handle, \"" + name + "\");\n";
        code = code + "    if (!" + name + "_fn) { PyErr_SetString(PyExc_RuntimeError, \"dlsym " + name + " failed\"); return NULL; }\n";
    };

    code = code + "    return PyModuleDef_Init(&module_def);\n";
    code = code + "}\n";
    term code;
};

$(Normalized @ highest) {
    let exports = Tag$("export");
    when exports.Count$() > 0 {
        let code = gen_python_bridge(exports, "brief_bridge");
        FileWrite$("ffi-out/python/bridge.c", code, true);
        EmitInfo$("gen_python: ffi-out/python/bridge.c");
    };
};

