// Kria KV260 Vision AI Starter Kit Configuration (.dbv)
// Concrete board-level bindings

IMPORT "xck26.dbvs";

// PS Peripheral Bindings
ALIAS gic_distributor: Data = @0xF9010000;
ALIAS uart_debug: Data = @0xFF010000;
ALIAS smmu_regs: Data = @0xFD800000;
ALIAS ocm_memory: Vector[UInt[8], 262144] = @0xFFFC0000;

// Firmware Reservations
ALIAS atf_vectors: Data = @0x00000000; // 0x0000_0000 – 0x0000_1FFF
ALIAS pmu_firmware: Data = @0x7FF00000; // 0x7FF0_0000 – 0x7FFF_FFFF
ALIAS rpu_shared: Data = @0x7FE00000; // 0x7FE0_0000 – 0x7FEF_FFFF

// Board Constraints
CHECK board_safety [
    // Ensure critical firmware regions are locked
    atf_vectors == 0x00000000;
    pmu_firmware == 0x7FF00000;
]
