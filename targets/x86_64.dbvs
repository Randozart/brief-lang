// x86_64 Target Schema
schema X86_64Target {
    name: String,
    architecture: String,
    bits: Int,
    endian: String,
    os: String,
    abi: String
};

X86_64Target {
    name: "x86_64-unknown-linux-gnu",
    architecture: "x86_64",
    bits: 64,
    endian: "little",
    os: "linux",
    abi: "gnu"
};

// Linux x86_64 syscall numbers
schema SyscallMap {
    SYS_READ: Int = 0;
    SYS_WRITE: Int = 1;
    SYS_OPEN: Int = 2;
    SYS_CLOSE: Int = 3;
    SYS_MMAP: Int = 9;
    SYS_MUNMAP: Int = 11;
    SYS_BRK: Int = 12;
    SYS_IOCTL: Int = 16;
    SYS_NANOSLEEP: Int = 35;
    SYS_GETPID: Int = 39;
    SYS_EXIT: Int = 60;
    SYS_FUTEX: Int = 202;
};