// AArch64 Target Schema
schema AArch64Target {
    name: String,
    architecture: String,
    bits: Int,
    endian: String,
    os: String,
    abi: String
};

AArch64Target {
    name: "aarch64-unknown-linux-gnu",
    architecture: "aarch64",
    bits: 64,
    endian: "little",
    os: "linux",
    abi: "gnu"
};

// Linux AArch64 syscall numbers
schema SyscallMap {
    SYS_READ: Int = 63;
    SYS_WRITE: Int = 64;
    SYS_OPEN: Int = 56;
    SYS_CLOSE: Int = 57;
    SYS_MMAP: Int = 222;
    SYS_MUNMAP: Int = 215;
    SYS_EXIT: Int = 93;
};