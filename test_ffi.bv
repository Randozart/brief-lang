#![ffi.c, bind("./c_profile.toml"), map("uint","uint32_t")]

// Fire-and-forget with explicit address
frgn! write_reg @ 0x40001000 (val: UInt);

// Fire-and-forget with compiler-picked address
frgn! sync();

// Standard foreign function with Result
frgn printk(fmt: String) -> Result<Int, Err>;

// Standard foreign function with explicit address
frgn write_dma @ 0x40002000 (addr: UInt, size: UInt) -> Result<Bool, Err>;

// Per-function type override
#[ffi.c, type("Int32Array")]
frgn get_buffer() -> Result<UInt, Err>;